@page "/ethics/submit"
@layout EmptyLayout
@inject EthicsService EthicsSvc
@inject ConfigService CfgSvc
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Etik Bildirim</PageTitle>

<div class="login-page">
    <div class="login-card" style="max-width:560px">
        <div class="login-logo">
            <h1>Etik Bildirim</h1>
            <p>Anonim bildirim — kimliğiniz gizli tutulur</p>
        </div>

        @if (_submitted)
        {
            <div class="alert alert-success">
                <strong>Bildiriminiz alındı.</strong> Referans kodunuz: <strong>@_code</strong>
                <p style="margin-top:8px;font-size:13px">Bu kodu saklayınız. Durumu takip etmek için kullanabilirsiniz.</p>
            </div>
            <a href="/ethics/status/@_code" class="btn btn-outline" style="width:100%;text-align:center;margin-top:8px">
                Bildirim Durumunu Görüntüle →
            </a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error">@_error</div> }

            <div class="form-group">
                <label class="form-label">Konu *</label>
                <input class="form-control" @bind="_subject" maxlength="200" />
            </div>
            <div class="form-group">
                <label class="form-label">Kategori</label>
                <select class="form-control" @bind="_category">
                    <option value="">— Seçiniz —</option>
                    @foreach (var c in _categories) { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Açıklama *</label>
                <textarea class="form-control" rows="5" @bind="_description" placeholder="Olayı detaylı anlatınız…"></textarea>
            </div>
            <button class="btn btn-primary" style="width:100%" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Gönderiliyor…" : "Gönder")
            </button>
        }
    </div>
</div>

@code {
    private string _subject = "", _description = "", _category = "";
    private string[] _categories = [];
    private bool _loading, _submitted;
    private string _error = "", _code = "";

    protected override void OnInitialized() =>
        _categories = CfgSvc.GetList("ethics_categories");

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_description))
        { _error = "Konu ve açıklama zorunludur."; return; }
        _loading = true;
        var report = await EthicsSvc.SubmitAsync(_subject, _description, _category, []);
        _code = report.Code;
        _submitted = true;
        _loading = false;
    }
}

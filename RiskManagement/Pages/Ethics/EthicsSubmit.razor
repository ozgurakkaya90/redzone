@page "/ethics/submit"
@layout EmptyLayout
@inject EthicsService EthicsSvc
@inject ConfigService CfgSvc
@inject AnonymousRateLimiter RateLimiter
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Etik Bildirim</PageTitle>

<div class="login-page">
    <div class="login-card" style="max-width:560px">
        <div class="login-logo">
            <h1>Etik Bildirim</h1>
            <p>Anonim bildirim — kimliğiniz gizli tutulur</p>
        </div>

        @if (_submitted)
        {
            <div class="alert alert-success">
                <strong>Bildiriminiz alındı.</strong> Referans kodunuz: <strong>@_code</strong>
                <p style="margin-top:8px;font-size:13px">
                    Durumu takip etmek için aşağıdaki <strong>kişisel takip bağlantınızı</strong> saklayınız.
                    Bu bağlantı yalnızca size özeldir; kaybederseniz bildiriminize erişilemez.
                </p>
                <div style="margin-top:8px;font-size:12px;word-break:break-all;background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px">
                    @_statusUrl
                </div>
            </div>
            <a href="/ethics/status/@_token" class="btn btn-outline" style="width:100%;text-align:center;margin-top:8px">
                Bildirim Durumunu Görüntüle →
            </a>
        }
        else
        {
            @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error">@_error</div> }

            <div class="form-group">
                <label class="form-label">Konu *</label>
                <input class="form-control" @bind="_subject" maxlength="200" />
            </div>
            <div class="form-group">
                <label class="form-label">Kategori</label>
                <select class="form-control" @bind="_category">
                    <option value="">— Seçiniz —</option>
                    @foreach (var c in _categories) { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Açıklama *</label>
                <textarea class="form-control" rows="5" @bind="_description" placeholder="Olayı detaylı anlatınız…"></textarea>
            </div>
            <button class="btn btn-primary" style="width:100%" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Gönderiliyor…" : "Gönder")
            </button>
        }
    </div>
</div>

@code {
    private string _subject = "", _description = "", _category = "";
    private string[] _categories = [];
    private bool _loading, _submitted;
    private string _error = "", _code = "", _token = "", _statusUrl = "";

    protected override void OnInitialized() =>
        _categories = CfgSvc.GetList("ethics_categories");

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_description))
        { _error = "Konu ve açıklama zorunludur."; return; }

        // Sunucu taraflı uzunluk sınırı — client'taki maxlength bypass edilebilir, depolama suistimalini engeller.
        // Sınırlar model ile hizalı: Subject MaxLength(200), Description MaxLength(4000).
        if (_subject.Trim().Length > 200 || _description.Trim().Length > 4000)
        { _error = "Konu en fazla 200, açıklama en fazla 4000 karakter olabilir."; return; }

        // Anonim/kimlik doğrulamasız form — IP bazlı rate limit (spam/DoS koruması).
        // ProposeAnonymous ile aynı limiter; ayrı bucket ile bağımsız sayaç.
        var ip = HttpCtx.HttpContext?.Connection.RemoteIpAddress?.ToString();
        if (!RateLimiter.IsAllowed(ip, "anon_ethics"))
        { _error = "Çok fazla bildirim gönderildi. Lütfen daha sonra tekrar deneyin."; return; }

        _loading = true;
        var report = await EthicsSvc.SubmitAsync(_subject.Trim(), _description.Trim(), _category, []);
        _code = report.Code;
        _token = report.TrackingToken ?? "";
        _statusUrl = Nav.ToAbsoluteUri($"/ethics/status/{_token}").ToString();
        _submitted = true;
        _loading = false;
    }
}

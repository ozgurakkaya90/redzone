@page "/ethics/status/{Code}"
@layout EmptyLayout
@inject AppDbContext Db

<PageTitle>Bildirim Durumu</PageTitle>

<div class="login-page">
    <div class="login-card" style="max-width:520px">
        <div class="login-logo">
            <div class="login-logo-icon">
                <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <h1>Bildirim Durumu</h1>
            <p>Etik bildiriminizin mevcut durumu</p>
        </div>

        @if (_notFound)
        {
            <div class="alert alert-error">Bu koda ait bildirim bulunamadı.</div>
        }
        else if (_report != null)
        {
            <div class="es-card">
                <div class="es-card-top">
                    <div>
                        <div class="es-ref-label">Referans Kodu</div>
                        <div class="es-ref-code">@_report.Code</div>
                    </div>
                    <span class="badge es-status-badge" style="background:@_statusBg;color:@_statusColor;border-color:@_statusColor20">
                        @_statusLabel
                    </span>
                </div>
                <div class="es-meta">
                    <strong>Konu:</strong> @_report.Subject
                </div>
                @if (_report.ReportCategory != null)
                {
                    <div class="es-meta">
                        <strong>Kategori:</strong> @_report.ReportCategory
                    </div>
                }
                <div class="es-date">
                    Bildirim tarihi: @_report.SubmittedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_report.AuditNotes) || !string.IsNullOrEmpty(_report.EthicsNotes))
            {
                <div class="es-notes-card">
                    <div class="es-notes-label">İnceleme Notları</div>
                    @if (!string.IsNullOrEmpty(_report.AuditNotes))
                    {
                        <div class="es-note-row"><strong>Denetim:</strong> @_report.AuditNotes</div>
                    }
                    @if (!string.IsNullOrEmpty(_report.EthicsNotes))
                    {
                        <div class="es-note-row"><strong>Kurul:</strong> @_report.EthicsNotes</div>
                    }
                </div>
            }

            <div class="alert alert-success" style="margin-bottom:0">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                Kimliğiniz gizli tutulmaktadır. Kişisel bilgiler hiçbir aşamada kayıt altına alınmamıştır.
            </div>
        }

        <div style="text-align:center;margin-top:20px">
            <a href="/login" class="es-back-link">← Giriş sayfasına dön</a>
        </div>
    </div>
</div>

<style>
    .es-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r-xl);
        padding: 20px;
        margin-bottom: 12px;
    }
    .es-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
        gap: 12px;
    }
    .es-ref-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--text-3);
        margin-bottom: 4px;
    }
    .es-ref-code {
        font-size: 18px;
        font-weight: 700;
        font-family: var(--font-mono);
        color: var(--text);
    }
    .es-status-badge { font-size: 12px; white-space: nowrap; }
    .es-meta  { font-size: 13px; color: var(--text-2); margin-bottom: 4px; }
    .es-date  { font-size: 12px; color: var(--text-3); margin-top: 8px; }

    .es-notes-card {
        border: 1px solid #e0e7ff;
        border-radius: var(--r-lg);
        padding: 14px;
        background: #f8faff;
        margin-bottom: 12px;
    }
    .es-notes-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        color: #6366f1;
        margin-bottom: 10px;
    }
    .es-note-row { font-size: 13px; color: var(--text); margin-bottom: 6px; }
    .es-note-row:last-child { margin-bottom: 0; }

    .es-back-link { color: var(--text-3); font-size: 13px; text-decoration: none; }
    .es-back-link:hover { color: var(--text-2); }
</style>

@code {
    [Parameter] public string Code { get; set; } = "";

    private EthicsReport? _report;
    private bool _notFound;

    private string _statusLabel = "", _statusColor = "", _statusBg = "", _statusColor20 = "";

    protected override void OnInitialized()
    {
        _report = Db.EthicsReports.FirstOrDefault(r => r.Code == Code);
        if (_report == null) { _notFound = true; return; }

        (_statusLabel, _statusColor, _statusBg) = _report.Status switch
        {
            "pending"                => ("Beklemede",               "#92400e", "#fffbeb"),
            "ethics_board_notified"  => ("Kurul İncelemesinde",     "#1d4ed8", "#eff6ff"),
            "disciplinary_referred"  => ("Disiplin Sürecine Alındı","#7c3aed", "#faf5ff"),
            "no_violation"           => ("İhlal Tespit Edilmedi",   "#15803d", "#f0fdf4"),
            "irrelevant"             => ("Kapsam Dışı",             "#64748b", "#f1f5f9"),
            _                        => ("İşlemde",                 "#374151", "#f8fafc"),
        };
        _statusColor20 = _statusColor + "33";
    }
}

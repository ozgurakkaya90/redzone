@page "/ethics/reports"
@attribute [Authorize(Roles = "audit_manager,ethics_board,admin")]
@inject EthicsService EthicsSvc

<PageTitle>Etik Bildirimler</PageTitle>

<ImportModal Visible="_showImport" Title="Etik Bildirimler" Module="ethics" OnClose="@(() => _showImport = false)" />

<div class="page-header" style="display:flex;justify-content:space-between;align-items:center">
    <h1>Etik Bildirimler</h1>
    <div style="display:flex;gap:8px;align-items:center">
        <div class="export-dropdown">
            <button class="btn btn-outline btn-sm"><Icon Name="download" Size="14" /> Dışa Aktar</button>
            <div class="export-menu">
                <a href="/export/ethics/excel" class="export-item">Excel (.xlsx)</a>
                <a href="/export/ethics/pdf" class="export-item">PDF</a>
            </div>
        </div>
        <button class="btn btn-outline btn-sm" @onclick="@(() => _showImport = true)"><Icon Name="upload" Size="14" /> İçe Aktar</button>
        <a href="/ethics/reports/new" class="btn btn-primary">+ Yeni Bildirim</a>
    </div>
</div>


<div class="card" style="padding:0">
    <table class="table">
        <thead>
            <tr><th>Kod</th><th>Konu</th><th>Kategori</th><th>Durum</th><th>Tarih</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var r in PagedReports)
            {
                <tr>
                    <td><code>@r.Code</code></td>
                    <td>@r.Subject</td>
                    <td><span class="tag">@(r.ReportCategory ?? "—")</span></td>
                    <td><span class="badge @StatusBadge(r.Status)">@StatusLabel(r.Status)</span></td>
                    <td>@r.SubmittedAt.ToString("dd.MM.yyyy")</td>
                    <td><a href="/ethics/reports/@r.Id" class="btn btn-outline btn-sm">Detay</a></td>
                </tr>
            }
            @if (!_reports.Any())
            {
                <EmptyState Colspan="6" Icon="" Title="Etik bildirim bulunamadı" Subtitle="Henüz bildirim girilmemiş veya filtreyle eşleşen kayıt yok." />
            }
        </tbody>
    </table>
</div>

@if (TotalEthicsPages > 1)
{
    <div class="pagination-bar">
        <div class="pagination-info">
            @((_ePage-1)*_ePageSize+1)–@(Math.Min(_ePage*_ePageSize, _reports.Count)) / @_reports.Count kayıt
        </div>
        <div class="pagination-controls">
            <button class="btn btn-outline btn-sm" @onclick="() => _ePage=1"              disabled="@(_ePage==1)">«</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _ePage--"              disabled="@(_ePage==1)">‹</button>
            @for (int p = Math.Max(1,_ePage-2); p <= Math.Min(TotalEthicsPages,_ePage+2); p++)
            { var pp = p; <button class="btn @(_ePage==pp?"btn-primary":"btn-outline") btn-sm" @onclick="() => _ePage=pp">@pp</button> }
            <button class="btn btn-outline btn-sm" @onclick="() => _ePage++"              disabled="@(_ePage==TotalEthicsPages)">›</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _ePage=TotalEthicsPages" disabled="@(_ePage==TotalEthicsPages)">»</button>
        </div>
        <div class="pagination-size">
            Sayfa başı:
            <select class="form-control" @bind="_ePageSize" @bind:after="() => _ePage=1">
                <option value="25">25</option><option value="50">50</option><option value="100">100</option>
            </select>
        </div>
    </div>
}

@code {
    private List<RiskManagement.Models.EthicsReport> _reports = [];
    private bool _showImport;
    private int _ePage = 1, _ePageSize = 25;

    private IEnumerable<RiskManagement.Models.EthicsReport> PagedReports
        => _reports.Skip((_ePage-1)*_ePageSize).Take(_ePageSize);
    private int TotalEthicsPages
        => (int)Math.Ceiling(_reports.Count / (double)_ePageSize);

    protected override void OnInitialized() => _reports = EthicsSvc.GetAll();

    private static string StatusLabel(string s) => s switch
    {
        "pending" => "Bekliyor", "irrelevant" => "İlgisiz",
        "ethics_board_notified" => "Kurul Bildirimi", "disciplinary_referred" => "Disiplin",
        "no_violation" => "İhlal Yok", _ => s
    };
    private static string StatusBadge(string s) => s switch
    {
        "pending" => "badge-yellow", "irrelevant" => "badge-gray",
        "ethics_board_notified" => "badge-orange",
        "disciplinary_referred" => "badge-red", "no_violation" => "badge-green", _ => ""
    };
}

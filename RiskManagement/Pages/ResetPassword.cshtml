@page "/reset-password"
@model RiskManagement.Pages.ResetPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yeni Şifre — RED</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
    <style>
        .strength-bar  { height: 4px; border-radius: 2px; background: #e5e7eb; margin-top: 6px; overflow: hidden; }
        .strength-fill { height: 100%; border-radius: 2px; transition: width .25s, background .25s; }
    </style>
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon">🔒</div>
            <h1>Yeni Şifre Belirle</h1>
            <p>Şifrenizi sıfırlayın</p>
        </div>

        @if (Model.Success)
        {
            <div style="text-align:center;padding:8px 0">
                <div style="font-size:48px;margin-bottom:16px">✅</div>
                <div style="font-weight:700;color:var(--text-1);margin-bottom:8px">Şifreniz güncellendi</div>
                <div style="font-size:13px;color:var(--text-2)">Yeni şifrenizle giriş yapabilirsiniz.</div>
            </div>
            <div style="margin-top:24px">
                <a href="/login" class="btn btn-primary" style="width:100%;text-align:center;display:block">
                    Giriş Sayfasına Git →
                </a>
            </div>
        }
        else if (Model.TokenInvalid)
        {
            <div style="text-align:center;padding:8px 0">
                <div style="font-size:48px;margin-bottom:16px">⚠️</div>
                <div style="font-weight:700;color:#991b1b;margin-bottom:8px">Geçersiz veya süresi dolmuş bağlantı</div>
                <div style="font-size:13px;color:var(--text-2)">
                    Lütfen yöneticinizden yeni bir sıfırlama bağlantısı talep edin.
                </div>
            </div>
            <div style="margin-top:24px">
                <a href="/forgot-password" class="btn btn-outline" style="width:100%;text-align:center;display:block">
                    Yeni Talep Oluştur
                </a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-error" style="margin-bottom:16px">@Model.Error</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model.Token" />
                <div class="form-group">
                    <label class="form-label">Yeni Şifre</label>
                    <input type="password" class="form-control" name="password"
                           placeholder="En az 8 karakter" autocomplete="new-password"
                           oninput="checkStrength(this.value)" autofocus />
                    <div class="strength-bar"><div class="strength-fill" id="strengthFill"></div></div>
                    <div id="strengthLabel" style="font-size:11px;margin-top:3px;min-height:16px"></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Şifre Tekrar</label>
                    <input type="password" class="form-control" name="confirm"
                           placeholder="Şifreyi tekrar girin" autocomplete="new-password" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%">
                    Şifremi Güncelle
                </button>
            </form>
        }
    </div>
</div>
<script>
function checkStrength(val) {
    var fill = document.getElementById('strengthFill');
    var label = document.getElementById('strengthLabel');
    if (!val) { fill.style.width = '0'; label.textContent = ''; return; }
    var score = 0;
    if (val.length >= 8)          score++;
    if (/[A-Z]/.test(val))        score++;
    if (/[0-9]/.test(val))        score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;
    var levels = [
        { w: '20%',  bg: '#ef4444', text: 'Çok zayıf' },
        { w: '40%',  bg: '#f97316', text: 'Zayıf'     },
        { w: '65%',  bg: '#eab308', text: 'Orta'       },
        { w: '100%', bg: '#22c55e', text: 'Güçlü'      },
    ];
    var l = levels[Math.min(score, 3)];
    fill.style.width = l.w; fill.style.background = l.bg;
    label.textContent = l.text; label.style.color = l.bg;
}
</script>
</body>
</html>

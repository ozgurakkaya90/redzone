@page "/risk/matrix"
@attribute [Authorize(Policy = "risk.read")]
@inject RiskService RiskSvc
@inject AuthService Auth
@inject ConfigService CfgSvc
@inject IRiskCalculator RiskCalc
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims

<PageTitle>Risk Kontrol Matrisi</PageTitle>

<div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
    <h1>Risk Kontrol Matrisi</h1>
    <div style="font-size:13px;color:var(--text-3)">@Filtered.Count() risk gösteriliyor</div>
</div>

<!-- Filtre Paneli -->
<div class="card" style="margin-bottom:16px;padding:16px">
    <div class="rcm-filter-grid">
        <div class="filter-group">
            <label class="filter-label">Arama</label>
            <input class="form-control" style="width:220px" placeholder="Kod, başlık, birim..." @bind="_search" @bind:event="oninput" />
        </div>
        <div class="filter-group">
            <label class="filter-label">Kategori</label>
            <select class="form-control" style="width:180px" @bind="_filterCat">
                <option value="">Tüm Kategoriler</option>
                @foreach (var c in _categories) { <option value="@c">@c</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">İlk Risk Seviyesi</label>
            <select class="form-control" style="width:180px" @bind="_filterInitLevel">
                <option value="">Tüm Seviyeler</option>
                @foreach (var l in _levels) { <option value="@l">@l</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Kalan Risk Seviyesi</label>
            <select class="form-control" style="width:180px" @bind="_filterResLevel">
                <option value="">Tüm Seviyeler</option>
                @foreach (var l in _levels) { <option value="@l">@l</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Kontrol Durumu</label>
            <select class="form-control" style="width:160px" @bind="_filterCtrl">
                <option value="">Tümü</option>
                <option value="has">Kontrol Var</option>
                <option value="none">Kontrol Yok</option>
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Kontrol Türü</label>
            <select class="form-control" style="width:160px" @bind="_filterCtrlType">
                <option value="">Tüm Türler</option>
                @foreach (var t in _controlTypes) { <option value="@t">@t</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Strateji</label>
            <select class="form-control" style="width:160px" @bind="_filterStrategy">
                <option value="">Tüm Stratejiler</option>
                @foreach (var s in _strategies) { <option value="@s">@s</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Aksiyon</label>
            <select class="form-control" style="width:160px" @bind="_filterAction">
                <option value="">Tümü</option>
                <option value="has">Aksiyon Var</option>
                <option value="open">Açık Aksiyon</option>
                <option value="done">Tamamlandı</option>
                <option value="none">Aksiyon Yok</option>
            </select>
        </div>
        <div class="filter-group" style="justify-content:flex-end">
            <label class="filter-label" style="opacity:0;user-select:none">—</label>
            <button class="btn btn-outline btn-sm" @onclick="ResetFilters">Filtreleri Temizle</button>
        </div>
    </div>
</div>

<!-- Özet Kartları -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px;margin-bottom:16px">
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Toplam Risk</div>
        <div style="font-size:26px;font-weight:700">@Filtered.Count()</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Kontrol Girilen</div>
        <div style="font-size:26px;font-weight:700;color:#2563eb">@Filtered.Count(r => r.Controls.Any())</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Kontrol Yok</div>
        <div style="font-size:26px;font-weight:700;color:#dc2626">@Filtered.Count(r => !r.Controls.Any())</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Kalan Risk Değerlendirilen</div>
        <div style="font-size:26px;font-weight:700;color:#16a34a">@Filtered.Count(r => r.Evaluations.Any(e => e.EvalType == "residual"))</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Toplam Kontrol</div>
        <div style="font-size:26px;font-weight:700;color:#7c3aed">@Filtered.Sum(r => r.Controls.Count)</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Açık Aksiyon</div>
        <div style="font-size:26px;font-weight:700;color:#d97706">@Filtered.Sum(r => r.ActionPlans.Count(a => a.Status is "planned" or "in_progress"))</div>
    </div>
    <div class="card" style="padding:12px;text-align:center">
        <div class="stat-label">Risk Azalma Ort.</div>
        <div style="font-size:26px;font-weight:700;color:#0891b2">
            @{
                var pairs = Filtered
                    .Select(r => new {
                        Init = r.Evaluations.FirstOrDefault(e => e.EvalType == "initial")?.Score,
                        Res  = r.Evaluations.FirstOrDefault(e => e.EvalType == "residual")?.Score
                    })
                    .Where(x => x.Init.HasValue && x.Res.HasValue)
                    .ToList();
                var avgDrop = pairs.Any() ? pairs.Average(x => x.Init!.Value - x.Res!.Value) : 0;
            }
            @avgDrop.ToString("0.#")
        </div>
    </div>
</div>

<!-- Tablo -->
<div class="card" style="padding:0;overflow-x:auto">
    <table class="table" style="font-size:13px;min-width:1100px">
        <thead>
            <tr style="background:var(--gray-50)">
                <th style="width:90px;cursor:pointer" @onclick='() => SetSort("code")'>
                    Kod @SortIcon("code")
                </th>
                <th style="cursor:pointer" @onclick='() => SetSort("title")'>
                    Risk @SortIcon("title")
                </th>
                <th style="cursor:pointer" @onclick='() => SetSort("category")'>
                    Kategori @SortIcon("category")
                </th>
                <th style="cursor:pointer" @onclick='() => SetSort("strategy")'>
                    Strateji @SortIcon("strategy")
                </th>
                <th style="cursor:pointer;text-align:center" @onclick='() => SetSort("initscore")'>
                    İlk Skor @SortIcon("initscore")
                </th>
                <th style="cursor:pointer;text-align:center" @onclick='() => SetSort("ctrlcount")'>
                    Kontrol @SortIcon("ctrlcount")
                </th>
                <th>Kontrol Detayları</th>
                <th style="cursor:pointer;text-align:center" @onclick='() => SetSort("resscore")'>
                    Kalan Skor @SortIcon("resscore")
                </th>
                <th style="cursor:pointer;text-align:center" @onclick='() => SetSort("reduction")'>
                    Azalma @SortIcon("reduction")
                </th>
                <th style="cursor:pointer;text-align:center" @onclick='() => SetSort("actions")'>
                    Aksiyonlar @SortIcon("actions")
                </th>
                <th style="text-align:center">Detay</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Sorted)
            {
                var initial  = r.Evaluations.FirstOrDefault(e => e.EvalType == "initial");
                var residual = r.Evaluations.FirstOrDefault(e => e.EvalType == "residual");
                var reduction = (initial?.Score ?? 0) - (residual?.Score ?? 0);
                var openAct  = r.ActionPlans.Count(a => a.Status is "planned" or "in_progress");
                var doneAct  = r.ActionPlans.Count(a => a.Status == "completed");
                var cancelAct = r.ActionPlans.Count(a => a.Status == "cancelled");

                var preventive = r.Controls.Count(c => c.ControlType == "Önleyici");
                var detective  = r.Controls.Count(c => c.ControlType == "Tespit Edici");
                var corrective = r.Controls.Count(c => c.ControlType == "Düzeltici");

                <tr style="vertical-align:top">
                    <!-- Kod -->
                    <td>
                        <code class="rcm-code">@r.Code</code>
                    </td>

                    <!-- Risk başlık + birim + tarih -->
                    <td style="max-width:200px">
                        <a href="/risk/@r.Id" style="color:var(--text);font-weight:600;text-decoration:none;line-height:1.3">@r.Title</a>
                        @if (r.Organization != null)
                        {
                            <div class="rcm-score-detail" style="margin-top:2px">@r.Organization.Name</div>
                        }
                        @if (!string.IsNullOrEmpty(r.ProposerName))
                        {
                            <div class="rcm-score-detail">@r.ProposerName</div>
                        }
                        <div style="font-size:10px;color:var(--gray-300);margin-top:2px">@r.ProposedAt.ToString("dd.MM.yyyy")</div>
                    </td>

                    <!-- Kategori -->
                    <td><span class="tag">@(r.Category ?? "—")</span></td>

                    <!-- Strateji -->
                    <td>
                        @if (!string.IsNullOrEmpty(r.RiskStrategy))
                        {
                            <span class="badge badge-blue" style="background:#ede9fe;color:#6d28d9;border-color:#ddd6fe">@r.RiskStrategy</span>
                        }
                        else { <span class="rcm-score-detail">—</span> }
                    </td>

                    <!-- İlk Skor -->
                    <td style="text-align:center">
                        @if (initial != null)
                        {
                            <div class="rcm-score" style="color:@RiskCalc.GetRiskLevelColor(initial.RiskLevel)">@initial.Score.ToString("0.##")</div>
                            <div class="rcm-level-badge" style="color:@RiskCalc.GetRiskLevelColor(initial.RiskLevel);background:@RiskCalc.GetRiskLevelColor(initial.RiskLevel)15">@initial.RiskLevel</div>
                            <div class="rcm-score-detail">O:@initial.Probability / M:@initial.Exposure / S:@initial.Consequence</div>
                        }
                        else { <span class="rcm-score-detail">—</span> }
                    </td>

                    <!-- Kontrol sayısı -->
                    <td style="text-align:center">
                        @if (r.Controls.Any())
                        {
                            <div class="rcm-ctrl-count">@r.Controls.Count</div>
                            <div class="rcm-ctrl-sub">kontrol</div>
                        }
                        else
                        {
                            <span class="badge badge-red">Yok</span>
                        }
                    </td>

                    <!-- Kontrol Detayları -->
                    <td style="max-width:240px">
                        @if (r.Controls.Any())
                        {
                            <div style="display:flex;gap:4px;flex-wrap:wrap;margin-bottom:5px">
                                @if (preventive > 0) { <span class="badge badge-blue">Önleyici ×@preventive</span> }
                                @if (detective > 0)  { <span class="badge badge-yellow">Tespit ×@detective</span> }
                                @if (corrective > 0) { <span class="badge badge-green">Düzeltici ×@corrective</span> }
                            </div>
                            @foreach (var ctrl in r.Controls.Take(3))
                            {
                                <div class="rcm-ctrl-desc">
                                    @(ctrl.Description.Length > 70 ? ctrl.Description[..70] + "…" : ctrl.Description)
                                    @if (!string.IsNullOrEmpty(ctrl.Effectiveness))
                                    {
                                        <span class="rcm-score-detail"> · @ctrl.Effectiveness</span>
                                    }
                                </div>
                            }
                            @if (r.Controls.Count > 3)
                            {
                                <div class="rcm-ctrl-more">+@(r.Controls.Count - 3) kontrol daha</div>
                            }
                        }
                        else
                        {
                            <span class="rcm-score-detail">Henüz kontrol girilmemiş</span>
                        }
                    </td>

                    <!-- Kalan Skor -->
                    <td style="text-align:center">
                        @if (residual != null)
                        {
                            <div class="rcm-score" style="color:@RiskCalc.GetRiskLevelColor(residual.RiskLevel)">@residual.Score.ToString("0.##")</div>
                            <div class="rcm-level-badge" style="color:@RiskCalc.GetRiskLevelColor(residual.RiskLevel);background:@RiskCalc.GetRiskLevelColor(residual.RiskLevel)15">@residual.RiskLevel</div>
                            <div class="rcm-score-detail">O:@residual.Probability / M:@residual.Exposure / S:@residual.Consequence</div>
                        }
                        else { <span class="rcm-score-detail">—</span> }
                    </td>

                    <!-- Azalma -->
                    <td style="text-align:center">
                        @if (initial != null && residual != null)
                        {
                            var pct = initial.Score > 0 ? (reduction / initial.Score * 100) : 0;
                            var col = reduction > 0 ? "#16a34a" : reduction < 0 ? "#dc2626" : "var(--text-3)";
                            <div style="font-weight:700;font-size:15px;color:@col">
                                @(reduction > 0 ? "▼" : reduction < 0 ? "▲" : "=") @Math.Abs(reduction).ToString("0.##")
                            </div>
                            <div style="font-size:10px;color:@col">%@pct.ToString("0")</div>
                            <div class="rcm-reduction-bar-wrap">
                                <div class="rcm-reduction-bar" style="width:@(Math.Min(100,Math.Abs(pct)))%;background:@col"></div>
                            </div>
                        }
                        else { <span class="rcm-score-detail">—</span> }
                    </td>

                    <!-- Aksiyonlar -->
                    <td style="text-align:center">
                        @if (r.ActionPlans.Any())
                        {
                            <div style="display:flex;flex-direction:column;gap:3px;align-items:center">
                                @if (doneAct > 0)   { <span class="badge badge-green">@doneAct tamamlandı</span> }
                                @if (openAct > 0)   { <span class="badge badge-yellow">@openAct açık</span> }
                                @if (cancelAct > 0) { <span class="badge badge-gray">@cancelAct iptal</span> }
                                @{
                                    var nearest = r.ActionPlans
                                        .Where(a => a.Status is "planned" or "in_progress" && a.DueDate.HasValue)
                                        .OrderBy(a => a.DueDate)
                                        .FirstOrDefault();
                                }
                                @if (nearest != null)
                                {
                                    var overdue = nearest.DueDate!.Value < DateOnly.FromDateTime(DateTime.Today);
                                    <div class="rcm-score-detail" style="color:@(overdue ? "#dc2626" : "var(--text-3)")">
                                        @(overdue ? "Geçmiş: " : "")@nearest.DueDate!.Value.ToString("dd.MM.yyyy")
                                    </div>
                                }
                            </div>
                        }
                        else { <span class="rcm-score-detail">—</span> }
                    </td>

                    <!-- Detay linki -->
                    <td style="text-align:center">
                        <a href="/risk/@r.Id" class="btn btn-outline btn-sm" style="font-size:11px;padding:3px 10px">Aç →</a>
                    </td>
                </tr>
            }
            @if (!Sorted.Any())
            {
                <tr><td colspan="11" class="empty-state">Filtreye uygun kayıt bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Sayfalama bilgisi -->
<div class="rcm-footer-info">
    @Filtered.Count() risk · @Filtered.Sum(r => r.Controls.Count) toplam kontrol
</div>


@code {
    private List<RiskManagement.Models.Risk> _risks = [];
    private string[] _categories = [];
    private string[] _controlTypes = [];
    private string[] _strategies = [];

    private string _search = "";
    private string _filterCat = "";
    private string _filterInitLevel = "";
    private string _filterResLevel = "";
    private string _filterCtrl = "";
    private string _filterCtrlType = "";
    private string _filterStrategy = "";
    private string _filterAction = "";

    private string _sortCol = "initscore";
    private bool _sortDesc = true;

    private User? _user;

    private static readonly string[] _levels =
        ["Çok Yüksek Risk", "Yüksek Risk", "Önemli Risk", "Orta Risk", "Kabul Edilebilir"];

    protected override void OnInitialized()
    {
        _user  = Auth.ActiveUserFromPrincipal(HttpCtx.HttpContext?.User);
        _risks = (_user is not null ? RiskSvc.GetForUser(_user) : [])
            .Where(r => r.Status != "proposed" && r.Status != "rejected")
            .ToList();

        _categories   = CfgSvc.GetList("risk_categories");
        _controlTypes = _risks.SelectMany(r => r.Controls.Select(c => c.ControlType))
                              .Where(t => !string.IsNullOrEmpty(t)).Distinct().Order().ToArray();
        _strategies   = _risks.Select(r => r.RiskStrategy).Where(s => !string.IsNullOrEmpty(s))
                              .Distinct().Order().ToArray()!;
    }

    private IEnumerable<RiskManagement.Models.Risk> Filtered => _risks
        .Where(r => string.IsNullOrEmpty(_search) ||
                    r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    r.Code.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (r.Organization?.Name ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase))
        .Where(r => string.IsNullOrEmpty(_filterCat) || r.Category == _filterCat)
        .Where(r => string.IsNullOrEmpty(_filterStrategy) || r.RiskStrategy == _filterStrategy)
        .Where(r => string.IsNullOrEmpty(_filterInitLevel) ||
                    r.Evaluations.Any(e => e.EvalType == "initial" && e.RiskLevel == _filterInitLevel))
        .Where(r => string.IsNullOrEmpty(_filterResLevel) ||
                    r.Evaluations.Any(e => e.EvalType == "residual" && e.RiskLevel == _filterResLevel))
        .Where(r => _filterCtrl switch {
            "has"  => r.Controls.Any(),
            "none" => !r.Controls.Any(),
            _      => true
        })
        .Where(r => string.IsNullOrEmpty(_filterCtrlType) ||
                    r.Controls.Any(c => c.ControlType == _filterCtrlType))
        .Where(r => _filterAction switch {
            "has"  => r.ActionPlans.Any(),
            "open" => r.ActionPlans.Any(a => a.Status is "planned" or "in_progress"),
            "done" => r.ActionPlans.Any(a => a.Status == "completed"),
            "none" => !r.ActionPlans.Any(),
            _      => true
        });

    private IEnumerable<RiskManagement.Models.Risk> Sorted => _sortCol switch {
        "code"      => Order(Filtered, r => r.Code),
        "title"     => Order(Filtered, r => r.Title),
        "category"  => Order(Filtered, r => r.Category ?? ""),
        "strategy"  => Order(Filtered, r => r.RiskStrategy ?? ""),
        "initscore" => Order(Filtered, r => r.Evaluations.FirstOrDefault(e => e.EvalType == "initial")?.Score ?? 0),
        "resscore"  => Order(Filtered, r => r.Evaluations.FirstOrDefault(e => e.EvalType == "residual")?.Score ?? 0),
        "ctrlcount" => Order(Filtered, r => r.Controls.Count),
        "actions"   => Order(Filtered, r => r.ActionPlans.Count),
        "reduction" => Order(Filtered, r => {
            var i = r.Evaluations.FirstOrDefault(e => e.EvalType == "initial")?.Score ?? 0;
            var res = r.Evaluations.FirstOrDefault(e => e.EvalType == "residual")?.Score ?? 0;
            return i - res;
        }),
        _ => Filtered
    };

    private IEnumerable<T> Order<T, TKey>(IEnumerable<T> src, Func<T, TKey> key) =>
        _sortDesc ? src.OrderByDescending(key) : src.OrderBy(key);

    private void SetSort(string col)
    {
        if (_sortCol == col) _sortDesc = !_sortDesc;
        else { _sortCol = col; _sortDesc = true; }
    }

    private string SortIcon(string col) =>
        _sortCol != col ? "⇅" : _sortDesc ? "↓" : "↑";

    private void ResetFilters()
    {
        _search = _filterCat = _filterInitLevel = _filterResLevel =
        _filterCtrl = _filterCtrlType = _filterStrategy = _filterAction = "";
    }
}

@page "/risk/actions"
@attribute [Authorize]
@inject AppDbContext Db
@inject ConfigService CfgSvc
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Aksiyon Planları</PageTitle>

<ImportModal Visible="_showImport" Title="Risk Aksiyon Planları" Module="action-plans" OnClose="@(() => _showImport = false)" />

<div class="page-header">
    <h1>Aksiyon Planları</h1>
    <div style="display:flex;gap:8px;align-items:center">
        <div class="export-dropdown">
            <button class="btn btn-outline btn-sm">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                Dışa Aktar
            </button>
            <div class="export-menu">
                <a href="/export/action-plans/excel" class="export-item">Excel (.xlsx)</a>
                <a href="/export/action-plans/pdf" class="export-item">PDF</a>
            </div>
        </div>
        <button class="btn btn-outline btn-sm" @onclick="@(() => _showImport = true)">
            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            İçe Aktar
        </button>
    </div>
</div>

@* Preset hızlı filtreler *@
<div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
    @{
        var overdueCount = _all.Count(a => a.DueDate.HasValue && a.DueDate.Value < _today && a.Status is "planned" or "in_progress");
        var weekCount    = _all.Count(a => a.DueDate.HasValue && a.DueDate.Value >= _today && a.DueDate.Value <= _today.AddDays(_weekDays) && a.Status is "planned" or "in_progress");
        var mineCount    = _all.Count(a => IsMine(a));
    }
    @foreach (var (label, preset, count) in new[]{
        ("Tümü",        "",         0),
        ("Geciken",     "overdue",  overdueCount),
        ("Bu Hafta",    "week",     weekCount),
        ("Bana Atanan", "mine",     mineCount),
    })
    {
        var p = preset;
        var isActive = _actionPreset == p;
        <button class="preset-chip @(isActive ? "preset-chip-active" : "") @(p == "overdue" && overdueCount > 0 ? "preset-overdue" : "")"
                @onclick="() => ApplyActionPreset(p)">
            @label
            @if (count > 0) { <span class="preset-chip-count">@count</span> }
        </button>
    }
</div>

<div class="card" style="margin-bottom:16px">
    <div class="filter-bar">
        <div class="filter-group">
            <label class="filter-label">Durum</label>
            <select class="form-control" style="width:160px" @bind="_filterStatus">
                <option value="">Tüm Durumlar</option>
                <option value="planned">Planlandı</option>
                <option value="in_progress">Devam Ediyor</option>
                <option value="completed">Tamamlandı</option>
                <option value="cancelled">İptal</option>
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Departman</label>
            <select class="form-control" style="width:200px" @bind="_filterDept">
                <option value="">Tüm Departmanlar</option>
                @foreach (var d in _departments) { <option value="@d.Id.ToString()">@d.Name</option> }
            </select>
        </div>
        <div class="filter-group">
            <label class="filter-label">Vade</label>
            <select class="form-control" style="width:160px" @bind="_filterOverdue">
                <option value="">Tümü</option>
                <option value="overdue">Vadesi Geçmiş</option>
                <option value="upcoming">Yaklaşan (@_warnDays gün)</option>
            </select>
        </div>
        <div class="filter-group" style="flex:1;min-width:180px">
            <label class="filter-label">Arama</label>
            <input class="form-control" placeholder="Risk veya aksiyon ara…"
                   @bind="_search" @bind:event="oninput" />
        </div>
    </div>
</div>

<div class="card" style="padding:0;overflow-x:auto">
    <table class="table table-sticky">
        <thead>
            <tr>
                <th>Risk</th>
                <th>Aksiyon Açıklaması</th>
                <th>Sorumlu Departman</th>
                <th>Hedef Tarih</th>
                <th>Durum</th>
                <th>Oluşturan</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in PagedActions)
            {
                var daysLeft = a.DueDate.HasValue ? (a.DueDate.Value.DayNumber - _today.DayNumber) : (int?)null;
                var overdue  = daysLeft.HasValue && daysLeft.Value < 0 && a.Status is "planned" or "in_progress";
                var rowCls   = daysLeft.HasValue && daysLeft.Value < -_critDays ? "overdue-row-crit" : overdue ? "overdue-row" : "";
                <tr class="@rowCls">
                    <td style="white-space:nowrap">
                        <a href="/risk/@a.RiskId" style="color:#1e40af;font-weight:600;font-size:12px;text-decoration:none">
                            @a.Risk.Code
                        </a>
                        <div style="font-size:11px;color:#6b7280;max-width:160px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                            @a.Risk.Title
                        </div>
                    </td>
                    <td style="max-width:260px">@a.Description</td>
                    <td>
                        @if (a.OwnerDept != null)
                        { <span class="badge badge-orange" style="font-size:10px">@a.OwnerDept.Name</span> }
                        else if (!string.IsNullOrEmpty(a.Responsible))
                        { <span style="font-size:12px;color:#374151">@a.Responsible</span> }
                        else { <span style="color:#9ca3af">—</span> }
                    </td>
                    <td style="white-space:nowrap">
                        @if (a.DueDate.HasValue)
                        {
                            <span class="@(overdue ? "overdue-date" : "")">
                                @a.DueDate.Value.ToString("dd.MM.yyyy")
                            </span>
                            @if (daysLeft.HasValue)
                            {
                                @if (daysLeft.Value < -_critDays)
                                { <span class="overdue-badge-crit">KRİTİK</span> }
                                else if (daysLeft.Value < 0)
                                { <span class="overdue-badge-late">GECİKTİ</span> }
                                else if (daysLeft.Value <= _warnDays && a.Status is "planned" or "in_progress")
                                { <span class="overdue-badge-warn">@daysLeft.Value GÜN</span> }
                            }
                        }
                        else { <span style="color:#9ca3af">—</span> }
                    </td>
                    <td><span class="badge @StatusBadge(a.Status)">@StatusLabel(a.Status)</span></td>
                    <td style="font-size:12px;color:#6b7280">@a.CreatedBy?.FullName</td>
                    <td>
                        <a href="/risk/@a.RiskId" class="btn btn-outline btn-sm">Risk Detayı</a>
                    </td>
                </tr>
            }
            @if (!Filtered.Any())
            {
                <EmptyState Colspan="7" Icon="" Title="Aksiyon planı bulunamadı"
                            Subtitle="Riskler ve bulgular için aksiyon planları risk/bulgu detay sayfalarından oluşturulur."
                            ActionHref="/risk"
                            ActionLabel="Risk Envanterine Git" />
            }
        </tbody>
    </table>
</div>

@if (TotalActionPages > 1)
{
    <div class="pagination-bar">
        <div class="pagination-info">
            @((_aPage-1)*_aPageSize+1)–@(Math.Min(_aPage*_aPageSize, Filtered.Count())) / @Filtered.Count() kayıt
        </div>
        <div class="pagination-controls">
            <button class="btn btn-outline btn-sm" @onclick="() => _aPage=1"               disabled="@(_aPage==1)">«</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _aPage--"               disabled="@(_aPage==1)">‹</button>
            @for (int p = Math.Max(1,_aPage-2); p <= Math.Min(TotalActionPages,_aPage+2); p++)
            { var pp = p; <button class="btn @(_aPage==pp?"btn-primary":"btn-outline") btn-sm" @onclick="() => _aPage=pp">@pp</button> }
            <button class="btn btn-outline btn-sm" @onclick="() => _aPage++"               disabled="@(_aPage==TotalActionPages)">›</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _aPage=TotalActionPages" disabled="@(_aPage==TotalActionPages)">»</button>
        </div>
        <div class="pagination-size">
            Sayfa başı:
            <select class="form-control" @bind="_aPageSize" @bind:after="() => _aPage=1">
                <option value="25">25</option><option value="50">50</option><option value="100">100</option>
            </select>
        </div>
    </div>
}

<div class="list-stat-grid">
    <div class="card list-stat-card">
        <div class="stat-label">Toplam</div>
        <div class="list-stat-val">@Filtered.Count()</div>
    </div>
    <div class="card list-stat-card">
        <div class="stat-label">Planlandı</div>
        <div class="list-stat-val" style="color:#2563eb">@Filtered.Count(a => a.Status == "planned")</div>
    </div>
    <div class="card list-stat-card">
        <div class="stat-label">Devam Ediyor</div>
        <div class="list-stat-val" style="color:#ca8a04">@Filtered.Count(a => a.Status == "in_progress")</div>
    </div>
    <div class="card list-stat-card">
        <div class="stat-label">Tamamlandı</div>
        <div class="list-stat-val" style="color:#16a34a">@Filtered.Count(a => a.Status == "completed")</div>
    </div>
    <div class="card list-stat-card">
        <div class="stat-label">Vadesi Geçmiş</div>
        <div class="list-stat-val" style="color:#dc2626">
            @Filtered.Count(a => a.DueDate.HasValue && a.DueDate.Value < _today && a.Status is "planned" or "in_progress")
        </div>
    </div>
</div>

@code {
    private string Role   => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

    private List<ActionPlan> _all = [];
    private List<Department> _departments = [];
    private string _filterStatus = "", _filterDept = "", _filterOverdue = "", _search = "";
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private int _weekDays, _warnDays, _critDays;
    private bool _showImport;
    private string _actionPreset = "";
    private int _aPage = 1, _aPageSize = 25;
    private string _myFullName => HttpCtx.HttpContext?.User.FindFirst("full_name")?.Value ?? "";
    // Arama döngüsünde tekrarlayan DB sorgusunu önlemek için OnInitialized'da bir kez çekilir.
    private int _myDeptId;

    private bool IsMine(ActionPlan a) =>
        (!string.IsNullOrEmpty(_myFullName) && a.Responsible?.Contains(_myFullName, StringComparison.OrdinalIgnoreCase) == true)
        || (a.OwnerDeptId.HasValue && a.OwnerDeptId == _myDeptId);

    private void ApplyActionPreset(string preset)
    {
        _actionPreset = preset;
        _filterStatus = ""; _filterDept = ""; _filterOverdue = ""; _search = "";
    }

    protected override void OnInitialized()
    {
        _weekDays = CfgSvc.GetWeekDays();
        _warnDays = CfgSvc.GetWarnDays();
        _critDays = CfgSvc.GetCritDays();
        _myDeptId = Db.Users.Where(u => u.Id == UserId).Select(u => u.DepartmentId ?? 0).FirstOrDefault();

        var managedOrgIds = Role is "admin" or "committee"
            ? null
            : Db.Departments.Where(d => d.ManagerUserId == UserId && d.OrganizationId != null)
                .Select(d => d.OrganizationId!.Value).Distinct().ToList();

        var q = Db.ActionPlans
            .Include(a => a.Risk)
            .Include(a => a.CreatedBy)
            .Include(a => a.OwnerDept)
            .AsQueryable();

        if (managedOrgIds != null)
            q = q.Where(a =>
                a.Risk.ProposedById == UserId ||
                a.Risk.OwnerId == UserId ||
                (a.Risk.OrganizationId != null && managedOrgIds.Contains(a.Risk.OrganizationId.Value)));

        _all = [.. q.OrderBy(a => a.DueDate == null).ThenBy(a => a.DueDate).ThenBy(a => a.Status)];
        _departments = [.. Db.Departments.OrderBy(d => d.Name)];
    }

    private IEnumerable<ActionPlan> PagedActions
        => Filtered.Skip((_aPage-1)*_aPageSize).Take(_aPageSize);
    private int TotalActionPages
        => (int)Math.Ceiling(Filtered.Count() / (double)_aPageSize);

    private IEnumerable<ActionPlan> Filtered => _all
        .Where(a => _actionPreset switch {
            "overdue" => a.DueDate.HasValue && a.DueDate.Value < _today && a.Status is "planned" or "in_progress",
            "week"    => a.DueDate.HasValue && a.DueDate.Value >= _today && a.DueDate.Value <= _today.AddDays(_weekDays) && a.Status is "planned" or "in_progress",
            "mine"    => IsMine(a),
            _         => true
        })
        .Where(a => string.IsNullOrEmpty(_filterStatus) || a.Status == _filterStatus)
        .Where(a => string.IsNullOrEmpty(_filterDept)   || a.OwnerDeptId?.ToString() == _filterDept)
        .Where(a => _filterOverdue switch {
            "overdue"   => a.DueDate.HasValue && a.DueDate.Value < _today && a.Status is "planned" or "in_progress",
            "upcoming"  => a.DueDate.HasValue && a.DueDate.Value >= _today && a.DueDate.Value <= _today.AddDays(_warnDays) && a.Status is "planned" or "in_progress",
            _           => true
        })
        .Where(a => string.IsNullOrEmpty(_search) ||
                    a.Description.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    a.Risk.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    a.Risk.Code.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static string StatusLabel(string s) => s switch
    {
        "planned"     => "Planlandı",
        "in_progress" => "Devam Ediyor",
        "completed"   => "Tamamlandı",
        "cancelled"   => "İptal",
        _ => s
    };
    private static string StatusBadge(string s) => s switch
    {
        "planned"     => "badge-blue",
        "in_progress" => "badge-yellow",
        "completed"   => "badge-green",
        "cancelled"   => "badge-gray",
        _ => ""
    };
}

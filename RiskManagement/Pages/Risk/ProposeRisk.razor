@page "/risk/new"
@attribute [Authorize]
@inject RiskService RiskSvc
@inject ConfigService CfgSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims

<PageTitle>Risk Öner</PageTitle>

<div class="page-header"><h1>Risk Öner</h1></div>
<div style="max-width:680px">
    <div class="card">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-error" style="margin-bottom:16px">@_error</div>
        }

        <div class="form-group">
            <label class="form-label">Risk Başlığı *</label>
            <input class="form-control" @bind="_title" maxlength="200" placeholder="Kısa, açıklayıcı başlık" />
        </div>
        <div class="form-group">
            <label class="form-label">Kategori *</label>
            <select class="form-control" @bind="_category">
                <option value="">— Seçiniz —</option>
                @foreach (var c in _categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="4" @bind="_description"
                      placeholder="Riskin detaylı açıklaması…"></textarea>
        </div>

        <div style="display:flex;gap:10px;margin-top:8px">
            <button class="btn btn-primary" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Kaydediliyor…" : "Gönder")
            </button>
            <a href="/risk" class="btn btn-outline">İptal</a>
        </div>
    </div>
</div>

@code {
    private string _title = "", _category = "", _description = "";
    private string[] _categories = [];
    private bool _loading;
    private string _error = "";

    protected override void OnInitialized()
    {
        _categories = CfgSvc.GetList("risk_categories");
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_title)) { _error = "Başlık zorunludur."; return; }
        if (string.IsNullOrWhiteSpace(_category)) { _error = "Kategori seçiniz."; return; }

        _loading = true;
        var userId = int.TryParse(
            HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : (int?)null;

        var risk = RiskSvc.Create(_title, _description, _category, null, null, userId, null);
        Nav.NavigateTo($"/risk/{risk.Id}");
    }
}

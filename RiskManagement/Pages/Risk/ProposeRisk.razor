@page "/risk/new"
@attribute [Authorize]
@inject RiskService RiskSvc
@inject ConfigService CfgSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject AppDbContext Db
@inject ToastService ToastSvc
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Risk Öner</PageTitle>

<div class="page-header"><h1>Risk Öner</h1></div>
<div style="max-width:680px">
    <div class="card">
        <div class="alert alert-info" style="margin-bottom:16px">
            Önerdiğiniz risk, Risk Komitesi tarafından incelenecek ve Fine-Kinney
            metodolojisiyle değerlendirilerek envantere alınacaktır.
            <div style="font-size:11px;margin-top:6px;color:#1e40af">Zorunlu alan: yalnızca başlık. Açıklama isteğe bağlıdır.</div>
        </div>

        <div class="form-group">
            <label class="form-label">Risk Başlığı <span style="color:#dc2626">*</span></label>
            <input class="form-control @(_errTitle ? "input-error" : "")"
                   @bind="_title" @bind:event="oninput" @onblur="() => _errTitle = string.IsNullOrWhiteSpace(_title)"
                   maxlength="200" placeholder="Kısa, açıklayıcı başlık" />
            @if (_errTitle)
            { <div class="field-error">Başlık zorunludur.</div> }
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="4" @bind="_description"
                      placeholder="Olası nedenleri, etkilerini ve ilgili süreçleri belirtin."></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Departman</label>
            <select class="form-control" @bind="_fDepartmentId">
                <option value="">— Seçiniz —</option>
                @foreach (var d in _departments)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>

        <div style="display:flex;gap:10px;margin-top:8px">
            <button class="btn btn-primary" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Kaydediliyor…" : "Gönder")
            </button>
            <a href="/risk" class="btn btn-outline">İptal</a>
        </div>
    </div>
</div>

@code {
    private string _title = "", _description = "";
    private bool _loading, _errTitle;
    private int? _fDepartmentId;
    private List<Department> _departments = [];

    private int UserId => int.TryParse(
        HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

    protected override void OnInitialized()
    {
        _departments = [.. Db.Departments.OrderBy(d => d.Name)];

        // Varsayılan departman: oturum açan kullanıcının departmanı
        if (_fDepartmentId == null && UserId > 0)
        {
            var userDept = Db.Users
                .Where(u => u.Id == UserId)
                .Select(u => u.DepartmentId)
                .FirstOrDefault();
            if (userDept.HasValue) _fDepartmentId = userDept.Value;
        }
    }

    private async Task Submit()
    {
        _errTitle = string.IsNullOrWhiteSpace(_title);
        if (_errTitle) return;

        _loading = true;
        var userId = UserId > 0 ? (int?)UserId : null;
        var risk = await RiskSvc.CreateAsync(_title.Trim(), _description.Trim(), null, null, null, userId, null);

        // Departman seçildiyse metadata güncelle
        if (_fDepartmentId.HasValue)
            await RiskSvc.UpdateMetadataAsync(risk.Id, null, _fDepartmentId, null, userId);

        ToastSvc.Success("Risk önerisi başarıyla gönderildi. İnceleme ekibi bilgilendirildi.");
        Nav.NavigateTo($"/risk/{risk.Id}");
    }
}

@page "/risk/new"
@attribute [Authorize]
@inject RiskService RiskSvc
@inject ConfigService CfgSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims

<PageTitle>Risk Öner</PageTitle>

<div class="page-header"><h1>Risk Öner</h1></div>
<div style="max-width:680px">
    <div class="card">
        <div class="alert alert-info" style="margin-bottom:16px">
            Önerdiğiniz risk, Risk Komitesi tarafından incelenecek ve Fine-Kinney
            metodolojisiyle değerlendirilerek envantere alınacaktır.
        </div>

        <div class="form-group">
            <label class="form-label">Risk Başlığı <span style="color:#dc2626">*</span></label>
            <input class="form-control @(_errTitle ? "input-error" : "")"
                   @bind="_title" @bind:event="oninput" @onblur="() => _errTitle = string.IsNullOrWhiteSpace(_title)"
                   maxlength="200" placeholder="Kısa, açıklayıcı başlık" />
            @if (_errTitle)
            { <div class="field-error">Başlık zorunludur.</div> }
        </div>

        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="4" @bind="_description"
                      placeholder="Olası nedenleri, etkilerini ve ilgili süreçleri belirtin."></textarea>
        </div>

        <div style="display:flex;gap:10px;margin-top:8px">
            <button class="btn btn-primary" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Kaydediliyor…" : "Gönder")
            </button>
            <a href="/risk" class="btn btn-outline">İptal</a>
        </div>
    </div>
</div>

@code {
    private string _title = "", _description = "";
    private bool _loading, _errTitle;

    private void Submit()
    {
        _errTitle = string.IsNullOrWhiteSpace(_title);
        if (_errTitle) return;

        _loading = true;
        var userId = int.TryParse(
            HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : (int?)null;
        var risk = RiskSvc.Create(_title.Trim(), _description.Trim(), null, null, null, userId, null);
        Nav.NavigateTo($"/risk/{risk.Id}");
    }
}

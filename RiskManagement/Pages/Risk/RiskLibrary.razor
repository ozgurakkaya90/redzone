@page "/risk/library"
@attribute [Authorize]
@inject RiskLibraryService LibSvc
@inject RiskService RiskSvc
@inject AiRiskDraftService AiSvc
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@using System.Security.Claims
@using RiskManagement.Models
@using RiskManagement.Services.Ai

<PageTitle>Risk Kütüphanesi</PageTitle>

@if (!string.IsNullOrEmpty(_successMsg))
{
    <div class="alert alert-success" style="margin-bottom:12px">@_successMsg</div>
}
@if (!string.IsNullOrEmpty(_errorMsg))
{
    <div class="alert alert-error" style="margin-bottom:12px">@_errorMsg</div>
}

<div class="page-header">
    <div>
        <h1>Risk Kütüphanesi</h1>
        <div class="page-toolbar-sub">@_filtered.Count kayıt · Beğendiğiniz riskleri envanterinize önerebilirsiniz</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
        <a href="/export/library/excel" class="btn btn-outline btn-sm">Dışa Aktar</a>
        @if (AiSvc.IsAvailable)
        {
            <button class="btn btn-primary btn-sm" @onclick="OpenAiModal">
                ✨ AI ile Risk Taslağı
            </button>
        }
        @if (IsAdmin)
        {
            <a href="/risk/library/admin" class="btn btn-outline btn-sm">Yönet</a>
        }
    </div>
</div>

@* ── Kategori hızlı filtreler ── *@
<div class="lib-cat-pills">
    <button class="btn @(_filterCat==""?"btn-primary":"btn-outline") btn-sm"
            @onclick='() => { _filterCat=""; _filterSub=""; ApplyFilter(); }'>
        Tümü (@_allItems.Count)
    </button>
    @foreach (var (cat, cnt) in _catCounts.OrderByDescending(x => x.Value))
    {
        var c = cat;
        <button class="btn @(_filterCat==c?"btn-primary":"btn-outline") btn-sm"
                @onclick='() => { _filterCat=c; _filterSub=""; ApplyFilter(); }'>
            @c (@cnt)
        </button>
    }
</div>

@* ── Filtre ve arama ── *@
<div class="card" style="padding:14px 16px;margin-bottom:16px">
    <div class="filter-bar">
        <div class="filter-group" style="flex:2;min-width:200px">
            <label class="filter-label">Arama</label>
            <input class="form-control" placeholder="Başlık, tehlike, etiket…"
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>
        <div class="filter-group" style="min-width:180px">
            <label class="filter-label">Alt Kategori</label>
            <select class="form-control" @bind="_filterSub" @bind:after="ApplyFilter">
                <option value="">Tümü</option>
                @foreach (var s in _subCats)
                { <option value="@s">@s</option> }
            </select>
        </div>
        <div class="filter-group" style="min-width:140px">
            <label class="filter-label">Kaynak</label>
            <select class="form-control" @bind="_filterSource" @bind:after="ApplyFilter">
                <option value="">Tümü</option>
                <option value="internal">İç</option>
                <option value="external">Dış</option>
            </select>
        </div>
        <div class="filter-group" style="min-width:140px">
            <label class="filter-label">Görünüm</label>
            <select class="form-control" @bind="_view">
                <option value="card">Kart</option>
                <option value="table">Tablo</option>
            </select>
        </div>
        @if (HasFilter)
        {
            <div class="filter-group">
                <label class="filter-label" style="opacity:0;user-select:none">—</label>
                <button class="btn btn-outline btn-sm" @onclick="ClearFilter">Temizle</button>
            </div>
        }
    </div>
</div>

@if (!_filtered.Any())
{
    <div class="card" style="padding:40px">
        <div class="empty-state">
            <div class="empty-state-title">Sonuç bulunamadı</div>
            <div class="empty-state-sub">Farklı arama kriterleri deneyin.</div>
        </div>
    </div>
}
else if (_view == "card")
{
    @* ── KART GÖRÜNÜMÜ ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px">
        @foreach (var item in PagedItems)
        {
            <div class="card lib-card">
                <div class="lib-card-top">
                    <div style="flex:1;min-width:0">
                        <div class="lib-card-title">@item.Title</div>
                        @if (!string.IsNullOrEmpty(item.Category))
                        {
                            <div class="lib-card-tags">
                                <span class="tag">@item.Category</span>
                                @if (!string.IsNullOrEmpty(item.SubCategory))
                                { <span class="tag">@item.SubCategory</span> }
                            </div>
                        }
                    </div>
                    <span class="badge @(item.SourceType=="external"?"badge-blue":"badge-gray") lib-source-badge">
                        @(item.SourceType == "external" ? "Dış" : "İç")
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(item.Hazard))
                {
                    <div class="lib-card-meta">
                        <span class="lib-card-meta-label lib-card-meta-label--hazard">Tehlike:</span> @item.Hazard
                    </div>
                }
                @if (!string.IsNullOrEmpty(item.PossibleImpact))
                {
                    <div class="lib-card-meta">
                        <span class="lib-card-meta-label lib-card-meta-label--impact">Etki:</span> @item.PossibleImpact
                    </div>
                }

                <div class="lib-card-footer">
                    @if (item.UsageCount > 0)
                    {
                        <span class="lib-usage-count">@item.UsageCount kez kullanıldı</span>
                    }
                    else { <span></span> }
                    @if (_proposedIds.Contains(item.Id))
                    {
                        <span class="lib-proposed-label">Daha önce önerildi</span>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => Propose(item.Id)"
                                disabled="@_proposing">
                            + Envanterime Öner
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    @* ── TABLO GÖRÜNÜMÜ ── *@
    <div class="card" style="padding:0;overflow-x:auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th style="width:140px">Kategori</th>
                    <th style="width:130px">Alt Kategori</th>
                    <th style="width:80px">Kaynak</th>
                    <th>Tehlike</th>
                    <th>Olası Etki</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in PagedItems)
                {
                    <tr>
                        <td style="font-weight:600;max-width:240px">@item.Title</td>
                        <td>@if (!string.IsNullOrEmpty(item.Category)) { <span class="tag" style="font-size:11px">@item.Category</span> }</td>
                        <td style="font-size:12px;color:var(--text-3)">@(item.SubCategory ?? "—")</td>
                        <td><span class="badge @(item.SourceType=="external"?"badge-blue":"badge-gray")" style="font-size:11px">@(item.SourceType=="external"?"Dış":"İç")</span></td>
                        <td style="font-size:12px;color:var(--text-3);max-width:180px">@(item.Hazard ?? "—")</td>
                        <td style="font-size:12px;color:var(--text-3);max-width:180px">@(item.PossibleImpact ?? "—")</td>
                        <td>
                            @if (_proposedIds.Contains(item.Id))
                            {
                                <span style="font-size:12px;font-weight:600;color:#16a34a;white-space:nowrap">Daha önce önerildi</span>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => Propose(item.Id)"
                                        disabled="@_proposing" style="white-space:nowrap">
                                    + Öner
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── Sayfalama ── *@
@if (TotalPages > 1)
{
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px">
        <div style="font-size:12px;color:var(--text-3)">
            @((_page-1)*_pageSize+1)–@(Math.Min(_page*_pageSize, _filtered.Count)) / @_filtered.Count kayıt
        </div>
        <div style="display:flex;gap:4px">
            <button class="btn btn-outline btn-sm" @onclick="() => _page=1"         disabled="@(_page==1)">«</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _page--"          disabled="@(_page==1)">‹</button>
            @for (int p = Math.Max(1,_page-2); p <= Math.Min(TotalPages,_page+2); p++)
            {
                var pp = p;
                <button class="btn @(_page==pp?"btn-primary":"btn-outline") btn-sm" @onclick="() => _page=pp">@pp</button>
            }
            <button class="btn btn-outline btn-sm" @onclick="() => _page++"          disabled="@(_page==TotalPages)">›</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _page=TotalPages" disabled="@(_page==TotalPages)">»</button>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-3)">
            Sayfa başı
            <select class="form-control" style="width:70px;padding:4px;font-size:12px" @bind="_pageSize" @bind:after="() => _page=1">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="48">48</option>
            </select>
        </div>
    </div>
}


@* ── AI Risk Taslağı Modalı ─────────────────────────────────────────────────── *@
@if (_aiModalOpen)
{
    <div @onclick="CloseAiModal"
         style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9000"></div>

    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
                z-index:9001;background:#fff;border-radius:14px;width:min(600px,92vw);
                box-shadow:0 24px 64px rgba(0,0,0,.22);display:flex;flex-direction:column;
                max-height:88vh;overflow:hidden;font-family:inherit">

        
        <div style="display:flex;align-items:center;justify-content:space-between;
                    padding:18px 20px 16px;border-bottom:1px solid #e5e7eb;flex-shrink:0">
            <h3 style="margin:0;font-size:16px;font-weight:700;color:#111827">
                ✨ AI ile Risk Taslağı Oluştur
            </h3>
            <button @onclick="CloseAiModal" @onclick:stopPropagation="true"
                    style="border:none;background:none;cursor:pointer;font-size:18px;
                           color:#6b7280;line-height:1;padding:4px 8px;border-radius:6px"
                    title="Kapat">✕</button>
        </div>

        
        <div style="padding:20px;overflow-y:auto;flex:1">
            @if (_aiDraft == null && !_aiLoading)
            {
                <p style="font-size:13px;color:#6b7280;margin:0 0 14px">
                    Karşılaştığınız durumu veya endişeyi serbest metinle anlatın.
                    AI bunu bir risk kaydı taslağına dönüştürecek.
                </p>
                <textarea class="form-control" rows="5" style="resize:vertical;width:100%;box-sizing:border-box"
                          placeholder="Örn: Son depremde tedarikçimiz kapandı ve ham madde temin edemez hale geldik. Üretim durma riski var."
                          @bind="_aiInput" @bind:event="oninput"></textarea>
                @if (!string.IsNullOrEmpty(_aiError))
                {
                    <div style="margin-top:12px;padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;
                                border-radius:8px;font-size:13px;color:#991b1b">
                        ⚠️ @_aiError
                    </div>
                }
            }
            else if (_aiLoading)
            {
                <div style="text-align:center;padding:48px 20px">
                    <div style="font-size:32px;margin-bottom:14px">🤖</div>
                    <div style="font-size:14px;color:#6b7280">Analiz ediliyor…</div>
                </div>
            }
            else if (_aiDraft != null)
            {
                <p style="font-size:13px;color:#6b7280;margin:0 0 16px">
                    AI aşağıdaki taslağı oluşturdu. Düzenleyip envanterinize önerebilirsiniz.
                </p>
                <div style="margin-bottom:12px">
                    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">
                        Risk Başlığı <span style="color:#ef4444">*</span>
                    </label>
                    <input class="form-control" @bind="_draftTitle" maxlength="200" style="width:100%;box-sizing:border-box" />
                </div>
                <div style="margin-bottom:12px">
                    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">Kategori</label>
                    <input class="form-control" @bind="_draftCategory" maxlength="100" style="width:100%;box-sizing:border-box" />
                </div>
                <div style="margin-bottom:12px">
                    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">Kaynak Türü</label>
                    <select class="form-control" @bind="_draftSourceType" style="width:100%;box-sizing:border-box">
                        <option value="internal">İç</option>
                        <option value="external">Dış</option>
                    </select>
                </div>
                <div style="margin-bottom:12px">
                    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">Tehlike</label>
                    <textarea class="form-control" rows="2" @bind="_draftHazard" style="width:100%;box-sizing:border-box;resize:vertical"></textarea>
                </div>
                <div style="margin-bottom:4px">
                    <label style="display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:4px">Olası Etki</label>
                    <textarea class="form-control" rows="2" @bind="_draftImpact" style="width:100%;box-sizing:border-box;resize:vertical"></textarea>
                </div>
                @if (!string.IsNullOrEmpty(_aiError))
                {
                    <div style="margin-top:12px;padding:12px 14px;background:#fef2f2;border:1px solid #fca5a5;
                                border-radius:8px;font-size:13px;color:#991b1b">
                        ⚠️ @_aiError
                    </div>
                }
            }
        </div>

        
        <div style="display:flex;justify-content:flex-end;gap:8px;
                    padding:14px 20px;border-top:1px solid #e5e7eb;flex-shrink:0">
            @if (_aiDraft == null && !_aiLoading)
            {
                <button class="btn btn-outline" @onclick="CloseAiModal">İptal</button>
                <button class="btn btn-primary" @onclick="RunAiDraft"
                        disabled="@(string.IsNullOrWhiteSpace(_aiInput))">
                    Taslak Oluştur
                </button>
            }
            else if (_aiDraft != null)
            {
                <button class="btn btn-outline" @onclick="ResetAiDraft">← Geri</button>
                <button class="btn btn-primary" @onclick="ProposeFromDraft"
                        disabled="@(string.IsNullOrWhiteSpace(_draftTitle) || _aiProposing)">
                    @(_aiProposing ? "Öneriliyor…" : "Envanterime Öner")
                </button>
            }
        </div>
    </div>
}

@code {
    private string Role   => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private bool IsAdmin  => Role is "admin" or "committee" or "risk_manager";

    private List<RiskLibraryItem> _allItems = [];
    private List<RiskLibraryItem> _filtered = [];
    private Dictionary<string, int> _catCounts = [];
    private string[] _subCats = [];

    private string _search = "", _filterCat = "", _filterSub = "", _filterSource = "";
    private string _view = "card";
    private int _page = 1, _pageSize = 24;
    private bool _proposing;
    private string _successMsg = "", _errorMsg = "";
    private HashSet<int> _proposedIds = [];

    // ── AI Risk Taslağı ──────────────────────────────────────────────────────
    private bool              _aiModalOpen;
    private bool              _aiLoading;
    private bool              _aiProposing;
    private string            _aiInput  = "";
    private string            _aiError  = "";
    private AiRiskDraftResult? _aiDraft;
    private string _draftTitle      = "";
    private string _draftCategory   = "";
    private string _draftSourceType = "internal";
    private string _draftHazard     = "";
    private string _draftImpact     = "";

    private bool HasFilter => !string.IsNullOrEmpty(_search) || !string.IsNullOrEmpty(_filterCat) ||
                              !string.IsNullOrEmpty(_filterSub) || !string.IsNullOrEmpty(_filterSource);

    private IEnumerable<RiskLibraryItem> PagedItems => _filtered.Skip((_page-1)*_pageSize).Take(_pageSize);
    private int TotalPages => (int)Math.Ceiling(_filtered.Count / (double)_pageSize);

    protected override void OnInitialized()
    {
        _allItems   = LibSvc.Search(null, null, null, null);
        _catCounts  = LibSvc.GetCategoryCounts();
        _subCats    = LibSvc.GetSubCategories();
        _filtered   = _allItems;
        _proposedIds = LibSvc.GetProposedLibraryItemIds(UserId);
    }

    private void ApplyFilter()
    {
        _filtered = LibSvc.Search(_search, _filterCat, _filterSub, _filterSource);
        _subCats  = LibSvc.GetSubCategories(string.IsNullOrEmpty(_filterCat) ? null : _filterCat);
        _page = 1;
    }

    private void ClearFilter()
    {
        _search = ""; _filterCat = ""; _filterSub = ""; _filterSource = "";
        ApplyFilter();
    }

    private void Propose(int itemId)
    {
        _successMsg = ""; _errorMsg = "";
        _proposing = true;
        try
        {
            var risk = LibSvc.ProposeFromLibrary(itemId, UserId);
            _successMsg  = $"Risk '{risk.Title}' envantere önerildi ({risk.Code}). Detay için: Risk Envanteri";
            _proposedIds = LibSvc.GetProposedLibraryItemIds(UserId);
            _allItems    = LibSvc.Search(null, null, null, null);
            _catCounts   = LibSvc.GetCategoryCounts();
            ApplyFilter();
        }
        catch (Exception)
        {
            _errorMsg = "İşlem sırasında bir sorun oluştu. Lütfen tekrar deneyin.";
        }
        finally
        {
            _proposing = false;
        }
    }

    // ── AI Draft metodları ───────────────────────────────────────────────────
    private void OpenAiModal()
    {
        _aiModalOpen = true;
        StateHasChanged();
    }

    private void CloseAiModal()
    {
        _aiModalOpen = false;
        _aiInput     = "";
        _aiDraft     = null;
        _aiError     = "";
        StateHasChanged();
    }

    private void ResetAiDraft() { _aiDraft = null; _aiError = ""; }

    private async Task RunAiDraft()
    {
        _aiError   = "";
        _aiLoading = true;
        try
        {
            _aiDraft = await AiSvc.DraftAsync(_aiInput);
            _draftTitle      = _aiDraft.Title;
            _draftCategory   = _aiDraft.Category   ?? "";
            _draftSourceType = _aiDraft.SourceType  ?? "internal";
            _draftHazard     = _aiDraft.Hazard      ?? "";
            _draftImpact     = _aiDraft.PossibleImpact ?? "";
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("429") || ex.Message.Contains("TooManyRequests") || ex.Message.Contains("RESOURCE_EXHAUSTED") || ex.Message.Contains("quota"))
        {
            _aiError = "API kotası aşıldı veya ücretsiz plan sınırına ulaşıldı. " +
                       "Google AI Studio'da faturalandırmayı etkinleştirin ya da başka bir sağlayıcı (OpenAI/Anthropic) deneyin.";
        }
        catch (Exception ex)
        {
            _aiError = $"AI hatası: {ex.Message}";
        }
        finally
        {
            _aiLoading = false;
        }
    }

    private async Task ProposeFromDraft()
    {
        if (string.IsNullOrWhiteSpace(_draftTitle)) return;
        _aiProposing = true;
        _aiError     = "";
        try
        {
            var risk = await RiskSvc.CreateAsync(
                title:          _draftTitle.Trim(),
                description:    null,
                category:       string.IsNullOrWhiteSpace(_draftCategory) ? null : _draftCategory.Trim(),
                organizationId: null,
                riskStrategy:   null,
                proposedById:   UserId,
                proposerName:   null);

            // Ek alanları güncelle (hazard, possible impact, source type)
            if (!string.IsNullOrWhiteSpace(_draftHazard) || !string.IsNullOrWhiteSpace(_draftImpact))
                await RiskSvc.UpdateRiskFieldsAsync(risk.Id,
                    sourceType: _draftSourceType,
                    source: null, hazard: string.IsNullOrWhiteSpace(_draftHazard) ? null : _draftHazard.Trim(),
                    possibleImpact: string.IsNullOrWhiteSpace(_draftImpact) ? null : _draftImpact.Trim(),
                    affectedPersons: null, relevantLegislation: null,
                    lastReviewedAt: null, lastReviewerName: null, lastReviewerTitle: null,
                    userId: UserId, category: string.IsNullOrWhiteSpace(_draftCategory) ? null : _draftCategory.Trim());

            _successMsg = $"Risk '{risk.Title}' AI taslağından oluşturuldu ({risk.Code}).";
            CloseAiModal();
        }
        catch (Exception ex)
        {
            _aiError = $"Kayıt hatası: {ex.Message}";
        }
        finally
        {
            _aiProposing = false;
        }
    }

}

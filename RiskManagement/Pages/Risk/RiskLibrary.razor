@page "/risk/library"
@attribute [Authorize]
@inject RiskLibraryService LibSvc
@inject RiskService RiskSvc
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@using System.Security.Claims
@using RiskManagement.Models

<PageTitle>Risk Kütüphanesi</PageTitle>

@if (!string.IsNullOrEmpty(_successMsg))
{
    <div class="alert alert-success" style="margin-bottom:12px">@_successMsg</div>
}
@if (!string.IsNullOrEmpty(_errorMsg))
{
    <div class="alert alert-error" style="margin-bottom:12px">@_errorMsg</div>
}

<div class="page-header">
    <div>
        <h1>Risk Kütüphanesi</h1>
        <div class="page-toolbar-sub">@_filtered.Count kayıt · Beğendiğiniz riskleri envanterinize önerebilirsiniz</div>
    </div>
    <div style="display:flex;gap:8px;align-items:center">
        <a href="/export/library/excel" class="btn btn-outline btn-sm">Dışa Aktar</a>
        @if (IsAdmin)
        {
            <a href="/risk/library/admin" class="btn btn-outline btn-sm">Yönet</a>
        }
    </div>
</div>

@* ── Kategori hızlı filtreler ── *@
<div class="lib-cat-pills">
    <button class="btn @(_filterCat==""?"btn-primary":"btn-outline") btn-sm"
            @onclick='() => { _filterCat=""; _filterSub=""; ApplyFilter(); }'>
        Tümü (@_allItems.Count)
    </button>
    @foreach (var (cat, cnt) in _catCounts.OrderByDescending(x => x.Value))
    {
        var c = cat;
        <button class="btn @(_filterCat==c?"btn-primary":"btn-outline") btn-sm"
                @onclick='() => { _filterCat=c; _filterSub=""; ApplyFilter(); }'>
            @c (@cnt)
        </button>
    }
</div>

@* ── Filtre ve arama ── *@
<div class="card" style="padding:14px 16px;margin-bottom:16px">
    <div class="filter-bar">
        <div class="filter-group" style="flex:2;min-width:200px">
            <label class="filter-label">Arama</label>
            <input class="form-control" placeholder="Başlık, tehlike, etiket…"
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>
        <div class="filter-group" style="min-width:180px">
            <label class="filter-label">Alt Kategori</label>
            <select class="form-control" @bind="_filterSub" @bind:after="ApplyFilter">
                <option value="">Tümü</option>
                @foreach (var s in _subCats)
                { <option value="@s">@s</option> }
            </select>
        </div>
        <div class="filter-group" style="min-width:140px">
            <label class="filter-label">Kaynak</label>
            <select class="form-control" @bind="_filterSource" @bind:after="ApplyFilter">
                <option value="">Tümü</option>
                <option value="internal">İç</option>
                <option value="external">Dış</option>
            </select>
        </div>
        <div class="filter-group" style="min-width:140px">
            <label class="filter-label">Görünüm</label>
            <select class="form-control" @bind="_view">
                <option value="card">Kart</option>
                <option value="table">Tablo</option>
            </select>
        </div>
        @if (HasFilter)
        {
            <div class="filter-group">
                <label class="filter-label" style="opacity:0;user-select:none">—</label>
                <button class="btn btn-outline btn-sm" @onclick="ClearFilter">Temizle</button>
            </div>
        }
    </div>
</div>

@if (!_filtered.Any())
{
    <div class="card" style="padding:40px">
        <div class="empty-state">
            <div class="empty-state-title">Sonuç bulunamadı</div>
            <div class="empty-state-sub">Farklı arama kriterleri deneyin.</div>
        </div>
    </div>
}
else if (_view == "card")
{
    @* ── KART GÖRÜNÜMÜ ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px">
        @foreach (var item in PagedItems)
        {
            <div class="card lib-card">
                <div class="lib-card-top">
                    <div style="flex:1;min-width:0">
                        <div class="lib-card-title">@item.Title</div>
                        @if (!string.IsNullOrEmpty(item.Category))
                        {
                            <div class="lib-card-tags">
                                <span class="tag">@item.Category</span>
                                @if (!string.IsNullOrEmpty(item.SubCategory))
                                { <span class="tag">@item.SubCategory</span> }
                            </div>
                        }
                    </div>
                    <span class="badge @(item.SourceType=="external"?"badge-blue":"badge-gray") lib-source-badge">
                        @(item.SourceType == "external" ? "Dış" : "İç")
                    </span>
                </div>

                @if (!string.IsNullOrEmpty(item.Hazard))
                {
                    <div class="lib-card-meta">
                        <span class="lib-card-meta-label lib-card-meta-label--hazard">Tehlike:</span> @item.Hazard
                    </div>
                }
                @if (!string.IsNullOrEmpty(item.PossibleImpact))
                {
                    <div class="lib-card-meta">
                        <span class="lib-card-meta-label lib-card-meta-label--impact">Etki:</span> @item.PossibleImpact
                    </div>
                }

                <div class="lib-card-footer">
                    @if (item.UsageCount > 0)
                    {
                        <span class="lib-usage-count">@item.UsageCount kez kullanıldı</span>
                    }
                    else { <span></span> }
                    @if (_proposedIds.Contains(item.Id))
                    {
                        <span class="lib-proposed-label">Daha önce önerildi</span>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => Propose(item.Id)"
                                disabled="@_proposing">
                            + Envanterime Öner
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    @* ── TABLO GÖRÜNÜMÜ ── *@
    <div class="card" style="padding:0;overflow-x:auto">
        <table class="table">
            <thead>
                <tr>
                    <th>Başlık</th>
                    <th style="width:140px">Kategori</th>
                    <th style="width:130px">Alt Kategori</th>
                    <th style="width:80px">Kaynak</th>
                    <th>Tehlike</th>
                    <th>Olası Etki</th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in PagedItems)
                {
                    <tr>
                        <td style="font-weight:600;max-width:240px">@item.Title</td>
                        <td>@if (!string.IsNullOrEmpty(item.Category)) { <span class="tag" style="font-size:11px">@item.Category</span> }</td>
                        <td style="font-size:12px;color:var(--text-3)">@(item.SubCategory ?? "—")</td>
                        <td><span class="badge @(item.SourceType=="external"?"badge-blue":"badge-gray")" style="font-size:11px">@(item.SourceType=="external"?"Dış":"İç")</span></td>
                        <td style="font-size:12px;color:var(--text-3);max-width:180px">@(item.Hazard ?? "—")</td>
                        <td style="font-size:12px;color:var(--text-3);max-width:180px">@(item.PossibleImpact ?? "—")</td>
                        <td>
                            @if (_proposedIds.Contains(item.Id))
                            {
                                <span style="font-size:12px;font-weight:600;color:#16a34a;white-space:nowrap">Daha önce önerildi</span>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-sm" @onclick="() => Propose(item.Id)"
                                        disabled="@_proposing" style="white-space:nowrap">
                                    + Öner
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* ── Sayfalama ── *@
@if (TotalPages > 1)
{
    <div style="display:flex;align-items:center;justify-content:space-between;margin-top:16px">
        <div style="font-size:12px;color:var(--text-3)">
            @((_page-1)*_pageSize+1)–@(Math.Min(_page*_pageSize, _filtered.Count)) / @_filtered.Count kayıt
        </div>
        <div style="display:flex;gap:4px">
            <button class="btn btn-outline btn-sm" @onclick="() => _page=1"         disabled="@(_page==1)">«</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _page--"          disabled="@(_page==1)">‹</button>
            @for (int p = Math.Max(1,_page-2); p <= Math.Min(TotalPages,_page+2); p++)
            {
                var pp = p;
                <button class="btn @(_page==pp?"btn-primary":"btn-outline") btn-sm" @onclick="() => _page=pp">@pp</button>
            }
            <button class="btn btn-outline btn-sm" @onclick="() => _page++"          disabled="@(_page==TotalPages)">›</button>
            <button class="btn btn-outline btn-sm" @onclick="() => _page=TotalPages" disabled="@(_page==TotalPages)">»</button>
        </div>
        <div style="display:flex;align-items:center;gap:8px;font-size:12px;color:var(--text-3)">
            Sayfa başı
            <select class="form-control" style="width:70px;padding:4px;font-size:12px" @bind="_pageSize" @bind:after="() => _page=1">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="48">48</option>
            </select>
        </div>
    </div>
}


@code {
    private string Role   => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private bool IsAdmin  => Role is "admin" or "committee" or "risk_manager";

    private List<RiskLibraryItem> _allItems = [];
    private List<RiskLibraryItem> _filtered = [];
    private Dictionary<string, int> _catCounts = [];
    private string[] _subCats = [];

    private string _search = "", _filterCat = "", _filterSub = "", _filterSource = "";
    private string _view = "card";
    private int _page = 1, _pageSize = 24;
    private bool _proposing;
    private string _successMsg = "", _errorMsg = "";
    private HashSet<int> _proposedIds = [];

    private bool HasFilter => !string.IsNullOrEmpty(_search) || !string.IsNullOrEmpty(_filterCat) ||
                              !string.IsNullOrEmpty(_filterSub) || !string.IsNullOrEmpty(_filterSource);

    private IEnumerable<RiskLibraryItem> PagedItems => _filtered.Skip((_page-1)*_pageSize).Take(_pageSize);
    private int TotalPages => (int)Math.Ceiling(_filtered.Count / (double)_pageSize);

    protected override void OnInitialized()
    {
        _allItems   = LibSvc.Search(null, null, null, null);
        _catCounts  = LibSvc.GetCategoryCounts();
        _subCats    = LibSvc.GetSubCategories();
        _filtered   = _allItems;
        _proposedIds = LibSvc.GetProposedLibraryItemIds(UserId);
    }

    private void ApplyFilter()
    {
        _filtered = LibSvc.Search(_search, _filterCat, _filterSub, _filterSource);
        _subCats  = LibSvc.GetSubCategories(string.IsNullOrEmpty(_filterCat) ? null : _filterCat);
        _page = 1;
    }

    private void ClearFilter()
    {
        _search = ""; _filterCat = ""; _filterSub = ""; _filterSource = "";
        ApplyFilter();
    }

    private void Propose(int itemId)
    {
        _successMsg = ""; _errorMsg = "";
        _proposing = true;
        try
        {
            var risk = LibSvc.ProposeFromLibrary(itemId, UserId);
            _successMsg  = $"Risk '{risk.Title}' envantere önerildi ({risk.Code}). Detay için: Risk Envanteri";
            _proposedIds = LibSvc.GetProposedLibraryItemIds(UserId);
            _allItems    = LibSvc.Search(null, null, null, null);
            _catCounts   = LibSvc.GetCategoryCounts();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            _errorMsg = "Hata: " + ex.Message;
        }
        finally
        {
            _proposing = false;
        }
    }

}

        "strategy_set"=>"Strateji","controlled"=>"Kontrollü","residual_evaluated"=>"Kalan Risk",
        "action_planned"=>"Aksiyon","risk_accepted"=>"Risk Kabul Edildi","rejected"=>"Reddedildi",_=>s

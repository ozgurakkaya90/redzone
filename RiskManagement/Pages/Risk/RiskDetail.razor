@page "/risk/{Id:int}"
@attribute [Authorize]
@inject RiskService RiskSvc
@inject AuditService AuditSvc
@inject ConfigService CfgSvc
@inject IRiskCalculator RiskCalc
@inject AppDbContext Db
@inject AuthService Auth
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject IJSRuntime JS
@inject ToastService Toast
@inject ILogger<RiskDetail> Logger
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Risk Detayı</PageTitle>

@if (_risk == null)
{
    <div class="spinner">Yükleniyor…</div>
}
else
{
    <div style="max-width:900px">

        <div class="breadcrumb-bar">
            <a href="/risk" class="breadcrumb-back">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Risk Envanteri
            </a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@_risk.Code</span>
        </div>

        @* ── Premium Başlık Şeridi ── *@
        <div class="detail-header-strip">
            <div class="detail-header-top">
                <div style="flex:1;min-width:0">
                    <div class="detail-header-badges">
                        <code style="font-size:11px;background:var(--gray-100);padding:2px 8px;border-radius:4px;color:var(--text-3)">@_risk.Code</code>
                        <span class="badge @StatusBadge(_risk.Status)">@StatusLabel(_risk.Status)</span>
                        @if (!_risk.IsActive)
                        { <span class="badge" style="background:#6b7280;color:#fff">Pasif</span> }
                        @if (_risk.Category != null) { <span class="tag">@_risk.Category</span> }
                    </div>
                    <h2 class="detail-header-title">@_risk.Title</h2>
                </div>
                <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
                    <div class="detail-nav">
                        @if (_prevId.HasValue)
                        {
                            <a href="/risk/@_prevId" class="detail-nav-btn" aria-label="Önceki risk">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                            </a>
                        }
                        else
                        {
                            <span class="detail-nav-btn disabled" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                            </span>
                        }
                        @if (_nextId.HasValue)
                        {
                            <a href="/risk/@_nextId" class="detail-nav-btn" aria-label="Sonraki risk">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                            </a>
                        }
                        else
                        {
                            <span class="detail-nav-btn disabled" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </span>
                        }
                    </div>
                    <a href="/risk" class="btn btn-outline btn-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                        Liste
                    </a>
                    @if (IsRiskManager)
                    {
                        @if (_risk.IsActive)
                        { <button class="btn btn-outline btn-sm" style="color:#b45309;border-color:#fcd34d" @onclick="AskSetPassive" disabled="@_loading" title="Riski pasife al">Pasife Al</button> }
                        else
                        { <button class="btn btn-outline btn-sm" style="color:#15803d;border-color:#86efac" @onclick="SetActive" disabled="@_loading" title="Riski yeniden aktifleştir">Aktifleştir</button> }
                    }
                </div>
            </div>
            <div class="detail-header-meta">
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Risk Sahibi</span>
                    <span class="detail-meta-value">@(_risk.Owner?.FullName ?? "—")</span>
                </div>
                @if (_risk.Department != null || _risk.Organization != null)
                {
                    <div class="detail-meta-item">
                        <span class="detail-meta-label">Birim</span>
                        <span class="detail-meta-value">@(_risk.Department?.Name ?? _risk.Organization?.Name ?? "—")</span>
                    </div>
                }
                @if (_initial != null)
                {
                    <div class="detail-meta-item">
                        <span class="detail-meta-label">İlk Risk Skoru</span>
                        <span class="detail-meta-value" style="color:@(_risk.Evaluations.FirstOrDefault(e=>e.EvalType=="initial")?.RiskLevel switch { "Çok Yüksek Risk"=>"#7f1d1d","Yüksek Risk"=>"#dc2626","Önemli Risk"=>"#c2410c","Orta Risk"=>"#ca8a04",_=>"#15803d"})">
                            @_initial.Score.ToString("0.##") · @_initial.RiskLevel
                        </span>
                    </div>
                }
                @if (_residual != null)
                {
                    <div class="detail-meta-item">
                        <span class="detail-meta-label">Kalan Risk</span>
                        <span class="detail-meta-value" style="color:@(_risk.Evaluations.LastOrDefault(e=>e.EvalType=="residual")?.RiskLevel switch { "Çok Yüksek Risk"=>"#7f1d1d","Yüksek Risk"=>"#dc2626","Önemli Risk"=>"#c2410c","Orta Risk"=>"#ca8a04",_=>"#15803d"})">
                            @_residual.Score.ToString("0.##") · @_residual.RiskLevel
                        </span>
                    </div>
                }
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Öneren</span>
                    <span class="detail-meta-value">@(_risk.ProposedBy?.FullName ?? _risk.ProposerName ?? "Anonim")</span>
                </div>
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Tarih</span>
                    <span class="detail-meta-value" title="@_risk.ProposedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">@RelativeDate(_risk.ProposedAt)</span>
                </div>
            </div>
        </div>

        @* ── Stepper (sticky) ── *@
        @if (_risk.Status == "rejected")
        {
            <div class="alert alert-error" style="margin-bottom:16px">
                <strong>Bu risk reddedildi.</strong>
                @if (!string.IsNullOrEmpty(_risk.RejectionReason)) { <span> Gerekçe: @_risk.RejectionReason</span> }
            </div>
        }
        else
        {
            <div class="sticky-stepper-wrap">
                @{ var si = StepIndex(_risk.Status); }
                <div class="stepper2">
                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var idx = i;
                        var isDone    = idx < si;
                        var isCurrent = idx == si;
                        var isNext    = idx == si + 1;
                        <div class="step2 @(isDone ? "done" : isCurrent ? "current" : isNext ? "next" : "")">
                            <div class="step2-dot">
                                @if (isDone) { <span>&#10003;</span> }
                                else         { <span>@(idx+1)</span> }
                            </div>
                            <div class="step2-body">
                                <div class="step2-name">@_steps[idx]</div>
                                @if (isCurrent) { <div class="step2-badge">Şu an burada</div> }
                                @if (isNext)    { <div class="step2-badge next">Sıradaki</div> }
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (_risk.Status == "risk_accepted")
            {
                <div style="margin-bottom:14px;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:10px 16px;font-size:13px;color:#166534">
                    <strong>Kalıntı Risk Kabul Edildi.</strong>
                    @if (!string.IsNullOrEmpty(_risk.AcceptanceReason)) { <span> Gerekçe: @_risk.AcceptanceReason</span> }
                </div>
            }
        }

        @* ════════════════════════════════════════════════════════
           KART 1 — Risk Önerisi
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[0]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(0)">
                <div class="card-title">
                    @CardDot(0)
                    <span class="section-title" style="margin-bottom:0">1. Risk Önerisi</span>
                </div>
                <span class="card-chevron" style="transform:rotate(@(_expanded[0]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[0]) { <div style="margin-top:14px">

            @* Açıklama *@
            <div style="margin-bottom:12px">
                <div class="fl">Açıklama</div>
                @if (!string.IsNullOrEmpty(_risk.Description))
                { <p style="font-size:14px;line-height:1.6;margin:0;white-space:pre-wrap">@_risk.Description</p> }
                else { <span class="empty-val">—</span> }
            </div>

            <div class="meta-grid mg-3">
                <div>
                    <div class="fl">Kategori</div>
                    @if (!string.IsNullOrEmpty(_risk.Category)) { <span class="tag">@_risk.Category</span> }
                    else { <span class="empty-val">—</span> }
                </div>
                <div>
                    <div class="fl">Öneren</div>
                    <div style="font-size:13px">@(_risk.ProposedBy?.FullName ?? _risk.ProposerName ?? "Anonim")</div>
                </div>
                <div>
                    <div class="fl">Öneri Tarihi</div>
                    <div style="font-size:13px" title="@_risk.ProposedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">
                        @RelativeDate(_risk.ProposedAt)
                    </div>
                </div>
            </div>

            @* Risk Yöneticisi: incelemeye al / onaya gönder / reddet *@
            @if (IsRiskManager && _risk.Status is "proposed" or "under_review")
            {
                <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:8px;flex-wrap:wrap">
                    @if (_risk.Status == "proposed")
                    { <button class="btn btn-warning btn-sm" @onclick='() => DoStatus("under_review")' disabled="@_loading">İncelemeye Al</button> }
                    @if (_risk.Status == "under_review")
                    { <button class="btn btn-success btn-sm" @onclick='() => DoStatus("awaiting_approval")' disabled="@_loading">Onaya Gönder</button> }
                    <button class="btn btn-danger btn-sm" @onclick="ToggleRejectForm" disabled="@_loading">Reddet</button>
                </div>
                @if (_showReject)
                {
                    <div style="margin-top:10px;background:#fff5f5;padding:12px;border-radius:8px">
                        <div class="form-group">
                            <label class="form-label">Red Gerekçesi</label>
                            <textarea class="form-control" rows="2" @bind="_rejectReason"></textarea>
                        </div>
                        <button class="btn btn-danger btn-sm" @onclick='() => DoStatus("rejected", _rejectReason)' disabled="@_loading">Reddi Onayla</button>
                    </div>
                }
            }

            @* Komite: onayla / reddet *@
            @if (IsCommittee && _risk.Status == "awaiting_approval")
            {
                <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
                    <div style="font-size:12px;color:#92400e;font-weight:600;margin-bottom:8px;background:#fffbeb;padding:8px 12px;border-radius:6px;border:1px solid #fcd34d">
                        Bu risk komite onayı bekliyor.
                    </div>
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="btn btn-success btn-sm" @onclick='() => DoStatus("approved")' disabled="@_loading">Onayla</button>
                        <button class="btn btn-danger btn-sm" @onclick="ToggleRejectForm" disabled="@_loading">Reddet</button>
                    </div>
                    @if (_showReject)
                    {
                        <div style="margin-top:10px;background:#fff5f5;padding:12px;border-radius:8px">
                            <div class="form-group">
                                <label class="form-label">Red Gerekçesi</label>
                                <textarea class="form-control" rows="2" @bind="_rejectReason"></textarea>
                            </div>
                            <button class="btn btn-danger btn-sm" @onclick='() => DoStatus("rejected", _rejectReason)'>Reddi Onayla</button>
                        </div>
                    }
                </div>
            }
            </div> } @* end expanded[0] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 2 — Risk Detayları
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[1]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(1)">
                <div class="card-title">@CardDot(1)<span class="section-title" style="margin-bottom:0">2. Risk Detayları</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if ((IsOwner || IsRiskManager) && HasRiskDetailData)
                    { <button class="btn btn-outline btn-sm" @onclick="() => _showFields = !_showFields">@(_showFields ? "İptal" : "Düzenle")</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[1]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[1]) { <div style="margin-top:14px">
            @if (_showFields)
            {
                <div class="meta-grid mg-2" style="margin-bottom:12px">
                    <div style="grid-column:span 2">
                        <label class="form-label">Kategori</label>
                        <select class="form-control" @bind="_fCategory">
                            <option value="">— Seçiniz —</option>
                            @foreach (var c in CfgSvc.GetList("risk_categories"))
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                    @if (FieldVisible("source_type")) {
                    <div>
                        <label class="form-label">Kaynak Sınıflandırması</label>
                        <select class="form-control" @bind="_fSourceType">
                            <option value="internal">İç Faktör</option>
                            <option value="external">Dış Faktör</option>
                        </select>
                    </div> }
                    @if (FieldVisible("source")) {
                    <div>
                        <label class="form-label">Kaynak Türü</label>
                        <input class="form-control" @bind="_fSource" placeholder="Riskin kaynak türü…" />
                    </div> }
                    @if (FieldVisible("hazard")) {
                    <div>
                        <label class="form-label">Tehlike</label>
                        <input class="form-control" @bind="_fHazard" placeholder="Tehlike tanımı…" />
                    </div> }
                    @if (FieldVisible("possible_impact")) {
                    <div>
                        <label class="form-label">Olası Etki</label>
                        <input class="form-control" @bind="_fPossibleImpact" placeholder="Gerçekleşirse ne olur?" />
                    </div> }
                    @if (FieldVisible("activity_area")) {
                    <div style="grid-column:span 2">
                        <label class="form-label">Faaliyet Alanı</label>
                        <textarea class="form-control" rows="2" @bind="_fActivityArea" placeholder="Riskin ilgili olduğu faaliyet alanı…"></textarea>
                    </div> }
                    @if (FieldVisible("relevant_legislation")) {
                    <div style="grid-column:span 2">
                        <label class="form-label">İlgili Mevzuat / Doküman</label>
                        <input class="form-control" @bind="_fLegislation" placeholder="Yasal düzenlemeler, standartlar, iç dokümanlar…" />
                    </div> }
                </div>
                @if (FieldVisible("affected_persons")) {
                <div style="margin-bottom:14px">
                    <label class="form-label">Riskten Etkilenecek Kişiler</label>
                    <div style="display:flex;flex-wrap:wrap;gap:10px;padding:10px;background:#f8fafc;border-radius:8px;border:1px solid var(--border)">
                        @foreach (var p in _allAffected)
                        {
                            var person = p;
                            <label style="display:flex;align-items:center;gap:6px;cursor:pointer;font-size:13px">
                                <input type="checkbox" checked="@_selectedAffected.Contains(person)"
                                       @onchange="e => ToggleAffected(person, (bool)(e.Value ?? false))" />
                                @person
                            </label>
                        }
                    </div>
                </div> }
                <div style="display:flex;gap:8px">
                    <button class="btn btn-success btn-sm" @onclick="SaveFields">Kaydet</button>
                    <button class="btn btn-outline btn-sm" @onclick="() => _showFields = false">İptal</button>
                </div>
            }
            else
            {
                <div class="meta-grid mg-2">
                    <div style="grid-column:span 2">
                        <div class="fl">Kategori</div>
                        @if (!string.IsNullOrEmpty(_risk.Category)) { <span class="tag">@_risk.Category</span> }
                        else { <span class="empty-val">—</span> }
                    </div>
                    @if (FieldVisible("source_type")) {
                    <div>
                        <div class="fl">Kaynak Sınıflandırması</div>
                        <span class="tag">@(_risk.SourceType == "external" ? "Dış Faktör" : "İç Faktör")</span>
                    </div> }
                    @if (FieldVisible("source")) {
                    <div>
                        <div class="fl">Kaynak Türü</div>
                        @if (!string.IsNullOrEmpty(_risk.Source)) { <div style="font-size:13px">@_risk.Source</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                    @if (FieldVisible("hazard")) {
                    <div>
                        <div class="fl">Tehlike</div>
                        @if (!string.IsNullOrEmpty(_risk.Hazard)) { <div style="font-size:13px">@_risk.Hazard</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                    @if (FieldVisible("possible_impact")) {
                    <div>
                        <div class="fl">Olası Etki</div>
                        @if (!string.IsNullOrEmpty(_risk.PossibleImpact)) { <div style="font-size:13px">@_risk.PossibleImpact</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                    @if (FieldVisible("activity_area")) {
                    <div style="grid-column:span 2">
                        <div class="fl">Faaliyet Alanı</div>
                        @if (!string.IsNullOrEmpty(_risk.ActivityArea)) { <div style="font-size:13px">@_risk.ActivityArea</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                    @if (FieldVisible("relevant_legislation")) {
                    <div style="grid-column:span 2">
                        <div class="fl">İlgili Mevzuat / Doküman</div>
                        @if (!string.IsNullOrEmpty(_risk.RelevantLegislation)) { <div style="font-size:13px">@_risk.RelevantLegislation</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                    @if (FieldVisible("affected_persons")) {
                    <div style="grid-column:span 2">
                        <div class="fl">Etkilenecek Kişiler</div>
                        @{ var persons = _risk.GetAffectedPersonsList(); }
                        @if (persons.Any())
                        { <div style="display:flex;gap:6px;flex-wrap:wrap">@foreach (var p in persons) { <span class="badge badge-blue">@p</span> }</div> }
                        else { <span class="empty-val">—</span> }
                    </div> }
                </div>
            } </div> } @* end expanded[1] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 3 — İlk Değerlendirme
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[2]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(2)">
                <div class="card-title">@CardDot(2)<span class="section-title" style="margin-bottom:0">3. İlk Değerlendirme</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsRiskManager && _initial != null)
                    { <button class="btn btn-outline btn-sm" @onclick="ToggleEvalForm">Güncelle</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[2]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[2]) { <div style="margin-top:14px">

            @if (_initial != null)
            { <EvalBox Eval="_initial" Label="İlk Değerlendirme" /> }
            else
            { <div class="empty-state"><p>Henüz ilk değerlendirme yapılmamış.</p></div> }

            @if (_showEval || (IsRiskManager && _initial == null))
            {
                <div style="margin-top:14px;border-top:1px solid var(--border);padding-top:14px">
                    <div class="section-title">Fine-Kinney Formu</div>
                    <FineKinneyForm EvalType="initial" OnSubmit="HandleEval" Loading="_loading" />
                    @if (_initial != null) { <button class="btn btn-outline btn-sm" style="margin-top:8px" @onclick="() => _showEval = false">İptal</button> }
                </div>
            }
            </div> } @* end expanded[2] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 4 — Sorumluluk & Strateji
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[3]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(3)">
                <div class="card-title">@CardDot(3)<span class="section-title" style="margin-bottom:0">4. Sorumluluk & Strateji</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsRiskManager)
                    { <button class="btn btn-outline btn-sm" @onclick="ToggleMeta">@(_showMeta ? "İptal" : "Güncelle")</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[3]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[3]) { <div style="margin-top:14px">

            <div class="meta-grid mg-4">
                <div>
                    <div class="fl">Sorumlu Organizasyon</div>
                    @if (_risk.Organization != null)
                    { <div style="font-size:13px">@_risk.Organization.Name@(_risk.Organization.Company != null ? $" · {_risk.Organization.Company.Name}" : "")</div> }
                    else { <span class="empty-val">—</span> }
                </div>
                <div>
                    <div class="fl">Sorumlu Departman</div>
                    @if (_risk.Department != null) { <div style="font-size:13px">@_risk.Department.Name</div> }
                    else { <span class="empty-val">—</span> }
                </div>
                <div>
                    <div class="fl">Risk Stratejisi</div>
                    @if (!string.IsNullOrEmpty(_risk.RiskStrategy)) { <span class="tag">@_risk.RiskStrategy</span> }
                    else { <span class="empty-val">—</span> }
                </div>
                <div>
                    <div class="fl">Risk Sahibi</div>
                    @if (_risk.Owner != null) { <div style="font-size:13px">@_risk.Owner.FullName</div> }
                    else { <span class="empty-val">—</span> }
                </div>
            </div>

            @if (_showMeta)
            {
                <div style="margin-top:14px;background:#fffbeb;padding:14px;border-radius:8px;border:1px solid #fcd34d">
                    <div class="meta-grid mg-2">
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Sorumlu Organizasyon</label>
                            <select class="form-control" @bind="_metaOrgId" @bind:after="OnMetaOrgChanged">
                                <option value="0">— Seçiniz —</option>
                                @foreach (var o in _organizations)
                                { <option value="@o.Id">@o.Name@(o.Company != null ? $" · {o.Company.Name}" : "")</option> }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Sorumlu Departman</label>
                            <select class="form-control" @bind="_metaDeptId">
                                <option value="0">— Seçiniz —</option>
                                @foreach (var d in _metaFilteredDepts)
                                { <option value="@d.Id">@d.Name</option> }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Risk Stratejisi</label>
                            <select class="form-control" @bind="_metaStrategy">
                                <option value="">— Seçiniz —</option>
                                @foreach (var s in _riskStrategies) { <option value="@s">@s</option> }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Risk Sahibi</label>
                            <select class="form-control" @bind="_metaOwnerId">
                                <option value="0">— Seçiniz —</option>
                                @foreach (var u in _allUsers)
                                { <option value="@u.Id">@u.FullName (@(u.DepartmentNav?.Name ?? ""))</option> }
                            </select>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-top:12px">
                        <button class="btn btn-success btn-sm" @onclick="SaveMeta" disabled="@_loading">Kaydet</button>
                        <button class="btn btn-outline btn-sm" @onclick="() => _showMeta = false">İptal</button>
                    </div>
                </div>
            }
            </div> } @* end expanded[3] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 5 — Kontroller
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[4]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(4)">
                <div class="card-title">@CardDot(4)<span class="section-title" style="margin-bottom:0">5. Kontroller</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsOwner || IsRiskManager)
                    { <button class="btn btn-outline btn-sm" @onclick="ToggleControlForm">@(_showControl ? "İptal" : "+ Kontrol Ekle")</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[4]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[4]) { <div style="margin-top:14px">

            @if (_showControl)
            {
                <div class="form-panel">
                    <div class="form-group">
                        <label class="form-label">Kontrol Açıklaması *</label>
                        <textarea class="form-control" rows="2" @bind="_ctrlDesc"></textarea>
                    </div>
                    <div class="meta-grid mg-3" style="margin-bottom:10px">
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Tür</label>
                            <select class="form-control" @bind="_ctrlType">
                                @foreach (var t in _controlTypes) { <option value="@t">@t</option> }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Etkinlik</label>
                            <select class="form-control" @bind="_ctrlEff">
                                <option value="">Seçiniz…</option>
                                @foreach (var e in _controlEffectiveness) { <option value="@e">@e</option> }
                            </select>
                        </div>
                        <div class="form-group" style="margin-bottom:0">
                            <label class="form-label">Sıklık</label>
                            <select class="form-control" @bind="_ctrlFreq">
                                <option value="">Seçiniz…</option>
                                @foreach (var f in _controlFrequencies) { <option value="@f">@f</option> }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Kontrol Sahibi Departman</label>
                        <select class="form-control" @bind="_ctrlOwnerId">
                            <option value="0">— Seçiniz —</option>
                            @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                        </select>
                    </div>
                    <button class="btn btn-success btn-sm" @onclick="SaveControl" disabled="@_loading">Kaydet</button>
                </div>
            }

            @if (!_risk.Controls.Any())
            { <div class="empty-state"><p>Henüz kontrol eylemi girilmemiş.</p></div> }
            else
            {
                @foreach (var c in _risk.Controls)
                {
                    var cid = c.Id;
                    <div style="padding:10px 0;border-bottom:1px solid #f3f4f6">
                        @if (_editControlId == cid)
                        {
                            <div class="form-panel">
                                <div class="form-group">
                                    <label class="form-label">Açıklama</label>
                                    <textarea class="form-control" rows="2" @bind="_editCtrlDesc"></textarea>
                                </div>
                                <div class="meta-grid mg-3" style="margin-bottom:10px">
                                    <div class="form-group" style="margin-bottom:0">
                                        <label class="form-label">Tür</label>
                                        <select class="form-control" @bind="_editCtrlType">
                                            @foreach (var t in _controlTypes) { <option value="@t">@t</option> }
                                        </select>
                                    </div>
                                    <div class="form-group" style="margin-bottom:0">
                                        <label class="form-label">Etkinlik</label>
                                        <select class="form-control" @bind="_editCtrlEff">
                                            <option value="">—</option>
                                            @foreach (var e in _controlEffectiveness) { <option value="@e">@e</option> }
                                        </select>
                                    </div>
                                    <div class="form-group" style="margin-bottom:0">
                                        <label class="form-label">Sıklık</label>
                                        <select class="form-control" @bind="_editCtrlFreq">
                                            <option value="">—</option>
                                            @foreach (var f in _controlFrequencies) { <option value="@f">@f</option> }
                                        </select>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Kontrol Sahibi Departman</label>
                                    <select class="form-control" @bind="_editCtrlOwnerId">
                                        <option value="0">—</option>
                                        @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                                    </select>
                                </div>
                                <div style="display:flex;gap:6px">
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveEditControl(cid)">Kaydet</button>
                                    <button class="btn btn-outline btn-sm" @onclick="() => _editControlId = 0">İptal</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex;gap:12px;align-items:flex-start">
                                <div style="flex:1">
                                    <div style="font-size:13px">@c.Description</div>
                                    <div style="margin-top:3px;display:flex;gap:6px;flex-wrap:wrap">
                                        <span class="tag">@c.ControlType</span>
                                        @if (!string.IsNullOrEmpty(c.Effectiveness)) { <span class="badge badge-green">@c.Effectiveness</span> }
                                        @if (!string.IsNullOrEmpty(c.Frequency))    { <span class="badge badge-blue">@c.Frequency</span> }
                                        @if (c.OwnerDept != null) { <span class="badge badge-orange">@c.OwnerDept.Name</span> }
                                        <span style="font-size:11px;color:#9ca3af">· @c.EnteredBy?.FullName</span>
                                    </div>
                                </div>
                                @if (IsOwner || IsRiskManager)
                                {
                                    <div style="display:flex;gap:4px">
                                        <button class="btn btn-outline btn-sm" @onclick="() => StartEditControl(c)">Düzenle</button>
                                        <button class="btn btn-ghost-danger btn-sm" @onclick="() => AskDeleteControl(cid)">Sil</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
            </div> } @* end expanded[4] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 6 — Kalan Risk Değerlendirmesi
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[5]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(5)">
                <div class="card-title">@CardDot(5)<span class="section-title" style="margin-bottom:0">6. Kalan Risk Değerlendirmesi</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsRiskManager && _residual != null)
                    { <button class="btn btn-outline btn-sm" @onclick="ToggleResidualForm">Güncelle</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[5]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[5]) { <div style="margin-top:14px">

            @if (_residual != null)
            { <div style="margin-bottom:16px"><EvalBox Eval="_residual" Label="Kalan Risk" /></div> }
            else
            { <div class="empty-state" style="margin-bottom:0"><p>Henüz kalan risk değerlendirmesi yapılmamış.</p></div> }

            @if (_showResidual || (IsRiskManager && _residual == null))
            {
                <div style="border-top:1px solid var(--border);padding-top:14px">
                    <div class="section-title">Fine-Kinney Formu (Kalan Risk)</div>
                    <FineKinneyForm EvalType="residual" OnSubmit="HandleEval" Loading="_loading" />
                    @if (_residual != null) { <button class="btn btn-outline btn-sm" style="margin-top:8px" @onclick="() => _showResidual = false">İptal</button> }
                </div>
            }
            </div> } @* end expanded[5] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 7 — Aksiyonlar
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[6]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(6)">
                <div class="card-title">@CardDot(6)<span class="section-title" style="margin-bottom:0">7. Aksiyon Planları</span></div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if ((IsOwner || IsRiskManager) && _risk?.Status != "risk_accepted")
                    { <button class="btn btn-outline btn-sm" @onclick="OpenActionForm">@(_showAction ? "İptal" : "+ Aksiyon Ekle")</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[6]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[6]) { <div style="margin-top:14px">

            @if (_showAction)
            {
                <div class="form-panel">
                    <div class="form-group">
                        <label class="form-label">Açıklama *</label>
                        <textarea class="form-control" rows="2" @bind="_actDesc"></textarea>
                    </div>
                    <div class="meta-grid mg-2">
                        <div class="form-group">
                            <label class="form-label">Sorumlu Departman *</label>
                            <select class="form-control" @bind="_actOwnerId">
                                <option value="0">— Seçiniz —</option>
                                @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Hedef Tarih</label>
                            <input type="date" class="form-control" @bind="_actDue" />
                        </div>
                    </div>
                    <button class="btn btn-success btn-sm" @onclick="SaveAction" disabled="@_loading">Kaydet</button>
                </div>
            }

            @if (!_risk!.ActionPlans.Any())
            { <div class="empty-state"><p>Henüz aksiyon planı girilmemiş.</p></div> }
            else
            {
                @foreach (var a in _risk.ActionPlans)
                {
                    var aid = a.Id;
                    <div style="padding:12px 0;border-bottom:1px solid #f3f4f6">
                        @if (_editActionId == aid)
                        {
                            <div class="form-panel">
                                <div class="form-group">
                                    <label class="form-label">Açıklama</label>
                                    <textarea class="form-control" rows="2" @bind="_editActDesc"></textarea>
                                </div>
                                <div class="meta-grid mg-2" style="margin-bottom:10px">
                                    <div class="form-group" style="margin-bottom:0">
                                        <label class="form-label">Sorumlu Departman</label>
                                        <select class="form-control" @bind="_editActOwnerId">
                                            <option value="0">—</option>
                                            @foreach (var d in _departments) { <option value="@d.Id">@d.Name</option> }
                                        </select>
                                    </div>
                                    <div class="form-group" style="margin-bottom:0">
                                        <label class="form-label">Hedef Tarih</label>
                                        <input type="date" class="form-control" @bind="_editActDue" />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Kapanış Notu <span style="font-size:11px;color:var(--text-3)">(opsiyonel)</span></label>
                                    <textarea class="form-control" rows="2" @bind="_fClosureNote" placeholder="Aksiyon tamamlandığında ne yapıldı?"></textarea>
                                </div>
                                <div style="display:flex;gap:6px">
                                    <button class="btn btn-success btn-sm" @onclick="() => SaveEditAction(aid)">Kaydet</button>
                                    <button class="btn btn-outline btn-sm" @onclick="() => _editActionId = 0">İptal</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            var isOverdue = a.DueDate.HasValue && a.DueDate.Value < DateOnly.FromDateTime(DateTime.Today) && a.Status is not "completed" and not "cancelled";
                            <div style="display:flex;gap:12px;align-items:flex-start">
                                <div style="flex:1">
                                    <div style="font-size:13px;margin-bottom:4px">@a.Description</div>
                                    <div style="font-size:12px;color:var(--text-3);display:flex;gap:8px;flex-wrap:wrap">
                                        @if (a.OwnerDept != null) { <span>@a.OwnerDept.Name</span> }
                                        @if (a.DueDate.HasValue)
                                        {
                                            <span style="@(isOverdue ? "color:#dc2626;font-weight:600" : "")">
                                                Hedef: @a.DueDate
                                            </span>
                                            @if (isOverdue) { <span class="overdue-badge-late">GECİKTİ</span> }
                                        }
                                        <span>· @a.CreatedBy?.FullName</span>
                                        @if (a.CompletedAt.HasValue) { <span style="color:#16a34a">@a.CompletedAt.Value.ToLocalTime().ToString("dd.MM.yyyy")</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(a.ClosureNote))
                                    {
                                        <div style="margin-top:4px;font-size:12px;color:#16a34a;background:#f0fdf4;padding:4px 8px;border-radius:4px;border:1px solid #bbf7d0">
                                            <strong>Kapanış:</strong> @a.ClosureNote
                                        </div>
                                    }
                                    @if (isOverdue)
                                    {
                                        @if (!string.IsNullOrEmpty(a.DelayReason))
                                        {
                                            <div style="margin-top:4px;font-size:12px;color:#92400e;background:#fffbeb;padding:4px 8px;border-radius:4px;border:1px solid #fcd34d">
                                                <strong>Gecikme nedeni:</strong> @a.DelayReason
                                                @if (IsOwner || IsRiskManager)
                                                {
                                                    <button class="btn btn-ghost btn-sm" style="font-size:11px;padding:0 6px;margin-left:6px"
                                                            @onclick="() => OpenDelayEdit(a, a.DelayReason)">Düzenle</button>
                                                }
                                            </div>
                                        }
                                        else if (IsOwner || IsRiskManager)
                                        {
                                            <div style="margin-top:4px">
                                                <button class="btn btn-ghost btn-sm" style="font-size:11px;color:#dc2626;padding:0;text-decoration:underline"
                                                        @onclick="() => OpenDelayEdit(a, string.Empty)">
                                                    Gecikme nedeni gir
                                                </button>
                                            </div>
                                        }
                                        @if (_editDelayActionId == aid)
                                        {
                                            <div style="margin-top:6px;background:#fffbeb;padding:10px;border-radius:6px;border:1px solid #fcd34d">
                                                <div class="form-group" style="margin-bottom:6px">
                                                    <label class="form-label" style="font-size:12px">Gecikme Nedeni</label>
                                                    <textarea class="form-control" rows="2" style="font-size:12px"
                                                              @bind="_delayReasonDraft"
                                                              placeholder="Aksiyonun neden geciktiğini açıklayın…"></textarea>
                                                </div>
                                                <div style="display:flex;gap:6px">
                                                    <button class="btn btn-warning btn-sm" style="font-size:12px" @onclick="() => SaveDelayReason(a)">Kaydet</button>
                                                    <button class="btn btn-outline btn-sm" style="font-size:12px" @onclick="() => _editDelayActionId = 0">İptal</button>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <div style="display:flex;gap:4px;align-items:center;flex-wrap:wrap">
                                    <span class="badge @ActionBadge(a.Status)">@ActionLabel(a.Status)</span>
                                    @if ((IsOwner || IsRiskManager) && a.Status is not "completed" and not "cancelled")
                                    {
                                        <button class="btn btn-outline btn-sm" @onclick="() => StartEditAction(a)">Düzenle</button>
                                        <button class="btn btn-success btn-sm" @onclick='() => UpdateAction(aid, "completed")'>Tamamlandı</button>
                                    }
                                    @if (IsOwner || IsRiskManager)
                                    { <button class="btn btn-ghost-danger btn-sm" @onclick="() => AskDeleteAction(aid)">Sil</button> }
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @* Kalıntı riski kabul et / kabul edildi göstergesi *@
            <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">
                @if (_risk.Status == "risk_accepted")
                {
                    <div style="display:flex;align-items:center;gap:8px;background:#f0fdf4;padding:10px 14px;border-radius:8px;border:1px solid #86efac">
                        <span style="font-size:13px;font-weight:600;color:#166534">Kalıntı Risk Kabul Edildi</span>
                        @if (!string.IsNullOrEmpty(_risk.AcceptanceReason))
                        { <span style="font-size:12px;color:#166534;opacity:.8">— @_risk.AcceptanceReason</span> }
                    </div>
                }
                else if (IsCommittee || IsRiskManager)
                {
                    <button class="btn @(_showAccept ? "btn-outline" : "btn-success") btn-sm"
                            @onclick="() => _showAccept = !_showAccept">
                        Kalıntı Riski Kabul Et
                    </button>
                    @if (_showAccept)
                    {
                        <div style="margin-top:10px;background:#f0fdf4;padding:12px;border-radius:8px;border:1px solid #bbf7d0">
                            <div class="form-group">
                                <label class="form-label">Kabul Gerekçesi</label>
                                <textarea class="form-control" rows="3" @bind="_acceptReason" placeholder="Kalıntı riski kabul etme gerekçenizi yazın…"></textarea>
                            </div>
                            <div style="display:flex;gap:8px">
                                <button class="btn btn-success btn-sm" @onclick="AcceptRisk">Onayla ve Kapat</button>
                                <button class="btn btn-outline btn-sm" @onclick="() => _showAccept = false">İptal</button>
                            </div>
                        </div>
                    }
                }
            </div>
            </div> } @* end expanded[6] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 8 — Gözden Geçirmeler (Komite Onay Mercii)
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[7]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(7)">
                <div class="card-title">
                    @CardDot(7)
                    <div>
                        <div class="section-title" style="margin-bottom:1px">8. Komite Gözden Geçirme</div>
                        <div style="font-size:11px;color:var(--text-3)">Riskin Erken Tespiti Komitesi toplantı kayıtları</div>
                    </div>
                </div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsCommittee)
                    { <button class="btn btn-outline btn-sm" @onclick="() => _showReview = !_showReview">@(_showReview ? "İptal" : "+ Ekle")</button> }
                    </div><span class="card-chevron" style="transform:rotate(@(_expanded[7]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[7]) { <div style="margin-top:14px">
            @if (_showReview)
            {
                <div class="form-panel">
                    <div class="form-group">
                        <label class="form-label">Toplantı Tarihi *</label>
                        <input type="date" class="form-control" style="max-width:200px"
                               value="@(_reviewMeetingDate?.ToString("yyyy-MM-dd") ?? "")"
                               @onchange="e => _reviewMeetingDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : (DateTime?)DateTime.Parse(e.Value.ToString()!)" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Komite Kararları * <span style="font-weight:400;color:var(--text-3);font-size:11px">(aynı toplantıda alınan kararları madde madde ekleyin)</span></label>
                        @for (int i = 0; i < _reviewItems.Count; i++)
                        {
                            var idx = i;
                            <div style="display:flex;gap:8px;align-items:flex-start;margin-bottom:8px">
                                <span style="font-weight:700;font-size:13px;padding-top:9px;min-width:24px;color:var(--text-3)">@(idx + 1).</span>
                                <textarea class="form-control" rows="2" style="flex:1"
                                          placeholder="Karar maddesi…"
                                          @bind="_reviewItems[idx]"></textarea>
                                @if (_reviewItems.Count > 1)
                                {
                                    <button type="button" class="btn btn-ghost-danger btn-sm" style="padding:6px 10px"
                                            @onclick="() => RemoveReviewItem(idx)" title="Maddeyi sil" aria-label="Maddeyi sil"><Icon Name="close" Size="14" /></button>
                                }
                            </div>
                        }
                        <button type="button" class="btn btn-outline btn-sm" @onclick="AddReviewItem">+ Madde Ekle</button>
                    </div>
                    <button class="btn btn-success btn-sm" @onclick="SaveReviewAsync"
                            disabled="@(_reviewMeetingDate == null || !_reviewItems.Any(s => !string.IsNullOrWhiteSpace(s)) || _savingReview)">
                        @(_savingReview ? "Kaydediliyor…" : "Kaydet")
                    </button>
                </div>
            }

            @if (!_risk!.Reviews.Any())
            { <div class="empty-state"><p>Henüz gözden geçirme kaydı yok.</p></div> }
            else
            {
                @foreach (var rv in _risk.Reviews.OrderByDescending(r => r.MeetingDate))
                {
                    var rvInit = _risk.Evaluations.Where(e => e.EvalType=="initial"  && e.EvaluatedAt<=rv.MeetingDate).OrderByDescending(e=>e.EvaluatedAt).FirstOrDefault();
                    var rvRes  = _risk.Evaluations.Where(e => e.EvalType=="residual" && e.EvaluatedAt<=rv.MeetingDate).OrderByDescending(e=>e.EvaluatedAt).FirstOrDefault();
                    <div style="padding:14px 0;border-bottom:1px solid #f3f4f6">
                        <div style="display:grid;grid-template-columns:140px 1fr auto;gap:16px;align-items:start">
                            <div>
                                <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--text-3);margin-bottom:2px">Toplantı Tarihi</div>
                                <div style="font-weight:700;font-size:14px">@rv.MeetingDate.ToLocalTime().ToString("dd.MM.yyyy")</div>
                                <div style="font-size:11px;color:var(--text-3);margin-top:4px">Kaydeden: @rv.CreatedBy?.FullName</div>
                            </div>
                            <div>
                                @{ var decisionItems = rv.GetDecisionItemsList(); }
                                @if (decisionItems.Count > 0)
                                {
                                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--text-3);margin-bottom:4px">@(decisionItems.Count > 1 ? "Kararlar" : "Karar")</div>
                                    @if (decisionItems.Count == 1)
                                    {
                                        <div style="font-size:13px;font-weight:600;margin-bottom:8px">@decisionItems[0]</div>
                                    }
                                    else
                                    {
                                        <ol style="font-size:13px;font-weight:600;margin:0 0 8px 0;padding-left:20px">
                                            @foreach (var item in decisionItems)
                                            { <li style="margin-bottom:4px">@item</li> }
                                        </ol>
                                    }
                                }
                                <div style="display:flex;gap:8px;flex-wrap:wrap">
                                    @if (rvInit != null)
                                    { <span style="font-size:11px;padding:3px 10px;border-radius:20px;background:#fee2e2;color:@RiskCalc.GetRiskLevelColor(rvInit.RiskLevel);font-weight:600">İlk: @rvInit.Score · @rvInit.RiskLevel</span> }
                                    @if (rvRes != null)
                                    { <span style="font-size:11px;padding:3px 10px;border-radius:20px;background:#dcfce7;color:@RiskCalc.GetRiskLevelColor(rvRes.RiskLevel);font-weight:600">Kalan: @rvRes.Score · @rvRes.RiskLevel</span> }
                                </div>
                            </div>
                            @if (IsCommittee)
                            { <button class="btn btn-ghost-danger btn-sm" @onclick="() => AskDeleteReview(rv.Id)">Sil</button> }
                        </div>
                    </div>
                }
            } </div> } @* end expanded[7] *@
        </div>

        @* ════════════════════════════════════════════════════════
           KART 9 — İlgili Denetim Bulguları
        ════════════════════════════════════════════════════════ *@
        <div class="card card-section" style="padding-bottom:@(_expanded[8]?"18px":"2px")">
            <div class="card-hdr" @onclick="() => ToggleCard(8)">
                <div class="card-title">
                    <div>
                        <div class="section-title" style="margin-bottom:1px">9. İlgili Denetim Bulguları</div>
                        <div style="font-size:11px;color:var(--text-3)">Bu riskle ilişkilendirilmiş denetim bulguları</div>
                    </div>
                </div>
                <div style="display:flex;gap:8px;align-items:center" @onclick:stopPropagation="true">
                    @if (IsRiskManager || IsOwner)
                    { <button class="btn btn-outline btn-sm" @onclick="() => _showLinkFinding = !_showLinkFinding">@(_showLinkFinding?"İptal":"+ Bulgu Bağla")</button> }
                </div>
                <span class="card-chevron" style="transform:rotate(@(_expanded[8]?"180deg":"0deg"))">▼</span>
            </div>
            @if (_expanded[8]) { <div style="margin-top:14px">
            @if (_showLinkFinding)
            {
                <div class="form-panel" style="margin-bottom:12px">
                    <div class="form-group">
                        <label class="form-label">Bulgu Ara</label>
                        <input class="form-control" placeholder="Bulgu kodu veya başlık…"
                               @bind="_findingSearch" @bind:event="oninput" />
                    </div>
                    @{
                        var matchedFindings = _allFindings
                            .Where(f => !_risk!.FindingLinks.Any(l => l.FindingId == f.Id))
                            .Where(f => string.IsNullOrEmpty(_findingSearch) ||
                                        f.Code.Contains(_findingSearch, StringComparison.OrdinalIgnoreCase) ||
                                        f.Title.Contains(_findingSearch, StringComparison.OrdinalIgnoreCase))
                            .Take(8).ToList();
                    }
                    @if (matchedFindings.Any())
                    {
                        <div style="display:flex;flex-direction:column;gap:6px;margin-top:8px">
                            @foreach (var f in matchedFindings)
                            {
                                var fid = f.Id;
                                <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 12px;border:1px solid var(--border);border-radius:8px;font-size:13px">
                                    <span><code style="color:#1e40af;font-size:12px">@f.Code</code> — @f.Title</span>
                                    <button class="btn btn-outline btn-sm" style="padding:2px 10px;font-size:11px"
                                            @onclick="() => LinkFinding(fid)">Bağla</button>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_findingSearch))
                    { <div style="font-size:12px;color:var(--text-3);margin-top:8px">Sonuç bulunamadı</div> }
                </div>
            }
            @if (!_risk!.FindingLinks.Any())
            { <div class="empty-state"><p>Bu riskle ilişkilendirilmiş denetim bulgusu yok.</p></div> }
            else
            {
                <div style="display:flex;flex-direction:column;gap:6px">
                    @foreach (var link in _risk.FindingLinks)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border:1px solid var(--border);border-radius:10px">
                            <a href="/audit/findings/@link.FindingId" style="display:flex;align-items:center;gap:8px;text-decoration:none;color:inherit">
                                <code style="color:#1e40af;font-size:12px;font-weight:600">@link.Finding.Code</code>
                                <span style="font-size:13px">@link.Finding.Title</span>
                                <span class="badge badge-gray" style="font-size:10px">@(link.Finding.Status switch { "open" => "Açık", "closure_requested" => "Kapanış Bekleyen", "closed" => "Kapalı", _ => link.Finding.Status })</span>
                            </a>
                            @if (IsRiskManager || IsOwner)
                            {
                                var lid = link.Id;
                                <button class="btn btn-outline btn-sm" style="padding:2px 8px;font-size:11px;color:#dc2626"
                                        @onclick="() => UnlinkFinding(lid)">Kaldır</button>
                            }
                        </div>
                    }
                </div>
            }
            </div> } @* end expanded[8] *@
        </div>

        @* KART 10 — Tarihçe (RiskHistoryCard componenti) *@
        <RiskHistoryCard Logs="_risk!.AuditLogs"
                         Expanded="_expanded[9]"
                         Number="10"
                         OnToggle="@(() => ToggleCard(9))" />

        <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border);display:flex;justify-content:flex-start">
            <a href="/risk" class="btn btn-outline">← Risk Envanterine Dön</a>
        </div>

        @if (_lastLog != null)
        {
            <div class="last-modified-bar">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/></svg>
                Son değişiklik:
                <strong>@(_lastLog.User?.FullName ?? "Sistem")</strong>
                —
                @_lastLog.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                @if (!string.IsNullOrEmpty(_lastLog.Action))
                { <span style="color:var(--text-3)">· @_lastLog.Action</span> }
            </div>
        }
    </div>
}

<style>
    .empty-val    { font-size:12px;color:var(--text-3) }
    .card-hdr     { display:flex;justify-content:space-between;align-items:center;cursor:pointer;user-select:none;margin-bottom:0 }
    .card-hdr:hover .card-title { opacity:.8 }
    .card-title   { display:flex;align-items:center;gap:10px }
    .card-chevron { font-size:11px;color:var(--text-3);transition:transform .2s }
    .cs-dot       { width:10px;height:10px;border-radius:50%;flex-shrink:0 }
</style>

<ConfirmModal Visible="_confirmVisible"
              Title="@_confirmTitle"
              Message="@_confirmMessage"
              Icon=""
              ConfirmLabel="Evet, Sil"
              OnConfirm="ExecuteConfirmedDelete"
              OnCancel="@(() => _confirmVisible = false)" />

@code {
    // Kontrol ve aksiyon state/metodları → RiskDetail.Controls.cs / RiskDetail.Actions.cs partial sınıflarında

    [Parameter] public int Id { get; set; }

    private RiskManagement.Models.Risk? _risk;
    private Evaluation? _initial, _residual;
    private int? _prevId, _nextId;

    // Kontrol state → RiskDetail.Controls.cs partial class
    // Aksiyon state  → RiskDetail.Actions.cs  partial class

    private bool _showEval, _showResidual, _showReject, _showMeta, _showFields, _showReview;
    private bool _loading;

    private string _error = "";

    // Risk–Denetim Çapraz Link
    private List<RiskManagement.Models.AuditFinding> _allFindings = [];
    private bool   _showLinkFinding;
    private string _findingSearch = "";

    // Silme onay modal
    private bool   _confirmVisible;
    private string _confirmTitle = "", _confirmMessage = "";
    private Func<Task>? _confirmedAction;
    private string _rejectReason = "";
    private int _metaOrgId;
    private int _metaDeptId;
    private int _metaOwnerId;
    private string _metaStrategy = "";
    private List<Department> _metaFilteredDepts = [];

    // Detay alanları
    private static readonly string[] _allAffected = ["Hasta","Çalışanlar","Üst Yönetim","Sermayedarlar","Tedarikçiler","Paydaşlar"];
    private HashSet<string> _selectedAffected = [];
    private string _fCategory = "", _fSourceType = "internal", _fSource = "", _fHazard = "", _fPossibleImpact = "", _fLegislation = "", _fActivityArea = "";

    // Accordion (index 0-9: kartlar 1-8 → 0-7, kart 9 → 8, kart 10 → 9)
    private bool[] _expanded = new bool[10]; // Clone pattern ile güncelleniyor — Blazor değişimi algılasın

    // Gözden geçirme
    private DateTime? _reviewMeetingDate;
    private List<string> _reviewItems = [""];
    private bool _savingReview;

    private void AddReviewItem() => _reviewItems.Add("");
    private void RemoveReviewItem(int idx) { if (idx >= 0 && idx < _reviewItems.Count) _reviewItems.RemoveAt(idx); if (_reviewItems.Count == 0) _reviewItems.Add(""); }

    // Risk detay alanı görünürlüğü — eksik anahtarlarda KeyNotFoundException atmaması için varsayılan görünür.
    private bool FieldVisible(string key) => !_fieldVisible.TryGetValue(key, out var v) || v;

    private List<Department> _departments = [];
    private List<Organization> _organizations = [];
    private string[] _riskStrategies = [], _controlTypes = [], _controlEffectiveness = [], _controlFrequencies = [];
    private Dictionary<string, bool> _fieldVisible = [];

    private List<User> _allUsers = []; // tarihçede kullanılmıyor ama namespace için
    private RiskAuditLog? _lastLog;

    private static readonly string[] _steps =
        ["Öneri","Detaylar","İlk Değerlendirme","Strateji","Kontroller","Kalan Risk","Aksiyon","Gözden Geçirme"];

    private void InitExpanded()
    {
        _expanded = new bool[10];
        var active = _risk?.Status switch
        {
            "proposed" or "under_review"
                or "awaiting_approval"   => 0,  // Risk Önerisi
            "approved"                   => _initial != null ? 3 : 2,  // Değerlendirme yapıldıysa → Strateji, yoksa → İlk Değerlendirme
            "strategy_set"               => 3,  // Strateji & Sorumluluk
            "controlled"                 => 4,  // Kontroller
            "residual_evaluated"         => 5,  // Kalan Risk
            "action_planned"             => 6,  // Aksiyon Planları
            "risk_accepted" or "rejected"=> 0,
            _                            => 0
        };
        _expanded[active] = true;
        OnCardExpanded(active);
    }

    private void ToggleCard(int i)
    {
        // Yeni array oluştur — Blazor array mutation'ını her zaman algılamaz
        var arr = (bool[])_expanded.Clone();
        arr[i] = !arr[i];
        _expanded = arr;
        if (_expanded[i]) OnCardExpanded(i);
    }

    private void OnCardExpanded(int i)
    {
        switch (i)
        {
            case 1:
                if ((IsOwner || IsRiskManager) && !HasRiskDetailData) _showFields = true;
                break;
            case 2:
                if (IsRiskManager && _initial == null) _showEval = true;
                break;
            case 3:
                if (IsRiskManager && !HasMeta && !_showMeta)
                { _showMeta = true; _metaOrgId = _risk?.OrganizationId ?? 0; _metaDeptId = _risk?.DepartmentId ?? 0; _metaStrategy = _risk?.RiskStrategy ?? ""; RefreshMetaDepts(); }
                break;
            case 4:
                if ((IsOwner || IsRiskManager) && !_risk!.Controls.Any()) _showControl = true;
                break;
            case 5:
                if (IsRiskManager && _residual == null) _showResidual = true;
                break;
            case 6:
                if ((IsOwner || IsRiskManager) && !_risk!.ActionPlans.Any()) _showAction = true;
                break;
        }
    }

    private bool HasRiskDetailData => _risk != null &&
        (_risk.Source != null || _risk.Hazard != null || _risk.PossibleImpact != null || _risk.ActivityArea != null);

    // Kart tamamlanma durumu: 2=complete(yeşil), 1=warning(sarı), 0=neutral(gri)
    private int CardStatus(int i) => i switch
    {
        0 => _risk!.Status != "proposed" ? 2 : 0,
        1 => _risk!.Source != null || _risk.Hazard != null || _risk.PossibleImpact != null || _risk.ActivityArea != null ? 2 : 0,
        2 => _initial != null ? 2 : 0,
        3 => HasMeta ? 2 : 0,
        4 => _risk!.Controls.Any() ? 2 : 0,
        5 => _residual != null ? 2 : 0,
        6 => _risk!.ActionPlans.Any() ? 2 : 0,
        7 => _risk!.Reviews.Any() ? 2 : 0,
        _ => 0
    };

    private RenderFragment CardDot(int i) => b =>
    {
        var cs = CardStatus(i);
        b.OpenElement(0, "span");
        b.AddAttribute(1, "class", "icon");
        b.AddAttribute(2, "style", cs == 2 ? "color:#16a34a" : "color:#94a3b8");
        b.AddAttribute(3, "aria-hidden", "true");
        b.AddMarkupContent(4, cs == 2
            ? "<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6 9 17l-5-5\"/></svg>"
            : "<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/></svg>");
        b.CloseElement();
    };

    private static int StepIndex(string s) => s switch
    {
        "proposed"=>0,"under_review"=>1,"approved"=>2,"strategy_set"=>3,
        "controlled"=>4,"residual_evaluated"=>5,"action_planned"=>6,
        "risk_accepted"=>8, // tüm adımlar OK
        _=>0
    };

    private IEnumerable<string> UserRoles =>
        HttpCtx.HttpContext?.User.FindAll(ClaimTypes.Role).Select(c => c.Value) ?? Enumerable.Empty<string>();
    private string Role => UserRoles.FirstOrDefault() ?? "";

    private static string RelativeDate(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt;
        if (diff.TotalMinutes < 2)  return "Az önce";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} dk önce";
        if (diff.TotalHours < 24)   return $"{(int)diff.TotalHours} sa önce";
        if (diff.TotalDays < 7)     return $"{(int)diff.TotalDays} gün önce";
        if (diff.TotalDays < 30)    return $"{(int)(diff.TotalDays / 7)} hafta önce";
        if (diff.TotalDays < 365)   return $"{(int)(diff.TotalDays / 30)} ay önce";
        return dt.ToLocalTime().ToString("dd.MM.yyyy");
    }

    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private bool IsThisRiskOwner => _risk?.OwnerId == UserId && UserId > 0;
    private bool IsCommittee   => UserRoles.Any(r => r == Roles.Committee || r == Roles.Admin);
    private bool IsRiskManager => UserRoles.Any(r => r == Roles.RiskManager || r == Roles.Admin) || IsThisRiskOwner;
    private bool IsOwner       => UserRoles.Any(r => r == Roles.RiskOwner   || r == Roles.Admin) || IsThisRiskOwner;
    private bool HasMeta     => (_risk?.OrganizationId != null || _risk?.DepartmentId != null) && !string.IsNullOrEmpty(_risk?.RiskStrategy);

    private User? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = Auth.ActiveUserFromPrincipal(HttpCtx.HttpContext?.User);
        await LoadAsync();
        LoadLinkableFindings();
        _departments         = await Db.Departments.OrderBy(d => d.Name).ToListAsync();
        _organizations       = await Db.Organizations.Include(o => o.Company).OrderBy(o => o.Name).ToListAsync();
        _allUsers            = await Db.Users.Where(u => u.IsActive).OrderBy(u => u.FullName).ToListAsync();
        _riskStrategies      = CfgSvc.GetList("risk_strategies");
        _controlTypes        = CfgSvc.GetList("control_types");
        _controlEffectiveness= CfgSvc.GetList("control_effectiveness");
        _controlFrequencies  = CfgSvc.GetList("control_frequencies");
        _fieldVisible        = CfgSvc.GetRiskDetailFields();
    }

    private async Task LoadAsync()
    {
        _risk = await RiskSvc.GetByIdForUserAsync(Id, UserId, Role);
        ApplyLoadedRisk();
    }

    // Kaydet işlemleri sonrası sync yenileme için
    private void Load()
    {
        _risk = RiskSvc.GetByIdForUser(Id, UserId, Role);
        if (_allFindings.Count == 0)
            LoadLinkableFindings();
        ApplyLoadedRisk();
    }

    private void ApplyLoadedRisk()
    {
        if (_risk == null) { Nav.NavigateTo("/risk"); return; }
        _initial  = _risk.Evaluations.FirstOrDefault(e => e.EvalType == EvalType.Initial);
        _residual = _risk.Evaluations.FirstOrDefault(e => e.EvalType == EvalType.Residual);
        (_prevId, _nextId) = RiskSvc.GetAdjacentIds(Id, UserId, Role);
        _fCategory       = _risk.Category ?? "";
        _fSourceType     = _risk.SourceType ?? "internal";
        _fSource         = _risk.Source ?? "";
        _fHazard         = _risk.Hazard ?? "";
        _fPossibleImpact = _risk.PossibleImpact ?? "";
        _fActivityArea   = _risk.ActivityArea ?? "";
        _fLegislation    = _risk.RelevantLegislation ?? "";
        InitExpanded();
        _selectedAffected = [.. _risk.GetAffectedPersonsList()];
        _lastLog = _risk.AuditLogs.OrderByDescending(l => l.Timestamp).FirstOrDefault();
    }

    // Yalnızca kullanıcının erişebildiği bulgular bağlanabilir/aranabilir.
    // _allFindings tüm bulguları açığa çıkarıyordu (Kod+Başlık) — CanAccessFinding ile hizalandı.
    private void LoadLinkableFindings()
    {
        if (_user == null) { _allFindings = []; return; }
        _allFindings = AuditSvc.GetFindingsForUser(_user)
            .Select(f => new RiskManagement.Models.AuditFinding { Id = f.Id, Code = f.Code, Title = f.Title, Status = f.Status })
            .ToList();
    }

    private async Task LinkFinding(int findingId)
    {
        // Erişim guard'ı: yalnızca kullanıcının erişebildiği bir bulgu bağlanabilir.
        if (!_allFindings.Any(f => f.Id == findingId)) return;
        if (Db.RiskFindingLinks.Any(l => l.RiskId == Id && l.FindingId == findingId)) return;
        Db.RiskFindingLinks.Add(new RiskManagement.Models.RiskFindingLink { RiskId = Id, FindingId = findingId, CreatedById = UserId });
        await Db.SaveChangesAsync();
        _findingSearch = ""; Load();
    }

    private async Task UnlinkFinding(int linkId)
    {
        var link = Db.RiskFindingLinks.Find(linkId);
        if (link == null) return;
        Db.RiskFindingLinks.Remove(link);
        await Db.SaveChangesAsync();
        Load();
    }

    private void Notify(string msg, bool error = false)
    {
        if (error) { Toast.Error(msg); _error = msg; }
        else       { Toast.Success(msg); _error = ""; }
    }

    private void ToggleAffected(string p, bool add) { if (add) _selectedAffected.Add(p); else _selectedAffected.Remove(p); }

    private async Task SaveFields()
    {
        await RiskSvc.UpdateRiskFieldsAsync(Id, _fSourceType,
            NullIfBlank(_fSource), NullIfBlank(_fHazard), NullIfBlank(_fPossibleImpact),
            Risk.SerializePersonsList(_selectedAffected),
            NullIfBlank(_fLegislation), null, null, null, _risk?.CurrentStatus, UserId,
            category: NullIfBlank(_fCategory), activityArea: NullIfBlank(_fActivityArea));
        _showFields = false; Notify("Risk detayları güncellendi."); Load();
    }

    private async Task DoStatus(string newStatus, string? reason = null)
    {
        _loading = true;
        var user = _user ?? new User { Id = UserId, Role = Role };
        if (await RiskSvc.UpdateStatusAsync(Id, newStatus, reason, user))
        {
            Notify("Durum güncellendi.");
            Load();
            _showReject = false;
            if (newStatus == "under_review")
            {
                _expanded[0] = false;
                _expanded[1] = true;
                OnCardExpanded(1);
            }
        }
        else Notify("Geçersiz durum geçişi.", true);
        _loading = false;
    }

    private async Task SaveMeta()
    {
        _loading = true;
        await RiskSvc.UpdateMetadataAsync(Id,
            _metaOrgId  > 0 ? _metaOrgId  : null,
            _metaDeptId > 0 ? _metaDeptId : null,
            _metaStrategy, UserId);
        if (_metaOwnerId > 0)
        {
            var user = _user ?? new User { Id = UserId, Role = Role };
            await RiskSvc.AssignOwnerAsync(Id, _metaOwnerId, user);
        }
        Notify("Sorumluluk ve strateji güncellendi."); _showMeta = false;
        Load(); _loading = false;
    }

    private async Task HandleEval(EvalResult r)
    {
        _loading = true;
        await RiskSvc.AddEvaluationAsync(Id, r.EvalType, r.Probability, r.Exposure, r.Consequence, r.Notes, UserId);
        Notify("Değerlendirme kaydedildi.");
        _showEval = false; _showResidual = false;
        Load();
        _loading = false;
        if (r.EvalType == "residual")
        {
            _expanded[5] = false;
            _expanded[6] = true;
            if (IsOwner || IsRiskManager) _showAction = true;
        }
    }

    // Controls ve Actions metodları → RiskDetail.Controls.cs / RiskDetail.Actions.cs partial sınıflarına taşındı

    private void AskDeleteReview(int rid)
    {
        _confirmTitle    = "Gözden geçirmeyi sil";
        _confirmMessage  = "Bu kayıt kalıcı olarak silinecek.";
        _confirmedAction = () => DeleteReview(rid)!;
        _confirmVisible  = true;
    }

    private async Task ExecuteConfirmedDelete()
    {
        _confirmVisible = false;
        if (_confirmedAction != null)
            await _confirmedAction();
        _confirmedAction = null;
    }

    private void AskSetPassive()
    {
        _confirmTitle    = "Riski pasife al";
        _confirmMessage  = "Risk pasife alınacak ve envanter listesinde varsayılan olarak gizlenecek. Daha sonra yeniden aktifleştirebilirsiniz.";
        _confirmedAction = SetPassive;
        _confirmVisible  = true;
    }

    private async Task SetPassive()
    {
        _loading = true;
        if (await RiskSvc.SetActiveAsync(Id, false, UserId)) Notify("Risk pasife alındı.");
        _loading = false;
        Load();
    }

    private async Task SetActive()
    {
        _loading = true;
        if (await RiskSvc.SetActiveAsync(Id, true, UserId)) Notify("Risk yeniden aktifleştirildi.");
        _loading = false;
        Load();
    }

    private async Task AcceptRisk()
    {
        _loading = true;
        try
        {
            if (_user is null) { Notify("Oturum doğrulanamadı.", true); return; }
            var (ok, error) = await RiskSvc.AcceptRiskAsync(Id, _acceptReason, _user);
            if (ok)
            {
                Notify("Kalıntı risk kabul edildi.");
                _showAccept = false;
                Load();
            }
            else
            {
                Notify(error ?? "İşlem gerçekleştirilemedi.", true);
            }
        }
        catch (Exception)
        {
            Notify("Kayıt sırasında bir sorun oluştu. Lütfen tekrar deneyin.", true);
        }
        finally { _loading = false; }
    }

    private void ToggleEvalForm()    => _showEval      = !_showEval;
    private void ToggleResidualForm()=> _showResidual  = !_showResidual;
    private void ToggleRejectForm()  => _showReject    = !_showReject;
    private void ToggleMeta()
    {
        _showMeta = !_showMeta;
        if (_showMeta)
        {
            _metaOrgId    = _risk?.OrganizationId ?? 0;
            _metaDeptId   = _risk?.DepartmentId ?? 0;
            _metaOwnerId  = _risk?.OwnerId ?? 0;
            _metaStrategy = _risk?.RiskStrategy ?? "";
            RefreshMetaDepts();
        }
    }

    private void OnMetaOrgChanged() { _metaDeptId = 0; RefreshMetaDepts(); }

    private void RefreshMetaDepts() =>
        _metaFilteredDepts = _metaOrgId > 0
            ? [.. _departments.Where(d => d.OrganizationId == _metaOrgId)]
            : [.. _departments];


    private async Task SaveReviewAsync()
    {
        var items = _reviewItems.Where(s => !string.IsNullOrWhiteSpace(s)).Select(s => s.Trim()).ToList();
        if (_reviewMeetingDate == null || items.Count == 0) return;
        if (_savingReview) return;
        _savingReview = true;
        StateHasChanged();
        try
        {
            var uid = UserId;
            if (uid <= 0)
            {
                Notify("Oturum bilgisi alınamadı, lütfen sayfayı yenileyin.", true);
                return;
            }
            await RiskSvc.AddReviewAsync(Id, _reviewMeetingDate.Value, null, null, uid, items);
            _showReview = false;
            _reviewMeetingDate = null;
            _reviewItems = [""];
            Notify("Gözden geçirme kaydedildi.");
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Komite kararı kaydedilemedi: RiskId={Id}", Id);
            Notify("Kayıt sırasında bir sorun oluştu. Lütfen tekrar deneyin.", true);
            return;
        }
        finally
        {
            _savingReview = false;
        }
        Load();
    }

    private async Task DeleteReview(int rid) { await RiskSvc.DeleteReviewAsync(rid, UserId); Notify("Gözden geçirme silindi."); Load(); }

    private static string? NullIfBlank(string s) => string.IsNullOrWhiteSpace(s) ? null : s;


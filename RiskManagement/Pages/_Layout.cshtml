@using Microsoft.AspNetCore.Components.Web
@namespace RiskManagement.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Risk Yönetim Sistemi</title>
    <base href="~/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/tokens.css?v=5" />
    <link rel="stylesheet" href="css/layout.css?v=5" />
    <link rel="stylesheet" href="css/components.css?v=5" />
    <link rel="stylesheet" href="css/domain.css?v=5" />
    <link rel="stylesheet" href="RiskManagement.styles.css" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <!-- Bağlantı durumu banner'ı -->
    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-content">
            <div class="reconnect-spinner"></div>
            <div>
                <div class="reconnect-title">Yeniden bağlanıyor…</div>
                <div class="reconnect-sub">Ağ bağlantısı geçici olarak kesildi. Lütfen bekleyin.</div>
            </div>
        </div>
    </div>

    <div id="blazor-error-ui">
        <span>Bağlantı kesildi.</span>
        <a href="" class="reload">Sayfayı Yenile</a>
        <a class="dismiss">✕</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script>
        // Reconnect modal durumunu yönet
        (function () {
            const modal = document.getElementById('components-reconnect-modal');
            if (!modal) return;
            const observer = new MutationObserver(() => {
                const cls = modal.className;
                if (cls.includes('components-reconnect-show')) {
                    modal.style.display = 'flex';
                } else {
                    modal.style.display = 'none';
                }
            });
            observer.observe(modal, { attributes: true, attributeFilter: ['class'] });

            // Base64 içerik olarak dosya indirme yardımcısı (Blazor Server export)
            window.downloadFileFromBase64 = function (fileName, base64, mimeType) {
                try {
                    var bytes = atob(base64);
                    var arr = new Uint8Array(bytes.length);
                    for (var i = 0; i < bytes.length; i++) arr[i] = bytes.charCodeAt(i);
                    var blob = new Blob([arr], { type: mimeType || 'application/octet-stream' });
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url; a.download = fileName; document.body.appendChild(a);
                    a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
                } catch (e) { console.error('downloadFileFromBase64 hatası:', e); }
            };

            // Sayfa geçişinde ana içeriğe fokus — ekran okuyucu navigasyon
            window.focusMain = function () {
                const el = document.getElementById('main-content');
                if (!el) return;
                if (!el.hasAttribute('tabindex')) el.setAttribute('tabindex', '-1');
                el.focus({ preventScroll: true });
            };

            // Modal fokus trap — Tab/Shift+Tab modalın dışına çıkmasını engeller
            window.trapFocus = function (dialogId) {
                const dialog = document.getElementById(dialogId);
                if (!dialog) return;
                const sel = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
                const nodes = Array.from(dialog.querySelectorAll(sel));
                if (!nodes.length) return;
                nodes[0].focus();
                dialog._trapHandler = function (e) {
                    if (e.key !== 'Tab') return;
                    const first = nodes[0], last = nodes[nodes.length - 1];
                    if (e.shiftKey) { if (document.activeElement === first) { last.focus(); e.preventDefault(); } }
                    else { if (document.activeElement === last) { first.focus(); e.preventDefault(); } }
                };
                dialog.addEventListener('keydown', dialog._trapHandler);
            };
            window.releaseFocus = function (dialogId) {
                const dialog = document.getElementById(dialogId);
                if (dialog && dialog._trapHandler) dialog.removeEventListener('keydown', dialog._trapHandler);
            };

            // Enter tuşuyla form submit — key formlar için global
            document.addEventListener('keydown', function (e) {
                if (e.key !== 'Enter' || e.shiftKey) return;
                const active = document.activeElement;
                if (!active) return;
                // Textarea değilse ve form içindeyse primary butonu tıkla
                if (active.tagName === 'TEXTAREA') return;
                const form = active.closest('.card, .modal-content, [data-enter-submit]');
                if (!form) return;
                const btn = form.querySelector('button.btn-primary:not([disabled])');
                if (btn) { e.preventDefault(); btn.click(); }
            });
        })();
    </script>
</body>
</html>

@page "/pending"
@attribute [Authorize]
@inject TaskService TaskSvc
@inject AuthService Auth
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@using System.Security.Claims
@using RiskManagement.Models

<PageTitle>Bekleyen İşler</PageTitle>

<div class="page-header">
    <div>
        <h1>Bekleyen İşler</h1>
        <div class="page-toolbar-sub">
            @if (_tasks.Count == 0)
            { <span>Bekleyen işiniz yok.</span> }
            else
            { <span><strong>@_tasks.Count</strong> görev bekliyor</span> }
        </div>
    </div>
    <a href="/workflows" class="btn btn-outline btn-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/></svg>
        İş Akış Şemaları
    </a>
</div>

@{
    var urgentTasks = _tasks.Where(t => t.Priority == "urgent").ToList();
    var normalTasks = _tasks.Where(t => t.Priority != "urgent").ToList();
}

@if (_tasks.Count == 0)
{
    <div class="card" style="padding:48px">
        <div class="empty-state">
            <div class="empty-state-icon-wrap">
                <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="var(--gray-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="empty-state-title">Tüm işler tamamlandı</div>
            <div class="empty-state-sub">Şu an bekleyen bir göreviniz yok.</div>
        </div>
    </div>
}
else
{
    <div class="card" style="padding:0;overflow:hidden">
        @if (urgentTasks.Any())
        {
            <div class="task-urgency-strip task-urgency-urgent">
                <div class="task-urgency-label">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    Hemen Gerekli
                    <span class="task-urgency-count">@urgentTasks.Count</span>
                </div>
                @foreach (var task in urgentTasks)
                {
                    <a href="@task.Url" class="task-item"
                       style="--task-color:@task.Color;--task-bg:@task.Bg;--task-border:@(task.Color+"40")">
                        <span class="task-item-bar"></span>
                        <div class="task-item-body">
                            <div class="task-item-title">@task.Title</div>
                            <div class="task-item-detail">@task.Detail</div>
                        </div>
                        <span class="task-item-cat">@task.Category</span>
                        <span style="color:var(--text-3);font-size:12px">›</span>
                    </a>
                }
            </div>
        }
        @if (normalTasks.Any())
        {
            <div class="task-urgency-strip">
                <div class="task-urgency-label">
                    Bekleyen İşlerim
                    <span class="task-urgency-count">@normalTasks.Count</span>
                </div>
                @foreach (var task in normalTasks)
                {
                    <a href="@task.Url" class="task-item"
                       style="--task-color:@task.Color;--task-bg:@task.Bg;--task-border:@(task.Color+"40")">
                        <span class="task-item-bar"></span>
                        <div class="task-item-body">
                            <div class="task-item-title">@task.Title</div>
                            <div class="task-item-detail">@task.Detail</div>
                        </div>
                        <span class="task-item-cat">@task.Category</span>
                        <span style="color:var(--text-3);font-size:12px">›</span>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private List<UserTask> _tasks = [];
    private User? _user;

    protected override void OnInitialized()
    {
        _user  = Auth.ActiveUserFromPrincipal(HttpCtx.HttpContext?.User);
        _tasks = _user is not null ? TaskSvc.GetTasksForUser(_user) : [];
    }
}

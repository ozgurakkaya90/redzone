@page "/pending"
@attribute [Authorize]
@inject TaskService TaskSvc
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@using System.Security.Claims

<PageTitle>Bekleyen İşler</PageTitle>

<div class="page-header">
    <div>
        <h1>Bekleyen İşler</h1>
        <div class="page-toolbar-sub">
            @if (_tasks.Count == 0)
            { <span>Bekleyen işiniz yok.</span> }
            else
            { <span><strong>@_tasks.Count</strong> görev bekliyor</span> }
        </div>
    </div>
    <a href="/workflows" class="btn btn-outline btn-sm">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 8 12 12 14 14"/></svg>
        İş Akış Şemaları
    </a>
</div>

@if (_tasks.Count == 0)
{
    <div class="card" style="padding:48px">
        <div class="empty-state">
            <div class="empty-state-icon-wrap">
                <svg width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="var(--gray-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="empty-state-title">Tüm işler tamamlandı</div>
            <div class="empty-state-sub">Şu an bekleyen bir göreviniz yok.</div>
        </div>
    </div>
}
else
{
    @foreach (var group in _tasks.GroupBy(t => t.Category).OrderBy(g => g.Key))
    {
        <div class="task-group">
            <div class="task-group-label">
                @group.Key
                <span class="task-group-count">@group.Count()</span>
            </div>
            <div class="task-list">
                @foreach (var task in group)
                {
                    <a href="@task.Url" class="task-item" style="border-left-color:@task.Color">
                        <div class="task-item-body">
                            <div class="task-item-title">@task.Title</div>
                            <div class="task-item-detail">@task.Detail</div>
                        </div>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--gray-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:2px"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                }
            </div>
        </div>
    }
}

@code {
    private List<UserTask> _tasks = [];

    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private string Role   => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";

    protected override void OnInitialized()
    {
        _tasks = TaskSvc.GetTasksForUser(UserId, Role);
    }
}

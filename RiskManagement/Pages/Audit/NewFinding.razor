@page "/audit/findings/new"
@attribute [Authorize(Policy = "audit.write")]
@inject AuditService AuditSvc
@inject AuthService Auth
@inject ConfigService CfgSvc
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject IWebHostEnvironment Env
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Forms
@using RiskManagement.Models

<PageTitle>Yeni Bulgu</PageTitle>

<div class="page-header"><h1>Bulgu Gir</h1></div>
<div style="max-width:680px">
    <div class="card">
        @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-error" style="margin-bottom:16px">@_error</div> }

        <div class="form-group">
            <label class="form-label">İlgili Denetim</label>
            <select class="form-control" @bind="_auditId">
                <option value="0">— Seçiniz —</option>
                @foreach (var a in _audits)
                { <option value="@a.Id">[@a.Code] @a.Title (@a.Period)</option> }
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Başlık *</label>
            <input class="form-control" @bind="_title" maxlength="200" />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div class="form-group">
                <label class="form-label">Kategori</label>
                <select class="form-control" @bind="_category">
                    <option value="">— Seçiniz —</option>
                    @foreach (var c in _categories) { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Şiddet</label>
                <select class="form-control" @bind="_severity">
                    <option value="">— Seçiniz —</option>
                    @foreach (var s in _severities) { <option value="@s">@s</option> }
                </select>
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" rows="4" @bind="_description"></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Ekler (Dosya Yükle)</label>
            <InputFile OnChange="HandleFiles" multiple
                       style="display:block;padding:8px;border:1px dashed #d1d5db;border-radius:6px;width:100%;font-size:13px" />
            @if (_pendingFiles.Any())
            {
                <div style="margin-top:6px">
                    @foreach (var f in _pendingFiles)
                    {
                        <div style="font-size:12px;color:var(--gray-700);padding:2px 0">
                             @f.Name <span style="color:#9ca3af">(@FormatSize(f.Size))</span>
                        </div>
                    }
                </div>
            }
        </div>

        <div style="display:flex;gap:10px;margin-top:8px">
            <button class="btn btn-primary" @onclick="Submit" disabled="@_loading">
                @(_loading ? "Kaydediliyor…" : "Kaydet")
            </button>
            <a href="/audit/findings" class="btn btn-outline">İptal</a>
        </div>
    </div>
</div>

@code {
    private string _title = "", _category = "", _severity = "", _description = "";
    private int _auditId = 0;
    private string[] _categories = [], _severities = [];
    private List<InternalAudit> _audits = [];
    private List<IBrowserFile> _pendingFiles = [];
    private bool _loading;
    private string _error = "";

    private User? _user;

    protected override void OnInitialized()
    {
        _user = Auth.ActiveUserFromPrincipal(HttpCtx.HttpContext?.User);
        if (_user is null || !Auth.HasPermission(_user, "audit.write"))
        {
            Nav.NavigateTo("/403", replace: true);
            return;
        }
        _categories = CfgSvc.GetList("audit_categories");
        _severities = CfgSvc.GetList("audit_severities");
        _audits = AuditSvc.GetAuditsForUser(_user);
    }

    private void HandleFiles(InputFileChangeEventArgs e)
    {
        _pendingFiles = [.. e.GetMultipleFiles(10)];
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_title)) { _error = "Başlık zorunludur."; return; }
        _loading = true;
        var f = await AuditSvc.CreateFindingAsync(_title, _description, _category, _severity, null,
            _user!.Id, null, _auditId > 0 ? _auditId : null, null);

        if (_pendingFiles.Any())
        {
            var uploadDir = Path.Combine(Env.ContentRootPath, "uploads", "findings", f.Id.ToString());
            Directory.CreateDirectory(uploadDir);
            foreach (var file in _pendingFiles)
            {
                var ext = Path.GetExtension(file.Name).ToLowerInvariant();
                if (!AuditService.AllowedAttachmentExtensions.Contains(ext))
                { _error = $"İzin verilmeyen dosya türü: {ext}"; continue; }
                if (file.Size > AuditService.MaxAttachmentSize)
                { _error = $"Dosya boyutu {AuditService.MaxAttachmentSize / 1024 / 1024} MB sınırını aşıyor."; continue; }

                var originalName = Path.GetFileName(file.Name);
                var storedName   = $"{Guid.NewGuid()}{ext}";
                var dest = Path.Combine(uploadDir, storedName);
                await using var fs  = File.Create(dest);
                await using var src = file.OpenReadStream(maxAllowedSize: AuditService.MaxAttachmentSize);
                await src.CopyToAsync(fs);
                await AuditSvc.SaveAttachmentAsync(f.Id, originalName, dest, file.Size, _user!.Id);
            }
        }

        Nav.NavigateTo($"/audit/findings/{f.Id}");
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024L * 1024) return $"{bytes / 1024 / 1024} MB";
        if (bytes >= 1024) return $"{bytes / 1024} KB";
        return $"{bytes} B";
    }
}

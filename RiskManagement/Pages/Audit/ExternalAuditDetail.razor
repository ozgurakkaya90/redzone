@page "/audit/external/{Id:int}"
@attribute [Authorize(Policy = "external_audit.read")]
@inject ExternalAuditService ExtSvc
@inject AuthService Auth
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject ToastService Toast
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Dış Denetim @(_audit?.Code ?? "")</PageTitle>

@if (_audit is null)
{
    <div class="card" style="padding:24px">
        <div style="font-weight:700;margin-bottom:6px">Bulunamadı</div>
        <div style="color:var(--text-3)">Bu dış denetim kaydına erişiminiz yok veya kayıt mevcut değil.</div>
        <a href="/audit/external" class="btn btn-outline btn-sm" style="margin-top:12px">← Listeye dön</a>
    </div>
}
else
{
    <div class="breadcrumb-bar">
        <a href="/audit/external" class="breadcrumb-back">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Dış Denetimler
        </a>
        <span class="breadcrumb-sep">›</span>
        <span class="breadcrumb-current">@_audit.Code</span>
    </div>
    <div class="detail-header-strip">
        <div class="detail-header-top">
            <div style="flex:1;min-width:0">
                <div class="detail-header-badges">
                    <code style="font-size:11px;background:var(--gray-100);padding:2px 8px;border-radius:4px;color:var(--text-3)">@_audit.Code</code>
                    <span class="badge @StatusBadge(_audit.Status)">@StatusLabel(_audit.Status)</span>
                    @if (!string.IsNullOrEmpty(_audit.Standard)) { <span class="tag">@_audit.Standard</span> }
                </div>
                <h2 class="detail-header-title">@_audit.Subject</h2>
            </div>
            <a href="/audit/external" class="btn btn-outline btn-sm">&#8592; Geri</a>
        </div>
        <div class="detail-header-meta">
            <div class="detail-meta-item">
                <span class="detail-meta-label">Denetim Kuruluşu</span>
                <span class="detail-meta-value">@_audit.AuditingBody</span>
            </div>
            <div class="detail-meta-item">
                <span class="detail-meta-label">Denetim Tarihi</span>
                <span class="detail-meta-value">@_audit.AuditDate.ToString("dd.MM.yyyy")</span>
            </div>
            @if (!string.IsNullOrEmpty(_audit.Standard))
            {
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Standart</span>
                    <span class="detail-meta-value">@_audit.Standard</span>
                </div>
            }
        </div>
    </div>

    <div class="ead-layout">
        <div>
            @* ─── Findings ─── *@
            <div class="card" style="padding:18px;margin-bottom:16px">
                <div class="page-toolbar" style="margin-bottom:14px">
                    <h2 class="page-toolbar-title" style="font-size:16px">Dış Denetim Bulguları (@_findings.Count)</h2>
                    @if (_canEdit && !_addingFinding)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => _addingFinding = true">+ Bulgu Ekle</button>
                    }
                </div>

                @if (_addingFinding)
                {
                    <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:14px;margin-bottom:14px">
                        <div style="font-weight:700;margin-bottom:10px">Yeni Bulgu</div>
                        @if (!string.IsNullOrEmpty(_findingError))
                        { <div class="alert alert-error" style="margin-bottom:10px">@_findingError</div> }
                        <div class="form-group">
                            <label class="form-label">Başlık *</label>
                            <input class="form-control" @bind="_newFinding.Title" maxlength="200" />
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div class="form-group">
                                <label class="form-label">Majör/Minör</label>
                                <select class="form-control" @bind="_newFinding.Severity">
                                    <option value="">— Seçin —</option>
                                    <option value="Majör">Majör</option>
                                    <option value="Minör">Minör</option>
                                    <option value="critical">Kritik</option>
                                    <option value="high">Yüksek</option>
                                    <option value="medium">Orta</option>
                                    <option value="low">Düşük</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Uygunsuzluk Adedi</label>
                                <input type="number" class="form-control" min="1" @bind="_newFinding.NonconformityCount" placeholder="—" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">İlgili Mevzuat Maddesi</label>
                            <input class="form-control" @bind="_newFinding.StandardArticle" maxlength="500"
                                   placeholder="örn. IPSG.1, Madde 5.2" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Uygunsuzluğa Konu Olan Standart Maddesi</label>
                            <textarea class="form-control" rows="2" @bind="_newFinding.StandardClause" maxlength="1000"
                                      placeholder="Standart/checklist maddesini buraya yazın…"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Uygunsuzluk Detay Açıklaması</label>
                            <textarea class="form-control" rows="3" @bind="_newFinding.Description" maxlength="2000"></textarea>
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                            <div class="form-group">
                                <label class="form-label">Bulgu Sahibi</label>
                                <select class="form-control" @bind="_newFinding.OwnerId">
                                    <option value="">— Seçin —</option>
                                    @foreach (var u in _users)
                                    { <option value="@u.Id">@u.FullName</option> }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Sahip Birimi</label>
                                <select class="form-control" @bind="_newFinding.DepartmentId">
                                    <option value="">— Seçin —</option>
                                    @foreach (var d in _departments)
                                    { <option value="@d.Id">@d.Name</option> }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Termin</label>
                            <input type="date" class="form-control" @bind="_newFindingDue" />
                        </div>
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-primary btn-sm" @onclick="SaveFinding">Kaydet</button>
                            <button class="btn btn-outline btn-sm" @onclick="CancelAddFinding">İptal</button>
                        </div>
                    </div>
                }

                @if (!_findings.Any() && !_addingFinding)
                {
                    <div class="empty-state">
                        <div class="empty-state-title">Henüz bulgu eklenmemiş.</div>
                    </div>
                }
                else
                {
                    @foreach (var f in _findings)
                    {
                        var actions = _actionsByFinding.TryGetValue(f.Id, out var lst) ? lst : new List<AuditFindingAction>();
                        <div class="ead-finding-card">
                            <div class="ead-finding-top">
                                <div style="flex:1">
                                    @if (_editFindingId == f.Id)
                                    {
                                        @* ── Bulgu düzenleme formu ── *@
                                        <div style="background:#f8fafc;padding:14px;border-radius:8px;border:1px solid var(--border);margin-bottom:8px">
                                            <div style="font-weight:700;font-size:13px;margin-bottom:10px">Bulgu Düzenle</div>
                                            @if (!string.IsNullOrEmpty(_editFindingError))
                                            { <div class="alert alert-error" style="margin-bottom:8px">@_editFindingError</div> }
                                            <div class="form-group">
                                                <label class="form-label">Başlık *</label>
                                                <input class="form-control" @bind="_editFinding.Title" maxlength="200" />
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                                                <div class="form-group">
                                                    <label class="form-label">Majör/Minör</label>
                                                    <select class="form-control" @bind="_editFinding.Severity">
                                                        <option value="">— Seçin —</option>
                                                        <option value="Majör">Majör</option>
                                                        <option value="Minör">Minör</option>
                                                        <option value="critical">Kritik</option>
                                                        <option value="high">Yüksek</option>
                                                        <option value="medium">Orta</option>
                                                        <option value="low">Düşük</option>
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Uygunsuzluk Adedi</label>
                                                    <input type="number" class="form-control" min="1" @bind="_editFinding.NonconformityCount" placeholder="—" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">İlgili Mevzuat Maddesi</label>
                                                <input class="form-control" @bind="_editFinding.StandardArticle" maxlength="500" />
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Uygunsuzluğa Konu Standart Maddesi</label>
                                                <textarea class="form-control" rows="2" @bind="_editFinding.StandardClause" maxlength="1000"></textarea>
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                                                <div class="form-group">
                                                    <label class="form-label">Bulgu Sahibi</label>
                                                    <select class="form-control" @bind="_editFinding.OwnerId">
                                                        <option value="">— Seçin —</option>
                                                        @foreach (var u in _users)
                                                        { <option value="@u.Id">@u.FullName</option> }
                                                    </select>
                                                </div>
                                                <div class="form-group">
                                                    <label class="form-label">Sahip Birimi</label>
                                                    <select class="form-control" @bind="_editFinding.DepartmentId">
                                                        <option value="">— Seçin —</option>
                                                        @foreach (var d in _departments)
                                                        { <option value="@d.Id">@d.Name</option> }
                                                    </select>
                                                </div>
                                            </div>
                                            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                                                <div class="form-group">
                                                    <label class="form-label">Termin</label>
                                                    <input type="date" class="form-control" @bind="_editFindingDue" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="form-label">Açıklama</label>
                                                <textarea class="form-control" rows="2" @bind="_editFinding.Description" maxlength="2000"></textarea>
                                            </div>
                                            <div style="display:flex;gap:8px">
                                                <button class="btn btn-success btn-sm" @onclick="() => SaveFindingEdit(f.Id)">Kaydet</button>
                                                <button class="btn btn-outline btn-sm" @onclick="CancelFindingEdit">İptal</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ead-finding-title">
                                            <code>@f.Code</code>
                                            <span style="margin-left:6px">@f.Title</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(f.StandardArticle))
                                        {
                                            <div style="margin-top:4px;font-size:12px;color:var(--text-3)">
                                                <strong>Mevzuat Maddesi:</strong> @f.StandardArticle
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(f.StandardClause))
                                        {
                                            <div style="margin-top:4px;font-size:12px;color:var(--text-2);white-space:pre-wrap">
                                                <strong>Standart Maddesi:</strong> @f.StandardClause
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(f.Description))
                                        {
                                            <div class="text-muted" style="margin-top:6px;white-space:pre-wrap">@f.Description</div>
                                        }
                                        <div class="ead-finding-meta">
                                            @if (!string.IsNullOrEmpty(f.Severity))
                                            { <span class="badge @SeverityBadge(f.Severity)">@f.Severity</span> }
                                            @if (f.NonconformityCount.HasValue)
                                            { <span class="tag">@f.NonconformityCount Adet</span> }
                                            @if (f.Owner != null)
                                            { <span class="tag">@f.Owner.FullName</span> }
                                            @if (f.Department != null)
                                            { <span class="tag">@f.Department.Name</span> }
                                            @if (f.DueDate.HasValue)
                                            { <span class="tag">@f.DueDate.Value.ToString("dd.MM.yyyy")</span> }
                                        </div>
                                    }
                                </div>
                                <div style="display:flex;flex-direction:column;gap:6px;align-items:flex-end;flex-shrink:0">
                                    <span class="badge @FindingStatusBadge(f.Status)">@FindingStatusLabel(f.Status)</span>
                                    @if (_canEdit && _editFindingId != f.Id)
                                    {
                                        <button class="btn btn-outline btn-sm" style="font-size:11px;padding:2px 8px"
                                                @onclick="() => StartFindingEdit(f)">Düzenle</button>
                                    }
                                </div>
                            </div>

                            @* Aksiyonlar *@
                            <div class="ead-actions-section">
                                <div class="ead-actions-header">
                                    <span class="section-title" style="margin-bottom:0">Aksiyonlar (@actions.Count)</span>
                                    @if (_canEdit)
                                    {
                                        <button class="btn btn-outline btn-sm" style="padding:2px 8px;font-size:11px"
                                                @onclick="() => StartAddAction(f.Id)">+ Aksiyon</button>
                                    }
                                </div>
                                @foreach (var a in actions)
                                {
                                    @if (_editActionId == a.Id)
                                    {
                                        @* ── Aksiyon düzenleme satır içi ── *@
                                        <div class="ead-add-action-form">
                                            <input class="form-control" placeholder="Aksiyon açıklaması…"
                                                   @bind="_editAction.Description" maxlength="1000" style="margin-bottom:6px" />
                                            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:6px">
                                                <input class="form-control" placeholder="Sorumlu"
                                                       @bind="_editAction.Responsible" maxlength="200" />
                                                <input type="date" class="form-control" @bind="_editActionDue" />
                                                <select class="form-control" @bind="_editAction.Status">
                                                    <option value="planned">Planlandı</option>
                                                    <option value="in_progress">Devam Ediyor</option>
                                                    <option value="completed">Tamamlandı</option>
                                                    <option value="cancelled">İptal</option>
                                                </select>
                                            </div>
                                            <div style="display:flex;gap:6px">
                                                <button class="btn btn-primary btn-sm" @onclick="() => SaveActionEdit(a.Id)">Kaydet</button>
                                                <button class="btn btn-outline btn-sm" @onclick="() => _editActionId = 0">İptal</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ead-action-row" style="justify-content:space-between">
                                            <div style="display:flex;gap:8px;align-items:center;flex:1;flex-wrap:wrap">
                                                <span class="badge @ActionStatusBadge(a.Status)" style="font-size:10px">@ActionStatusLabel(a.Status)</span>
                                                <span>@a.Description</span>
                                                @if (!string.IsNullOrEmpty(a.Responsible))
                                                { <span class="text-muted">— @a.Responsible</span> }
                                                @if (a.DueDate.HasValue)
                                                { <span class="text-muted">@a.DueDate.Value.ToString("dd.MM.yyyy")</span> }
                                            </div>
                                            @if (_canEdit)
                                            {
                                                <button class="btn btn-outline btn-sm" style="font-size:11px;padding:2px 8px;flex-shrink:0"
                                                        @onclick="() => StartActionEdit(a)">Düzenle</button>
                                            }
                                        </div>
                                    }
                                }
                                @if (_addActionFor == f.Id)
                                {
                                    <div class="ead-add-action-form">
                                        <input class="form-control" placeholder="Aksiyon açıklaması…"
                                               @bind="_newAction.Description" maxlength="1000" style="margin-bottom:6px" />
                                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px">
                                            <input class="form-control" placeholder="Sorumlu (serbest metin)"
                                                   @bind="_newAction.Responsible" maxlength="200" />
                                            <input type="date" class="form-control" @bind="_newActionDue" />
                                        </div>
                                        <div style="display:flex;gap:6px">
                                            <button class="btn btn-primary btn-sm" @onclick="() => SaveAction(f.Id)">Ekle</button>
                                            <button class="btn btn-outline btn-sm" @onclick="() => _addActionFor = 0">İptal</button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* ─── Right panel: meta + status ─── *@
        <div>
            <div class="card" style="padding:16px;margin-bottom:14px">
                <div class="section-title">Durum</div>
                @if (_canEdit)
                {
                    <select class="form-control" @bind="_audit.Status" @bind:after="SaveStatus">
                        <option value="planned">Planlandı</option>
                        <option value="in_progress">Devam Ediyor</option>
                        <option value="completed">Tamamlandı</option>
                        <option value="closed">Kapatıldı</option>
                    </select>
                }
                else
                {
                    <div style="font-weight:600">@StatusLabel(_audit.Status)</div>
                }
            </div>

            <div class="card" style="padding:16px;margin-bottom:14px">
                <div class="section-title">Bilgiler</div>
                <div class="ead-info-list">
                    <div><strong>Kurum:</strong> @_audit.AuditingBody</div>
                    @if (!string.IsNullOrEmpty(_audit.AuditType))
                    { <div><strong>Denetim Türü:</strong> @_audit.AuditType</div> }
                    @if (!string.IsNullOrEmpty(_audit.Standard))
                    { <div><strong>Standart:</strong> @_audit.Standard</div> }
                    @if (!string.IsNullOrEmpty(_audit.ChecklistName))
                    { <div><strong>Denetim Listesi:</strong> @_audit.ChecklistName</div> }
                    <div><strong>Tarih:</strong> @_audit.AuditDate.ToString("dd.MM.yyyy")</div>
                    @if (_audit.EndDate.HasValue)
                    { <div><strong>Bitiş:</strong> @_audit.EndDate.Value.ToString("dd.MM.yyyy")</div> }
                    @if (!string.IsNullOrEmpty(_audit.Score))
                    { <div><strong>Skor:</strong> @_audit.Score</div> }
                    @if (_audit.ResponsibleDept != null)
                    { <div><strong>Sorumlu Birim:</strong> @_audit.ResponsibleDept.Name</div> }
                    @if (_audit.ResponsibleUser != null)
                    { <div><strong>Sorumlu Kişi:</strong> @_audit.ResponsibleUser.FullName</div> }
                    <div><strong>Oluşturan:</strong> @(_audit.CreatedBy?.FullName ?? "—")</div>
                    <div><strong>Oluşturma:</strong> @_audit.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(_audit.Notes))
            {
                <div class="card" style="padding:16px;margin-bottom:14px">
                    <div class="section-title">Notlar</div>
                    <div class="text-muted" style="white-space:pre-wrap">@_audit.Notes</div>
                </div>
            }

            @if (_canEdit)
            {
                <div class="card ead-danger-zone">
                    <div class="ead-danger-title">Tehlikeli Bölge</div>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-ghost-danger btn-sm" @onclick="() => _confirmDelete = true">Denetimi Sil</button>
                    }
                    else
                    {
                        <div class="text-muted" style="margin-bottom:8px;color:var(--color-danger-fg)">
                            Bu işlem denetimi, tüm bulgularını ve aksiyonlarını siler. Emin misiniz?
                        </div>
                        <div style="display:flex;gap:6px">
                            <button class="btn btn-danger btn-sm" @onclick="ConfirmDelete">Evet, sil</button>
                            <button class="btn btn-outline btn-sm" @onclick="() => _confirmDelete = false">Vazgeç</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}


@code {
    [Parameter] public int Id { get; set; }

    private ExternalAudit? _audit;
    private List<AuditFinding> _findings = [];
    private Dictionary<int, List<AuditFindingAction>> _actionsByFinding = new();
    private List<User> _users = [];
    private List<Department> _departments = [];
    private bool _canEdit;
    private bool _confirmDelete;
    private string _prevStatus = "";

    // New finding
    private bool _addingFinding;
    private AuditFinding _newFinding = new();
    private DateTime? _newFindingDue;
    private string _findingError = "";

    // New action
    private int _addActionFor;
    private AuditFindingAction _newAction = new();
    private DateTime? _newActionDue;

    // Bulgu düzenleme
    private int _editFindingId;
    private AuditFinding _editFinding = new();
    private DateTime? _editFindingDue;
    private string _editFindingError = "";

    // Aksiyon düzenleme
    private int _editActionId;
    private AuditFindingAction _editAction = new();
    private DateTime? _editActionDue;

    private int _userId;

    protected override void OnInitialized()
    {
        int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId);
        Load();
    }

    private void Load()
    {
        var user = Db.Users.Include(u => u.UserRoles).FirstOrDefault(u => u.Id == _userId);
        if (user is null) return;
        _audit = ExtSvc.Get(Id, user);
        if (_audit is null) return;
        _prevStatus = _audit.Status;
        _canEdit = ExtSvc.CanEdit(user, _audit.AuditingBody);
        _findings = LoadFindingsForAudit(Id);
        LoadActions();
        _users = [.. Db.Users.Where(u => u.IsActive).OrderBy(u => u.FullName)];
        _departments = [.. Db.Departments.OrderBy(d => d.Name)];
    }

    private List<AuditFinding> LoadFindingsForAudit(int extId)
    {
        try
        {
            return [.. Db.AuditFindings
                .Where(f => f.ExternalAuditId == extId)
                .Include(f => f.Owner)
                .Include(f => f.Department)
                .OrderByDescending(f => f.CreatedAt)
                .AsNoTracking()];
        }
        catch { return []; }
    }

    private void LoadActions()
    {
        _actionsByFinding.Clear();
        if (_findings.Count == 0) return;
        var ids = _findings.Select(f => f.Id).ToList();
        var all = Db.AuditFindingActions
            .Where(a => ids.Contains(a.FindingId))
            .OrderBy(a => a.CreatedAt)
            .AsNoTracking().ToList();
        foreach (var grp in all.GroupBy(a => a.FindingId))
            _actionsByFinding[grp.Key] = grp.ToList();
    }

    private void CancelAddFinding()
    {
        _addingFinding = false;
        _newFinding = new();
        _newFindingDue = null;
        _findingError = "";
    }

    // ── Bulgu düzenleme ────────────────────────────────────────────────────────
    private void StartFindingEdit(AuditFinding f)
    {
        _editFindingId    = f.Id;
        _editFinding      = new AuditFinding
        {
            Title                = f.Title,
            Description          = f.Description,
            Severity             = f.Severity,
            StandardArticle      = f.StandardArticle,
            StandardClause       = f.StandardClause,
            NonconformityCount   = f.NonconformityCount,
            OwnerId              = f.OwnerId,
            DepartmentId         = f.DepartmentId,
        };
        _editFindingDue   = f.DueDate.HasValue ? f.DueDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        _editFindingError = "";
        _editActionId     = 0; // başka formu kapat
    }

    private void CancelFindingEdit()
    {
        _editFindingId    = 0;
        _editFinding      = new();
        _editFindingDue   = null;
        _editFindingError = "";
    }

    private async Task SaveFindingEdit(int findingId)
    {
        _editFindingError = "";
        if (string.IsNullOrWhiteSpace(_editFinding.Title))
        { _editFindingError = "Başlık zorunludur."; return; }

        try
        {
            var f = await Db.AuditFindings.FindAsync(findingId);
            if (f is null) return;
            f.Title                = _editFinding.Title.Trim();
            f.Description          = string.IsNullOrWhiteSpace(_editFinding.Description)   ? null : _editFinding.Description.Trim();
            f.Severity             = string.IsNullOrWhiteSpace(_editFinding.Severity)      ? null : _editFinding.Severity;
            f.StandardArticle      = string.IsNullOrWhiteSpace(_editFinding.StandardArticle) ? null : _editFinding.StandardArticle.Trim();
            f.StandardClause       = string.IsNullOrWhiteSpace(_editFinding.StandardClause)  ? null : _editFinding.StandardClause.Trim();
            f.NonconformityCount   = _editFinding.NonconformityCount;
            f.OwnerId              = _editFinding.OwnerId;
            f.DepartmentId         = _editFinding.DepartmentId;
            f.DueDate              = _editFindingDue.HasValue ? DateOnly.FromDateTime(_editFindingDue.Value) : null;
            await Db.SaveChangesAsync();
            CancelFindingEdit();
            _findings = LoadFindingsForAudit(_audit!.Id);
        }
        catch
        {
            _editFindingError = "Kayıt sırasında bir sorun oluştu. Lütfen tekrar deneyin.";
        }
    }

    // ── Aksiyon düzenleme ─────────────────────────────────────────────────────
    private void StartActionEdit(AuditFindingAction a)
    {
        _editActionId  = a.Id;
        _editAction    = new AuditFindingAction
        {
            Description = a.Description,
            Responsible = a.Responsible,
            Status      = a.Status,
        };
        _editActionDue = a.DueDate.HasValue ? a.DueDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        _addActionFor  = 0; // ekle formunu kapat
    }

    private async Task SaveActionEdit(int actionId)
    {
        if (string.IsNullOrWhiteSpace(_editAction.Description)) return;
        var a = await Db.AuditFindingActions.FindAsync(actionId);
        if (a is null) return;
        a.Description = _editAction.Description.Trim();
        a.Responsible = string.IsNullOrWhiteSpace(_editAction.Responsible) ? null : _editAction.Responsible.Trim();
        a.Status      = _editAction.Status;
        a.DueDate     = _editActionDue.HasValue ? DateOnly.FromDateTime(_editActionDue.Value) : null;
        if (a.Status == "completed" && !a.CompletedAt.HasValue)
            a.CompletedAt = DateTime.UtcNow;
        await Db.SaveChangesAsync();
        _editActionId = 0;
        LoadActions();
    }

    private void SaveFinding()
    {
        _findingError = "";
        if (string.IsNullOrWhiteSpace(_newFinding.Title))
        { _findingError = "Başlık zorunludur."; return; }
        if (_audit is null) return;

        try
        {
            _newFinding.DueDate  = _newFindingDue.HasValue ? DateOnly.FromDateTime(_newFindingDue.Value) : null;
            _newFinding.Severity = string.IsNullOrEmpty(_newFinding.Severity) ? null : _newFinding.Severity;
            ExtSvc.CreateFinding(_audit.Id, _newFinding, _userId);
            CancelAddFinding();
            _findings = LoadFindingsForAudit(_audit.Id);
            LoadActions();
        }
        catch (Exception)
        {
            _findingError = "Kayıt sırasında bir sorun oluştu. Lütfen tekrar deneyin.";
        }
    }

    private void StartAddAction(int findingId)
    {
        _addActionFor = findingId;
        _newAction = new AuditFindingAction();
        _newActionDue = null;
    }

    private async Task SaveAction(int findingId)
    {
        if (string.IsNullOrWhiteSpace(_newAction.Description)) return;
        _newAction.FindingId   = findingId;
        _newAction.CreatedById = _userId;
        _newAction.CreatedAt   = DateTime.UtcNow;
        _newAction.Status      = "planned";
        _newAction.DueDate     = _newActionDue.HasValue ? DateOnly.FromDateTime(_newActionDue.Value) : null;
        Db.AuditFindingActions.Add(_newAction);
        await Db.SaveChangesAsync();
        _addActionFor = 0;
        LoadActions();
    }

    private void SaveStatus()
    {
        if (_audit is null) return;

        // Kapanış koruması: açık veya kapanış-bekleyen bulgu varken denetim kapatılamaz.
        if (_audit.Status == "closed")
        {
            var openCount = _findings.Count(f => f.Status is "open" or "closure_requested");
            if (openCount > 0)
            {
                Toast.Error($"Denetim kapatılamaz: {openCount} açık bulgu mevcut. Önce tüm bulgular kapatılmalıdır.");
                _audit.Status = _prevStatus; // Önceki duruma geri al
                return;
            }
        }

        try
        {
            ExtSvc.Update(_audit);
            _prevStatus = _audit.Status;
        }
        catch { /* sessizce yut */ }
    }

    private void ConfirmDelete()
    {
        if (_audit is null) return;
        try
        {
            ExtSvc.Delete(_audit.Id);
            Nav.NavigateTo("/audit/external");
        }
        catch { _confirmDelete = false; }
    }


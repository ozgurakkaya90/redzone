@page "/audit"
@attribute [Authorize]
@inject AuditService AuditSvc
@inject ExternalAuditService ExtSvc
@inject AuthService Auth
@inject AppDbContext Db
@inject ConfigService CfgSvc
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Denetim Paneli</PageTitle>

<div class="page-toolbar">
    <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Denetim Paneli</h1>
        <div class="page-toolbar-sub">@DateTime.Today.Year · İç denetim durumu ve bulgular</div>
    </div>
    @if (HasPerm("audit.read"))
    {
        <div class="page-toolbar-actions">
            <a href="/audit/plan"         class="btn btn-outline btn-sm">Yıllık Plan</a>
            <a href="/audit/internal/new" class="btn btn-primary btn-sm">+ Yeni Denetim</a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_initError))
{
    <div class="alert alert-error" style="margin-bottom:16px">
        Dashboard yüklenemedi: @_initError
        <span style="font-size:12px;display:block;margin-top:4px">
            Çözüm: <a href="/admin/db-migrate">Veritabanı Migration</a> sayfasından migration'ları çalıştırın.
        </span>
    </div>
}

@if (_stats != null)
{
    @* ── Denetim Planı Durumu ── *@
    @if (_stats.PlanTotal > 0)
    {
        var pct = _stats.PlanTotal > 0 ? (double)_stats.PlanCompleted / _stats.PlanTotal * 100 : 0;
        <div class="card" style="margin-bottom:20px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span class="section-label" style="margin-bottom:0">@(_stats.PlanYear) Yılı Denetim Planı</span>
                <a href="/audit/plan" style="font-size:12px;color:var(--navy-700)">Plana Git →</a>
            </div>
            <div class="mini-stat-grid" style="margin-bottom:14px">
                <div class="mini-stat-card">
                    <div class="mini-stat-val">@_stats.PlanTotal</div>
                    <div class="mini-stat-label">Toplam Madde</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--blue">@_stats.PlanConverted</div>
                    <div class="mini-stat-label">Denetime Dönüştürüldü</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--green">@_stats.PlanCompleted</div>
                    <div class="mini-stat-label">Tamamlandı</div>
                </div>
                @if (_stats.PlanLate > 0)
                {
                    <div class="mini-stat-card">
                        <div class="mini-stat-val mini-stat-val--red">@_stats.PlanLate</div>
                        <div class="mini-stat-label">Gecikmiş</div>
                    </div>
                }
            </div>
            <div class="progress-track">
                <div class="progress-fill" style="width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <div class="progress-meta">
                <span>Tamamlanma oranı</span>
                <span class="progress-meta-val">%@pct.ToString("F0")</span>
            </div>
        </div>
    }

    @* ── İç Denetim Özeti ── *@
    <div class="stat-strip">
        <div class="stat-strip-item" style="--stat-color:#0369a1">
            <div class="stat-strip-val">@_stats.PlannedAudits</div>
            <div class="stat-strip-label">Planlandı</div>
        </div>
        <div class="stat-strip-item" style="--stat-color:#f59e0b">
            <div class="stat-strip-val">@_stats.ActiveAudits</div>
            <div class="stat-strip-label">Devam Ediyor</div>
        </div>
        <div class="stat-strip-item" style="--stat-color:#16a34a">
            <div class="stat-strip-val">@_stats.CompletedAudits</div>
            <div class="stat-strip-label">Tamamlandı</div>
        </div>
    </div>

    @* ── Bulgular ── *@
    <div class="section-label">Bulgu Özeti</div>
    <div class="stat-strip">
        <div class="stat-strip-item" style="--stat-color:#dc2626">
            <div class="stat-strip-val">@_stats.Open</div>
            <div class="stat-strip-label">
                Açık Bulgular
                @if (_stats.Overdue > 0)
                { <span class="badge badge-red" style="font-size:10px;display:block;margin-top:4px">@_stats.Overdue gecikmiş</span> }
            </div>
        </div>
        <div class="stat-strip-item" style="--stat-color:#f59e0b">
            <div class="stat-strip-val">@_stats.ClosureRequested</div>
            <div class="stat-strip-label">Kapanış Bekleyen</div>
        </div>
        <div class="stat-strip-item" style="--stat-color:#16a34a">
            <div class="stat-strip-val">@_stats.Closed</div>
            <div class="stat-strip-label">Kapalı · Toplam @_stats.Total</div>
        </div>
    </div>

    @* ── Dağılım grafikleri ── *@
    <div class="meta-grid mg-2" style="margin-bottom:20px">
        <div class="card">
            <div class="section-label">Şiddete Göre Dağılım</div>
            @foreach (var (sev, count) in _stats.BySeverity.Where(x => x.Value > 0).OrderByDescending(x => x.Value))
            {
                var pctBar = _stats.Total > 0 ? (double)count / _stats.Total * 100 : 0;
                <div class="chart-row">
                    <div class="chart-row-hdr">
                        <span>@sev</span>
                        <span style="font-weight:600;color:@SeverityColor(sev)">@count</span>
                    </div>
                    <div class="chart-row-bar">
                        <div class="chart-row-fill" style="width:@(pctBar.ToString("F1",System.Globalization.CultureInfo.InvariantCulture))%;background:@SeverityColor(sev)"></div>
                    </div>
                </div>
            }
            @if (!_stats.BySeverity.Any(x => x.Value > 0))
            { <div style="color:var(--text-3);font-size:13px">Henüz bulgu yok.</div> }
        </div>

        <div class="card">
            <div class="section-label">Kategoriye Göre Dağılım</div>
            @foreach (var (cat, count) in _stats.ByCategory.Where(x => x.Value > 0).OrderByDescending(x => x.Value).Take(8))
            {
                <div class="cat-row">
                    <span>@cat</span>
                    <span class="badge badge-gray">@count</span>
                </div>
            }
            @if (!_stats.ByCategory.Any(x => x.Value > 0))
            { <div style="color:var(--text-3);font-size:13px">Henüz bulgu yok.</div> }
        </div>
    </div>

    @* ── Dış Denetim Kartı ── *@
    @if (_extStats != null && _canSeeExternal)
    {
        <div class="card" style="margin-top:4px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <span class="section-label" style="margin-bottom:0">Dış Denetimler</span>
                <a href="/audit/external" style="font-size:12px;color:var(--navy-700)">Tümünü Gör →</a>
            </div>
            <div class="mini-stat-grid" style="margin-bottom:0">
                <div class="mini-stat-card">
                    <div class="mini-stat-val">@_extStats.Total</div>
                    <div class="mini-stat-label">Toplam</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--blue">@_extStats.Planned</div>
                    <div class="mini-stat-label">Planlandı</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--amber">@_extStats.InProgress</div>
                    <div class="mini-stat-label">Devam Ediyor</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--green">@_extStats.Completed</div>
                    <div class="mini-stat-label">Tamamlandı</div>
                </div>
                <div class="mini-stat-card">
                    <div class="mini-stat-val mini-stat-val--navy">@_extStats.Upcoming</div>
                    <div class="mini-stat-label">Yaklaşan</div>
                </div>
            </div>
        </div>
    }

    @* ── Hızlı erişim ── *@
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px">
        <a href="/audit/internal" class="btn btn-outline btn-sm">İç Denetimler</a>
        <a href="/audit/findings" class="btn btn-outline btn-sm">Tüm Bulgular</a>
        <a href="/audit/actions"  class="btn btn-outline btn-sm">Aksiyon Planları</a>
        @if (HasPerm("audit.read"))
        {
            <a href="/audit/plan" class="btn btn-outline btn-sm">Denetim Planı</a>
        }
        @if (_canSeeExternal)
        {
            <a href="/audit/external" class="btn btn-outline btn-sm">Dış Denetimler</a>
        }
    </div>
}

@code {
    private AuditDashboardStats? _stats;
    private ExternalAuditStats? _extStats;
    private bool _canSeeExternal;
    private int    _userId;
    private User?  _user;
    private bool   HasPerm(string perm) => _user != null && Auth.HasPermission(_user, perm);

    private string _initError = "";

    protected override void OnInitialized()
    {
        var ctx = HttpCtx.HttpContext;
        if (ctx is not null)
            int.TryParse(ctx.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out _userId);

        _user = Db.Users
            .Include(u => u.UserRoles)
            .Include(u => u.UserDepartments)
            .FirstOrDefault(u => u.Id == _userId);

        try
        {
            _stats = _user is not null
                ? AuditSvc.GetDashboardForUser(_user, CfgSvc.GetList("audit_severities"))
                : new AuditDashboardStats();
        }
        catch (Exception)
        {
            _initError = "Veriler yüklenirken bir sorun oluştu. Lütfen sayfayı yenileyin.";
            _stats = new AuditDashboardStats();
        }

        // Dış denetim istatistikleri (yetki varsa)
        try
        {
            // _user zaten yüklendi
            if (_user != null)
            {
                _canSeeExternal = Auth.HasPermission(_user, "external_audit.read") || ExtSvc.IsAdmin(_user);
                if (_canSeeExternal) _extStats = ExtSvc.GetStats(_user);
            }
        }
        catch { /* migration uygulanmamışsa sessizce yut */ }
    }

    private static string SeverityColor(string sev) => sev switch
    {
        "Kritik"  => "#dc2626",
        "Yüksek"  => "#ea580c",
        "Orta"    => "#ca8a04",
        "Düşük"   => "#3b82f6",
        _         => "#94a3b8"
    };
}

@page "/audit"
@attribute [Authorize]
@inject AuditService AuditSvc
@inject ConfigService CfgSvc
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims

<PageTitle>Denetim Paneli</PageTitle>

<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <div>
        <h1 style="margin:0;font-size:22px;font-weight:800">Denetim Paneli</h1>
        <div style="font-size:12px;color:var(--text-3);margin-top:2px">
            @DateTime.Today.Year · İç denetim durumu ve bulgular
        </div>
    </div>
    @if (HasRole("auditor","audit_manager","admin"))
    {
        <div style="display:flex;gap:8px">
            <a href="/audit/plan"         class="btn btn-outline btn-sm">📅 Yıllık Plan</a>
            <a href="/audit/internal/new" class="btn btn-primary btn-sm">+ Yeni Denetim</a>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_initError))
{
    <div class="alert alert-error" style="margin-bottom:16px">
        ⚠️ Dashboard yüklenemedi: @_initError
        <span style="font-size:12px;display:block;margin-top:4px">
            Çözüm: <a href="/admin/db-migrate">Veritabanı Migration</a> sayfasından migration'ları çalıştırın.
        </span>
    </div>
}

@if (_stats != null)
{
    @* ── Denetim Planı Durumu ── *@
    @if (_stats.PlanTotal > 0)
    {
        var pct = _stats.PlanTotal > 0 ? (double)_stats.PlanCompleted / _stats.PlanTotal * 100 : 0;
        <div class="card" style="padding:16px;margin-bottom:20px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div style="font-size:13px;font-weight:700">
                    📅 @(_stats.PlanYear) Yılı Denetim Planı
                </div>
                <a href="/audit/plan" style="font-size:12px;color:#0369a1">Plana Git →</a>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;margin-bottom:14px">
                <div style="text-align:center;padding:10px;background:#f8fafc;border-radius:8px">
                    <div style="font-size:18px;font-weight:800;color:#64748b">@_stats.PlanTotal</div>
                    <div style="font-size:10px;color:var(--text-3)">Toplam Madde</div>
                </div>
                <div style="text-align:center;padding:10px;background:#eff6ff;border-radius:8px">
                    <div style="font-size:18px;font-weight:800;color:#0369a1">@_stats.PlanConverted</div>
                    <div style="font-size:10px;color:var(--text-3)">Denetime Dönüştürüldü</div>
                </div>
                <div style="text-align:center;padding:10px;background:#f0fdf4;border-radius:8px">
                    <div style="font-size:18px;font-weight:800;color:#16a34a">@_stats.PlanCompleted</div>
                    <div style="font-size:10px;color:var(--text-3)">Tamamlandı</div>
                </div>
                @if (_stats.PlanLate > 0)
                {
                    <div style="text-align:center;padding:10px;background:#fef2f2;border-radius:8px">
                        <div style="font-size:18px;font-weight:800;color:#dc2626">@_stats.PlanLate</div>
                        <div style="font-size:10px;color:var(--text-3)">Gecikmiş</div>
                    </div>
                }
            </div>
            @* İlerleme çubuğu *@
            <div style="background:#f1f5f9;border-radius:6px;height:8px;overflow:hidden">
                <div style="height:100%;background:#22c55e;border-radius:6px;
                            width:@(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                            transition:width .4s ease"></div>
            </div>
            <div style="display:flex;justify-content:space-between;margin-top:4px;font-size:11px;color:var(--text-3)">
                <span>Tamamlanma oranı</span>
                <span style="font-weight:600">%@pct.ToString("F0")</span>
            </div>
        </div>
    }

    @* ── İç Denetim Özeti ── *@
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-bottom:20px">
        <div class="card" style="padding:14px;border-top:3px solid #3b82f6">
            <div style="font-size:22px;font-weight:800;color:#3b82f6">@_stats.PlannedAudits</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">📋 Planlandı</div>
        </div>
        <div class="card" style="padding:14px;border-top:3px solid #f59e0b">
            <div style="font-size:22px;font-weight:800;color:#f59e0b">@_stats.ActiveAudits</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">🔄 Devam Ediyor</div>
        </div>
        <div class="card" style="padding:14px;border-top:3px solid #22c55e">
            <div style="font-size:22px;font-weight:800;color:#22c55e">@_stats.CompletedAudits</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">✅ Tamamlandı</div>
        </div>
    </div>

    @* ── Bulgular ── *@
    <div style="font-size:13px;font-weight:700;margin-bottom:10px">Bulgu Özeti</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-bottom:20px">
        <div class="card" style="padding:14px;border-top:3px solid #dc2626">
            <div style="font-size:22px;font-weight:800;color:#dc2626">@_stats.Open</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">🔴 Açık Bulgular</div>
            @if (_stats.Overdue > 0)
            {
                <div style="margin-top:4px">
                    <span class="badge badge-red" style="font-size:10px">@_stats.Overdue gecikmiş</span>
                </div>
            }
        </div>
        <div class="card" style="padding:14px;border-top:3px solid #f59e0b">
            <div style="font-size:22px;font-weight:800;color:#f59e0b">@_stats.ClosureRequested</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">🟡 Kapanış Bekleyen</div>
        </div>
        <div class="card" style="padding:14px;border-top:3px solid #22c55e">
            <div style="font-size:22px;font-weight:800;color:#22c55e">@_stats.Closed</div>
            <div style="font-size:11px;color:var(--text-3);margin-top:2px">✅ Kapalı</div>
            <div style="font-size:10px;color:var(--text-3)">Toplam @_stats.Total</div>
        </div>
    </div>

    @* ── Dağılım grafikleri ── *@
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px">
        <div class="card">
            <div style="font-size:13px;font-weight:700;margin-bottom:12px">Şiddete Göre Dağılım</div>
            @foreach (var (sev, count) in _stats.BySeverity.Where(x => x.Value > 0).OrderByDescending(x => x.Value))
            {
                var pctBar = _stats.Total > 0 ? (double)count / _stats.Total * 100 : 0;
                <div style="margin-bottom:8px">
                    <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px">
                        <span>@sev</span>
                        <span style="font-weight:600;color:@SeverityColor(sev)">@count</span>
                    </div>
                    <div style="background:#f1f5f9;border-radius:4px;height:6px">
                        <div style="height:100%;background:@SeverityColor(sev);border-radius:4px;
                                    width:@(pctBar.ToString("F1",System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
            @if (!_stats.BySeverity.Any(x => x.Value > 0))
            { <div style="color:var(--text-3);font-size:13px">Henüz bulgu yok.</div> }
        </div>

        <div class="card">
            <div style="font-size:13px;font-weight:700;margin-bottom:12px">Kategoriye Göre Dağılım</div>
            @foreach (var (cat, count) in _stats.ByCategory.Where(x => x.Value > 0).OrderByDescending(x => x.Value).Take(8))
            {
                var pctBar = _stats.Total > 0 ? (double)count / _stats.Total * 100 : 0;
                <div style="display:flex;justify-content:space-between;padding:5px 0;
                            border-bottom:1px solid #f3f4f6;font-size:12px">
                    <span>@cat</span>
                    <span class="badge badge-gray" style="font-size:11px">@count</span>
                </div>
            }
            @if (!_stats.ByCategory.Any(x => x.Value > 0))
            { <div style="color:var(--text-3);font-size:13px">Henüz bulgu yok.</div> }
        </div>
    </div>

    @* ── Hızlı erişim ── *@
    <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/audit/internal" class="btn btn-outline btn-sm">📁 İç Denetimler</a>
        <a href="/audit/findings" class="btn btn-outline btn-sm">📋 Tüm Bulgular</a>
        <a href="/audit/actions"  class="btn btn-outline btn-sm">✅ Aksiyon Planları</a>
        @if (HasRole("auditor","audit_manager","admin"))
        {
            <a href="/audit/plan" class="btn btn-outline btn-sm">📅 Denetim Planı</a>
        }
    </div>
}

@code {
    private AuditDashboardStats? _stats;
    private string Role   => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private bool   HasRole(params string[] roles) => roles.Contains(Role);

    private string _initError = "";

    protected override void OnInitialized()
    {
        try
        {
            _stats = AuditSvc.GetDashboardForUser(UserId, Role, CfgSvc.GetList("audit_severities"));
        }
        catch (Exception ex)
        {
            _initError = ex.Message;
            _stats = new AuditDashboardStats(); // boş istatistik — sayfa çökmez
        }
    }

    private static string SeverityColor(string sev) => sev switch
    {
        "Kritik"  => "#dc2626",
        "Yüksek"  => "#ea580c",
        "Orta"    => "#ca8a04",
        "Düşük"   => "#3b82f6",
        _         => "#94a3b8"
    };
}

@page "/audit/findings/{Id:int}"
@attribute [Authorize]
@inject AuditService AuditSvc
@inject ConfigService CfgSvc
@inject AuthService Auth
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject IWebHostEnvironment Env
@inject OrgService OrgSvc
@inject IJSRuntime JS
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using RiskManagement.Models

<PageTitle>Bulgu Detayı</PageTitle>

@if (_finding == null) { <div class="spinner">Yükleniyor…</div> }
else
{
    <div style="max-width:860px">
        <div class="breadcrumb-bar">
            <a href="/audit/findings" class="breadcrumb-back">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                Denetim Bulguları
            </a>
            <span class="breadcrumb-sep">›</span>
            <span class="breadcrumb-current">@_finding.Code</span>
        </div>
        <div class="detail-header-strip">
            <div class="detail-header-top">
                <div style="flex:1;min-width:0">
                    <div class="detail-header-badges">
                        <code style="font-size:11px;background:var(--gray-100);padding:2px 8px;border-radius:4px;color:var(--text-3)">@_finding.Code</code>
                        <span class="badge @StatusBadge(_finding.Status)">@StatusLabel(_finding.Status)</span>
                        @if (_finding.Severity != null) { <span class="badge @SevBadge(_finding.Severity)">@_finding.Severity</span> }
                        @if (_finding.ActionDecision == "risk_accepted")  { <span class="badge badge-gray">Risk Kabul Edildi</span> }
                        @if (_finding.ActionDecision == "action_planned") { <span class="badge badge-blue">Aksiyon Planlandı</span> }
                    </div>
                    <h2 class="detail-header-title">@_finding.Title</h2>
                </div>
                <div style="display:flex;gap:8px;align-items:center;flex-shrink:0">
                    @if (HasPerm("audit.modify") && _finding.Status != "closed")
                    {
                        <button class="btn btn-outline btn-sm" @onclick="ToggleFindingEdit">
                            @(_showFindingEdit ? "İptal" : "Düzenle")
                        </button>
                    }
                    <a href="/audit/findings" class="btn btn-outline btn-sm">&#8592; Bulgular</a>
                </div>
            </div>
            <div class="detail-header-meta">
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Denetçi</span>
                    <span class="detail-meta-value">@(_finding.Auditor?.FullName ?? "—")</span>
                </div>
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Sorumlu</span>
                    <span class="detail-meta-value">@(_finding.Owner?.FullName ?? "—")</span>
                </div>
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Kategori</span>
                    <span class="detail-meta-value">@(_finding.Category ?? "—")</span>
                </div>
                @if (_finding.DueDate.HasValue)
                {
                    <div class="detail-meta-item">
                        <span class="detail-meta-label">Hedef Tarih</span>
                        <span class="detail-meta-value">@_finding.DueDate.Value.ToString("dd.MM.yyyy")</span>
                    </div>
                }
                @if (_finding.InternalAudit != null)
                {
                    <div class="detail-meta-item">
                        <span class="detail-meta-label">Denetim</span>
                        <span class="detail-meta-value">
                            <a href="/audit/internal/@_finding.InternalAudit.Id" style="color:var(--navy-700)">@_finding.InternalAudit.Code</a>
                        </span>
                    </div>
                }
                <div class="detail-meta-item">
                    <span class="detail-meta-label">Tarih</span>
                    <span class="detail-meta-value">@_finding.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))   { <div class="alert alert-error">@_error</div> }
        @if (!string.IsNullOrEmpty(_success)) { <div class="alert alert-success">@_success</div> }

        @* ── Bulgu Düzenleme Formu ── *@
        @if (_showFindingEdit)
        {
            <div class="card">
                <div class="section-title">Bulguyu Düzenle</div>
                <div class="form-group">
                    <label class="form-label">Başlık *</label>
                    <input class="form-control" @bind="_editTitle" maxlength="300" />
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div class="form-group">
                        <label class="form-label">Kategori</label>
                        <select class="form-control" @bind="_editCategory">
                            <option value="">— Seçiniz —</option>
                            @foreach (var c in _auditCategories)
                            { <option value="@c">@c</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Önem Derecesi</label>
                        <select class="form-control" @bind="_editSeverity">
                            <option value="">— Seçiniz —</option>
                            @foreach (var s in _auditSeverities)
                            { <option value="@s">@s</option> }
                        </select>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <div class="form-group">
                        <label class="form-label">Sorumlu</label>
                        <select class="form-control" @bind="_editOwnerId">
                            <option value="0">— Seçiniz —</option>
                            @foreach (var u in _allUsers)
                            { <option value="@u.Id">@u.FullName</option> }
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Hedef Tarih</label>
                        <input type="date" class="form-control" @bind="_editDueDate" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Açıklama</label>
                    <textarea class="form-control" rows="3" @bind="_editDescription"></textarea>
                </div>
                <div style="display:flex;gap:8px">
                    <button class="btn btn-success btn-sm" @onclick="SaveFindingEdit" disabled="@_loading">Kaydet</button>
                    <button class="btn btn-outline btn-sm" @onclick="() => _showFindingEdit = false">İptal</button>
                </div>
            </div>
        }

        <div class="card">
            <div class="section-title">Bulgu Bilgileri</div>
            <div class="meta-grid mg-2">
                <div><div class="fl">Kategori</div><span class="tag">@(_finding.Category ?? "—")</span></div>
                <div><div class="fl">Sorumlu</div><span>@(_finding.Owner?.FullName ?? "—")</span></div>
                <div><div class="fl">İlgili Denetim</div>
                    @if (_finding.InternalAudit != null)
                    { <a href="/audit/internal/@_finding.InternalAudit.Id" style="color:#1e40af">@_finding.InternalAudit.Title</a> }
                    else { <span style="color:#9ca3af">—</span> }
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_finding.Description))
            {
                <div style="margin-top:12px">
                    <div class="form-label">Açıklama</div>
                    <p style="font-size:14px;white-space:pre-wrap">@_finding.Description</p>
                </div>
            }
        </div>

        <!-- Aksiyon Kararı -->
        @if (_finding.Status == "open" && _finding.ActionDecision == null
            && (HasPerm("audit.write") && (_finding.OwnerId == UserId || HasPerm("audit.close_approve"))))
        {
            <div class="alert alert-warning" style="flex-direction:column;align-items:flex-start;margin-bottom:0">
                <div style="font-weight:600;margin-bottom:8px">Aksiyon Kararı: Bu bulgu için ne yapılacak?</div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <button class="btn btn-warning btn-sm" @onclick="() => { _showAction = true; _showAccept = false; }">
                        Aksiyon Al
                    </button>
                    <button class="btn btn-outline btn-sm" style="border-color:#6b7280;color:#374151"
                            @onclick="() => { _showAccept = !_showAccept; _showAction = false; }">
                        Riski Kabul Et
                    </button>
                </div>
                @if (_showAccept)
                {
                    <div style="margin-top:12px;background:#f8fafc;padding:14px;border-radius:8px">
                        <div class="form-group">
                            <label class="form-label">Kabul Gerekçesi</label>
                            <textarea class="form-control" rows="2" @bind="_acceptReason"
                                      placeholder="Riski kabul etme gerekçenizi yazın…"></textarea>
                        </div>
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-success btn-sm" @onclick="AcceptRisk">Onayla</button>
                            <button class="btn btn-outline btn-sm" @onclick="() => _showAccept = false">İptal</button>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_finding.ActionDecision == "risk_accepted")
        {
            <div class="alert alert-success">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div>
                    <div style="font-weight:600">Kalıntı Risk Kabul Edildi</div>
                    <div style="font-size:12px;margin-top:2px">Bu bulgu için risk kabul edildi.</div>
                </div>
            </div>
        }

        <!-- Aksiyon Planları -->
        @if (_finding.ActionDecision == "action_planned" || _showAction || _finding.Actions.Any())
        {
            <div class="card">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                    <div class="section-title" style="margin-bottom:0">Aksiyon Planları</div>
                    @if (HasPerm("audit.write") && _finding.Status == "open")
                    {
                        <button class="btn btn-primary btn-sm" @onclick="() => _showAction = !_showAction">
                            @(_showAction ? "İptal" : "+ Aksiyon Ekle")
                        </button>
                    }
                </div>

                @if (_showAction)
                {
                    <div style="background:#f8fafc;padding:16px;border-radius:8px;margin-bottom:16px">
                        <div class="form-group">
                            <label class="form-label">Açıklama *</label>
                            <textarea class="form-control" rows="2" @bind="_actDesc"></textarea>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sorumlu Birim *</label>
                            <select class="form-control" @bind="_actResp">
                                <option value="">— Seçiniz —</option>
                                @foreach (var d in _departments)
                                { <option value="@d.Name">@d.Name</option> }
                            </select>
                        </div>
                        <div style="display:flex;gap:8px">
                            <button class="btn btn-success btn-sm" @onclick="SaveAction" disabled="@_loading">Kaydet</button>
                            <button class="btn btn-outline btn-sm" @onclick="() => _showAction = false">İptal</button>
                        </div>
                    </div>
                }

                @if (!_finding.Actions.Any())
                {
                    <div class="empty-state"><p>Henüz aksiyon girilmemiş.</p></div>
                }
                else
                {
                    @foreach (var a in _finding.Actions.OrderBy(a => a.DueDate == null).ThenBy(a => a.DueDate))
                    {
                        var overdue = a.DueDate.HasValue && a.DueDate.Value < DateOnly.FromDateTime(DateTime.Today)
                                      && a.Status is "planned" or "in_progress";
                        <div style="padding:12px 0;border-bottom:1px solid #f3f4f6">
                            @if (_editActionId == a.Id)
                            {
                                @* ── Aksiyon düzenleme satır içi formu ── *@
                                <div style="background:#f8fafc;padding:14px;border-radius:8px;border:1px solid var(--border)">
                                    <div class="form-group">
                                        <label class="form-label">Açıklama *</label>
                                        <textarea class="form-control" rows="2" @bind="_editActDesc"></textarea>
                                    </div>
                                    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
                                        <div class="form-group" style="margin-bottom:0">
                                            <label class="form-label">Sorumlu Birim</label>
                                            <select class="form-control" @bind="_editActResp">
                                                <option value="">— Seçiniz —</option>
                                                @foreach (var d in _departments)
                                                { <option value="@d.Name">@d.Name</option> }
                                            </select>
                                        </div>
                                        <div class="form-group" style="margin-bottom:0">
                                            <label class="form-label">Hedef Tarih</label>
                                            <input type="date" class="form-control" @bind="_editActDue" />
                                        </div>
                                        <div class="form-group" style="margin-bottom:0">
                                            <label class="form-label">Durum</label>
                                            <select class="form-control" @bind="_editActStatus">
                                                <option value="planned">Planlandı</option>
                                                <option value="in_progress">Devam Ediyor</option>
                                                <option value="completed">Tamamlandı</option>
                                                <option value="cancelled">İptal</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div style="display:flex;gap:6px;margin-top:10px">
                                        <button class="btn btn-success btn-sm" @onclick="() => SaveActionEdit(a.Id)">Kaydet</button>
                                        <button class="btn btn-outline btn-sm" @onclick="() => _editActionId = 0">İptal</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div style="display:flex;gap:12px;align-items:flex-start">
                                    <div style="flex:1">
                                        <div style="font-size:13px;margin-bottom:4px">@a.Description</div>
                                        <div class="text-muted" style="display:flex;gap:8px;flex-wrap:wrap">
                                            @if (!string.IsNullOrEmpty(a.Responsible))
                                            { <span class="badge badge-orange" style="font-size:10px">@a.Responsible</span> }
                                            @if (a.DueDate.HasValue)
                                            {
                                                <span style="font-size:11px;@(overdue ? "color:#dc2626;font-weight:600" : "color:var(--text-3)")">
                                                    @a.DueDate.Value.ToString("dd.MM.yyyy")@(overdue ? " — GECİKTİ" : "")
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap">
                                        <span class="badge @ActionBadge(a.Status)">@ActionLabel(a.Status)</span>
                                        @if (HasPerm("audit.modify") && a.Status != "completed" && a.Status != "cancelled")
                                        {
                                            <button class="btn btn-success btn-sm"
                                                    @onclick='() => UpdateAction(a.Id, "completed")'>Tamamlandı</button>
                                            <button class="btn btn-outline btn-sm"
                                                    @onclick="() => StartActionEdit(a)">Düzenle</button>
                                        }
                                        @if (HasPerm("audit.modify"))
                                        {
                                            <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteAction(a.Id)">Sil</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- Ekler -->
        <div class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                <div class="section-title" style="margin-bottom:0">Ekler</div>
                @if (HasPerm("audit.modify"))
                {
                    <button class="btn btn-outline btn-sm"
                            @onclick="TriggerFileInput">Dosya Ekle</button>
                    <InputFile id="finding-file-input" OnChange="UploadFiles"
                               multiple style="display:none" />
                }
            </div>
            @if (_uploading) { <div style="font-size:13px;color:#6b7280">Yükleniyor…</div> }
            @if (!_finding.Attachments.Any())
            {
                <div class="empty-state"><p>Henüz ek dosya yüklenmemiş.</p></div>
            }
            else
            {
                @foreach (var att in _finding.Attachments.OrderByDescending(a => a.UploadedAt))
                {
                    <div style="display:flex;gap:12px;align-items:center;padding:8px 0;border-bottom:1px solid var(--border)">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="var(--gray-400)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><polyline points="9 18 15 12 9 6"/></svg>
                        <div style="flex:1">
                            <a href="/audit/findings/@_finding.Id/attachments/@att.Id/download" target="_blank"
                               style="font-size:13px;color:#1e40af;font-weight:500">@att.FileName</a>
                            <div style="font-size:11px;color:#9ca3af">
                                @FormatSize(att.FileSize) • @att.UploadedBy?.FullName • @att.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy")
                            </div>
                        </div>
                        @if (HasPerm("audit.modify"))
                        {
                            <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteFile(att.Id)">Sil</button>
                        }
                    </div>
                }
            }
        </div>

        <!-- Kapanış Başvurusu -->
        @if (_finding.Status == "open" && HasPerm("audit.modify"))
        {
            <div class="card">
                <div class="section-title">Kapanış Başvurusu</div>
                <div class="form-group">
                    <label class="form-label">Kapanış Gerekçesi *</label>
                    <textarea class="form-control" rows="3" @bind="_closureDesc"></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Kanıt Dosyaları</label>
                    <InputFile OnChange="HandleClosureFiles" multiple
                               style="display:block;padding:8px;border:1px dashed #d1d5db;border-radius:6px;width:100%;font-size:13px" />
                    @if (_closureFiles.Any())
                    {
                        <div style="margin-top:6px">
                            @foreach (var f in _closureFiles)
                            {
                                <div style="font-size:12px;color:#374151;padding:2px 0">
                                    @f.Name <span style="color:#9ca3af">(@FormatSize(f.Size))</span>
                                </div>
                            }
                        </div>
                    }
                </div>
                <button class="btn btn-primary btn-sm" @onclick="SubmitClosure" disabled="@_loading">
                    Kapanış Başvurusu Yap
                </button>
            </div>
        }

        <!-- Kapanış İnceleme -->
        @if (_finding.Status == "closure_requested" && HasPerm("audit.close_approve"))
        {
            var pending = _finding.ClosureRequests.FirstOrDefault(r => r.Status == "pending");
            @if (pending != null)
            {
                <div class="card">
                    <div class="section-title">Kapanış Başvurusu İnceleme</div>
                    <p style="font-size:13px">@pending.Description</p>
                    @if (!string.IsNullOrEmpty(pending.Evidence))
                    {
                        <div style="margin-bottom:8px;display:flex;flex-wrap:wrap;gap:6px">
                            @foreach (var fn in pending.Evidence.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <a href="@ClosureFileUrl(fn)" target="_blank"
                                   style="font-size:12px;color:#1e40af;display:flex;align-items:center;gap:3px">
                                    @fn
                                </a>
                            }
                        </div>
                    }
                    <div class="form-group" style="margin-top:12px">
                        <label class="form-label">İnceleme Notu</label>
                        <textarea class="form-control" rows="2" @bind="_reviewNote"></textarea>
                    </div>
                    <div style="display:flex;gap:8px">
                        <button class="btn btn-success btn-sm" @onclick='() => ReviewClosure(pending.Id, "approved")'>Onayla</button>
                        <button class="btn btn-danger btn-sm" @onclick='() => ReviewClosure(pending.Id, "rejected")'>Reddet</button>
                    </div>
                </div>
            }
        }

        <!-- Kapanış Geçmişi -->
        @if (_finding.ClosureRequests.Any())
        {
            <div class="card">
                <div class="section-title">Başvuru Geçmişi</div>
                @foreach (var req in _finding.ClosureRequests.OrderByDescending(r => r.RequestedAt))
                {
                    <div style="padding:10px 0;border-bottom:1px solid #f3f4f6">
                        <div style="display:flex;justify-content:space-between">
                            <span style="font-size:13px">@req.Description</span>
                            <span class="badge @ReqBadge(req.Status)">@ReqLabel(req.Status)</span>
                        </div>
                        <div class="text-muted">@req.RequestedBy?.FullName • @req.RequestedAt.ToString("dd.MM.yyyy")</div>
                        @if (!string.IsNullOrEmpty(req.Evidence))
                        {
                            <div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:6px">
                                @foreach (var fn in req.Evidence.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <a href="@ClosureFileUrl(fn)" target="_blank"
                                       style="font-size:11px;color:#1e40af;display:flex;align-items:center;gap:3px">
                                        @fn
                                    </a>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(req.ReviewNotes))
                        { <div style="font-size:12px;color:#6b7280;margin-top:4px">Not: @req.ReviewNotes</div> }
                    </div>
                }
            </div>
        }

        @* ── İlgili Riskler ──────────────────────────────────────────────────── *@
        @if (_finding.RiskLinks.Any())
        {
            <div class="card" style="margin-top:16px">
                <div style="font-weight:700;font-size:13px;color:var(--text-1);margin-bottom:12px">İlgili Riskler</div>
                <div style="display:flex;flex-direction:column;gap:6px">
                    @foreach (var link in _finding.RiskLinks)
                    {
                        <a href="/risk/@link.RiskId" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--border);border-radius:8px;text-decoration:none;color:inherit">
                            <code style="color:#1e40af;font-size:12px;font-weight:600">@link.Risk.Code</code>
                            <span style="font-size:13px">@link.Risk.Title</span>
                        </a>
                    }
                </div>
            </div>
        }

        @* ── Aktivite Tarihçesi ──────────────────────────────────────────────── *@
        @if (_finding.ActivityLogs.Any())
        {
            <div class="card" style="margin-top:16px">
                <div style="font-weight:700;font-size:13px;color:var(--text-1);margin-bottom:12px">Tarihçe</div>
                @foreach (var log in _finding.ActivityLogs.OrderByDescending(l => l.Timestamp))
                {
                    <div style="display:flex;gap:12px;padding:8px 0;border-bottom:1px solid var(--border)">
                        <div style="min-width:130px">
                            <div style="font-size:11px;color:var(--text-3)">@log.Timestamp.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
                            <div style="font-size:12px;color:var(--text-2);font-weight:600">@(log.User?.FullName ?? "Sistem")</div>
                        </div>
                        <div>
                            <div style="font-size:13px;font-weight:600;color:var(--text-1)">@log.Action</div>
                            @if (!string.IsNullOrEmpty(log.Detail))
                            { <div style="font-size:12px;color:var(--text-3);margin-top:2px">@log.Detail</div> }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private AuditFinding? _finding;
    private bool _loading, _uploading;
    private async Task TriggerFileInput()
    {
        try { await JS.InvokeVoidAsync("document.getElementById('finding-file-input').click"); }
        catch { /* dosya seçici açılamadı — sessizce geç */ }
    }
    private string _error = "", _success = "";
    private string _closureDesc = "", _reviewNote = "";
    private List<IBrowserFile> _closureFiles = [];
    private string _acceptReason = "";
    private string _actDesc = "", _actResp = "";
    private bool _showAction, _showAccept;
    private List<RiskManagement.Models.Department> _departments = [];
    private List<RiskManagement.Models.User> _allUsers = [];
    private List<string> _auditCategories = [], _auditSeverities = [];

    // Bulgu düzenleme
    private bool   _showFindingEdit;
    private string _editTitle = "", _editCategory = "", _editSeverity = "", _editDescription = "";
    private int    _editOwnerId;
    private DateTime? _editDueDate;

    // Aksiyon düzenleme
    private int    _editActionId;
    private string _editActDesc = "", _editActResp = "", _editActStatus = "";
    private DateTime? _editActDue;

    // _user DB'den yüklenir (OnInitialized); Role oradan alınır — çoklu rol senaryosunda ilk claim sırası önemli değil
    private string Role   => _user?.Role ?? HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private User?  _user;
    private bool   HasPerm(string perm) => _user != null && Auth.HasPermission(_user, perm);

    protected override void OnInitialized()
    {
        _user = Auth.GetUserById(UserId);
        Load();
        _departments     = OrgSvc.GetDepartments();
        _allUsers        = OrgSvc.GetActiveUsers();
        _auditCategories = [.. CfgSvc.GetList("audit_categories")];
        _auditSeverities = [.. CfgSvc.GetList("audit_severities")];
    }

    private void Load()
    {
        _finding = AuditSvc.GetFindingForUser(Id, UserId, Role);
        if (_finding == null) Nav.NavigateTo("/audit/findings");
    }

    // ── Bulgu düzenleme ────────────────────────────────────────────────────────
    private void ToggleFindingEdit()
    {
        _showFindingEdit = !_showFindingEdit;
        if (_showFindingEdit && _finding != null)
        {
            _editTitle       = _finding.Title;
            _editCategory    = _finding.Category    ?? "";
            _editSeverity    = _finding.Severity    ?? "";
            _editDescription = _finding.Description ?? "";
            _editOwnerId     = _finding.OwnerId ?? 0;
            _editDueDate     = _finding.DueDate.HasValue
                ? _finding.DueDate.Value.ToDateTime(TimeOnly.MinValue) : null;
        }
    }

    private async Task SaveFindingEdit()
    {
        if (string.IsNullOrWhiteSpace(_editTitle)) { _error = "Başlık zorunludur."; return; }
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        _loading = true;
        var due = _editDueDate.HasValue ? DateOnly.FromDateTime(_editDueDate.Value) : (DateOnly?)null;
        await AuditSvc.UpdateFindingAsync(Id, _editTitle,
            string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
            string.IsNullOrWhiteSpace(_editCategory)    ? null : _editCategory,
            string.IsNullOrWhiteSpace(_editSeverity)    ? null : _editSeverity,
            null,
            _editOwnerId > 0 ? _editOwnerId : null,
            due, caller: _user);
        _success = "Bulgu güncellendi."; _error = "";
        _showFindingEdit = false;
        Load(); _loading = false;
    }

    // ── Aksiyon düzenleme ─────────────────────────────────────────────────────
    private void StartActionEdit(AuditFindingAction a)
    {
        _editActionId  = a.Id;
        _editActDesc   = a.Description;
        _editActResp   = a.Responsible ?? "";
        _editActStatus = a.Status;
        _editActDue    = a.DueDate.HasValue ? a.DueDate.Value.ToDateTime(TimeOnly.MinValue) : null;
    }

    private async Task SaveActionEdit(int actionId)
    {
        if (string.IsNullOrWhiteSpace(_editActDesc)) { _error = "Açıklama zorunludur."; return; }
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        var due = _editActDue.HasValue ? DateOnly.FromDateTime(_editActDue.Value) : (DateOnly?)null;
        await AuditSvc.UpdateFindingActionAsync(Id, actionId, _editActDesc,
            string.IsNullOrWhiteSpace(_editActResp) ? null : _editActResp, due, caller: _user);
        if (_editActStatus != _finding?.Actions.FirstOrDefault(a => a.Id == actionId)?.Status)
            await AuditSvc.UpdateFindingActionStatusAsync(Id, actionId, _editActStatus, caller: _user);
        _success = "Aksiyon güncellendi."; _error = "";
        _editActionId = 0;
        Load();
    }

    private async Task AcceptRisk()
    {
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        await AuditSvc.SetActionDecisionAsync(Id, "risk_accepted", caller: _user);
        _success = "Risk kabul edildi."; _error = "";
        _showAccept = false;
        Load();
    }

    private async Task SaveAction()
    {
        if (string.IsNullOrWhiteSpace(_actDesc)) { _error = "Açıklama zorunludur."; return; }
        if (string.IsNullOrWhiteSpace(_actResp)) { _error = "Sorumlu birim seçiniz."; return; }
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        _loading = true;
        await AuditSvc.AddFindingActionAsync(Id, _actDesc, _actResp, null, UserId, caller: _user);
        _success = "Aksiyon eklendi."; _error = "";
        _actDesc = ""; _actResp = ""; _showAction = false;
        Load(); _loading = false;
    }

    private async Task UpdateAction(int actionId, string status)
    {
        if (_user == null) return;
        await AuditSvc.UpdateFindingActionStatusAsync(Id, actionId, status, caller: _user);
        _success = "Aksiyon güncellendi."; _error = "";
        Load();
    }

    private async Task DeleteAction(int actionId)
    {
        if (_user == null) return;
        await AuditSvc.DeleteFindingActionAsync(Id, actionId, caller: _user);
        _success = "Aksiyon silindi."; _error = "";
        Load();
    }

    private async Task UploadFiles(InputFileChangeEventArgs e)
    {
        _uploading = true;
        var uploadDir = Path.Combine(Env.ContentRootPath, "uploads", "findings", Id.ToString());
        Directory.CreateDirectory(uploadDir);
        foreach (var file in e.GetMultipleFiles(10))
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!AuditService.AllowedAttachmentExtensions.Contains(ext))
            { _error = $"İzin verilmeyen dosya türü: {ext}"; continue; }
            if (file.Size > AuditService.MaxAttachmentSize)
            { _error = $"Dosya {AuditService.MaxAttachmentSize / 1024 / 1024} MB sınırını aşıyor."; continue; }

            var originalName = Path.GetFileName(file.Name);
            var storedName   = $"{Guid.NewGuid()}{ext}";
            var dest = Path.Combine(uploadDir, storedName);
            await using var fs  = File.Create(dest);
            await using var src = file.OpenReadStream(maxAllowedSize: AuditService.MaxAttachmentSize);
            await src.CopyToAsync(fs);
            await AuditSvc.SaveAttachmentAsync(Id, originalName, dest, file.Size, UserId);
        }
        if (string.IsNullOrEmpty(_error)) _success = "Dosyalar yüklendi.";
        _uploading = false;
        Load();
    }

    private async Task DeleteFile(int attachmentId)
    {
        await AuditSvc.DeleteAttachmentAsync(attachmentId);
        _success = "Dosya silindi."; _error = "";
        Load();
    }

    private void HandleClosureFiles(InputFileChangeEventArgs e)
    {
        _closureFiles = [.. e.GetMultipleFiles(10)];
    }

    private async Task SubmitClosure()
    {
        if (string.IsNullOrWhiteSpace(_closureDesc)) { _error = "Gerekçe zorunludur."; return; }
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        _loading = true;
        var evidence = "";
        if (_closureFiles.Any())
        {
            var uploadDir = Path.Combine(Env.ContentRootPath, "uploads", "findings", Id.ToString(), "closure");
            Directory.CreateDirectory(uploadDir);
            var names = new List<string>();
            foreach (var file in _closureFiles)
            {
                var ext = Path.GetExtension(file.Name).ToLowerInvariant();
                if (!AuditService.AllowedAttachmentExtensions.Contains(ext)) continue;
                if (file.Size > AuditService.MaxAttachmentSize) continue;

                // Guid prefix → overwrite koruması + path traversal güvencesi
                var storedName = $"{Guid.NewGuid()}{ext}";
                var dest = Path.Combine(uploadDir, storedName);
                await using var fs  = File.Create(dest);
                await using var src = file.OpenReadStream(maxAllowedSize: AuditService.MaxAttachmentSize);
                await src.CopyToAsync(fs);
                names.Add(storedName);
            }
            evidence = string.Join('\n', names);
        }
        await AuditSvc.SubmitClosureRequestAsync(Id, _closureDesc, evidence, UserId, caller: _user);
        _success = "Kapanış başvurusu yapıldı."; _closureDesc = ""; _closureFiles = [];
        Load(); _loading = false;
    }

    private async Task ReviewClosure(int reqId, string decision)
    {
        if (_user == null) { _error = "Oturum bilgisi alınamadı."; return; }
        _loading = true;
        await AuditSvc.ReviewClosureRequestAsync(Id, reqId, decision, _reviewNote, UserId, caller: _user);
        _success = decision == "approved" ? "Bulgu kapatıldı." : "Başvuru reddedildi.";
        _reviewNote = ""; Load(); _loading = false;
    }

    private static string FormatSize(long bytes)
    {
        if (bytes >= 1024L * 1024) return $"{bytes / 1024 / 1024} MB";
        if (bytes >= 1024) return $"{bytes / 1024} KB";
        return $"{bytes} B";
    }

    private string ClosureFileUrl(string fileName) =>
        $"/audit/findings/{Id}/closure-files/{Uri.EscapeDataString(fileName)}";


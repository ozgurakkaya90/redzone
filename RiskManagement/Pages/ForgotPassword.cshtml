@page "/forgot-password"
@model RiskManagement.Pages.ForgotPasswordModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Şifremi Unuttum — RED</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/css/app.css" />
</head>
<body>
<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <div class="login-logo-icon">
                <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                </svg>
            </div>
            <h1>Şifremi Unuttum</h1>
            <p>Şifre sıfırlama talebi</p>
        </div>

        @if (Model.Submitted)
        {
            <div style="text-align:center;padding:8px 0">
                <div class="auth-state-icon auth-state-icon--success">
                    <svg width="26" height="26" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                    </svg>
                </div>
                <div style="font-weight:700;color:var(--text-1);margin-bottom:8px">Talebiniz alındı</div>
                <div style="font-size:13px;color:var(--text-2);line-height:1.6">
                    Şifre sıfırlama bağlantısı sistem yöneticinize iletildi.<br />
                    Yöneticiniz size bağlantıyı kısa süre içinde ulaştıracaktır.
                </div>
            </div>
            <div style="margin-top:24px">
                <a href="/login" class="btn btn-outline" style="width:100%;text-align:center;display:block">
                    ← Giriş sayfasına dön
                </a>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(Model.Error))
            {
                <div class="alert alert-error" style="margin-bottom:16px">@Model.Error</div>
            }

            <form method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input class="form-control" name="username" value="@Model.Username"
                           placeholder="kullanıcı adı" autofocus autocomplete="username" />
                </div>
                <button type="submit" class="btn btn-primary" style="width:100%">
                    Talep Gönder
                </button>
            </form>
            <div style="text-align:center;margin-top:14px;font-size:13px">
                <a href="/login" style="color:#E1251B">← Giriş sayfasına dön</a>
            </div>
        }
    </div>
</div>
</body>
</html>

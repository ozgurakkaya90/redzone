@page "/admin/permissions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]
@inject AuthService Auth
@inject IDbContextFactory<AppDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using RiskManagement.Models
@using RiskManagement.Services

<PageTitle>Yetki Yönetimi</PageTitle>

<div class="page-toolbar">
    <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Yetki Yönetimi</h1>
        <div class="page-toolbar-sub">Rol bazlı erişim kontrolü — her role hangi işlemlerin açık olduğunu belirleyin. Özel rol oluşturmak için <a href="/admin/roles">Rol Yönetimi</a> sayfasına gidin.</div>
    </div>
    <div class="page-toolbar-actions">
        @if (_dirty)
        {
            <span style="font-size:12px;font-weight:600;color:#92400e;background:#fef3c7;padding:5px 12px;border-radius:6px;border:1px solid #fcd34d">
                Kaydedilmemiş değişiklik
            </span>
        }
        <button class="btn btn-outline btn-sm" @onclick="ResetDefaults">↺ Varsayılanlara Sıfırla</button>
        <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Kaydet</button>
    </div>
</div>

@if (_saved)
{
    <div class="alert alert-success" style="margin-bottom:16px">Yetki matrisi başarıyla kaydedildi.</div>
}

<div style="border:1px solid var(--border);border-radius:10px;overflow:hidden;overflow-x:auto;box-shadow:var(--shadow-sm)">
    <table style="border-collapse:collapse;width:100%;font-size:13px">
        <thead>
            <tr style="border-bottom:2px solid var(--border)">
                <th style="padding:14px 20px;text-align:left;background:#f8fafc;min-width:260px;
                            font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--text-3)">
                    İzin
                </th>
                @foreach (var role in _editableRoles)
                {
                    var cnt = _matrix.TryGetValue(role, out var s) ? s.Count : 0;
                    var total = AuthService.Permissions.Count;
                    <th style="background:#f8fafc;border-left:1px solid var(--border);
                                padding:12px 8px;text-align:center;min-width:88px;max-width:100px">
                        <div style="font-size:12px;font-weight:600;color:var(--text);line-height:1.3;margin-bottom:4px">
                            @_roleLabels.GetValueOrDefault(role, role)
                        </div>
                        <div style="display:inline-block;font-size:10px;font-weight:600;
                                    padding:1px 7px;border-radius:10px;
                                    background:@(cnt==total?"#dcfce7":cnt>0?"#dbeafe":"var(--gray-100)");
                                    color:@(cnt==total?"#15803d":cnt>0?"#1d4ed8":"var(--text-3)")">
                            @cnt / @total
                        </div>
                    </th>
                }
                <th style="background:#f0fdf4;border-left:1px solid #bbf7d0;padding:12px 8px;text-align:center;min-width:88px">
                    <div style="font-size:12px;font-weight:600;color:#15803d;line-height:1.3;margin-bottom:4px">
                        @_adminLabel
                    </div>
                    <div style="display:inline-block;font-size:10px;font-weight:600;
                                padding:1px 7px;border-radius:10px;background:#bbf7d0;color:#15803d">
                        Tümü
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in AuthService.PermGroups)
            {
                <tr>
                    <td colspan="@(_editableRoles.Length + 2)"
                        style="padding:8px 20px;background:#f8fafc;border-top:1px solid var(--border);border-bottom:1px solid var(--border);
                               border-left:3px solid @group.Color">
                        <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:@group.Color">
                            @group.Name
                        </span>
                    </td>
                </tr>

                @foreach (var item in group.Items)
                {
                    <tr style="border-bottom:1px solid #f1f5f9;transition:background .1s"
                        @onmouseenter="@(() => _hoverRow = item.Key)"
                        @onmouseleave="@(() => _hoverRow = null)">
                        <td style="padding:10px 20px;min-width:260px">
                            <div style="display:flex;align-items:center;gap:8px">
                                <span style="width:7px;height:7px;border-radius:50%;flex-shrink:0;background:@(_levelColors.GetValueOrDefault(item.Level,"#94a3b8"))"></span>
                                <span style="font-size:13px;color:var(--text);flex:1">@item.Description</span>
                                <span style="font-size:10px;font-family:monospace;color:var(--text-3);
                                             background:var(--gray-100);padding:1px 5px;border-radius:4px;
                                             opacity:@(_hoverRow==item.Key?"1":"0");transition:opacity .15s">
                                    @item.Key
                                </span>
                            </div>
                        </td>

                        @foreach (var role in _editableRoles)
                        {
                            var key = item.Key;
                            var r   = role;
                            var chk = _matrix.TryGetValue(r, out var set) && set.Contains(key);
                            <td style="text-align:center;border-left:1px solid #f1f5f9;padding:8px 0;width:88px">
                                <button style="display:inline-flex;align-items:center;justify-content:center;
                                               width:28px;height:28px;border-radius:6px;cursor:pointer;
                                               border:@(chk?"none":"1.5px solid var(--border)");
                                               background:@(chk?"#1e3a5f":"var(--surface)");
                                               color:@(chk?"#fff":"transparent");
                                               box-shadow:@(chk?"0 1px 3px rgba(30,58,95,.25)":"none");
                                               transition:all .15s"
                                        @onclick="() => OnToggle(r, key, !chk)"
                                        title="@(chk?"Kaldır":"Ver")">
                                    @if (chk)
                                    {
                                        <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
                                            <path d="M2.5 7L5.5 10L11.5 4" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    }
                                </button>
                            </td>
                        }

                        <td style="text-align:center;border-left:1px solid #d1fae5;background:#f8fffe;width:88px">
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                                <path d="M2.5 7L5.5 10L11.5 4" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<div style="display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin-top:12px;padding:4px">
    @foreach (var (key, color) in _levelColors)
    {
        <span style="display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--text-2)">
            <span style="width:7px;height:7px;border-radius:50%;background:@color;display:inline-block"></span>
            @key
        </span>
    }
</div>

@code {
    private string[] _editableRoles = [];
    private Dictionary<string, HashSet<string>> _matrix = [];
    // Rol etiketleri init aşamasında önceden hesaplanır; render sırasında DB'ye gidilmez.
    private Dictionary<string, string> _roleLabels = [];
    private string _adminLabel = "";
    private bool _saved;
    private bool _dirty;
    private string? _hoverRow;

    private static readonly Dictionary<string, string> _levelColors = new()
    {
        ["Okuma"]     = "#15803d",
        ["Yazma"]     = "#1d4ed8",
        ["Düzenleme"] = "#b45309",
        ["Onaylama"]  = "#7c3aed",
        ["Denetim"]   = "#0f766e",
        ["Yönetim"]   = "#9f1239",
        ["Kurul"]     = "#7c3aed",
        ["İnceleme"]  = "#0369a1",
    };

    protected override async Task OnInitializedAsync()
    {
        _editableRoles = Auth.GetAllRoles()
            .Where(r => r.Name != "admin")
            .Select(r => r.Name)
            .ToArray();
        // Etiketleri await'ten ÖNCE (senkron) hesapla. Render sırasında Auth.GetRoleLabel
        // çağrılmaz; böylece LoadFromDbAsync'in await'i sürerken paylaşılan DbContext'e
        // ikinci bir sorgu açılmaz ("A second operation was started…" hatasının kaynağı).
        _adminLabel = Auth.GetRoleLabel("admin");
        _roleLabels = _editableRoles.ToDictionary(r => r, r => Auth.GetRoleLabel(r));
        await LoadFromDbAsync();
    }

    private async Task LoadFromDbAsync()
    {
        // Kısa ömürlü, izole context — circuit-scoped AppDbContext ile paylaşılmaz.
        await using var db = await DbFactory.CreateDbContextAsync();
        _matrix = [];
        foreach (var role in _editableRoles)
            _matrix[role] = (await db.RolePermissions
                .Where(rp => rp.Role == role)
                .Select(rp => rp.Permission)
                .ToListAsync())
                .ToHashSet();
        _saved = false;
        _dirty = false;
    }

    private void OnToggle(string role, string key, bool value)
    {
        if (!_matrix.ContainsKey(role)) _matrix[role] = [];
        if (value) _matrix[role].Add(key);
        else       _matrix[role].Remove(key);
        _dirty = true;
        _saved = false;
    }

    private async Task SaveAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        foreach (var role in _editableRoles)
        {
            db.RolePermissions.RemoveRange(db.RolePermissions.Where(rp => rp.Role == role));
            if (_matrix.TryGetValue(role, out var perms))
                foreach (var perm in perms)
                    db.RolePermissions.Add(new RiskManagement.Models.RolePermission { Role = role, Permission = perm });
        }
        await db.SaveChangesAsync();
        foreach (var role in _editableRoles)
            Auth.InvalidateRoleCache(role);
        _saved = true;
        _dirty = false;
    }

    private void ResetDefaults()
    {
        _matrix = [];
        foreach (var (role, perms) in AuthService.DefaultPermissions)
            if (role != "admin") _matrix[role] = [.. perms];
        _dirty = true;
        _saved = false;
    }
}

@page "/admin/database"
@using RiskManagement.Models
@using RiskManagement.Data
@using MySqlConnector
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IConfiguration Config
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]

<div class="page-header">
    <h1 class="page-title">🗄️ Veritabanı Bağlantıları</h1>
    <p class="page-subtitle">Uygulama veritabanı ve harici bağlantı yapılandırmaları</p>
</div>

@* ── Mevcut uygulama veritabanı ── *@
<div style="margin-bottom:24px">
    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--text-3);margin-bottom:10px">
        Uygulama Veritabanı (Aktif)
    </div>
    <div class="card" style="padding:16px 18px;border-left:4px solid #f97316;max-width:720px">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px">
            <div>
                <div style="font-weight:700;font-size:14px;color:var(--text-1)">
                    @_appDb.Name
                    <span style="margin-left:8px;font-size:10px;padding:2px 7px;border-radius:10px;background:#fff7ed;color:#c2410c;font-weight:600">SİSTEM</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:3px">
                    MySQL · @_appDb.Host:@_appDb.Port / @_appDb.DatabaseName · kullanıcı: @_appDb.Username
                </div>
            </div>
            <span class="badge badge-green" style="font-size:10px">Aktif</span>
        </div>

        @* ham bağlantı dizesi (şifre maskeli) *@
        <div style="background:#0f172a;border-radius:6px;padding:8px 12px;margin-bottom:10px">
            <code style="font-size:11px;color:#7dd3fc;word-break:break-all">@_appDbConnStrMasked</code>
        </div>

        @if (_appDbTestResult != null)
        {
            <div style="font-size:11px;margin-bottom:10px;padding:6px 10px;border-radius:6px;
                        background:@(_appDbTestOk ? "#f0fdf4" : "#fef2f2");
                        color:@(_appDbTestOk ? "#166534" : "#991b1b")">
                @_appDbTestResult
                @if (_appDbDetail != null)
                {
                    <span style="margin-left:8px;font-family:monospace">· @_appDbDetail</span>
                }
            </div>
        }

        <div style="display:flex;gap:8px;flex-wrap:wrap">
            <button class="btn btn-outline btn-sm" @onclick="TestAppDb" disabled="@_testingAppDb">
                @(_testingAppDb ? "Test ediliyor..." : "🔌 Test Et")
            </button>
            @if (_appDbTestOk)
            {
                <button class="btn btn-outline btn-sm" @onclick="BrowseAppDbTables">📋 Tablolar</button>
            }
        </div>
    </div>

    @if (_appDbTables.Any())
    {
        <div class="card" style="margin-top:10px;max-width:720px;padding:14px 16px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                <span style="font-size:13px;font-weight:600">Tablolar — @_appDb.DatabaseName (@_appDbTables.Count adet)</span>
                <button class="btn btn-outline btn-sm" @onclick="() => _appDbTables.Clear()">Kapat</button>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:6px">
                @foreach (var t in _appDbTables)
                {
                    <span style="padding:4px 10px;background:#f1f5f9;border-radius:6px;font-size:12px;font-family:monospace">@t</span>
                }
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success" style="margin-bottom:16px">@_success</div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-error" style="margin-bottom:16px">@_error</div>
}

@* ── Kayıtlı bağlantılar ── *@
@if (_connections.Any())
{
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px;margin-bottom:24px">
        @foreach (var conn in _connections)
        {
            <div class="card" style="padding:16px 18px;border-left:4px solid @ProviderColor(conn.Provider)">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:10px">
                    <div>
                        <div style="font-weight:700;font-size:14px;color:var(--text-1)">@conn.Name</div>
                        <div style="font-size:11px;color:var(--text-3);margin-top:2px">
                            @ProviderLabel(conn.Provider) · @conn.Host:@conn.Port / @conn.DatabaseName
                        </div>
                    </div>
                    <span class="badge @(conn.IsActive ? "badge-green" : "badge-red")" style="font-size:10px">
                        @(conn.IsActive ? "Aktif" : "Pasif")
                    </span>
                </div>

                @if (conn.LastTestedAt.HasValue)
                {
                    <div style="font-size:11px;margin-bottom:10px;padding:6px 10px;border-radius:6px;
                                background:@(conn.LastTestSuccess == true ? "#f0fdf4" : "#fef2f2");
                                color:@(conn.LastTestSuccess == true ? "#166534" : "#991b1b")">
                        @(conn.LastTestSuccess == true ? "✅" : "❌") @conn.LastTestMessage
                        <span style="color:var(--text-3);margin-left:6px">
                            (@conn.LastTestedAt.Value.ToLocalTime().ToString("dd.MM.yy HH:mm"))
                        </span>
                    </div>
                }

                <div style="display:flex;gap:6px;flex-wrap:wrap">
                    <button class="btn btn-outline btn-sm" @onclick="() => EditConn(conn)">Düzenle</button>
                    <button class="btn btn-outline btn-sm" @onclick="() => TestExisting(conn.Id)" disabled="@_testing">
                        @(_testingId == conn.Id && _testing ? "Test ediliyor..." : "🔌 Test Et")
                    </button>
                    @if (conn.LastTestSuccess == true)
                    {
                        <button class="btn btn-outline btn-sm" @onclick="() => BrowseTables(conn.Id)">
                            📋 Tablolar
                        </button>
                    }
                    <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteConn(conn.Id)">Sil</button>
                </div>
            </div>
        }
    </div>
}

@* ── Tablo listesi (test sonrası) ── *@
@if (_tables.Any())
{
    <div class="card" style="margin-bottom:24px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
            <div style="font-weight:700;font-size:14px">📋 Tablolar — @_browsingName</div>
            <button class="btn btn-outline btn-sm" @onclick="() => { _tables=[]; _browsingName=null; }">Kapat</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px">
            @foreach (var t in _tables)
            {
                <span style="padding:4px 10px;background:#f1f5f9;border-radius:6px;font-size:12px;font-family:monospace">@t</span>
            }
        </div>
    </div>
}

@* ── Yeni / Düzenle formu ── *@
<div class="card" style="max-width:720px">
    <div class="card-body">
        <h3 style="margin:0 0 20px;font-size:15px;font-weight:700;color:var(--text-1)">
            @(_editing ? "Bağlantıyı Düzenle" : "Yeni Bağlantı")
        </h3>

        @* Genel *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
            <div>
                <label class="form-label">Bağlantı Adı *</label>
                <input class="form-input" @bind="_cfg.Name" placeholder="Üretim MySQL" />
            </div>
            <div>
                <label class="form-label">Sürücü *</label>
                <select class="form-input" @bind="_cfg.Provider" @bind:after="ProviderChanged">
                    <option value="mysql">MySQL / MariaDB</option>
                    <option value="postgresql">PostgreSQL</option>
                    <option value="sqlserver">SQL Server</option>
                    <option value="sqlite">SQLite</option>
                </select>
            </div>
        </div>

        @if (_cfg.Provider == "sqlite")
        {
            <div style="margin-bottom:12px">
                <label class="form-label">Veritabanı Dosya Yolu *</label>
                <input class="form-input" @bind="_cfg.Host" placeholder="/var/data/mydb.sqlite" />
                <p style="font-size:11px;color:var(--text-3);margin:4px 0 0">SQLite için sunucu/port/kullanıcı gerekmez.</p>
            </div>
        }
        else
        {
            <div style="display:grid;grid-template-columns:1fr 120px;gap:12px;margin-bottom:12px">
                <div>
                    <label class="form-label">Sunucu Adresi *</label>
                    <input class="form-input" @bind="_cfg.Host" placeholder="db.sirket.com" />
                </div>
                <div>
                    <label class="form-label">Port</label>
                    <input class="form-input" type="number" @bind="_cfg.Port" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px">
                <div>
                    <label class="form-label">Veritabanı Adı *</label>
                    <input class="form-input" @bind="_cfg.DatabaseName" placeholder="MyDatabase" />
                </div>
                <div>
                    <label class="form-label">Kullanıcı Adı</label>
                    <input class="form-input" @bind="_cfg.Username" placeholder="dbuser" />
                </div>
                <div>
                    <label class="form-label">Şifre</label>
                    <input class="form-input" type="password" @bind="_cfg.Password" placeholder="••••••••" />
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
                <label style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid var(--border);cursor:pointer">
                    <input type="checkbox" @bind="_cfg.UseSsl" />
                    <span style="font-size:13px">SSL / TLS Kullan</span>
                </label>
                <div>
                    <label class="form-label">Bağlantı Zaman Aşımı (sn)</label>
                    <input class="form-input" type="number" @bind="_cfg.ConnectTimeout" style="max-width:100px" />
                </div>
            </div>
        }

        <label style="display:flex;align-items:center;gap:8px;margin-bottom:20px;cursor:pointer">
            <input type="checkbox" @bind="_cfg.IsActive" />
            <span style="font-size:13px">Aktif</span>
        </label>

        @* Bağlantı dizesi önizleme *@
        <div style="background:#0f172a;border-radius:8px;padding:10px 14px;margin-bottom:20px">
            <div style="font-size:10px;color:#64748b;margin-bottom:4px;text-transform:uppercase;letter-spacing:.05em">Bağlantı Dizesi Önizleme</div>
            <code style="font-size:11px;color:#7dd3fc;word-break:break-all">@BuildPreviewConnStr()</code>
        </div>

        @if (_testResult != null)
        {
            <div class="alert @(_testOk ? "alert-success" : "alert-error")" style="margin-bottom:16px">
                @_testResult
                @if (_testOk && _queryResult != null)
                {
                    <div style="margin-top:8px;font-size:12px;font-family:monospace;background:rgba(0,0,0,.06);padding:6px 10px;border-radius:5px">
                        @_queryResult
                    </div>
                }
            </div>
        }

        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <button class="btn btn-primary" @onclick="Save">Kaydet</button>
            <button class="btn btn-outline" @onclick="TestForm" disabled="@_testing">
                @(_testing && _testingId == 0 ? "Test ediliyor..." : "🔌 Bağlantıyı Test Et")
            </button>
            @if (_editing)
            {
                <button class="btn btn-outline" @onclick="CancelEdit">İptal</button>
            }
        </div>
    </div>
</div>

@code {
    // ── Harici bağlantılar ──
    private List<DatabaseConnectionConfig> _connections = [];
    private DatabaseConnectionConfig _cfg = new();
    private bool _editing;
    private string _success = "", _error = "";
    private string? _testResult;
    private string? _queryResult;
    private bool _testOk;
    private bool _testing;
    private int _testingId;

    private List<string> _tables = [];
    private string? _browsingName;

    // ── Uygulama veritabanı ──
    private AppDbInfo _appDb = new();
    private string _appDbConnStrMasked = "";
    private string? _appDbTestResult;
    private string? _appDbDetail;
    private bool _appDbTestOk;
    private bool _testingAppDb;
    private List<string> _appDbTables = [];

    protected override void OnInitialized()
    {
        Reload();
        ParseAppDb();
    }

    void ParseAppDb()
    {
        var raw = Config.GetConnectionString("DefaultConnection") ?? "";
        _appDbConnStrMasked = MaskPassword(raw);

        // Parse key=value pairs
        var parts = raw.Split(';', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2)
            .ToDictionary(p => p[0].Trim().ToLowerInvariant(), p => p[1].Trim());

        _appDb = new AppDbInfo
        {
            Name     = "Uygulama Veritabanı",
            Host     = parts.GetValueOrDefault("server") ?? parts.GetValueOrDefault("host") ?? "",
            Port     = int.TryParse(parts.GetValueOrDefault("port"), out var port) ? port : 3306,
            DatabaseName = parts.GetValueOrDefault("database") ?? parts.GetValueOrDefault("initial catalog") ?? "",
            Username = parts.GetValueOrDefault("user") ?? parts.GetValueOrDefault("uid") ?? parts.GetValueOrDefault("user id") ?? "",
            Password = parts.GetValueOrDefault("password") ?? parts.GetValueOrDefault("pwd") ?? "",
            UseSsl   = (parts.GetValueOrDefault("sslmode") ?? "").ToLower() is "required" or "true",
            RawConnStr = raw,
        };
    }

    static string MaskPassword(string cs)
    {
        return System.Text.RegularExpressions.Regex.Replace(
            cs, @"(?i)(password|pwd)=([^;]+)", m => $"{m.Groups[1].Value}=••••••");
    }

    async Task TestAppDb()
    {
        _testingAppDb = true; _appDbTestResult = null; _appDbDetail = null;
        StateHasChanged();
        try
        {
            using var conn = new MySqlConnection(_appDb.RawConnStr);
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT VERSION(), NOW(), (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE()) AS tbl_count";
            using var r = await cmd.ExecuteReaderAsync();
            if (await r.ReadAsync())
            {
                _appDbTestOk = true;
                _appDbTestResult = $"✅ Bağlantı başarılı — MySQL {r.GetString(0)}";
                _appDbDetail = $"Sunucu saati: {r.GetString(1)} · {r.GetInt32(2)} tablo";
            }
        }
        catch (Exception ex)
        {
            _appDbTestOk = false;
            _appDbTestResult = $"❌ {ex.Message}";
        }
        _testingAppDb = false;
    }

    async Task BrowseAppDbTables()
    {
        _appDbTables.Clear();
        try
        {
            using var conn = new MySqlConnection(_appDb.RawConnStr);
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SHOW TABLES";
            using var r = await cmd.ExecuteReaderAsync();
            while (await r.ReadAsync()) _appDbTables.Add(r.GetString(0));
        }
        catch (Exception ex) { _appDbTables.Add($"Hata: {ex.Message}"); }
    }

    record AppDbInfo
    {
        public string Name { get; init; } = "";
        public string Host { get; init; } = "";
        public int Port { get; init; } = 3306;
        public string DatabaseName { get; init; } = "";
        public string Username { get; init; } = "";
        public string Password { get; init; } = "";
        public bool UseSsl { get; init; }
        public string RawConnStr { get; init; } = "";
    }

    void Reload() => _connections = [.. Db.DatabaseConnections.OrderBy(c => c.Name)];

    void ProviderChanged()
    {
        _cfg.Port = _cfg.Provider switch
        {
            "mysql"      => 3306,
            "postgresql" => 5432,
            "sqlserver"  => 1433,
            _            => 0
        };
    }

    void EditConn(DatabaseConnectionConfig c)
    {
        _cfg = new DatabaseConnectionConfig
        {
            Id = c.Id, Name = c.Name, Provider = c.Provider,
            Host = c.Host, Port = c.Port, DatabaseName = c.DatabaseName,
            Username = c.Username, Password = c.Password,
            UseSsl = c.UseSsl, ConnectTimeout = c.ConnectTimeout, IsActive = c.IsActive
        };
        _editing = true;
        _testResult = null; _success = ""; _error = "";
    }

    void CancelEdit() { _cfg = new(); _editing = false; _testResult = null; }

    void Save()
    {
        _success = ""; _error = "";
        if (string.IsNullOrWhiteSpace(_cfg.Name) || string.IsNullOrWhiteSpace(_cfg.Host))
        { _error = "Bağlantı adı ve sunucu adresi zorunludur."; return; }

        if (_editing)
        {
            var existing = Db.DatabaseConnections.Find(_cfg.Id);
            if (existing == null) { _error = "Kayıt bulunamadı."; return; }
            CopyTo(_cfg, existing);
            Db.SaveChanges();
            _success = "Bağlantı güncellendi.";
            _editing = false; _cfg = new();
        }
        else
        {
            Db.DatabaseConnections.Add(_cfg);
            Db.SaveChanges();
            _success = "Bağlantı eklendi.";
            _cfg = new();
        }
        Reload();
    }

    void DeleteConn(int id)
    {
        var c = Db.DatabaseConnections.Find(id);
        if (c != null) { Db.DatabaseConnections.Remove(c); Db.SaveChanges(); }
        Reload();
    }

    async Task TestForm()
    {
        _testing = true; _testingId = 0; _testResult = null; _queryResult = null;
        StateHasChanged();
        (_testOk, _testResult, _queryResult) = await RunTest(_cfg);
        _testing = false;
    }

    async Task TestExisting(int id)
    {
        _testing = true; _testingId = id;
        StateHasChanged();
        var conn = Db.DatabaseConnections.Find(id);
        if (conn == null) { _testing = false; return; }
        var (ok, msg, qr) = await RunTest(conn);
        conn.LastTestedAt = DateTime.UtcNow;
        conn.LastTestSuccess = ok;
        conn.LastTestMessage = msg + (qr != null ? " · " + qr : "");
        Db.SaveChanges();
        Reload();
        _testing = false;
    }

    async Task BrowseTables(int id)
    {
        var conn = _connections.FirstOrDefault(c => c.Id == id);
        if (conn == null) return;
        _browsingName = conn.Name;
        _tables = await FetchTables(conn);
    }

    async Task<(bool ok, string msg, string? detail)> RunTest(DatabaseConnectionConfig c)
    {
        try
        {
            if (c.Provider == "sqlite")
            {
                var exists = System.IO.File.Exists(c.Host);
                return exists
                    ? (true, $"✅ SQLite dosyası bulundu: {c.Host}", null)
                    : (false, $"❌ Dosya bulunamadı: {c.Host}", null);
            }

            if (c.Provider == "mysql")
            {
                var cs = BuildConnStr(c);
                using var mysqlConn = new MySqlConnection(cs);
                await mysqlConn.OpenAsync();
                using var cmd = mysqlConn.CreateCommand();
                cmd.CommandText = "SELECT VERSION(), NOW()";
                using var reader = await cmd.ExecuteReaderAsync();
                string? version = null, now = null;
                if (await reader.ReadAsync()) { version = reader.GetString(0); now = reader.GetString(1); }
                return (true, $"✅ Bağlantı başarılı — MySQL {version}", $"Sunucu saati: {now}");
            }

            // PostgreSQL / SQL Server — TCP probe
            using var tcp = new System.Net.Sockets.TcpClient();
            var connected = await Task.Run(() =>
            {
                try { tcp.Connect(c.Host, c.Port); return true; }
                catch { return false; }
            });
            return connected
                ? (true, $"✅ {c.Host}:{c.Port} TCP bağlantısı başarılı (tam sorgu testi için sürücü eklenmeli)", null)
                : (false, $"❌ {c.Host}:{c.Port} adresine ulaşılamadı ({c.ConnectTimeout}sn)", null);
        }
        catch (Exception ex)
        {
            return (false, $"❌ Hata: {ex.Message}", null);
        }
    }

    async Task<List<string>> FetchTables(DatabaseConnectionConfig c)
    {
        if (c.Provider != "mysql") return ["(Tablo listesi yalnızca MySQL için desteklenmektedir)"];
        try
        {
            using var mysqlConn = new MySqlConnection(BuildConnStr(c));
            await mysqlConn.OpenAsync();
            using var cmd = mysqlConn.CreateCommand();
            cmd.CommandText = "SHOW TABLES";
            using var reader = await cmd.ExecuteReaderAsync();
            var list = new List<string>();
            while (await reader.ReadAsync()) list.Add(reader.GetString(0));
            return list;
        }
        catch (Exception ex)
        {
            return [$"Hata: {ex.Message}"];
        }
    }

    string BuildConnStr(DatabaseConnectionConfig c) => c.Provider switch
    {
        "mysql" => $"Server={c.Host};Port={c.Port};Database={c.DatabaseName};User={c.Username};Password={c.Password};SslMode={(c.UseSsl ? "Required" : "None")};ConnectionTimeout={c.ConnectTimeout};",
        "postgresql" => $"Host={c.Host};Port={c.Port};Database={c.DatabaseName};Username={c.Username};Password={c.Password};Timeout={c.ConnectTimeout};SslMode={(c.UseSsl ? "Require" : "Disable")};",
        "sqlserver" => $"Server={c.Host},{c.Port};Database={c.DatabaseName};User Id={c.Username};Password={c.Password};TrustServerCertificate={(c.UseSsl ? "False" : "True")};Connection Timeout={c.ConnectTimeout};",
        _ => c.Host
    };

    string BuildPreviewConnStr()
    {
        if (string.IsNullOrWhiteSpace(_cfg.Host)) return "(sunucu adresi girilmedi)";
        var cs = BuildConnStr(_cfg);
        return string.IsNullOrWhiteSpace(_cfg.Password) ? cs : cs.Replace(_cfg.Password, "••••••");
    }

    static void CopyTo(DatabaseConnectionConfig src, DatabaseConnectionConfig dst)
    {
        dst.Name = src.Name; dst.Provider = src.Provider; dst.Host = src.Host;
        dst.Port = src.Port; dst.DatabaseName = src.DatabaseName;
        dst.Username = src.Username; dst.Password = src.Password;
        dst.UseSsl = src.UseSsl; dst.ConnectTimeout = src.ConnectTimeout;
        dst.IsActive = src.IsActive;
    }

    static string ProviderColor(string p) => p switch
    {
        "mysql"      => "#f97316",
        "postgresql" => "#3b82f6",
        "sqlserver"  => "#8b5cf6",
        _            => "#6b7280"
    };

    static string ProviderLabel(string p) => p switch
    {
        "mysql"      => "MySQL",
        "postgresql" => "PostgreSQL",
        "sqlserver"  => "SQL Server",
        "sqlite"     => "SQLite",
        _            => p
    };
}

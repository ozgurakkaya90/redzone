@page "/admin/modules"
@attribute [Authorize(Roles = "admin")]
@inject ConfigService CfgSvc
@inject AppDbContext Db

<PageTitle>Modül Yönetimi</PageTitle>

<div class="page-header">
    <h1>Modül Yönetimi</h1>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-error" : "alert-success")" style="margin-bottom:16px">@_message</div>
}

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:16px">

    <!-- Risk -->
    <div style="background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden">
        <div style="background:#fff5f5;padding:20px 24px;border-bottom:1px solid #fca5a5;display:flex;align-items:center;gap:12px">
            <span style="font-size:26px">🛡️</span>
            <div style="flex:1">
                <div style="font-size:15px;font-weight:700;color:#c41c13">Risk Yönetimi</div>
                <div style="font-size:12px;color:#ef4444;margin-top:2px">Risk envanteri, kontrol matrisi, aksiyon planları</div>
            </div>
            <label class="module-toggle @(_riskActive ? "on" : "")" @onclick="ToggleRisk">
                <span class="module-toggle-knob"></span>
            </label>
        </div>
        <div style="padding:16px 24px">
            <div style="font-size:12px;color:var(--text-3);margin-bottom:12px">Bu modül kapalıyken aşağıdakiler gizlenir:</div>
            <ul style="margin:0;padding-left:18px;font-size:12px;color:var(--text-2);line-height:2">
                <li>Risk paneli ve risk envanteri</li>
                <li>Kontrol matrisi</li>
                <li>Risk önerme ekranları</li>
                <li>Görev panelindeki risk görevleri</li>
                <li>Ana panel Risk kartı</li>
            </ul>
            <div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;font-weight:600;
                        background:@(_riskActive ? "#f0fdf4" : "#fef2f2");
                        color:@(_riskActive ? "#166534" : "#991b1b");
                        border:1px solid @(_riskActive ? "#86efac" : "#fca5a5")">
                @(_riskActive ? "✅ Modül Aktif" : "⛔ Modül Kapalı")
            </div>
        </div>
    </div>

    <!-- Audit -->
    <div style="background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden">
        <div style="background:#f0fdf4;padding:20px 24px;border-bottom:1px solid #86efac;display:flex;align-items:center;gap:12px">
            <span style="font-size:26px">🔍</span>
            <div style="flex:1">
                <div style="font-size:15px;font-weight:700;color:#065f46">İç Denetim</div>
                <div style="font-size:12px;color:#059669;margin-top:2px">Denetim planları, bulgular, kapanış süreçleri</div>
            </div>
            <label class="module-toggle @(_auditActive ? "on" : "")" @onclick="ToggleAudit">
                <span class="module-toggle-knob"></span>
            </label>
        </div>
        <div style="padding:16px 24px">
            <div style="font-size:12px;color:var(--text-3);margin-bottom:12px">Bu modül kapalıyken aşağıdakiler gizlenir:</div>
            <ul style="margin:0;padding-left:18px;font-size:12px;color:var(--text-2);line-height:2">
                <li>Denetim paneli ve iç denetimler</li>
                <li>Bulgular listesi ve bulgu girişi</li>
                <li>Kapanış onay ekranları</li>
                <li>Görev panelindeki denetim görevleri</li>
                <li>Ana panel Denetim kartı</li>
            </ul>
            <div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;font-weight:600;
                        background:@(_auditActive ? "#f0fdf4" : "#fef2f2");
                        color:@(_auditActive ? "#166534" : "#991b1b");
                        border:1px solid @(_auditActive ? "#86efac" : "#fca5a5")">
                @(_auditActive ? "✅ Modül Aktif" : "⛔ Modül Kapalı")
            </div>
        </div>
    </div>

    <!-- Ethics -->
    <div style="background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden">
        <div style="background:#faf5ff;padding:20px 24px;border-bottom:1px solid #c4b5fd;display:flex;align-items:center;gap:12px">
            <span style="font-size:26px">⚖️</span>
            <div style="flex:1">
                <div style="font-size:15px;font-weight:700;color:#7c3aed">Etik Yönetimi</div>
                <div style="font-size:12px;color:#9333ea;margin-top:2px">Etik bildirimler, kurul incelemeleri</div>
            </div>
            <label class="module-toggle @(_ethicsActive ? "on" : "")" @onclick="ToggleEthics">
                <span class="module-toggle-knob"></span>
            </label>
        </div>
        <div style="padding:16px 24px">
            <div style="font-size:12px;color:var(--text-3);margin-bottom:12px">Bu modül kapalıyken aşağıdakiler gizlenir:</div>
            <ul style="margin:0;padding-left:18px;font-size:12px;color:var(--text-2);line-height:2">
                <li>Etik paneli ve etik bildirimler</li>
                <li>Etik bildirim oluşturma ekranı</li>
                <li>Görev panelindeki etik görevleri</li>
                <li>Ana panel Etik kartı</li>
                <li>Hızlı erişim etik bağlantıları</li>
            </ul>
            <div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;font-weight:600;
                        background:@(_ethicsActive ? "#f0fdf4" : "#fef2f2");
                        color:@(_ethicsActive ? "#166534" : "#991b1b");
                        border:1px solid @(_ethicsActive ? "#86efac" : "#fca5a5")">
                @(_ethicsActive ? "✅ Modül Aktif" : "⛔ Modül Kapalı")
            </div>
        </div>
    </div>

    <!-- Active Directory -->
    <div style="background:#fff;border:1px solid var(--border);border-radius:12px;overflow:hidden">
        <div style="background:#eff6ff;padding:20px 24px;border-bottom:1px solid #bfdbfe;display:flex;align-items:center;gap:12px">
            <span style="font-size:26px">🏢</span>
            <div style="flex:1">
                <div style="font-size:15px;font-weight:700;color:#1e40af">Active Directory Girişi</div>
                <div style="font-size:12px;color:#2563eb;margin-top:2px">Kurumsal LDAP/AD kimlik doğrulaması</div>
            </div>
            <label class="module-toggle @(_ldapEnabled ? "on" : "")" @onclick="ToggleLdap">
                <span class="module-toggle-knob"></span>
            </label>
        </div>
        <div style="padding:16px 24px">
            <div style="font-size:12px;color:var(--text-3);margin-bottom:12px">Bu seçenek kapalıyken aşağıdakiler gizlenir:</div>
            <ul style="margin:0;padding-left:18px;font-size:12px;color:var(--text-2);line-height:2">
                <li>Giriş ekranındaki "Active Directory" sekmesi</li>
                <li>AD ile giriş yapma imkânı</li>
            </ul>
            <div style="margin-top:10px;font-size:12px;color:#6b7280">
                LDAP sunucu ayarları için
                <a href="/admin/ldap" style="color:#1e40af;font-weight:600">AD Yapılandırması</a> sayfasını kullanın.
            </div>
            <div style="margin-top:14px;padding:10px 12px;border-radius:8px;font-size:12px;font-weight:600;
                        background:@(_ldapEnabled ? "#f0fdf4" : "#fef2f2");
                        color:@(_ldapEnabled ? "#166534" : "#991b1b");
                        border:1px solid @(_ldapEnabled ? "#86efac" : "#fca5a5")">
                @(_ldapEnabled ? "✅ AD Girişi Aktif" : "⛔ AD Girişi Kapalı")
            </div>
        </div>
    </div>

</div>

<div style="margin-top:24px;padding:16px 20px;background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;font-size:13px;color:#92400e;display:flex;gap:10px;align-items:flex-start">
    <span style="font-size:16px;flex-shrink:0">⚠️</span>
    <div>
        Modül durumu değişikliği <strong>anında</strong> uygulanır. Kapalı bir modülün verileri silinmez; yalnızca arayüzden gizlenir. Modül yeniden açıldığında tüm veriler erişilebilir olur.
    </div>
</div>

<style>
    .module-toggle {
        position: relative;
        display: inline-flex;
        width: 44px;
        height: 24px;
        background: #d1d5db;
        border-radius: 12px;
        cursor: pointer;
        transition: background .2s;
        flex-shrink: 0;
    }
    .module-toggle.on { background: #16a34a; }
    .module-toggle-knob {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
        transition: left .2s;
    }
    .module-toggle.on .module-toggle-knob { left: 23px; }
</style>

@code {
    private bool _riskActive, _auditActive, _ethicsActive, _ldapEnabled;
    private string _message = "";
    private bool _isError;

    protected override void OnInitialized()
    {
        _riskActive   = CfgSvc.IsModuleActive("risk");
        _auditActive  = CfgSvc.IsModuleActive("audit");
        _ethicsActive = CfgSvc.IsModuleActive("ethics");
        _ldapEnabled  = Db.LdapConfigurations.FirstOrDefault()?.Enabled ?? false;
    }

    private void ToggleRisk()
    {
        _riskActive = !_riskActive;
        Save("module_risk", _riskActive, "Risk Yönetimi");
    }

    private void ToggleAudit()
    {
        _auditActive = !_auditActive;
        Save("module_audit", _auditActive, "İç Denetim");
    }

    private void ToggleEthics()
    {
        _ethicsActive = !_ethicsActive;
        Save("module_ethics", _ethicsActive, "Etik Yönetimi");
    }

    private void ToggleLdap()
    {
        _ldapEnabled = !_ldapEnabled;
        try
        {
            var cfg = Db.LdapConfigurations.FirstOrDefault();
            if (cfg == null)
            {
                cfg = new RiskManagement.Models.LdapConfiguration { Enabled = _ldapEnabled };
                Db.LdapConfigurations.Add(cfg);
            }
            else
            {
                cfg.Enabled = _ldapEnabled;
            }
            Db.SaveChanges();
            _message = $"Active Directory girişi {(_ldapEnabled ? "aktifleştirildi" : "kapatıldı")}.";
            _isError = false;
        }
        catch
        {
            _message = "Kayıt sırasında hata oluştu.";
            _isError = true;
            _ldapEnabled = !_ldapEnabled; // geri al
        }
    }

    private void Save(string key, bool value, string label)
    {
        try
        {
            CfgSvc.Set(key, value);
            _message = $"{label} modülü {(value ? "aktifleştirildi" : "kapatıldı")}.";
            _isError = false;
        }
        catch
        {
            _message = "Kayıt sırasında hata oluştu.";
            _isError = true;
        }
    }
}

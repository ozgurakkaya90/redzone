@page "/admin/db-migrate"
@attribute [Authorize(Roles = "admin")]
@inject AppDbContext Db
@inject ILogger<DbMigrate> Logger
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore

<PageTitle>Veritabanı Migration</PageTitle>

<div style="max-width:760px">
    <div class="page-header">
        <div>
            <h1>Veritabanı Migration</h1>
            <div class="page-toolbar-sub">Bekleyen migration'ları uygula ve tablo durumunu kontrol et</div>
        </div>
        <a href="/admin/config" class="btn btn-outline btn-sm">← Yapılandırma</a>
    </div>

    @* ── Durum ── *@
    <div class="card" style="margin-bottom:16px">
        <div class="card-title">Migration Durumu</div>

        @if (_pending.Count == 0 && _applied.Count > 0)
        {
            <div class="alert alert-success" style="margin-bottom:12px">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <div>
                    <div style="font-weight:700">Tüm migration'lar uygulanmış</div>
                    <div style="font-size:12px;margin-top:2px">@_applied.Count migration uygulandı.</div>
                </div>
            </div>
        }

        @if (_pending.Count > 0)
        {
            <div class="alert alert-warning" style="margin-bottom:12px">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <div>
                    <div style="font-weight:700">@_pending.Count bekleyen migration</div>
                    <div style="font-size:12px;margin-top:2px">Bu migration'lar henüz uygulanmadı.</div>
                </div>
            </div>

            <div style="margin-bottom:14px">
                @foreach (var m in _pending)
                {
                    <div class="dm-migration-row dm-migration-row--pending">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="#92400e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                        <code>@m</code>
                    </div>
                }
            </div>
        }

        @if (_applied.Count > 0)
        {
            <details class="dm-details">
                <summary>Uygulanmış migration'ları göster (@_applied.Count)</summary>
                <div style="margin-top:8px">
                    @foreach (var m in _applied)
                    {
                        <div class="dm-migration-row dm-migration-row--applied">
                            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <code>@m</code>
                        </div>
                    }
                </div>
            </details>
        }

        @if (_loadError != null)
        {
            <div class="alert alert-error" style="margin-bottom:12px">@_loadError</div>
        }

        <div class="dm-action-bar">
            <button class="btn btn-primary" @onclick="RunMigrations" disabled="@_running">
                @(_running ? "Çalışıyor…" : "Migration Çalıştır")
            </button>
            <button class="btn btn-outline" @onclick="Refresh" disabled="@_running">Yenile</button>
            <button class="btn btn-ghost-danger" @onclick="RestartApp" disabled="@_restarting">
                @(_restarting ? "Yeniden başlatılıyor…" : "Uygulamayı Yeniden Başlat")
            </button>
        </div>

        @if (!string.IsNullOrEmpty(_restartMsg))
        {
            <div class="alert alert-warning" style="margin-top:10px">@_restartMsg</div>
        }
    </div>

    @* ── Sonuç ── *@
    @if (_result != null)
    {
        var isOk = !_result.StartsWith("Hata");
        <div class="alert @(isOk ? "alert-success" : "alert-error")" style="flex-direction:column;align-items:flex-start;margin-bottom:16px">
            <div style="font-weight:700;margin-bottom:4px">@(isOk ? "Başarılı" : "Hata")</div>
            <div style="font-size:12px;white-space:pre-wrap;font-family:var(--font-mono)">@_result</div>
        </div>
    }

    @* ── Tablo kontrol ── *@
    <div class="card">
        <div class="card-title">Kritik Tablo Kontrolü</div>

        @if (_tableChecks.Count == 0)
        {
            <button class="btn btn-outline btn-sm" @onclick="CheckTables">Tabloları Kontrol Et</button>
        }
        else
        {
            <div class="dm-table-grid">
                @foreach (var (table, ok, detail) in _tableChecks)
                {
                    <div class="alert @(ok ? "alert-success" : "alert-error")" style="flex-direction:column;align-items:flex-start;padding:10px 12px;margin-bottom:0">
                        <div style="display:flex;gap:6px;align-items:center">
                            <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                @if (ok) { <polyline points="20 6 9 17 4 12"/> }
                                else     { <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/> }
                            </svg>
                            <code>@table</code>
                        </div>
                        @if (!string.IsNullOrEmpty(detail))
                        { <div style="font-size:11px;margin-top:4px">@detail</div> }
                    </div>
                }
            </div>
            <button class="btn btn-outline btn-sm" style="margin-top:10px" @onclick="CheckTables">Tekrar Kontrol Et</button>
        }
    </div>
</div>


@code {
    private List<string> _pending  = [];
    private List<string> _applied  = [];
    private string?      _loadError;
    private string?      _result;
    private bool         _running;
    private bool         _restarting;
    private string       _restartMsg = "";
    private List<(string Table, bool Ok, string Detail)> _tableChecks = [];

    protected override void OnInitialized() => Refresh();

    private void Refresh()
    {
        _loadError = null;
        try
        {
            _applied = [.. Db.Database.GetAppliedMigrations()];
            _pending = [.. Db.Database.GetPendingMigrations()];
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
            _applied   = [];
            _pending   = [];
        }
    }

    private async Task RunMigrations()
    {
        _running = true;
        _result  = null;
        StateHasChanged();
        try
        {
            await Task.Run(() => Db.Database.Migrate());
            Refresh();
            _result = _pending.Count == 0
                ? "Migration'lar başarıyla uygulandı."
                : $"Tamamlandı. Hâlâ {_pending.Count} bekleyen migration var.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Migration hatası");
            _result = $"Hata: {ex.Message}";
            Refresh();
        }
        finally { _running = false; }
    }

    private async Task RestartApp()
    {
        _restarting = true;
        _restartMsg = "Yeniden başlatma komutu verildi. 10 saniye içinde site tekrar açılacak, lütfen bekleyin…";
        StateHasChanged();
        await Task.Delay(300);
        _ = Task.Run(async () => { await Task.Delay(500); Environment.Exit(0); });
    }

    private void CheckTables()
    {
        _tableChecks.Clear();
        var checks = new[]
        {
            ("AuditPlans",      "SELECT COUNT(*) FROM AuditPlans"),
            ("AuditPlanItems",  "SELECT COUNT(*) FROM AuditPlanItems"),
            ("InternalAudits",  "SELECT DepartmentId FROM InternalAudits LIMIT 1"),
            ("Users",           "SELECT COUNT(*) FROM Users"),
            ("Departments",     "SELECT COUNT(*) FROM Departments"),
            ("RiskLibraryItems","SELECT COUNT(*) FROM RiskLibraryItems"),
        };
        foreach (var (table, sql) in checks)
        {
            try
            {
                var conn = Db.Database.GetDbConnection();
                if (conn.State != System.Data.ConnectionState.Open) conn.Open();
                using var cmd = conn.CreateCommand();
                cmd.CommandText = sql;
                var val = cmd.ExecuteScalar();
                _tableChecks.Add((table, true, val?.ToString() is { } v && long.TryParse(v, out var n) ? $"{n} kayıt" : "OK"));
            }
            catch (Exception ex)
            {
                _tableChecks.Add((table, false, ex.Message.Length > 80 ? ex.Message[..80] + "…" : ex.Message));
            }
        }
        StateHasChanged();
    }
}

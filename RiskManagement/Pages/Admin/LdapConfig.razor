@page "/admin/ldap"
@using RiskManagement.Models
@using RiskManagement.Data
@using Novell.Directory.Ldap
@inject AppDbContext Db
@inject NavigationManager Nav
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "admin")]

<div class="page-header">
    <h1 class="page-title">🏢 Active Directory / LDAP Yapılandırması</h1>
    <p class="page-subtitle">Kurumsal dizin entegrasyonu ayarları</p>
</div>

@if (saved)
{
    <div class="alert alert-success" style="margin-bottom:16px">Ayarlar başarıyla kaydedildi.</div>
}
@if (testRunning)
{
    <div class="alert" style="margin-bottom:16px;background:#f0f9ff;border:1px solid #bae6fd;color:#0369a1">
        ⏳ Test çalışıyor…
    </div>
}
@if (testSteps.Count > 0)
{
    <div class="alert @(testSuccess ? "alert-success" : "alert-error")" style="margin-bottom:16px">
        <div style="font-weight:700;margin-bottom:8px">
            @(testSuccess ? "✅ Bağlantı testi başarılı" : "❌ Bağlantı testi başarısız")
        </div>
        <ol style="margin:0;padding-left:20px;line-height:1.9;font-size:13px">
            @foreach (var step in testSteps)
            {
                <li>@step</li>
            }
        </ol>
    </div>
}

<div class="card" style="max-width:760px">
    <div class="card-body">
        <h3 style="margin:0 0 20px;font-size:15px;font-weight:700;color:var(--text-1)">Bağlantı Ayarları</h3>

        <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding:14px 16px;background:#f8fafc;border-radius:8px;border:1px solid var(--border)">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-weight:600">
                <input type="checkbox" @bind="cfg.Enabled" style="width:16px;height:16px" />
                LDAP Entegrasyonunu Etkinleştir
            </label>
        </div>

        <div style="display:grid;grid-template-columns:1fr 120px;gap:12px;margin-bottom:12px">
            <div>
                <label class="form-label">LDAP Sunucu Adresi</label>
                <input class="form-input" @bind="cfg.Server" placeholder="ldap.sirket.com" />
            </div>
            <div>
                <label class="form-label">Port</label>
                <input class="form-input" type="number" @bind="cfg.Port" />
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">
            <label style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid var(--border);cursor:pointer">
                <input type="checkbox" @bind="cfg.UseSsl" />
                <span style="font-size:13px">SSL Kullan (LDAPS)</span>
            </label>
            <label style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid var(--border);cursor:pointer">
                <input type="checkbox" @bind="cfg.UseTls" />
                <span style="font-size:13px">TLS Başlat (StartTLS)</span>
            </label>
        </div>

        <div style="margin-bottom:12px">
            <label class="form-label">Zaman Aşımı (saniye)</label>
            <input class="form-input" type="number" @bind="cfg.Timeout" style="max-width:120px" />
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0" />
        <h3 style="margin:0 0 16px;font-size:15px;font-weight:700;color:var(--text-1)">Kimlik Doğrulama</h3>

        <div style="margin-bottom:12px">
            <label class="form-label">Bind DN (Servis Hesabı)</label>
            <input class="form-input" @bind="cfg.BindDn" placeholder="CN=svc-ldap,OU=ServiceAccounts,DC=sirket,DC=com" />
        </div>
        <div style="margin-bottom:12px">
            <label class="form-label">Bind Şifresi</label>
            <input class="form-input" type="password" @bind="cfg.BindPassword" placeholder="••••••••" />
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0" />
        <h3 style="margin:0 0 16px;font-size:15px;font-weight:700;color:var(--text-1)">Kullanıcı Arama</h3>

        <div style="margin-bottom:12px">
            <label class="form-label">Arama Tabanı (Search Base)</label>
            <input class="form-input" @bind="cfg.UserSearchBase" placeholder="OU=Users,DC=sirket,DC=com" />
        </div>
        <div style="margin-bottom:12px">
            <label class="form-label">Arama Filtresi</label>
            <input class="form-input" @bind="cfg.UserSearchFilter" placeholder="(sAMAccountName={username})" />
            <p style="font-size:11px;color:var(--text-3);margin:4px 0 0">{username} yer tutucusu giriş yapan kullanıcı adıyla değiştirilir.</p>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0" />
        <h3 style="margin:0 0 16px;font-size:15px;font-weight:700;color:var(--text-1)">Özellik Eşleme</h3>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:12px">
            <div>
                <label class="form-label">Ad Soyad Alanı</label>
                <input class="form-input" @bind="cfg.AttrDisplayName" placeholder="displayName" />
            </div>
            <div>
                <label class="form-label">E-posta Alanı</label>
                <input class="form-input" @bind="cfg.AttrEmail" placeholder="mail" />
            </div>
            <div>
                <label class="form-label">Departman Alanı</label>
                <input class="form-input" @bind="cfg.AttrDepartment" placeholder="department" />
            </div>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0" />
        <h3 style="margin:0 0 16px;font-size:15px;font-weight:700;color:var(--text-1)">Kullanıcı Yönetimi</h3>

        <label style="display:flex;align-items:center;gap:8px;padding:10px 14px;background:#f8fafc;border-radius:8px;border:1px solid var(--border);cursor:pointer;margin-bottom:12px">
            <input type="checkbox" @bind="cfg.AutoCreateUsers" />
            <span style="font-size:13px">İlk girişte otomatik kullanıcı oluştur</span>
        </label>

        <div style="margin-bottom:20px">
            <label class="form-label">Varsayılan Rol</label>
            <select class="form-input" @bind="cfg.DefaultRole" style="max-width:220px">
                <option value="user">Kullanıcı</option>
                <option value="risk_owner">Risk Sahibi</option>
                <option value="committee">Risk Komitesi</option>
                <option value="auditor">Denetçi</option>
                <option value="audit_manager">Denetim Müdürü</option>
                <option value="finding_owner">Bulgu Sahibi</option>
                <option value="ethics_board">Etik Kurul</option>
                <option value="admin">Yönetici</option>
            </select>
        </div>

        <div style="display:flex;gap:10px">
            <button class="btn btn-primary" @onclick="Save">Kaydet</button>
            <button class="btn btn-outline" @onclick="TestConnection" disabled="@testRunning">
                @(testRunning ? "⏳ Test ediliyor…" : "🔌 Bağlantıyı Test Et")
            </button>
        </div>
    </div>
</div>

@code {
    LdapConfiguration cfg = new();
    bool saved;
    string? testResult;
    bool testSuccess;
    bool testRunning;
    List<string> testSteps = [];

    protected override void OnInitialized()
    {
        var existing = Db.LdapConfigurations.FirstOrDefault();
        if (existing != null) cfg = existing;
    }

    void Save()
    {
        saved = false;
        testResult = null;
        cfg.UpdatedAt = DateTime.UtcNow;
        var existing = Db.LdapConfigurations.FirstOrDefault();
        if (existing == null)
            Db.LdapConfigurations.Add(cfg);
        else
        {
            existing.Enabled = cfg.Enabled;
            existing.Server = cfg.Server;
            existing.Port = cfg.Port;
            existing.UseSsl = cfg.UseSsl;
            existing.UseTls = cfg.UseTls;
            existing.Timeout = cfg.Timeout;
            existing.BindDn = cfg.BindDn;
            existing.BindPassword = cfg.BindPassword;
            existing.UserSearchBase = cfg.UserSearchBase;
            existing.UserSearchFilter = cfg.UserSearchFilter;
            existing.AttrDisplayName = cfg.AttrDisplayName;
            existing.AttrEmail = cfg.AttrEmail;
            existing.AttrDepartment = cfg.AttrDepartment;
            existing.AutoCreateUsers = cfg.AutoCreateUsers;
            existing.DefaultRole = cfg.DefaultRole;
            existing.UpdatedAt = cfg.UpdatedAt;
        }
        Db.SaveChanges();
        saved = true;
    }

    async Task TestConnection()
    {
        if (string.IsNullOrWhiteSpace(cfg.Server))
        {
            testResult = "Sunucu adresi boş olamaz.";
            testSuccess = false;
            return;
        }

        testRunning = true;
        testResult  = null;
        testSteps   = [];
        StateHasChanged();

        await Task.Run(() =>
        {
            // Adım 1 — TCP bağlantısı
            try
            {
                using var tcp = new System.Net.Sockets.TcpClient();
                if (!tcp.ConnectAsync(cfg.Server!, cfg.Port).Wait(cfg.Timeout * 1000))
                {
                    testSteps.Add($"❌ TCP: {cfg.Server}:{cfg.Port} adresine {cfg.Timeout}s içinde ulaşılamadı.");
                    testSuccess = false;
                    return;
                }
                testSteps.Add($"✅ TCP: {cfg.Server}:{cfg.Port} erişilebilir.");
            }
            catch (Exception ex)
            {
                testSteps.Add($"❌ TCP: {ex.Message}");
                testSuccess = false;
                return;
            }

            // Adım 2 — LDAP connect + TLS
            LdapConnection conn;
            try
            {
                conn = new LdapConnection { SecureSocketLayer = cfg.UseSsl };
                conn.Connect(cfg.Server!, cfg.Port);
                if (cfg.UseTls) conn.StartTls();
                testSteps.Add(cfg.UseSsl  ? "✅ LDAPS bağlantısı kuruldu." :
                              cfg.UseTls  ? "✅ StartTLS tüneli kuruldu."  :
                                            "✅ LDAP bağlantısı kuruldu (şifresiz).");
            }
            catch (Exception ex)
            {
                testSteps.Add($"❌ LDAP connect: {ex.Message}");
                testSuccess = false;
                return;
            }

            using (conn)
            {
                // Adım 3 — Bind (servis hesabı)
                try
                {
                    if (!string.IsNullOrEmpty(cfg.BindDn))
                    {
                        conn.Bind(cfg.BindDn, cfg.BindPassword ?? "");
                        testSteps.Add($"✅ Bind başarılı: {cfg.BindDn}");
                    }
                    else
                    {
                        conn.Bind("", "");
                        testSteps.Add("✅ Anonim bind başarılı.");
                    }
                }
                catch (LdapException ex) when (ex.ResultCode == LdapException.InvalidCredentials)
                {
                    testSteps.Add("❌ Bind: Servis hesabı kimlik bilgileri hatalı.");
                    testSuccess = false;
                    return;
                }
                catch (Exception ex)
                {
                    testSteps.Add($"❌ Bind: {ex.Message}");
                    testSuccess = false;
                    return;
                }

                // Adım 4 — Search base erişilebilirlik
                if (!string.IsNullOrWhiteSpace(cfg.UserSearchBase))
                {
                    try
                    {
                        // Tek kayıt yeterli; sizelimit=1 ile base'i doğrula
                        var constraints = new LdapSearchConstraints { MaxResults = 1 };
                        var results = conn.Search(
                            cfg.UserSearchBase,
                            LdapConnection.ScopeBase,
                            "(objectClass=*)",
                            null, false, constraints);
                        _ = results.HasMore(); // lazy evaluation — exception yoksa base geçerli
                        testSteps.Add($"✅ Search base erişilebilir: {cfg.UserSearchBase}");
                    }
                    catch (LdapException ex) when (ex.ResultCode == LdapException.NoSuchObject)
                    {
                        testSteps.Add($"❌ Search base bulunamadı: {cfg.UserSearchBase}");
                        testSuccess = false;
                        return;
                    }
                    catch (LdapException ex) when (ex.ResultCode == LdapException.InsufficientAccessRights)
                    {
                        testSteps.Add($"⚠️ Search base okundu ancak servis hesabının okuma yetkisi yetersiz: {cfg.UserSearchBase}");
                        // Uyarı — tam hata değil; search base var ama yetki eksik olabilir
                    }
                    catch (Exception ex)
                    {
                        testSteps.Add($"❌ Search base: {ex.Message}");
                        testSuccess = false;
                        return;
                    }
                }
                else
                {
                    testSteps.Add("⚠️ Search base girilmemiş — kullanıcı araması yapılamaz.");
                }
            }

            testSuccess = true;
        });

        testRunning = false;
        testResult  = testSuccess ? "Tüm adımlar başarılı." : "Bir veya daha fazla adım başarısız.";
        StateHasChanged();
    }
}

@page "/admin/database"
@page "/admin/system-config"
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        // Eski URL'ler yeni sayfalara yönlendirilir
        var path = Nav.Uri.Contains("system-config") ? "/admin/config" : "/admin/db-migrate";
        Nav.NavigateTo(path, replace: true);
    }
}

    // ── Ayar değişiklik geçmişi ────────────────────────────────────────────
    private List<ConfigChangeLog> _changeLog = [];

    private string CurrentUser =>
        HttpCtx.HttpContext?.User.FindFirst("full_name")?.Value
        ?? HttpCtx.HttpContext?.User.Identity?.Name
        ?? "admin";

    private void LogChange(string key, string? oldVal, string? newVal, string description)
    {
        var masked_old = MaskSensitive(key, oldVal);
        var masked_new = MaskSensitive(key, newVal);
        Db.ConfigChangeLogs.Add(new ConfigChangeLog
        {
            ChangedAt   = DateTime.UtcNow,
            ChangedBy   = CurrentUser,
            SettingKey  = key,
            OldValue    = masked_old,
            NewValue    = masked_new,
            Description = description,
        });
        Db.SaveChanges();
    }

    private static string? MaskSensitive(string key, string? value)
    {
        if (value is null) return null;
        var k = key.ToLowerInvariant();
        if (k.Contains("password") || k.Contains("secret") || k.Contains("token")
            || k.Contains("bind_pass") || k.Contains("smtp_pass"))
            return "••••••";
        // Mask JSON password fields
        return System.Text.RegularExpressions.Regex.Replace(
            value,
            @"""(password|bind_password|smtp_password|secret|token)""\s*:\s*""[^""]+""",
            m => m.Value[..m.Value.IndexOf('"', m.Value.IndexOf(':'))] + "\": \"••••••\"",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }


    {
        foreach (var (key, _, _) in _emailEvents)
            CfgSvc.Set($"email_event_{key}", _emailEventToggles.GetValueOrDefault(key, true));
        if (_actionDueRemindDays < 1) _actionDueRemindDays = 1;
        CfgSvc.Set("action_due_remind_days", _actionDueRemindDays);

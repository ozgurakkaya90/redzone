    // ── Güvenlik Ayarları ─────────────────────────────────────────────────────
    private void SaveSecuritySettings()
    {
        if (_secPasswordMinLen  < 4)  _secPasswordMinLen  = 4;
        if (_secSessionHours    < 1)  _secSessionHours    = 1;
        if (_secResetTokenMin   < 5)  _secResetTokenMin   = 5;
        if (_secMaxFailedLogins < 0)  _secMaxFailedLogins = 0;
        if (_secLockoutMinutes  < 1)  _secLockoutMinutes  = 1;
        CfgSvc.Set("security_password_min_length",   _secPasswordMinLen);
        CfgSvc.Set("security_password_complexity",   _secPasswordComplexity);
        CfgSvc.Set("security_session_timeout_hours", _secSessionHours);
        CfgSvc.Set("security_reset_token_minutes",   _secResetTokenMin);
        CfgSvc.Set("security_max_failed_logins",     _secMaxFailedLogins);
        CfgSvc.Set("security_lockout_minutes",       _secLockoutMinutes);
        LogChange("security_settings", "[eski]",
            $"min_len={_secPasswordMinLen};complexity={_secPasswordComplexity};session={_secSessionHours}h;reset={_secResetTokenMin}m;max_fails={_secMaxFailedLogins};lockout={_secLockoutMinutes}m",
            "Güvenlik ayarları güncellendi");
        _secSaveMsg = "Kaydedildi.";
    }

    // ── Aksiyon Zorunluluk Ayarları ───────────────────────────────────────────
    private void SaveActionRequire()
    {
        foreach (var (key, _, _) in _actionRequireDefs)
            CfgSvc.Set($"action_require_{key}", _actionRequireToggles.GetValueOrDefault(key, false));
        var summary = string.Join(";", _actionRequireDefs.Select(d => $"{d.Key}={_actionRequireToggles.GetValueOrDefault(d.Key, false)}"));
        LogChange("action_require_settings", null, summary, "Aksiyon zorunluluk ayarları güncellendi");
        _actionRequireSaveMsg = "Kaydedildi.";
    }

    // ── E-posta Olay Ayarları ─────────────────────────────────────────────────

    // ── Config Import ─────────────────────────────────────────────────────────
    private record ImportDiff(string Key, string? Current, string? New);

    private static readonly HashSet<string> _importBlockedKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "email_settings",      // SMTP şifresi içerir
        "ldap_bind_password",  // LDAP şifresi
        "admin_cfg_advanced_mode", // kişisel tercih
    };

    // Hassas JSON alan adları (içe aktarma sırasında bu key içeren değerler atlanır)
    private static readonly string[] _importSensitivePatterns =
        ["password", "secret", "token", "key", "credential"];

    private List<ImportDiff>? _importPreview;
    private string? _importError;
    private string? _importSuccess;

    private async Task HandleImportFile(InputFileChangeEventArgs e)
    {
        _importError   = null;
        _importSuccess = null;
        _importPreview = null;

        var file = e.File;
        if (file.Size > 500_000) { _importError = "Dosya çok büyük (maks. 500 KB)."; return; }
        if (!file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
        { _importError = "Sadece .json dosyası yükleyebilirsiniz."; return; }

        try
        {
            using var stream = file.OpenReadStream(500_000);
            using var reader = new System.IO.StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var doc = System.Text.Json.JsonDocument.Parse(json);
            if (!doc.RootElement.TryGetProperty("settings", out var settingsEl))
            { _importError = "Geçerli bir ayar yedeği dosyası değil (\"settings\" alanı bulunamadı)."; return; }

            var diffs = new List<ImportDiff>();
            var current = CfgSvc.GetAll();

            foreach (var prop in settingsEl.EnumerateObject())
            {
                var key = prop.Name;
                var rawVal = prop.Value.ToString();

                if (_importBlockedKeys.Contains(key)) continue;

                // Hassas değer pattern kontrolü
                if (_importSensitivePatterns.Any(p => key.Contains(p, StringComparison.OrdinalIgnoreCase)))
                    continue;

                // İçerik hassas alan içeriyor mu?
                if (_importSensitivePatterns.Any(p => rawVal.Contains(p, StringComparison.OrdinalIgnoreCase)
                    && rawVal.Contains("••")))
                    continue;

                var currentStr = current.TryGetValue(key, out var cur)
                    ? (cur?.ToString()?.Length > 80 ? cur.ToString()![..80] + "…" : cur?.ToString())
                    : "(yok)";
                var newStr = rawVal.Length > 80 ? rawVal[..80] + "…" : rawVal;

                if (currentStr != newStr)
                    diffs.Add(new ImportDiff(key, currentStr, newStr));
            }

            if (!diffs.Any())
            { _importError = "Mevcut ayarlardan farklı hiçbir değer bulunamadı."; return; }

            _importPreview = diffs;
        }
        catch (System.Text.Json.JsonException)
        { _importError = "Geçersiz JSON formatı. Dosyayı kontrol edin."; }
        catch (Exception ex)
        { _importError = $"Dosya okunamadı: {ex.Message}"; }
    }

    private void ApplyImport()
    {
        if (_importPreview == null) return;
        ShowConfirm(
            "Ayarları İçe Aktar",
            $"{_importPreview.Count} ayar güncellenecek. Bu işlem geri alınamaz (yedek almak için önce \"↓ Ayar Yedeği\" indirin).",
            () =>
            {
                var applied = 0;
                foreach (var diff in _importPreview)
                {
                    try
                    {
                        // JSON değeri olarak sakla
                        var val = System.Text.Json.JsonDocument.Parse(diff.New ?? "null").RootElement;
                        CfgSvc.Set(diff.Key, val);
                        applied++;
                    }
                    catch { /* geçersiz değer atla */ }
                }
                LogChange("config_import", null, $"{applied} ayar içe aktarıldı", $"Config import tamamlandı ({applied}/{_importPreview.Count} ayar)");
                _importPreview = null;
                _importSuccess = $"{applied} ayar başarıyla içe aktarıldı.";
                return Task.CompletedTask;
            },
            "İçe Aktar",
            danger: false);
    }

    private void CancelImport()
    {
        _importPreview = null;
        _importError   = null;
    }

    // ── E-posta şablon yönetimi ──────────────────────────────────────────────
    private record EmailTplDef(
        string Key, string Title, string Description, string Recipients,
        string DefaultSubject, string DefaultBody, string[] Variables);

    private static readonly EmailTplDef[] EmailDefs =

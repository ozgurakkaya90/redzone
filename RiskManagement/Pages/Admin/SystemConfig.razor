@page "/admin/config"
@attribute [Authorize(Roles = "admin")]
@inject ConfigService CfgSvc
@inject AppDbContext Db
@inject SmtpNotificationService EmailSvc
@inject IWebHostEnvironment Env
@inject IConfiguration AppConfig
@using System.Text.Json
@using RiskManagement.Models
@using RiskManagement.Services.Email
@using Microsoft.EntityFrameworkCore
@using MySqlConnector
@using Novell.Directory.Ldap
@using Microsoft.AspNetCore.Components.Forms
@inject ExternalAuditService ExtSvc
@inject ILogger<SystemConfig> Logger
@inject IHttpContextAccessor HttpCtx
@inject IJSRuntime JS
@inject RecentLogBuffer LogBuf
@inject McpApiKeyService McpKeySvc
@inject AiRiskDraftService AiDraftSvc
@using RiskManagement.Services.Ai
@inject EmailQueue EmailQueueSvc
@using System.Security.Claims

<PageTitle>Sistem Yapılandırması</PageTitle>


@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success" style="margin-bottom:16px">@_success</div>
}

<div class="page-toolbar">
    <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Sistem Yapılandırması</h1>
        <div class="page-toolbar-sub">Kurumsal hiyerarşi, modül ayarları ve e-posta bildirimleri</div>
    </div>
    <div class="page-toolbar-right">
        <div class="cfg-mode-toggle">
            <button class="@(!_advancedMode ? "active" : "")" @onclick='() => SetMode(false)'>Basit</button>
            <button class="@(_advancedMode ? "active" : "")" @onclick='() => SetMode(true)'>Gelişmiş</button>
        </div>
    </div>
</div>

<div class="cfg-layout">

    @* ── Sol Navigasyon ─────────────────────────────────────────────────── *@
    @{
        var _navSearchResults = GetSearchResults().ToList();
        bool _navSearchActive = !string.IsNullOrEmpty(_searchQuery);
        var _recentLogs = LogBuf.GetAll();
    }
    <nav class="cfg-nav">

        @* Arama kutusu *@
        <div class="cfg-search-wrap">
            <input class="form-control cfg-search-input" @bind="_searchQuery" @bind:event="oninput"
                   placeholder="Ayar ara… (ör: smtp, logo, ldap)" />
            @if (_navSearchActive)
            {
                <button class="cfg-search-clear" @onclick='() => _searchQuery = ""'>✕</button>
            }
        </div>

        @if (_navSearchActive)
        {
            @if (!_navSearchResults.Any())
            {
                <div class="cfg-nav-empty">Sonuç bulunamadı</div>
            }
            else
            {
                <div class="cfg-nav-group">Arama Sonuçları</div>
                @foreach (var (tab, label) in _navSearchResults)
                {
                    <button class="cfg-nav-item @(_tab == tab ? "active" : "")"
                            @onclick="@(() => GoToTab(tab))">
                        @label
                    </button>
                }
            }
        }
        else
        {
            @* Normal navigasyon *@
            <div class="cfg-nav-group">Genel</div>
            <button class="cfg-nav-item @(_tab=="theme" ? "active" : "")" @onclick='()=>_tab="theme"'>
                Görsel Ayarlar
            </button>
            <button class="cfg-nav-item @(_tab=="modules" ? "active" : "")" @onclick='()=>_tab="modules"'>
                Modüller
            </button>
            @if (_advancedMode)
            {
                <button class="cfg-nav-item @(_tab=="security" ? "active" : "")" @onclick='()=>_tab="security"'>
                    Güvenlik
                    <span class="cfg-badge cfg-badge-adv">Gelişmiş</span>
                </button>
                <button class="cfg-nav-item @(_tab=="defaults" ? "active" : "")" @onclick='()=>_tab="defaults"'>
                    Varsayılan Değerler
                    <span class="cfg-badge cfg-badge-adv">Gelişmiş</span>
                </button>
            }

            <div class="cfg-nav-group">Kurumsal Yapı</div>
            <button class="cfg-nav-item @(_tab=="companies" ? "active" : "")" @onclick='()=>_tab="companies"'>
                Şirketler
                <span class="cfg-badge">@(_companies.Count + _organizations.Count)</span>
            </button>
            <button class="cfg-nav-item @(_tab=="departments" ? "active" : "")" @onclick='()=>_tab="departments"'>
                Departmanlar
                <span class="cfg-badge">@_departments.Count</span>
            </button>
            <div class="cfg-nav-group">Modül Ayarları</div>
            <button class="cfg-nav-item @(_tab=="risk" ? "active" : "")" @onclick='()=>_tab="risk"'>
                Risk Modülü
            </button>
            <button class="cfg-nav-item @(_tab=="controls" ? "active" : "")" @onclick='()=>_tab="controls"'>
                Kontroller
            </button>
            <button class="cfg-nav-item @(_tab=="audit" ? "active" : "")" @onclick='()=>_tab="audit"'>
                Denetim
            </button>
            <button class="cfg-nav-item @(_tab=="ethics" ? "active" : "")" @onclick='()=>_tab="ethics"'>
                Etik
            </button>
            @if (_advancedMode)
            {
                <button class="cfg-nav-item @(_tab=="external" ? "active" : "")" @onclick='()=>_tab="external"'>
                    Dış Denetim Kurumları
                    <span class="cfg-badge cfg-badge-adv">Gelişmiş</span>
                </button>
            }

            <div class="cfg-nav-group">Entegrasyon</div>
            <button class="cfg-nav-item @(_tab=="email" ? "active" : "")" @onclick='()=>_tab="email"'>
                E-posta SMTP
                @if (_emailSettings.Enabled)
                { <span class="cfg-badge" style="background:#dcfce7;color:#166534">Etkin</span> }
            </button>
            <button class="cfg-nav-item @(_tab=="email_monitor" ? "active" : "")" @onclick='()=>{ _tab="email_monitor"; RefreshEmailMonitor(); }'>
                E-posta Kuyruğu
            </button>
            <button class="cfg-nav-item @(_tab=="ai" ? "active" : "")" @onclick='()=>{ _tab="ai"; LoadAiSettings(); }'>
                Yapay Zeka
                @if (_aiSettings.Provider != "disabled")
                { <span class="cfg-badge" style="background:#dcfce7;color:#166534">Etkin</span> }
            </button>
            <button class="cfg-nav-item @(_tab=="mcp" ? "active" : "")" @onclick='()=>_tab="mcp"'>
                MCP / AI Bağlantı
            </button>
            @if (_advancedMode)
            {
                <button class="cfg-nav-item @(_tab=="email_templates" ? "active" : "")" @onclick='()=>_tab="email_templates"'>
                    E-posta Şablonları
                    <span class="cfg-badge cfg-badge-adv">Gelişmiş</span>
                </button>
                <button class="cfg-nav-item @(_tab=="ldap" ? "active" : "")" @onclick='()=>_tab="ldap"'>
                    Active Directory
                    @if (_ldapEnabled)
                    { <span class="cfg-badge" style="background:#dcfce7;color:#166534">Etkin</span> }
                </button>
            }

            <div class="cfg-nav-group">Araçlar</div>
            <button class="cfg-nav-item @(_tab=="health" ? "active" : "")" @onclick="ActivateHealth">
                Sistem Sağlığı
                @if (_healthBadge == "ok")
                { <span class="cfg-badge" style="background:#dcfce7;color:#166534">✓</span> }
                else if (_healthBadge == "warn")
                { <span class="cfg-badge" style="background:#fef3c7;color:#92400e">!</span> }
            </button>
            <button class="cfg-nav-item @(_tab=="checklist" ? "active" : "")" @onclick='()=>_tab="checklist"'>
                Kurulum Kontrolü
            </button>
            <button class="cfg-nav-item @(_tab=="history" ? "active" : "")" @onclick="ActivateHistory">
                Ayar Geçmişi
            </button>
            <button class="cfg-nav-item @(_tab=="import" ? "active" : "")" @onclick='()=>_tab="import"'>
                Ayar İçe Aktar
            </button>
            @if (_advancedMode)
            {
                <button class="cfg-nav-item @(_tab=="database" ? "active" : "")" @onclick='()=>_tab="database"'>
                    Veritabanı
                    <span class="cfg-badge cfg-badge-adv">Gelişmiş</span>
                </button>
            }
        }
    </nav>

    @* ── İçerik Alanı ───────────────────────────────────────────────────── *@
    <div>

    @* ════ GÖRSEL AYARLAR ════════════════════════════════════════════════ *@
    @if (_tab == "theme")
    {
        <div class="cfg-section-hdr">
            <h2>Görsel Ayarlar</h2>
            <p>Uygulamanın kimliğini ve renklerini kurum standartlarına göre özelleştirin.</p>
        </div>

        @* ── Uygulama Kimliği ── *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0f9ff"></div>
                <div>
                    <div class="cfg-card-title">Uygulama Adı</div>
                    <div class="cfg-card-desc">Sol üst köşede ve tarayıcı sekmesinde görünür</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="form-group">
                    <label class="form-label">Uygulama Adı</label>
                    <input class="form-control" @bind="_appName" placeholder="RED" maxlength="20" />
                    <div class="field-info">Kısa tutun — max 20 karakter</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Alt Başlık</label>
                    <input class="form-control" @bind="_appTagline" placeholder="Risk · Etik · Denetim" maxlength="60" />
                </div>
            </div>
            <div style="padding:14px 18px;background:var(--gray-50);border-radius:10px;border:1px solid var(--border);margin-top:4px">
                <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-3);margin-bottom:8px">Önizleme</div>
                <div style="display:flex;align-items:center;gap:10px">
                    <div style="width:32px;height:32px;background:#1e3a5f;border-radius:8px;display:flex;align-items:center;justify-content:center">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                    </div>
                    <div>
                        <div style="font-size:15px;font-weight:800;color:var(--text-1)">@_appName</div>
                        <div style="font-size:10px;color:var(--text-3);text-transform:uppercase;letter-spacing:.5px">@_appTagline</div>
                    </div>
                </div>
            </div>
            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveBranding">Kaydet</button>
                @if (!string.IsNullOrEmpty(_brandingSaveMsg))
                { <span class="save-msg">@_brandingSaveMsg</span> }
            </div>
        </div>

        @* ── Logo ── *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fef3c7"></div>
                <div>
                    <div class="cfg-card-title">Logo</div>
                    <div class="cfg-card-desc">Sidebar'da uygulama adının solunda görünür — PNG veya JPG, maks. 2 MB</div>
                </div>
            </div>
            <div style="display:flex;gap:20px;align-items:flex-start;flex-wrap:wrap">
                <div style="flex:1;min-width:200px">
                    <InputFile OnChange="HandleLogoUpload" accept=".png,.jpg,.jpeg"
                               style="display:block;margin-bottom:8px" />
                    @if (!string.IsNullOrEmpty(_logoError))
                    { <div style="font-size:12px;color:#dc2626;margin-top:4px">@_logoError</div> }
                    <div class="field-info">Yüklenen logo sunucuda saklanır ve yeniden başlatmaya gerek kalmadan uygulanır.</div>
                    @if (!string.IsNullOrEmpty(_logoPath))
                    {
                        <button class="btn btn-ghost-danger btn-sm" style="margin-top:8px" @onclick="RemoveLogo">
                            Logoyu Kaldır
                        </button>
                    }
                </div>
                <div style="width:120px;height:80px;background:var(--gray-50);border:1px solid var(--border);
                            border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                    @if (!string.IsNullOrEmpty(_logoPath))
                    {
                        <img src="@_logoPath" style="max-width:100px;max-height:70px;object-fit:contain" />
                    }
                    else
                    {
                        <span style="font-size:11px;color:var(--text-3)">Logo yok</span>
                    }
                </div>
            </div>
        </div>

        @* ── Renk Paleti ── *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fef3c7"></div>
                <div>
                    <div class="cfg-card-title">Renk Paleti</div>
                    <div class="cfg-card-desc">Buton, bağlantı ve sidebar arka plan renklerini belirler</div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px">
                <div>
                    <label class="form-label">Birincil Renk</label>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                        <input type="color" @bind="_primaryColor" class="color-swatch" />
                        <input class="form-control" @bind="_primaryColor" style="font-family:monospace" />
                    </div>
                    <div class="field-info">Butonlar, aktif öğeler</div>
                </div>
                <div>
                    <label class="form-label">İkincil Renk</label>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                        <input type="color" @bind="_secondaryColor" class="color-swatch" />
                        <input class="form-control" @bind="_secondaryColor" style="font-family:monospace" />
                    </div>
                    <div class="field-info">Başarı durumları</div>
                </div>
                <div>
                    <label class="form-label">Sidebar Rengi</label>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                        <input type="color" @bind="_sidebarColor" class="color-swatch" />
                        <input class="form-control" @bind="_sidebarColor" style="font-family:monospace" />
                    </div>
                    <div class="field-info">Sol panel arka planı</div>
                </div>
            </div>

            <div style="margin-top:16px;padding:16px;background:var(--gray-50);border-radius:10px;border:1px solid var(--border)">
                <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-3);margin-bottom:10px;letter-spacing:.05em">Önizleme</div>
                <div style="display:flex;gap:16px;align-items:stretch;border-radius:8px;overflow:hidden;border:1px solid var(--border)">
                    <div style="width:120px;background:@_sidebarColor;padding:12px 10px;flex-shrink:0">
                        <div style="font-size:12px;font-weight:700;color:#fff;margin-bottom:6px">@_appName</div>
                        <div style="background:rgba(255,255,255,.1);border-radius:6px;padding:5px 8px;font-size:11px;color:rgba(255,255,255,.9)">Ana Panel</div>
                    </div>
                    <div style="flex:1;padding:12px;background:#fff;display:flex;flex-direction:column;gap:8px">
                        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
                            <button style="background:@_primaryColor;color:#fff;border:none;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:default">Birincil</button>
                            <button style="background:transparent;color:@_primaryColor;border:1.5px solid @_primaryColor;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:default">Çerçeveli</button>
                            <span style="background:@(_secondaryColor)20;color:@_secondaryColor;font-size:11px;font-weight:600;padding:3px 8px;border-radius:20px">Başarılı</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveTheme">Renkleri Kaydet</button>
                @if (!string.IsNullOrEmpty(_themeSaveMsg))
                { <span class="save-msg">@_themeSaveMsg</span> }
            </div>
        </div>

        @* ── Menü Yazı Tipi ── *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f5f3ff"></div>
                <div>
                    <div class="cfg-card-title">Sol Menü Yazı Tipi</div>
                    <div class="cfg-card-desc">Sidebar menü öğelerinin yazı rengi, boyutu ve karakteri</div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:16px">
                <div>
                    <label class="form-label">Yazı Rengi</label>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                        <input type="color" @bind="_sidebarTextColor" class="color-swatch" />
                        <input class="form-control" @bind="_sidebarTextColor" style="font-family:monospace" />
                    </div>
                    <div class="field-info">Menü öğelerinin normal rengi</div>
                </div>
                <div>
                    <label class="form-label">Yazı Boyutu — @_sidebarFontSize px</label>
                    <div style="margin-top:8px;padding:0 4px">
                        <input type="range" min="11" max="16" step="1"
                               @bind="_sidebarFontSize" @bind:event="oninput"
                               style="width:100%;accent-color:#0369a1" />
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-3);margin-top:2px">
                        <span>11px</span><span>16px</span>
                    </div>
                </div>
                <div>
                    <label class="form-label">Yazı Karakteri</label>
                    <select class="form-control" style="margin-top:4px" @bind="_sidebarFont">
                        @foreach (var (name, label) in _fontOptions)
                        { <option value="@name">@label</option> }
                    </select>
                </div>
            </div>

            @* Önizleme *@
            <div style="padding:14px 16px;background:@_sidebarColor;border-radius:10px;display:flex;flex-direction:column;gap:4px">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(255,255,255,.4);letter-spacing:.05em;margin-bottom:6px">Önizleme</div>
                @foreach (var item in new[]{("","Ana Panel"),("","Risk Yönetimi"),("","İç Denetim")})
                {
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;
                                font-size:@(_sidebarFontSize)px;font-family:@_sidebarFont,Inter,system-ui,sans-serif;
                                color:@_sidebarTextColor">
                        <span>@item.Item1</span>
                        <span>@item.Item2</span>
                    </div>
                }
                <div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;
                            background:rgba(30,58,95,.35);
                            font-size:@(_sidebarFontSize)px;font-family:@_sidebarFont,Inter,system-ui,sans-serif;
                            color:#93c5fd">
                    <span>Dış Denetim</span>
                </div>
            </div>

            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveTheme">Kaydet</button>
                @if (!string.IsNullOrEmpty(_themeSaveMsg))
                { <span class="save-msg">@_themeSaveMsg</span> }
            </div>
        </div>

        @* ── Menü Grup Başlıkları ── *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                <div>
                    <div class="cfg-card-title">Menü Grup Başlıkları</div>
                    <div class="cfg-card-desc">Sidebar'daki bölüm başlıklarının (Risk Yönetimi, İç Denetim…) rengi ve punto boyutu</div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
                <div>
                    <label class="form-label">Başlık Rengi</label>
                    <div style="display:flex;gap:8px;align-items:center;margin-top:4px">
                        <input type="color" @bind="_navSectionColor" class="color-swatch" />
                        <input class="form-control" @bind="_navSectionColor" style="font-family:monospace" />
                    </div>
                    <div class="field-info">Bölüm başlıklarının metin rengi</div>
                </div>
                <div>
                    <label class="form-label">Punto Boyutu — @_navSectionFontSize px</label>
                    <div style="margin-top:8px;padding:0 4px">
                        <input type="range" min="8" max="14" step="1"
                               @bind="_navSectionFontSize" @bind:event="oninput"
                               style="width:100%;accent-color:#0369a1" />
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:10px;color:var(--text-3);margin-top:2px">
                        <span>8px</span><span>14px</span>
                    </div>
                </div>
            </div>

            @* Önizleme *@
            <div style="padding:14px 16px;background:@_sidebarColor;border-radius:10px;display:flex;flex-direction:column;gap:4px">
                <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:rgba(255,255,255,.4);letter-spacing:.05em;margin-bottom:6px">Önizleme</div>
                @foreach (var secLabel in new[]{"Risk Yönetimi","İç Denetim","Dış Denetim"})
                {
                    <div style="font-size:@(_navSectionFontSize)px;font-weight:600;text-transform:uppercase;
                                letter-spacing:1px;color:@_navSectionColor;padding:8px 8px 2px">
                        @secLabel
                    </div>
                    <div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;
                                font-size:@(_sidebarFontSize)px;font-family:@_sidebarFont,Inter,system-ui,sans-serif;
                                color:@_sidebarTextColor">
                        — Örnek Menü Öğesi
                    </div>
                }
            </div>

            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveNavSection">Kaydet</button>
                @if (!string.IsNullOrEmpty(_navSectionSaveMsg))
                { <span class="save-msg">@_navSectionSaveMsg</span> }
            </div>
        </div>
    }

    @* ════ ŞİRKETLER & ORGANİZASYONLAR ════════════════════════════════ *@
    @if (_tab == "companies")
    {
        <div class="cfg-section-hdr">
            <h2>Şirketler & Organizasyonlar</h2>
            <p>Kurumsal hiyerarşinin üst katmanları. Şirket → Organizasyon → Departman sırasıyla tanımlanır.</p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
            <div>
                <div class="cfg-card">
                    <div class="cfg-card-hdr">
                        <div class="cfg-card-icon" style="background:#eff6ff"></div>
                        <div>
                            <div class="cfg-card-title">Yeni Şirket</div>
                            <div class="cfg-card-desc">Holding veya bağımsız tüzel kişilik</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_companyError))
                    { <div class="alert alert-error" style="margin-bottom:10px">@_companyError</div> }
                    <div class="form-group">
                        <label class="form-label">Şirket Adı *</label>
                        <input class="form-control" @bind="_newCompanyName" placeholder="örn. ABC Holding A.Ş." />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Açıklama</label>
                        <input class="form-control" @bind="_newCompanyDesc" placeholder="İsteğe bağlı" />
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="AddCompany">+ Şirket Ekle</button>
                </div>

                <div class="cfg-card" style="padding:0">
                    @if (!_companies.Any())
                    {
                        <div style="padding:24px;text-align:center;color:var(--text-3);font-size:13px">
                            Henüz şirket tanımlanmamış.
                        </div>
                    }
                    else
                    {
                        @foreach (var c in _companies)
                        {
                            <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border)">
                                <div style="width:34px;height:34px;background:#eff6ff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0"></div>
                                <div style="flex:1;min-width:0">
                                    <div style="font-size:13px;font-weight:600;color:var(--text-1)">@c.Name</div>
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    { <div style="font-size:11px;color:var(--text-3)">@c.Description</div> }
                                </div>
                                <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteCompany(c.Id)">Sil</button>
                            </div>
                        }
                    }
                </div>
            </div>

            <div>
                <div class="cfg-card">
                    <div class="cfg-card-hdr">
                        <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                        <div>
                            <div class="cfg-card-title">Yeni Organizasyon</div>
                            <div class="cfg-card-desc">Genel müdürlük, direktörlük vb.</div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(_orgError))
                    { <div class="alert alert-error" style="margin-bottom:10px">@_orgError</div> }
                    <div class="form-group">
                        <label class="form-label">Organizasyon Adı *</label>
                        <input class="form-control" @bind="_newOrgName" placeholder="örn. Finans Genel Müdürlüğü" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Bağlı Şirket</label>
                        <select class="form-control" @bind="_newOrgCompanyId">
                            <option value="">— Şirket Seçin —</option>
                            @foreach (var c in _companies)
                            { <option value="@c.Id">@c.Name</option> }
                        </select>
                    </div>
                    <button class="btn btn-primary btn-sm" @onclick="AddOrganization">+ Organizasyon Ekle</button>
                </div>

                <div class="cfg-card" style="padding:0">
                    @if (!_organizations.Any())
                    {
                        <div style="padding:24px;text-align:center;color:var(--text-3);font-size:13px">
                            Henüz organizasyon tanımlanmamış.
                        </div>
                    }
                    else
                    {
                        @foreach (var o in _organizations)
                        {
                            <div style="display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border)">
                                <div style="width:34px;height:34px;background:#f0fdf4;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0"></div>
                                <div style="flex:1;min-width:0">
                                    <div style="font-size:13px;font-weight:600;color:var(--text-1)">@o.Name</div>
                                    @if (o.Company != null)
                                    { <div style="font-size:11px;color:var(--text-3)">@o.Company.Name</div> }
                                </div>
                                <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteOrganization(o.Id)">Sil</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }

    @* ════ DEPARTMANLAR ══════════════════════════════════════════════════ *@
    @if (_tab == "departments")
    {
        <div class="cfg-section-hdr">
            <h2>Departmanlar</h2>
            <p>Departmanlara organizasyon ve yönetici atayın. Yöneticiler kendi departmanlarının risklerini görebilir.</p>
        </div>

        <div class="cfg-card" style="margin-bottom:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#faf5ff"></div>
                <div>
                    <div class="cfg-card-title">Yeni Departman Ekle</div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_deptError))
            { <div class="alert alert-error" style="margin-bottom:10px">@_deptError</div> }
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Departman Adı *</label>
                    <input class="form-control" @bind="_newDeptName" placeholder="örn. Finans Direktörlüğü" />
                </div>
                <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Bağlı Organizasyon</label>
                    <select class="form-control" @bind="_newDeptOrgId">
                        <option value="">— Organizasyon Seçin —</option>
                        @foreach (var o in _organizations)
                        { <option value="@o.Id">@o.Name</option> }
                    </select>
                </div>
            </div>
            <div style="margin-top:12px">
                <button class="btn btn-primary" @onclick="AddDepartment">+ Departman Ekle</button>
            </div>
        </div>

        <div class="cfg-card" style="padding:0;overflow-x:auto">
            <table class="table">
                <thead>
                    <tr>
                        <th>Departman</th>
                        <th>Organizasyon</th>
                        <th>Şirket</th>
                        <th>Yönetici</th>
                        <th style="width:60px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dept in _departments)
                    {
                        var deptId = dept.Id;
                        <tr>
                            <td>
                                <div style="display:flex;align-items:center;gap:8px">
                                    <div style="width:28px;height:28px;background:#faf5ff;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0"></div>
                                    <span style="font-weight:600;font-size:13px">@dept.Name</span>
                                </div>
                            </td>
                            <td>
                                <select class="form-control" style="font-size:12px;min-width:160px"
                                        value="@(dept.OrganizationId?.ToString() ?? "")"
                                        @onchange="@(e => SetOrganization(deptId, e.Value?.ToString() ?? ""))">
                                    <option value="">— Seçin —</option>
                                    @foreach (var o in _organizations)
                                    { <option value="@o.Id" selected="@(dept.OrganizationId == o.Id)">@o.Name</option> }
                                </select>
                            </td>
                            <td style="font-size:12px;color:var(--text-3)">@(dept.Organization?.Company?.Name ?? "—")</td>
                            <td>
                                <select class="form-control" style="font-size:12px;min-width:160px"
                                        value="@(dept.ManagerUserId?.ToString() ?? "")"
                                        @onchange="@(e => SetManager(deptId, e.Value?.ToString() ?? ""))">
                                    <option value="">— Yönetici Seçin —</option>
                                    @foreach (var u in _allUsers)
                                    { <option value="@u.Id" selected="@(dept.ManagerUserId == u.Id)">@u.FullName</option> }
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-ghost-danger btn-sm" @onclick="() => DeleteDepartment(deptId)">Sil</button>
                            </td>
                        </tr>
                    }
                    @if (!_departments.Any())
                    { <tr><td colspan="5" class="empty-state">Henüz departman tanımlanmamış.</td></tr> }
                </tbody>
            </table>
        </div>

        <div style="padding:12px 16px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;font-size:12px;color:#1d4ed8">
            <strong>Departman Yöneticisi:</strong> Atanan kullanıcı, bu departmana ait tüm riskleri görüntüleyebilir ve risk kayıt süreçlerine katılabilir.
        </div>
    }

    @* ════ RİSK MODÜLÜ ══════════════════════════════════════════════════ *@
    @if (_tab == "risk")
    {
        <div class="cfg-section-hdr">
            <h2>Risk Modülü Ayarları</h2>
            <p>Risk kategorileri, stratejiler ve periyodik inceleme kuralları</p>
        </div>

        <ListEditor Title="Risk Kategorileri" Items="_riskCategories" OnSave="SaveRiskCategories" />
        <ListEditor Title="Risk Stratejileri"  Items="_riskStrategies" OnSave="SaveRiskStrategies" />

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fef3c7"></div>
                <div>
                    <div class="cfg-card-title">Periyodik İnceleme Eşiği</div>
                    <div class="cfg-card-desc">Bu süreyi aşan incelemesiz riskler "Bekleyen İşler"de uyarı oluşturur</div>
                </div>
            </div>
            <div class="form-group" style="max-width:160px">
                <label class="form-label">Eşik (gün)</label>
                <input type="number" class="form-control" @bind="_reviewThresholdDays" min="1" max="730" />
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveReviewThreshold">Kaydet</button>
            </div>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fee2e2"></div>
                <div>
                    <div class="cfg-card-title">Gecikme ve Yaklaşma Eşikleri</div>
                    <div class="cfg-card-desc">Aksiyon ve bulgu listelerinde kullanılan gün eşikleri — tüm modüllere uygulanır</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:480px">
                <div class="form-group">
                    <label class="form-label">"Bu Hafta" penceresi (gün)</label>
                    <input type="number" class="form-control" @bind="_weekDays" min="1" max="30" />
                    <div class="field-info">Hızlı filtre: "Bu Hafta" kaç gün kapsar?</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Yaklaşan uyarı eşiği (gün)</label>
                    <input type="number" class="form-control" @bind="_warnDays" min="1" max="60" />
                    <div class="field-info">Vadesi bu kadar gün kalan işler sarı uyarı alır</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Kritik gecikme eşiği (gün)</label>
                    <input type="number" class="form-control" @bind="_critDays" min="1" max="365" />
                    <div class="field-info">Bu kadar gün geciken işler KRİTİK olarak işaretlenir</div>
                </div>
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveOverdueThresholds">Kaydet</button>
            </div>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fdf4ff"></div>
                <div>
                    <div class="cfg-card-title">Aksiyon Zorunluluk Ayarları</div>
                    <div class="cfg-card-desc">İşaretlenen alanlar aksiyon formunda boş bırakılamaz</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px">
                @foreach (var (key, label, hint) in _actionRequireDefs)
                {
                    var k = key;
                    var isOn = _actionRequireToggles.GetValueOrDefault(k, false);
                    <label style="display:flex;align-items:flex-start;gap:10px;padding:12px 14px;
                                  border:1.5px solid @(isOn?"#d8b4fe":"var(--border)");border-radius:10px;
                                  cursor:pointer;background:@(isOn?"#fdf4ff":"var(--surface)");transition:all .15s">
                        <input type="checkbox" style="margin-top:2px;width:16px;height:16px;flex-shrink:0;accent-color:#7c3aed"
                               checked="@isOn"
                               @onchange="e => _actionRequireToggles[k] = (bool)(e.Value ?? false)" />
                        <div>
                            <div style="font-size:13px;font-weight:600;color:var(--text-1)">@label</div>
                            <div style="font-size:11px;color:var(--text-3);margin-top:2px">@hint</div>
                        </div>
                    </label>
                }
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveActionRequire">Kaydet</button>
                @if (!string.IsNullOrEmpty(_actionRequireSaveMsg))
                { <span class="save-msg">@_actionRequireSaveMsg</span> }
            </div>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                <div>
                    <div class="cfg-card-title">Risk Detayı — Alan Görünürlüğü</div>
                    <div class="cfg-card-desc">Kapatılan alanlar formdan ve görüntülemeden tamamen gizlenir</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px">
                @foreach (var (key, label, hint) in _riskDetailFieldDefs)
                {
                    var k = key;
                    var isOn = _riskDetailFields.GetValueOrDefault(k, true);
                    <label style="display:flex;align-items:flex-start;gap:10px;padding:12px 14px;
                                  border:1.5px solid @(isOn?"#86efac":"var(--border)");border-radius:10px;
                                  cursor:pointer;background:@(isOn?"#f0fdf4":"var(--surface)");
                                  transition:all .15s">
                        <input type="checkbox" style="margin-top:2px;width:16px;height:16px;flex-shrink:0;accent-color:#16a34a"
                               checked="@isOn"
                               @onchange="e => ToggleRiskField(k, (bool)(e.Value ?? true))" />
                        <div>
                            <div style="font-size:13px;font-weight:600;color:var(--text-1)">@label</div>
                            <div style="font-size:11px;color:var(--text-3);margin-top:2px">@hint</div>
                        </div>
                    </label>
                }
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveRiskDetailFields">Kaydet</button>
            </div>
        </div>
    }

    @* ════ KONTROLLER ════════════════════════════════════════════════════ *@
    @if (_tab == "controls")
    {
        <div class="cfg-section-hdr">
            <h2>Kontrol Ayarları</h2>
            <p>Risk kontrolü türleri, etkinlik düzeyleri ve denetim sıklıkları</p>
        </div>
        <ListEditor Title="Kontrol Türleri"    Items="_controlTypes"         OnSave="SaveControlTypes" />
        <ListEditor Title="Kontrol Etkinliği"  Items="_controlEffectiveness" OnSave="SaveControlEffectiveness" />
        <ListEditor Title="Kontrol Sıklıkları" Items="_controlFrequencies"   OnSave="SaveControlFrequencies" />
    }

    @* ════ DENETİM MODÜLÜ ═══════════════════════════════════════════════ *@
    @if (_tab == "audit")
    {
        <div class="cfg-section-hdr">
            <h2>Denetim Modülü Ayarları</h2>
            <p>Denetim türleri, bulgu kategorileri ve önem dereceleri — hem plan hem iç denetim ekranlarında kullanılır</p>
        </div>
        <ListEditor Title="Denetim Türleri"          Items="_auditTypes"      OnSave="SaveAuditTypes" />
        <ListEditor Title="Bulgu Kategorileri"       Items="_auditCategories" OnSave="SaveAuditCategories" />
        <ListEditor Title="Bulgu Şiddet Seviyeleri"  Items="_auditSeverities" OnSave="SaveAuditSeverities" />
    }

    @* ════ ETİK MODÜLÜ ══════════════════════════════════════════════════ *@
    @if (_tab == "ethics")
    {
        <div class="cfg-section-hdr">
            <h2>Etik Modülü Ayarları</h2>
            <p>Etik ihbar kategorileri</p>
        </div>
        <ListEditor Title="Etik Bildirim Kategorileri" Items="_ethicsCategories" OnSave="SaveEthicsCategories" />
    }

    @* ════ E-POSTA ŞABLONLARI ════════════════════════════════════════════ *@
    @if (_tab == "email_templates")
    {
        <div class="cfg-section-hdr">
            <h2>E-posta Şablonları</h2>
            <p>Sistem tarafından gönderilen otomatik bildirimlerin konu ve içerik şablonlarını özelleştirin.
               Değişkenleri <code>{değişkenAdı}</code> formatında kullanabilirsiniz.
               Boş bırakırsanız sistem varsayılan şablonu kullanır.</p>
        </div>

        @foreach (var (groupName, groupKeys) in new (string, string[])[]
        {
            ("Risk Yönetimi", new[]{ "risk_proposed","status_changed","owner_assigned","action_due" }),
            ("Denetim",       new[]{ "finding_assigned","closure_requested","closure_decided","finding_due" }),
            ("Etik",          new[]{ "ethics_submitted","ethics_reviewed" }),
            ("Sistem",        new[]{ "test" }),
        })
        {
            var groupDefs = EmailDefs.Where(d => groupKeys.Contains(d.Key)).ToList();
            if (!groupDefs.Any()) continue;
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
                        color:var(--text-3);margin:20px 0 10px;padding-bottom:6px;
                        border-bottom:1px solid var(--border)">@groupName</div>
            @foreach (var def in groupDefs)
            {
            var key = def.Key;
            if (!_emailTplSubjects.ContainsKey(key)) _emailTplSubjects[key] = "";
            if (!_emailTplBodies.ContainsKey(key))   _emailTplBodies[key]   = "";
            var isCustomized = !string.IsNullOrWhiteSpace(_emailTplSubjects[key]) ||
                               !string.IsNullOrWhiteSpace(_emailTplBodies[key]);

            <div class="cfg-card">
                <div class="cfg-card-hdr">
                    <div class="cfg-card-icon" style="background:#eff6ff">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                            <polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <div style="flex:1">
                        <div class="cfg-card-title">@def.Title
                            @if (isCustomized)
                            { <span style="font-size:10px;font-weight:600;background:#dbeafe;color:#1d4ed8;padding:2px 6px;border-radius:4px;margin-left:6px">Özelleştirildi</span> }
                        </div>
                        <div class="cfg-card-desc">@def.Description</div>
                        <div style="margin-top:2px;font-size:11px;color:var(--text-3)">
                            <b>Alıcı:</b> @def.Recipients
                        </div>
                    </div>
                </div>

                @* Konu *@
                <div class="form-group">
                    <label class="form-label">Konu Satırı</label>
                    <input class="form-control" style="font-family:monospace;font-size:12px"
                           placeholder="@def.DefaultSubject"
                           @bind="_emailTplSubjects[key]" />
                    <div class="field-info">Boş bırakırsanız varsayılan: <code>@def.DefaultSubject</code></div>
                </div>

                @* Gövde *@
                <div class="form-group">
                    <label class="form-label">İçerik (HTML)</label>
                    <textarea class="form-control" rows="6"
                              style="font-family:monospace;font-size:11px;resize:vertical"
                              placeholder="@def.DefaultBody"
                              @bind="_emailTplBodies[key]"></textarea>
                    <div class="field-info">
                        Kullanılabilir değişkenler:
                        @foreach (var v in def.Variables)
                        { <code style="margin-left:4px">{@v}</code> }
                    </div>
                </div>

                @* Önizleme *@
                @if (_previewKey == key)
                {
                    <div style="margin-bottom:12px">
                        <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--text-3);margin-bottom:6px">Şablon Önizlemesi</div>
                        <div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;max-height:400px;overflow-y:auto">
                            <iframe srcdoc="@_previewHtml" style="width:100%;height:380px;border:none;"></iframe>
                        </div>
                    </div>
                }

                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                    <button class="btn btn-primary btn-sm" @onclick="() => SaveEmailTemplate(key)">Kaydet</button>
                    <button class="btn btn-outline btn-sm" @onclick="() => PreviewTemplate(def)">
                        @(_previewKey == key ? "Önizlemeyi Kapat" : "Önizle")
                    </button>
                    @if (isCustomized)
                    {
                        <button class="btn btn-ghost-danger btn-sm" @onclick="() => ResetEmailTemplate(key)">Varsayılanı Geri Yükle</button>
                    }
                    @if (!string.IsNullOrEmpty(_emailTplSaveMsgs.GetValueOrDefault(key, "")))
                    { <span class="save-msg">@_emailTplSaveMsgs[key]</span> }
                </div>
            </div>
            } @* end foreach def *@
        } @* end foreach group *@
    }

    @* ════ E-POSTA ═══════════════════════════════════════════════════════ *@
    @if (_tab == "email")
    {
        var testAlertClass = _testOk ? "alert-success" : "alert-error";

        <div class="cfg-section-hdr">
            <h2>E-posta Bildirimleri</h2>
            <p>Değişiklikler anında etki eder — sunucuyu yeniden başlatmaya gerek yok.</p>
        </div>

        @* Hızlı Sağlayıcı Seçimi *@
        <div class="cfg-card" style="margin-bottom:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#eff6ff"></div>
                <div>
                    <div class="cfg-card-title">Hızlı Kurulum</div>
                    <div class="cfg-card-desc">Sağlayıcınızı seçin — bağlantı ayarları otomatik dolar</div>
                </div>
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:4px">
                <button class="btn btn-outline btn-sm" @onclick='()=>ApplySmtpPreset("gmail")'>
                    Gmail
                </button>
                <button class="btn btn-outline btn-sm" @onclick='()=>ApplySmtpPreset("outlook")'>
                    Outlook / Microsoft 365
                </button>
                <button class="btn btn-outline btn-sm" @onclick='()=>ApplySmtpPreset("yandex")'>
                    Yandex
                </button>
                <button class="btn btn-outline btn-sm" @onclick='()=>ApplySmtpPreset("custom")'>
                    Özel Sunucu
                </button>
            </div>
            <div style="font-size:11px;color:var(--text-3)">Seçimden sonra sadece kullanıcı adı ve şifrenizi girin.</div>
        </div>

        @* Etkin / Devre dışı durumu *@
        <div class="cfg-card" style="margin-bottom:16px">
            <div class="toggle-row" style="margin-bottom:0">
                <input type="checkbox" id="emailEnabled" @bind="_emailSettings.Enabled" />
                <label for="emailEnabled">
                    E-posta bildirimlerini etkinleştir
                    <span class="toggle-sub">Risk önerisi, durum değişikliği, sahip ataması ve aksiyon hatırlatmaları gönderilir</span>
                </label>
                @if (_emailSettings.Enabled)
                { <span class="status-pill pill-green">Etkin</span> }
                else
                { <span class="status-pill pill-gray">Devre Dışı</span> }
            </div>
        </div>

        @* SMTP Hızlı Şablonlar *@
        <div class="cfg-card" style="margin-bottom:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0f9ff"></div>
                <div>
                    <div class="cfg-card-title">Hızlı Şablon Seç</div>
                    <div class="cfg-card-desc">E-posta sağlayıcınızı seçin, sunucu ayarları otomatik dolar</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px">
                <button class="preset-btn" @onclick='()=>ApplyPreset("m365")'>
                    <span class="pb-icon"></span>
                    <div><div class="pb-name">Microsoft 365</div><div class="pb-host">smtp.office365.com:587</div></div>
                </button>
                <button class="preset-btn" @onclick='()=>ApplyPreset("gmail")'>
                    <span class="pb-icon">G</span>
                    <div><div class="pb-name">Gmail</div><div class="pb-host">smtp.gmail.com:587</div></div>
                </button>
                <button class="preset-btn" @onclick='()=>ApplyPreset("exchange")'>
                    <span class="pb-icon"></span>
                    <div><div class="pb-name">Exchange On-Prem</div><div class="pb-host">Özel host:25</div></div>
                </button>
            </div>
        </div>

        @* SMTP Form *@
        <div class="cfg-card" style="margin-bottom:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#faf5ff"></div>
                <div>
                    <div class="cfg-card-title">SMTP Yapılandırması</div>
                    <div class="cfg-card-desc">Sunucu bağlantı bilgileri</div>
                </div>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
                <div class="form-group">
                    <label class="form-label">SMTP Sunucu *</label>
                    <input class="form-control" @bind="_emailSettings.Host" placeholder="smtp.office365.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">Port</label>
                    <input class="form-control" type="number" @bind="_emailSettings.Port" />
                    <div class="field-info">TLS/STARTTLS: 587 &nbsp;·&nbsp; SSL: 465 &nbsp;·&nbsp; Şifresiz: 25</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Kullanıcı Adı</label>
                    <input class="form-control" @bind="_emailSettings.Username"
                           placeholder="redzone@sirketiniz.com" autocomplete="off" />
                </div>
                <div class="form-group">
                    <label class="form-label">Şifre</label>
                    <input class="form-control" type="password" @bind="_emailSettings.Password"
                           placeholder="••••••••" autocomplete="new-password" />
                    <div class="field-info">Gmail için uygulama şifresi (App Password) kullanın</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Gönderen E-posta *</label>
                    <input class="form-control" @bind="_emailSettings.FromAddress"
                           placeholder="redzone@sirketiniz.com" />
                </div>
                <div class="form-group">
                    <label class="form-label">Gönderen Adı</label>
                    <input class="form-control" @bind="_emailSettings.FromName"
                           placeholder="RedZone Risk Sistemi" />
                </div>
                <div class="form-group" style="grid-column:1/-1">
                    <label class="form-label">Sistem URL'i</label>
                    <input class="form-control" @bind="_emailSettings.BaseUrl"
                           placeholder="https://redzone.sirketiniz.com" />
                    <div class="field-info">E-postalardaki bağlantılar bu adres üzerinden oluşturulur</div>
                </div>
                <div style="grid-column:1/-1">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                        <input type="checkbox" @bind="_emailSettings.UseSsl"
                               style="width:16px;height:16px;accent-color:#0369a1" />
                        <span style="font-size:13px;font-weight:600">SSL / TLS şifrelemesi kullan</span>
                    </label>
                </div>
            </div>

            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveEmailSettings">Kaydet</button>
                @if (!string.IsNullOrEmpty(_emailSaveMsg))
                { <span class="save-msg">@_emailSaveMsg</span> }
            </div>
        </div>

        @* Test E-postası *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                <div>
                    <div class="cfg-card-title">Bağlantı Testi</div>
                    <div class="cfg-card-desc">Kaydettiğiniz ayarlarla gerçek bir e-posta gönderir</div>
                </div>
            </div>
            <div style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
                <div class="form-group" style="flex:1;min-width:220px;margin-bottom:0">
                    <label class="form-label">Test Alıcısı</label>
                    <input class="form-control" @bind="_testEmail" type="email"
                           placeholder="test@sirketiniz.com" />
                </div>
                <button class="btn btn-outline" @onclick="SendTestEmail" disabled="@_testSending"
                        style="white-space:nowrap">
                    @(_testSending ? "Gönderiliyor…" : "Test Gönder")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_testResult))
            { <div class="alert @testAlertClass" style="margin-top:12px">@_testResult</div> }
        </div>

        @* Bildirim Olayları *@
        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fef3c7"></div>
                <div>
                    <div class="cfg-card-title">Bildirim Olayları</div>
                    <div class="cfg-card-desc">Hangi olaylar e-posta göndersin? E-posta SMTP etkin olmasa bile ayarlar korunur.</div>
                </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:0;margin-bottom:16px">
                @foreach (var (grpLabel, grpKeys) in new (string, string[])[]
                {
                    ("Risk Yönetimi", new[]{ "risk_proposed","status_changed","owner_assigned","action_due" }),
                    ("Denetim",       new[]{ "finding_assigned","closure_requested","closure_decided","finding_due" }),
                    ("Etik",          new[]{ "ethics_submitted","ethics_reviewed" }),
                })
                {
                    <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;
                                color:var(--text-3);padding:12px 0 6px;border-bottom:1px solid var(--border);
                                margin-bottom:8px">@grpLabel</div>
                    @foreach (var (key, label, desc) in _emailEvents.Where(e => grpKeys.Contains(e.Key)))
                    {
                    var k = key;
                    var on = _emailEventToggles.GetValueOrDefault(k, true);
                    <label style="display:flex;align-items:flex-start;gap:12px;padding:10px 14px;margin-bottom:8px;
                                  border:1.5px solid @(on?"#fde68a":"var(--border)");border-radius:10px;
                                  cursor:pointer;background:@(on?"#fffbeb":"var(--surface)");transition:all .15s">
                        <input type="checkbox" style="margin-top:2px;width:16px;height:16px;flex-shrink:0;accent-color:#d97706"
                               checked="@on"
                               @onchange="e => _emailEventToggles[k] = (bool)(e.Value ?? true)" />
                        <div>
                            <div style="font-size:13px;font-weight:600;color:var(--text-1)">@label</div>
                            <div style="font-size:11px;color:var(--text-3);margin-top:2px">@desc</div>
                        </div>
                    </label>
                    } @* end foreach event *@
                } @* end foreach group *@
            </div>
            <div class="form-group" style="max-width:180px;margin-bottom:16px">
                <label class="form-label">Hatırlatma — kaç gün önce?</label>
                <input type="number" class="form-control" @bind="_actionDueRemindDays" min="1" max="30" />
                <div class="field-info">Risk aksiyonları ve denetim bulguları için geçerlidir</div>
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveEmailEvents">Kaydet</button>
                @if (!string.IsNullOrEmpty(_emailEventsSaveMsg))
                { <span class="save-msg">@_emailEventsSaveMsg</span> }
            </div>
        </div>
    }

    @* ════ MODÜLLER ══════════════════════════════════════════════════════ *@
    @if (_tab == "modules")
    {
        <div class="cfg-section-hdr">
            <h2>Modüller</h2>
            <p>Kapalı modüllerin verileri silinmez; yalnızca arayüzden gizlenir.</p>
        </div>

        @if (!string.IsNullOrEmpty(_moduleMsg))
        { <div class="alert @(_moduleIsError ? "alert-error" : "alert-success")" style="margin-bottom:14px">@_moduleMsg</div> }

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px">
            @foreach (var mod in new[]
            {
                (Icon:"", Name:"Risk Yönetimi",    Desc:"Risk envanteri, kontrol, aksiyon",  Bg:"#fff5f5", Border:"#fca5a5", Active:_riskActive,     Toggle:(Action)ToggleRisk),
                (Icon:"", Name:"İç Denetim",        Desc:"Denetim planları, bulgular",         Bg:"#f0fdf4", Border:"#86efac", Active:_auditActive,    Toggle:(Action)ToggleAudit),
                (Icon:"", Name:"Dış Denetim",       Desc:"BRC, JCI, müşteri denetimleri",      Bg:"#fffbeb", Border:"#fde68a", Active:_externalActive, Toggle:(Action)ToggleExternal),
                (Icon:"", Name:"Etik Yönetimi",     Desc:"Etik bildirimler, kurul incelemeleri",Bg:"#faf5ff", Border:"#c4b5fd", Active:_ethicsActive,   Toggle:(Action)ToggleEthics),
                (Icon:"", Name:"Active Directory",  Desc:"Kurumsal LDAP/AD kimlik doğrulama",  Bg:"#eff6ff", Border:"#bfdbfe", Active:_ldapEnabled,    Toggle:(Action)ToggleLdapModule),
            })
            {
                var m = mod;
                <div style="border:1px solid var(--border);border-radius:12px;overflow:hidden;background:var(--surface)">
                    <div style="background:@m.Bg;padding:16px 20px;border-bottom:1px solid @m.Border;display:flex;align-items:center;gap:12px">
                        <span style="font-size:24px;display:none">@m.Icon</span>
                        <div style="flex:1">
                            <div style="font-size:14px;font-weight:700">@m.Name</div>
                            <div style="font-size:11px;color:var(--text-3);margin-top:2px">@m.Desc</div>
                        </div>
                        <label style="position:relative;display:inline-flex;width:44px;height:24px;background:@(m.Active?"#16a34a":"#d1d5db");border-radius:12px;cursor:pointer;transition:background .2s;flex-shrink:0" @onclick="m.Toggle">
                            <span style="position:absolute;top:3px;left:@(m.Active?"23px":"3px");width:18px;height:18px;background:#fff;border-radius:50%;box-shadow:0 1px 3px rgba(0,0,0,.2);transition:left .2s"></span>
                        </label>
                    </div>
                    <div style="padding:12px 20px">
                        <span class="status-pill @(m.Active?"pill-green":"pill-red")" style="font-size:11px">
                            @(m.Active ? "Aktif" : "Kapalı")
                        </span>
                    </div>
                </div>
            }
        </div>
    }

    @* ════ ACTIVE DIRECTORY ══════════════════════════════════════════════ *@
    @if (_tab == "ldap")
    {
        <div class="cfg-section-hdr">
            <h2>Active Directory / LDAP</h2>
            <p>Kurumsal dizin entegrasyonu — çalışanlar AD şifresiyle giriş yapabilir.</p>
        </div>

        @if (_ldapSaved) { <div class="alert alert-success" style="margin-bottom:14px">Ayarlar kaydedildi.</div> }
        @if (_ldapTestRunning) { <div class="alert" style="margin-bottom:14px;background:#f0f9ff;border:1px solid #bae6fd;color:#0369a1">Test çalışıyor…</div> }
        @if (_ldapTestSteps.Count > 0)
        {
            <div class="alert @(_ldapTestSuccess ? "alert-success" : "alert-error")" style="margin-bottom:14px">
                <div style="font-weight:700;margin-bottom:8px">@(_ldapTestSuccess ? "Bağlantı başarılı" : "Test başarısız")</div>
                <ol style="margin:0;padding-left:20px;line-height:1.9;font-size:13px">
                    @foreach (var s in _ldapTestSteps) { <li>@s</li> }
                </ol>
            </div>
        }

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#eff6ff"></div>
                <div><div class="cfg-card-title">Bağlantı Ayarları</div></div>
            </div>
            <div class="toggle-row" style="margin-bottom:14px">
                <input type="checkbox" id="ldapEnabled" @bind="_ldapCfg.Enabled" />
                <label for="ldapEnabled">LDAP Entegrasyonunu Etkinleştir
                    <span class="toggle-sub">Aktif edildiğinde giriş ekranına "Active Directory" sekmesi eklenir</span>
                </label>
            </div>
            <div style="display:grid;grid-template-columns:1fr 120px;gap:12px;margin-bottom:12px">
                <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">LDAP Sunucu</label>
                    <input class="form-control" @bind="_ldapCfg.Server" placeholder="ldap.sirket.com" />
                </div>
                <div class="form-group" style="margin-bottom:0">
                    <label class="form-label">Port</label>
                    <input class="form-control" type="number" @bind="_ldapCfg.Port" />
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
                <label style="display:flex;gap:8px;align-items:center;padding:10px 14px;background:var(--gray-50);border-radius:8px;border:1px solid var(--border);cursor:pointer">
                    <input type="checkbox" @bind="_ldapCfg.UseSsl" /> <span style="font-size:13px">SSL (LDAPS)</span>
                </label>
                <label style="display:flex;gap:8px;align-items:center;padding:10px 14px;background:var(--gray-50);border-radius:8px;border:1px solid var(--border);cursor:pointer">
                    <input type="checkbox" @bind="_ldapCfg.UseTls" /> <span style="font-size:13px">StartTLS</span>
                </label>
            </div>
            <div class="form-group"><label class="form-label">Bind DN</label>
                <input class="form-control" @bind="_ldapCfg.BindDn" placeholder="CN=svc-ldap,OU=ServiceAccounts,DC=sirket,DC=com" />
            </div>
            <div class="form-group"><label class="form-label">Bind Şifresi</label>
                <input class="form-control" type="password" @bind="_ldapCfg.BindPassword" placeholder="••••••••" />
            </div>
            <div class="form-group"><label class="form-label">Search Base</label>
                <input class="form-control" @bind="_ldapCfg.UserSearchBase" placeholder="OU=Users,DC=sirket,DC=com" />
            </div>
            <div class="form-group"><label class="form-label">Search Filtresi</label>
                <input class="form-control" @bind="_ldapCfg.UserSearchFilter" placeholder="(sAMAccountName={username})" />
                <div class="field-info">{username} giriş yapan kullanıcı adıyla değiştirilir</div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px">
                <div class="form-group" style="margin-bottom:0"><label class="form-label">Ad Soyad Alanı</label>
                    <input class="form-control" @bind="_ldapCfg.AttrDisplayName" placeholder="displayName" /></div>
                <div class="form-group" style="margin-bottom:0"><label class="form-label">E-posta Alanı</label>
                    <input class="form-control" @bind="_ldapCfg.AttrEmail" placeholder="mail" /></div>
                <div class="form-group" style="margin-bottom:0"><label class="form-label">Departman Alanı</label>
                    <input class="form-control" @bind="_ldapCfg.AttrDepartment" placeholder="department" /></div>
            </div>
            <label style="display:flex;gap:8px;align-items:center;margin-bottom:12px;cursor:pointer">
                <input type="checkbox" @bind="_ldapCfg.AutoCreateUsers" />
                <span style="font-size:13px">İlk girişte otomatik kullanıcı oluştur</span>
            </label>
            <div class="form-group" style="max-width:200px"><label class="form-label">Varsayılan Rol</label>
                <select class="form-control" @bind="_ldapCfg.DefaultRole">
                    @foreach (var r in new[]{("user","Kullanıcı"),("risk_owner","Risk Sahibi"),("committee","Risk Komitesi"),("auditor","Denetçi"),("audit_manager","Denetim Müdürü"),("finding_owner","Bulgu Sahibi"),("ethics_board","Etik Kurul"),("admin","Yönetici")})
                    { <option value="@r.Item1">@r.Item2</option> }
                </select>
            </div>
            <div class="save-row">
                <button class="btn btn-primary" @onclick="SaveLdap">Kaydet</button>
                <button class="btn btn-outline" @onclick="TestLdapConnection" disabled="@_ldapTestRunning">
                    @(_ldapTestRunning ? "Test ediliyor…" : "Bağlantıyı Test Et")
                </button>
            </div>
        </div>
    }

    @* ════ DIŞ DENETİM AYARLARI ════════════════════════════════════════════════ *@
    @if (_tab == "external")
    {
        <div class="cfg-section-hdr">
            <h2>Dış Denetim Ayarları</h2>
            <p>Denetleyici kurumları tanımla ve kullanıcı erişim yetkilerini yönet.</p>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1.4fr;gap:16px;align-items:start;flex-wrap:wrap">

            <div class="cfg-card">
                <div class="cfg-card-hdr">
                    <div class="cfg-card-icon" style="background:#fffbeb"></div>
                    <div><div class="cfg-card-title">Denetleyici Kurumlar</div></div>
                    <button class="btn btn-primary btn-sm" style="margin-left:auto" @onclick="() => _extAddingBody = true">+ Kurum</button>
                </div>

                @if (_extAddingBody)
                {
                    <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:12px;margin-bottom:12px">
                        <input class="form-control" placeholder="Kurum adı (örn. BRC, JCI)"
                               @bind="_extNewBodyName" maxlength="200" style="margin-bottom:6px" />
                        <input class="form-control" placeholder="Açıklama (opsiyonel)"
                               @bind="_extNewBodyDesc" maxlength="500" style="margin-bottom:8px" />
                        @if (!string.IsNullOrEmpty(_extBodyError))
                        { <div class="alert alert-error" style="margin-bottom:8px;font-size:12px">@_extBodyError</div> }
                        <div style="display:flex;gap:6px">
                            <button class="btn btn-primary btn-sm" @onclick="ExtAddBody">Ekle</button>
                            <button class="btn btn-outline btn-sm" @onclick="ExtCancelAddBody">İptal</button>
                        </div>
                    </div>
                }

                <label style="font-size:12px;display:flex;align-items:center;gap:6px;cursor:pointer;margin-bottom:10px">
                    <input type="checkbox" @bind="_extShowInactive" @bind:after="ExtReloadBodies" />
                    Pasif kurumları da göster
                </label>

                @if (_extBodies.Count == 0)
                {
                    <div style="text-align:center;padding:24px;color:var(--text-3);font-size:13px">Henüz kurum eklenmemiş.</div>
                }
                else
                {
                    <table class="table" style="font-size:12px">
                        <thead><tr>
                            <th>Kurum</th>
                            <th style="width:70px;text-align:center">Yetkili</th>
                            <th style="width:70px;text-align:center">Denetim</th>
                            <th style="width:110px;text-align:right">İşlemler</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var b in _extBodies)
                        {
                            var userCnt  = _extUserCountByBody.GetValueOrDefault(b.Name, 0);
                            var auditCnt = _extAuditCountByBody.GetValueOrDefault(b.Name, 0);
                            <tr style="@(b.IsActive ? "" : "opacity:0.55")">
                                <td>
                                    <div style="font-weight:600">@b.Name</div>
                                    @if (!string.IsNullOrEmpty(b.Description))
                                    { <div style="font-size:11px;color:var(--text-3)">@b.Description</div> }
                                    @if (!b.IsActive)
                                    { <span class="badge badge-gray" style="font-size:10px;margin-top:2px">Pasif</span> }
                                </td>
                                <td style="text-align:center">
                                    <span style="color:#0369a1;font-weight:600;cursor:pointer" @onclick="() => ExtSelectBody(b.Name)">@userCnt</span>
                                </td>
                                <td style="text-align:center">@auditCnt</td>
                                <td style="text-align:right">
                                    @if (b.IsActive)
                                    { <button class="btn btn-outline btn-sm" style="padding:2px 8px;font-size:11px" @onclick="() => ExtDeactivateBody(b.Id)">Pasifleştir</button> }
                                    else
                                    { <button class="btn btn-outline btn-sm" style="padding:2px 8px;font-size:11px" @onclick="() => ExtActivateBody(b.Id)">Aktifleştir</button> }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <div class="cfg-card">
                <div class="cfg-card-hdr">
                    <div class="cfg-card-icon" style="background:#fffbeb"></div>
                    <div><div class="cfg-card-title">Kurum Yetkileri</div>
                        @if (!string.IsNullOrEmpty(_extSelectedBody))
                        { <div class="cfg-card-desc">@_extSelectedBody</div> }
                    </div>
                    <select class="form-control" style="width:auto;font-size:12px;margin-left:auto" @bind="_extSelectedBody" @bind:after="ExtLoadAssignments">
                        <option value="">— Kurum seçin —</option>
                        @foreach (var b in _extBodies.Where(x => x.IsActive))
                        { <option value="@b.Name">@b.Name</option> }
                    </select>
                </div>

                @if (string.IsNullOrEmpty(_extSelectedBody))
                {
                    <div style="text-align:center;padding:32px;color:var(--text-3);font-size:13px">Yetki yönetmek için bir kurum seçin.</div>
                }
                else
                {
                    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px;margin-bottom:12px">
                        <div style="font-size:11px;font-weight:600;color:var(--text-3);text-transform:uppercase;margin-bottom:8px">Kullanıcı Ekle</div>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <select class="form-control" style="flex:1;min-width:160px" @bind="_extGrantUserId">
                                <option value="">— Kullanıcı —</option>
                                @foreach (var u in _extUsers.Where(u => !_extAssignments.Any(a => a.UserId == u.Id)))
                                { <option value="@u.Id">@u.FullName (@u.Username)</option> }
                            </select>
                            <label style="display:flex;align-items:center;gap:6px;white-space:nowrap;font-size:12px">
                                <input type="checkbox" @bind="_extGrantCanEdit" /> Düzenleme
                            </label>
                            <button class="btn btn-primary btn-sm" @onclick="ExtGrantAccess">Ver</button>
                        </div>
                    </div>

                    @if (_extAssignments.Count == 0)
                    { <div style="text-align:center;padding:24px;color:var(--text-3);font-size:13px">Bu kuruma yetkili kullanıcı yok.</div> }
                    else
                    {
                        <table class="table" style="font-size:12px">
                            <thead><tr><th>Kullanıcı</th><th style="width:110px;text-align:center">Düzenleme</th><th style="width:70px"></th></tr></thead>
                            <tbody>
                            @foreach (var a in _extAssignments)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600">@(a.User?.FullName ?? "—")</div>
                                        <div style="font-size:10px;color:var(--text-3)">@a.User?.Username</div>
                                    </td>
                                    <td style="text-align:center">
                                        <input type="checkbox" checked="@a.CanEdit"
                                               @onchange="@((ChangeEventArgs e) => ExtToggleCanEdit(a, e))" />
                                    </td>
                                    <td>
                                        <button class="btn btn-outline btn-sm" style="padding:2px 8px;font-size:11px;color:#dc2626"
                                                @onclick="() => ExtRevoke(a)">Kaldır</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    }
                }
            </div>
        </div>
    }

    @* ════ VERİTABANI ════════════════════════════════════════════════════ *@
    @if (_tab == "database")
    {
        <div class="cfg-section-hdr">
            <h2>Veritabanı Durumu</h2>
            <p>Uygulama veritabanı bağlantısını test edin ve tablo yapısını inceleyin.</p>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fff7ed"></div>
                <div>
                    <div class="cfg-card-title">Uygulama Veritabanı</div>
                    <div class="cfg-card-desc">@_appDbInfo.Host:@_appDbInfo.Port / @_appDbInfo.DatabaseName · @_appDbInfo.Username</div>
                </div>
                <button class="btn btn-outline btn-sm" @onclick="TestAppDb" disabled="@_testingAppDb" style="margin-left:auto">
                    @(_testingAppDb ? "Test ediliyor…" : "Test Et")
                </button>
            </div>
            <div style="background:#0f172a;border-radius:8px;padding:10px 14px;margin-bottom:12px">
                <code style="font-size:11px;color:#7dd3fc;word-break:break-all">@_appDbConnStrMasked</code>
            </div>
            @if (_appDbTestResult != null)
            {
                <div style="font-size:12px;padding:8px 12px;border-radius:6px;margin-bottom:10px;
                            background:@(_appDbTestOk?"#f0fdf4":"#fef2f2");color:@(_appDbTestOk?"#166534":"#991b1b")">
                    @_appDbTestResult
                    @if (_appDbDetail != null) { <span style="margin-left:6px;opacity:.8"> · @_appDbDetail</span> }
                </div>
            }
            @if (_appDbTestOk)
            {
                <button class="btn btn-outline btn-sm" @onclick="BrowseAppDbTables">Tabloları Göster</button>
            }
            @if (_appDbTables.Any())
            {
                <div style="margin-top:12px;display:flex;flex-wrap:wrap;gap:6px">
                    @foreach (var t in _appDbTables)
                    { <span style="padding:3px 10px;background:#f1f5f9;border-radius:6px;font-size:12px;font-family:monospace">@t</span> }
                </div>
            }
        </div>

        <div class="cfg-card" style="margin-top:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fefce8"></div>
                <div><div class="cfg-card-title">Veritabanı Migration</div>
                    <div class="cfg-card-desc">Bekleyen migration'ları uygula</div>
                </div>
                <button class="btn btn-outline btn-sm" @onclick="MigrRefresh" disabled="@_migrRunning" style="margin-left:auto">Yenile</button>
            </div>

            @if (_migrLoadError != null)
            {
                <div style="padding:10px;background:#fef2f2;border:1px solid #fca5a5;border-radius:8px;font-size:12px;color:#991b1b;margin-bottom:10px">@_migrLoadError</div>
            }
            @if (_migrPending.Count == 0 && _migrApplied.Count > 0)
            {
                <div style="padding:10px 14px;background:#f0fdf4;border:1px solid #86efac;border-radius:8px;font-size:13px;color:#166534;margin-bottom:10px">
                    Tüm migration'lar uygulanmış (@_migrApplied.Count adet)
                </div>
            }
            @if (_migrPending.Count > 0)
            {
                <div style="padding:10px 14px;background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;margin-bottom:10px">
                    <div style="font-size:13px;font-weight:700;color:#92400e;margin-bottom:6px">△ @_migrPending.Count bekleyen migration</div>
                    @foreach (var m in _migrPending)
                    { <div style="font-size:11px;font-family:monospace;color:#b45309;padding:2px 0">@m</div> }
                </div>
            }
            @if (_migrResult != null)
            {
                var ok = !_migrResult.StartsWith("Hata");
                <div style="padding:10px 14px;border-radius:8px;margin-bottom:10px;font-size:12px;
                            background:@(ok?"#f0fdf4":"#fef2f2");border:1px solid @(ok?"#86efac":"#fca5a5");color:@(ok?"#166534":"#991b1b")">
                    @(ok ? "" : "[HATA] ") @_migrResult
                </div>
            }
            <div style="display:flex;gap:8px;flex-wrap:wrap">
                <button class="btn btn-primary btn-sm" @onclick="MigrRunWithConfirm" disabled="@(_migrRunning || _migrPending.Count == 0)">
                    @(_migrRunning ? "Çalışıyor…" : "Migration Çalıştır")
                </button>
                <button class="btn btn-outline btn-sm" style="color:#dc2626;border-color:#fca5a5" @onclick="MigrRestartApp" disabled="@_migrRestarting">
                    @(_migrRestarting ? "Yeniden başlatılıyor…" : "Uygulamayı Yeniden Başlat")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_migrRestartMsg))
            {
                <div style="margin-top:8px;padding:8px 12px;background:#fef3c7;border:1px solid #fcd34d;border-radius:8px;font-size:12px;color:#92400e">@_migrRestartMsg</div>
            }
        </div>
    }

    @* ════ VARSAYILAN DEĞERLER ══════════════════════════════════════════ *@
    @if (_tab == "defaults")
    {
        <div class="cfg-section-hdr">
            <h2>Varsayılan Değerler</h2>
            <p>Formlar açılırken bu değerler otomatik dolar; kullanıcı isterse değiştirebilir.</p>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                <div><div class="cfg-card-title">Aksiyon Varsayılanları</div></div>
            </div>
            <div class="form-group" style="max-width:200px;margin-bottom:16px">
                <label class="form-label">Varsayılan vade (gün)</label>
                <input type="number" class="form-control" @bind="_defaultActionDueDays" min="1" max="365" />
                <div class="field-info">Yeni aksiyon formu açıldığında hedef tarih bu kadar gün sonraya ayarlanır</div>
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveDefaults">Kaydet</button>
                @if (!string.IsNullOrEmpty(_defaultsSaveMsg))
                { <span class="save-msg">@_defaultsSaveMsg</span> }
            </div>
        </div>
    }

    @* ════ GÜVENLİK ════════════════════════════════════════════════════ *@
    @if (_tab == "security")
    {
        <div class="cfg-section-hdr">
            <h2>Güvenlik Ayarları</h2>
            <p>Şifre kuralları ve oturum süresi. Oturum zaman aşımı değişikliği bir sonraki giriş işleminde etki eder.</p>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#fef2f2"></div>
                <div><div class="cfg-card-title">Şifre Kuralları</div></div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:480px;margin-bottom:16px">
                <div class="form-group">
                    <label class="form-label">Minimum şifre uzunluğu</label>
                    <input type="number" class="form-control" @bind="_secPasswordMinLen" min="4" max="64" />
                    <div class="field-info">Yeni şifreler en az bu kadar karakter içermeli</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Şifre sıfırlama süresi (dk)</label>
                    <input type="number" class="form-control" @bind="_secResetTokenMin" min="5" max="1440" />
                    <div class="field-info">Şifre sıfırlama bağlantısı bu süre sonra geçersiz olur</div>
                </div>
            </div>
            <label style="display:flex;align-items:center;gap:10px;margin-bottom:16px;cursor:pointer">
                <input type="checkbox" @bind="_secPasswordComplexity" style="width:16px;height:16px;accent-color:#dc2626" />
                <div>
                    <div style="font-size:13px;font-weight:600">Şifre karmaşıklığı zorunlu</div>
                    <div style="font-size:11px;color:var(--text-3)">Şifrelerde en az bir büyük harf ve bir rakam bulunmalı</div>
                </div>
            </label>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveSecuritySettings">Kaydet</button>
                @if (!string.IsNullOrEmpty(_secSaveMsg))
                { <span class="save-msg">@_secSaveMsg</span> }
            </div>
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#eff6ff"></div>
                <div>
                    <div class="cfg-card-title">Giriş & Oturum Güvenliği</div>
                    <div class="cfg-card-desc">Değişiklik bir sonraki girişte geçerli olur</div>
                </div>
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;max-width:620px;margin-bottom:16px">
                <div class="form-group">
                    <label class="form-label">Oturum zaman aşımı (saat)</label>
                    <input type="number" class="form-control" @bind="_secSessionHours" min="1" max="720" />
                    <div class="field-info">Aktif oturum bu süre sonunda sonlanır</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Maks. hatalı giriş</label>
                    <input type="number" class="form-control" @bind="_secMaxFailedLogins" min="0" max="100" />
                    <div class="field-info">0 = sınırsız. Eşik aşılınca hesap kilitlenir.</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Kilit süresi (dakika)</label>
                    <input type="number" class="form-control" @bind="_secLockoutMinutes" min="1" max="1440" />
                    <div class="field-info">Hesap bu süre sonunda otomatik açılır.</div>
                </div>
            </div>
            <div class="save-row">
                <button class="btn btn-primary btn-sm" @onclick="SaveSecuritySettings">Kaydet</button>
            </div>
        </div>
    }

    @* ════ SİSTEM SAĞLIĞI ═══════════════════════════════════════════════ *@
    @if (_tab == "health")
    {
        <div class="cfg-section-hdr">
            <h2>Sistem Sağlığı</h2>
            <p>Uygulama bileşenlerini, bağlantıları ve ortam bilgisini tek ekranda görüntüleyin.</p>
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:8px">
            <div style="display:flex;gap:8px">
                <button class="btn btn-outline btn-sm" @onclick="DownloadConfigExport" title="Hassas değerler hariç tüm ayarları JSON olarak indirir">
                    ↓ Ayar Yedeği
                </button>
                <button class="btn btn-outline btn-sm" @onclick="DownloadSupportPackage" title="Sorun giderme için sistem özetini indirir">
                    ↓ Destek Paketi
                </button>
            </div>
            <button class="btn btn-primary btn-sm" @onclick="RunAllHealthChecks" disabled="@_healthRunning">
                @(_healthRunning ? "Test ediliyor…" : "Tümünü Test Et")
            </button>
        </div>

        @* ─ Satır 1: DB + Migration ─ *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">

            @* Veritabanı *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:8px">
                    <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;background:@(_appDbTestResult==null?"#d1d5db":_appDbTestOk?"#22c55e":"#ef4444")"></div>
                    <div>
                        <div class="cfg-card-title">Veritabanı</div>
                        <div class="cfg-card-desc">@_appDbInfo.Host / @_appDbInfo.DatabaseName</div>
                    </div>
                    <button class="btn btn-outline btn-sm" style="margin-left:auto;padding:2px 10px;font-size:11px"
                            @onclick="TestAppDb" disabled="@_testingAppDb">
                        @(_testingAppDb ? "…" : "Test Et")
                    </button>
                </div>
                @if (_appDbTestResult != null)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;
                                background:@(_appDbTestOk?"#f0fdf4":"#fef2f2");color:@(_appDbTestOk?"#166534":"#991b1b")">
                        @_appDbTestResult
                    </div>
                    @if (!_appDbTestOk)
                    {
                        <div class="health-action">
                            <span class="health-action-icon">💡</span>
                            <span>Connection string'i <code>appsettings.json</code> veya ortam değişkenlerinde kontrol edin (DefaultConnection).</span>
                        </div>
                    }
                }
                else
                {
                    <div style="font-size:12px;color:var(--text-3)">Test henüz çalıştırılmadı</div>
                }
            </div>

            @* Migration *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:8px">
                    <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;
                                background:@(_migrLoadError!=null?"#ef4444":_migrPending.Count>0?"#f59e0b":"#22c55e")"></div>
                    <div>
                        <div class="cfg-card-title">Veritabanı Migration</div>
                        <div class="cfg-card-desc">@_migrApplied.Count uygulanan · @_migrPending.Count bekleyen</div>
                    </div>
                    <button class="btn btn-outline btn-sm" style="margin-left:auto;padding:2px 10px;font-size:11px"
                            @onclick="MigrRefresh" disabled="@_migrRunning">
                        @(_migrRunning ? "…" : "Yenile")
                    </button>
                </div>
                @if (_migrLoadError != null)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;background:#fef2f2;color:#991b1b">@_migrLoadError</div>
                    <div class="health-action"><span class="health-action-icon">💡</span><span>Veritabanı bağlantısını kontrol edin. Bağlantı başarılıysa migration bilgisi görünür.</span></div>
                }
                else if (_migrPending.Count > 0)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;background:#fef3c7;color:#92400e">
                        @_migrPending.Count bekleyen migration var
                    </div>
                    <div class="health-action">
                        <span class="health-action-icon">⚡</span>
                        <span>Bekleyen güncellemeler var. <button class="btn-link-inline" @onclick='()=>_tab="database"'>Veritabanı sekmesindeki</button> "Migration Çalıştır" butonuna tıklayın.</span>
                    </div>
                }
                else if (_migrApplied.Count > 0)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;background:#f0fdf4;color:#166534">
                        Tüm migration'lar uygulanmış
                    </div>
                }
                else
                {
                    <div style="font-size:12px;color:var(--text-3)">Yüklemek için "Yenile" butonuna tıklayın</div>
                }
            </div>
        </div>

        @* ─ Satır 2: SMTP + Dosya Sistemi ─ *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px">

            @* SMTP *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:8px">
                    <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;
                                background:@(_smtpCheckMsg==null?"#d1d5db":_smtpCheckOk?"#22c55e":"#ef4444")"></div>
                    <div>
                        <div class="cfg-card-title">E-posta (SMTP)</div>
                        <div class="cfg-card-desc">
                            @if (_emailSettings.Enabled)
                            { <span>@_emailSettings.Host:@_emailSettings.Port</span> }
                            else
                            { <span style="color:#ef4444">Devre dışı</span> }
                        </div>
                    </div>
                    <button class="btn btn-outline btn-sm" style="margin-left:auto;padding:2px 10px;font-size:11px"
                            @onclick="CheckSmtp" disabled="@_smtpChecking">
                        @(_smtpChecking ? "…" : "Test Et")
                    </button>
                </div>
                @if (_smtpCheckMsg != null)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;
                                background:@(_smtpCheckOk?"#f0fdf4":"#fef2f2");color:@(_smtpCheckOk?"#166534":"#991b1b")">
                        @_smtpCheckMsg
                    </div>
                    @if (!_smtpCheckOk)
                    {
                        <div class="health-action">
                            <span class="health-action-icon">💡</span>
                            <span>
                                @if (!_emailSettings.Enabled)
                                { <span><button class="btn-link-inline" @onclick='()=>_tab="email"'>E-posta SMTP sekmesinden</button> SMTP'yi etkinleştirin.</span> }
                                else
                                { <span>Host, port ve kimlik bilgilerini <button class="btn-link-inline" @onclick='()=>_tab="email"'>E-posta SMTP sekmesinden</button> kontrol edin.</span> }
                            </span>
                        </div>
                    }
                }
                else
                {
                    <div style="font-size:12px;color:var(--text-3)">Test henüz çalıştırılmadı</div>
                }
            </div>

            @* Dosya Sistemi *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:8px">
                    <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;
                                background:@(_uploadsDirChecked?(_uploadsDirOk?"#22c55e":"#ef4444"):"#d1d5db")"></div>
                    <div>
                        <div class="cfg-card-title">Dosya Yükleme Klasörü</div>
                        <div class="cfg-card-desc">wwwroot/uploads</div>
                    </div>
                    <button class="btn btn-outline btn-sm" style="margin-left:auto;padding:2px 10px;font-size:11px"
                            @onclick="CheckUploadsDir">
                        Test Et
                    </button>
                </div>
                @if (_uploadsDirChecked)
                {
                    <div style="font-size:12px;padding:6px 10px;border-radius:6px;
                                background:@(_uploadsDirOk?"#f0fdf4":"#fef2f2");color:@(_uploadsDirOk?"#166534":"#991b1b")">
                        @if (_uploadsDirOk)
                        { <span>Yazılabilir · @_uploadsDirSizeStr</span> }
                        else
                        { <span>Klasör bulunamadı veya yazılamıyor</span> }
                    </div>
                    @if (!_uploadsDirOk)
                    {
                        <div class="health-action">
                            <span class="health-action-icon">💡</span>
                            <span>Sunucuda <code>wwwroot/uploads</code> klasörünü oluşturun ve uygulama kullanıcısına yazma izni verin: <code>chmod 755 wwwroot/uploads</code></span>
                        </div>
                    }
                }
                else
                {
                    <div style="font-size:12px;color:var(--text-3)">Test henüz çalıştırılmadı</div>
                }
            </div>
        </div>

        @* ─ Satır 3: Ortam Bilgisi + Aktif Modüller ─ *@
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">

            @* Ortam *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:12px">
                    <div class="cfg-card-icon" style="background:#eff6ff"></div>
                    <div><div class="cfg-card-title">Uygulama & Ortam</div></div>
                </div>
                <table style="width:100%;font-size:12px;border-collapse:collapse">
                    @{
                        var asm = System.Reflection.Assembly.GetExecutingAssembly();
                        var ver = asm.GetName().Version;
                        var verStr = ver != null ? $"{ver.Major}.{ver.Minor}.{ver.Build}" : "—";
                        var rt  = System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription;
                        var os  = System.Runtime.InteropServices.RuntimeInformation.OSDescription;
                    }
                    <tr style="border-bottom:1px solid var(--border)"><td style="padding:5px 0;color:var(--text-3)">Versiyon</td><td style="padding:5px 0;font-weight:600;text-align:right">@verStr</td></tr>
                    <tr style="border-bottom:1px solid var(--border)"><td style="padding:5px 0;color:var(--text-3)">Ortam</td><td style="padding:5px 0;text-align:right">@Env.EnvironmentName</td></tr>
                    <tr style="border-bottom:1px solid var(--border)"><td style="padding:5px 0;color:var(--text-3)">.NET Runtime</td><td style="padding:5px 0;text-align:right;font-size:11px">@rt</td></tr>
                    <tr><td style="padding:5px 0;color:var(--text-3)">İşletim Sistemi</td><td style="padding:5px 0;text-align:right;font-size:11px;word-break:break-all">@os</td></tr>
                </table>
            </div>

            @* Aktif Modüller *@
            <div class="cfg-card" style="margin:0">
                <div class="cfg-card-hdr" style="margin-bottom:12px">
                    <div class="cfg-card-icon" style="background:#f0fdf4"></div>
                    <div><div class="cfg-card-title">Aktif Modüller</div></div>
                </div>
                @{
                    var moduleList = new[] {
                        ("Risk Yönetimi",    CfgSvc.IsModuleActive("risk")),
                        ("İç Denetim",       CfgSvc.IsModuleActive("audit")),
                        ("Dış Denetim",      CfgSvc.IsModuleActive("external")),
                        ("Etik Bildirimi",   CfgSvc.IsModuleActive("ethics")),
                    };
                }
                <div style="display:flex;flex-direction:column;gap:8px">
                    @foreach (var (name, active) in moduleList)
                    {
                        <div style="display:flex;align-items:center;justify-content:space-between;font-size:13px">
                            <span>@name</span>
                            <span style="font-size:11px;padding:2px 10px;border-radius:20px;font-weight:600;
                                         background:@(active?"#dcfce7":"#f1f5f9");color:@(active?"#166534":"#6b7280")">
                                @(active ? "Etkin" : "Kapalı")
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ─ Son Uyarılar / Hatalar ─ *@
        <div class="cfg-card">
            <div class="cfg-card-hdr" style="margin-bottom:12px">
                <div class="cfg-card-icon" style="background:#fef2f2"></div>
                <div>
                    <div class="cfg-card-title">Son Uyarılar & Hatalar</div>
                    <div class="cfg-card-desc">Son @RecentLogBuffer.Capacity uygulama uyarısı/hatası — uygulama yeniden başlatılınca sıfırlanır</div>
                </div>
            </div>
            @if (!_recentLogs.Any())
            {
                <div style="font-size:12px;color:var(--text-3);padding:8px 0">Kayıt yok — iyi bir işaret!</div>
            }
            else
            {
                <div style="max-height:320px;overflow-y:auto">
                    <table style="width:100%;border-collapse:collapse;font-size:11px">
                        <thead style="position:sticky;top:0;background:var(--surface)">
                            <tr style="border-bottom:1px solid var(--border)">
                                <th style="padding:4px 8px;text-align:left;color:var(--text-3)">Saat</th>
                                <th style="padding:4px 8px;text-align:left;color:var(--text-3)">Seviye</th>
                                <th style="padding:4px 8px;text-align:left;color:var(--text-3)">Kategori</th>
                                <th style="padding:4px 8px;text-align:left;color:var(--text-3)">Mesaj</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in _recentLogs)
                            {
                                var levelColor = entry.Level switch
                                {
                                    Microsoft.Extensions.Logging.LogLevel.Error or
                                    Microsoft.Extensions.Logging.LogLevel.Critical => "#991b1b",
                                    _ => "#92400e"
                                };
                                var levelLabel = entry.Level switch
                                {
                                    Microsoft.Extensions.Logging.LogLevel.Warning  => "WARN",
                                    Microsoft.Extensions.Logging.LogLevel.Error    => "ERR",
                                    Microsoft.Extensions.Logging.LogLevel.Critical => "CRIT",
                                    _ => entry.Level.ToString()[..4].ToUpper()
                                };
                                <tr style="border-bottom:1px solid var(--gray-50)">
                                    <td style="padding:4px 8px;white-space:nowrap;color:var(--text-3)">
                                        @entry.Timestamp.ToLocalTime().ToString("HH:mm:ss")
                                    </td>
                                    <td style="padding:4px 8px">
                                        <span style="color:@levelColor;font-weight:700;font-size:10px">@levelLabel</span>
                                    </td>
                                    <td style="padding:4px 8px;color:var(--text-3);white-space:nowrap">@entry.Category</td>
                                    <td style="padding:4px 8px;color:var(--text-1)">
                                        @entry.Message
                                        @if (entry.Exception != null)
                                        {
                                            <div style="font-size:10px;color:#dc2626;margin-top:2px">@entry.Exception</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    @* ════ AYar GEÇMİŞİ ════════════════════════════════════════════════ *@
    @if (_tab == "history")
    {
        <div class="cfg-section-hdr">
            <h2>Ayar Değişiklik Geçmişi</h2>
            <p>Son 50 kritik ayar değişikliğini görüntüleyin. Hassas değerler maskelenir.</p>
        </div>

        <div class="cfg-card">
            @if (_changeLog.Count == 0)
            {
                <div style="padding:32px;text-align:center;color:var(--text-3);font-size:13px">
                    Henüz kayıt yok. Ayar değişiklikleriniz burada görünecek.
                </div>
            }
            else
            {
                <table style="width:100%;border-collapse:collapse;font-size:12px">
                    <thead>
                        <tr style="border-bottom:2px solid var(--border)">
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Tarih</th>
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Kullanıcı</th>
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Ayar / İşlem</th>
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Açıklama</th>
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Eski Değer</th>
                            <th style="padding:8px;text-align:left;color:var(--text-3);font-weight:600">Yeni Değer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _changeLog)
                        {
                            <tr style="border-bottom:1px solid var(--border)">
                                <td style="padding:7px 8px;color:var(--text-3);white-space:nowrap">
                                    @log.ChangedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")
                                </td>
                                <td style="padding:7px 8px;font-weight:500">@log.ChangedBy</td>
                                <td style="padding:7px 8px;font-family:monospace;font-size:11px">@log.SettingKey</td>
                                <td style="padding:7px 8px;color:var(--text-2)">@log.Description</td>
                                <td style="padding:7px 8px;font-family:monospace;font-size:11px;color:#9f1239;max-width:180px;overflow:hidden;text-overflow:ellipsis">
                                    @(log.OldValue?.Length > 60 ? log.OldValue[..60] + "…" : log.OldValue)
                                </td>
                                <td style="padding:7px 8px;font-family:monospace;font-size:11px;color:#166534;max-width:180px;overflow:hidden;text-overflow:ellipsis">
                                    @(log.NewValue?.Length > 60 ? log.NewValue[..60] + "…" : log.NewValue)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

    @* ════ KURULUM KONTROL LİSTESİ ══════════════════════════════════════ *@
    @if (_tab == "checklist")
    {
        <div class="cfg-section-hdr">
            <h2>Kurulum Kontrol Listesi</h2>
            <p>Uygulamanın tam çalışır durumda olması için gereken temel adımları kontrol edin.</p>
        </div>

        <div class="cfg-card">
            @{
                var checks = new (bool Done, string Label, string Tab, string Hint, bool Optional)[]
                {
                    (!string.IsNullOrEmpty(_appName) && _appName != "RED",
                        "Uygulama adı özelleştirildi",
                        "theme",
                        "Kurumunuza ait bir uygulama adı girin.", false),
                    (!string.IsNullOrEmpty(_logoPath),
                        "Logo yüklendi",
                        "theme",
                        "PNG, JPG veya SVG formatında kurumsal logonuzu yükleyin.", false),
                    (_companies.Count > 0,
                        "En az bir şirket eklendi",
                        "companies",
                        "Şirket/organizasyon hiyerarşisini oluşturun.", false),
                    (_departments.Count > 0,
                        "En az bir departman tanımlandı",
                        "departments",
                        "Kullanıcıların atanacağı departmanları tanımlayın.", false),
                    (_emailSettings.Enabled,
                        "E-posta (SMTP) etkinleştirildi",
                        "email",
                        "Bildirim e-postalarının gönderilebilmesi için SMTP ayarlayın.", false),
                    (_smtpCheckOk,
                        "SMTP bağlantısı test edildi ve başarılı",
                        "health",
                        "Sistem Sağlığı ekranından SMTP testini çalıştırın.", false),
                    (CfgSvc.GetList("risk_categories").Length > 0,
                        "Risk kategorileri kontrol edildi",
                        "risk",
                        "Risk kategorilerini kurumunuza göre düzenleyin.", false),
                    (CfgSvc.GetList("audit_types").Length > 0,
                        "Denetim türleri kontrol edildi",
                        "audit",
                        "Denetim türlerini kurumunuza göre düzenleyin.", false),
                    (_appDbTestOk,
                        "Veritabanı bağlantısı doğrulandı",
                        "health",
                        "Sistem Sağlığı ekranından veritabanı testini çalıştırın.", false),
                    (_migrPending.Count == 0 && _migrApplied.Count > 0,
                        "Bekleyen migration yok",
                        "health",
                        "Tüm veritabanı güncellemeleri uygulanmış olmalıdır.", false),
                    (CfgSvc.GetAiSettings().Provider is not ("disabled" or ""),
                        "Yapay zeka (AI) entegrasyonu yapılandırıldı",
                        "ai",
                        "İsteğe bağlı: Risk taslağı üretimi için AI sağlayıcısını (Anthropic / OpenAI uyumlu) ayarlayın.", true),
                    (McpKeySvc.GetAll().Any(k => k.IsActive),
                        "MCP bağlantısı için aktif API anahtarı var",
                        "mcp",
                        "İsteğe bağlı: Claude/Cursor gibi istemcilerin bağlanabilmesi için bir MCP API anahtarı oluşturun.", true),
                };
                var required   = checks.Where(c => !c.Optional).ToArray();
                var doneCount  = required.Count(c => c.Done);
                var totalCount = required.Length;
                var optDone    = checks.Count(c => c.Optional && c.Done);
                var optTotal   = checks.Count(c => c.Optional);
            }
            <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;padding:14px 16px;background:var(--gray-50);border-radius:10px;border:1px solid var(--border)">
                <div style="font-size:28px;font-weight:800;color:@(doneCount == totalCount ? "#16a34a" : "#0369a1")">@doneCount/@totalCount</div>
                <div>
                    <div style="font-size:13px;font-weight:600">Kurulum tamamlanma durumu</div>
                    <div style="font-size:11px;color:var(--text-3)">
                        @if (doneCount == totalCount) { <span>Zorunlu adımlar tamamlandı — sistem üretime hazır.</span> }
                        else { <span>@(totalCount - doneCount) zorunlu adım kaldı.</span> }
                        <span style="opacity:.8"> · İsteğe bağlı entegrasyon: @optDone/@optTotal</span>
                    </div>
                </div>
                <div style="flex:1;height:8px;background:#e5e7eb;border-radius:4px;overflow:hidden">
                    <div style="height:100%;width:@(doneCount * 100 / totalCount)%;background:@(doneCount == totalCount ? "#16a34a" : "#0369a1");border-radius:4px;transition:width .3s"></div>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:8px">
                @foreach (var (done, label, tab, hint, optional) in checks)
                {
                    <div style="display:flex;align-items:flex-start;gap:12px;padding:12px 14px;border-radius:8px;
                                background:@(done?"#f0fdf4":"#fafafa");border:1px solid @(done?"#bbf7d0":"var(--border)")">
                        <div style="width:22px;height:22px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;
                                    background:@(done?"#dcfce7":"#e5e7eb");color:@(done?"#16a34a":"#9ca3af");font-size:13px;font-weight:700;margin-top:1px">
                            @(done ? "✓" : "·")
                        </div>
                        <div style="flex:1;min-width:0">
                            <div style="font-size:13px;font-weight:@(done?"500":"600");color:@(done?"#166534":"var(--text-1)")">
                                @label
                                @if (optional)
                                {
                                    <span style="margin-left:6px;font-size:10px;font-weight:600;color:#64748b;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:4px;padding:1px 6px;vertical-align:middle">İsteğe bağlı</span>
                                }
                            </div>
                            @if (!done)
                            { <div style="font-size:11px;color:var(--text-3);margin-top:2px">@hint</div> }
                        </div>
                        @if (!done)
                        {
                            <button class="btn btn-outline btn-sm" style="flex-shrink:0;font-size:11px;padding:3px 10px"
                                    @onclick="() => _tab = tab">
                                Git →
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* ════ CONFIG IMPORT ════════════════════════════════════════════════ *@
    @if (_tab == "import")
    {
        <div class="cfg-section-hdr">
            <h2>Ayar İçe Aktarma</h2>
            <p>Daha önce dışa aktarılan bir ayar yedeğini içe aktarın. Hassas değerler (SMTP şifresi, LDAP bağlantı şifresi vb.) içe aktarılmaz.</p>
        </div>

        @if (_importError != null)
        {
            <div class="alert alert-error" style="margin-bottom:16px">@_importError</div>
        }
        @if (_importSuccess != null)
        {
            <div class="alert alert-success" style="margin-bottom:16px">@_importSuccess</div>
        }

        @if (_importPreview == null)
        {
            <div class="cfg-card">
                <div class="cfg-card-hdr">
                    <div class="cfg-card-icon" style="background:#eff6ff"></div>
                    <div>
                        <div class="cfg-card-title">JSON Dosyası Seçin</div>
                        <div class="cfg-card-desc">Admin → Sistem Sağlığı → "↓ Ayar Yedeği" ile oluşturulan dosyayı yükleyin.</div>
                    </div>
                </div>
                <div class="field-info" style="margin-bottom:12px">
                    <strong>İçe aktarılmayan alanlar:</strong> SMTP şifresi, LDAP bind şifresi, bağlantı dizesi şifresi, token/secret değerleri.
                </div>
                <InputFile OnChange="HandleImportFile" accept=".json" />
            </div>
        }
        else
        {
            <div class="cfg-card">
                <div class="cfg-card-hdr" style="margin-bottom:12px">
                    <div class="cfg-card-icon" style="background:#fef3c7"></div>
                    <div>
                        <div class="cfg-card-title">Önizleme — Değişecek Ayarlar</div>
                        <div class="cfg-card-desc">Aşağıdaki @_importPreview.Count ayar güncellenecek. Kontrol edin, sonra onaylayın.</div>
                    </div>
                </div>

                <table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:16px">
                    <thead>
                        <tr style="border-bottom:2px solid var(--border)">
                            <th style="padding:7px 8px;text-align:left;color:var(--text-3);font-weight:600">Ayar Anahtarı</th>
                            <th style="padding:7px 8px;text-align:left;color:var(--text-3);font-weight:600">Mevcut Değer</th>
                            <th style="padding:7px 8px;text-align:left;color:var(--text-3);font-weight:600">Yeni Değer</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _importPreview)
                        {
                            <tr style="border-bottom:1px solid var(--border)">
                                <td style="padding:7px 8px;font-family:monospace;font-size:11px;color:var(--text-2)">@item.Key</td>
                                <td style="padding:7px 8px;color:#9f1239;font-size:11px;max-width:220px;word-break:break-all">@item.Current</td>
                                <td style="padding:7px 8px;color:#166534;font-size:11px;max-width:220px;word-break:break-all">@item.New</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="display:flex;gap:10px;align-items:center">
                    <button class="btn btn-primary btn-sm" @onclick="ApplyImport">
                        Uygula (@_importPreview.Count ayar)
                    </button>
                    <button class="btn btn-outline btn-sm" @onclick="CancelImport">İptal</button>
                </div>
            </div>
        }
    }

    @* ════ MCP / AI BAĞLANTI ════════════════════════════════════════════ *@
    @if (_tab == "mcp")
    {
        <div class="cfg-section-hdr">
            <h2>MCP / AI Bağlantı</h2>
            <p>Yapay zeka araçlarını (Claude, Cursor vb.) sisteme bağlamak için API anahtarı yönetimi</p>
        </div>

        @if (!string.IsNullOrEmpty(_mcpError))
        {
            <div class="alert alert-error" style="margin-bottom:12px">@_mcpError</div>
        }

        @if (_mcpNewKey is not null)
        {
            <div class="alert alert-success" style="margin-bottom:16px">
                <strong>Anahtar oluşturuldu.</strong> Bu değeri şimdi kopyalayın — bir daha gösterilmeyecek:
                <div style="display:flex;align-items:center;gap:8px;margin-top:8px">
                    <code style="background:#f0fdf4;border:1px solid #bbf7d0;padding:8px 12px;border-radius:6px;font-size:13px;flex:1;word-break:break-all">@_mcpNewKey</code>
                </div>
                <div style="margin-top:10px;font-size:12px;color:var(--text-3)">
                    <strong>Claude Desktop için config örneği:</strong>
                    <pre style="margin-top:6px;background:#1e293b;color:#e2e8f0;padding:10px;border-radius:6px;font-size:11px;overflow-x:auto">@GetMcpClaudeConfig()</pre>
                </div>
                <button class="btn btn-sm" style="margin-top:8px" @onclick="() => _mcpNewKey = null">Kapat</button>
            </div>
        }

        @if (_mcpShowCreate)
        {
            <div class="cfg-card" style="margin-bottom:16px">
                <div class="cfg-card-hdr">
                    <div class="cfg-card-icon" style="background:#f0f9ff"></div>
                    <div><div class="cfg-card-title">Yeni API Anahtarı</div></div>
                </div>
                <div class="form-group">
                    <label class="form-label">Anahtar Adı *</label>
                    <input class="form-control" @bind="_mcpCreateName" placeholder="örn: Claude Desktop, Cursor, VS Code" />
                    <div class="field-info">Bu anahtarı hangi araç için oluşturduğunuzu belirtin</div>
                </div>
                <div class="form-group">
                    <label class="form-label">Kapsam (isteğe bağlı)</label>
                    <select class="form-control" @bind="_mcpCreateScopeUserId">
                        <option value="">— Tam erişim (admin davranışı) —</option>
                        @foreach (var u in _mcpUserChoices)
                        { <option value="@u.Id">@u.FullName (@u.Role)</option> }
                    </select>
                    <div class="field-info">Bir kullanıcı seçilirse bu anahtar yalnızca o kullanıcının görebildiği verilere erişebilir.</div>
                </div>
                <div style="display:flex;gap:8px;margin-top:12px">
                    <button class="btn btn-primary" @onclick="McpCreateKey">Oluştur</button>
                    <button class="btn btn-outline" @onclick="() => { _mcpShowCreate = false; _mcpCreateName = string.Empty; _mcpCreateScopeUserId = string.Empty; }">İptal</button>
                </div>
            </div>
        }
        else
        {
            <div style="margin-bottom:16px">
                <button class="btn btn-primary" @onclick="() => _mcpShowCreate = true">+ Yeni Anahtar</button>
            </div>
        }

        <div class="cfg-card" style="padding:0;overflow:auto;margin-bottom:16px">
            @if (!_mcpKeys.Any())
            {
                <div style="padding:32px;text-align:center;color:var(--text-3)">
                    Henüz API anahtarı oluşturulmamış.<br />
                    <small>Yapay zeka araçlarınızı bağlamak için yukarıdan yeni anahtar oluşturun.</small>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Ad</th>
                            <th>Anahtar Öneki</th>
                            <th>Kapsam</th>
                            <th>Oluşturan</th>
                            <th>Oluşturulma</th>
                            <th>Son Kullanım</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in _mcpKeys)
                        {
                            <tr>
                                <td style="font-weight:600">@k.Name</td>
                                <td><code style="font-size:12px">@k.KeyPrefix…</code></td>
                                <td style="font-size:12px">
                                    @if (k.ScopeUserName is not null)
                                    {
                                        <span class="tag" style="font-size:10px">@k.ScopeUserName</span>
                                        <div style="font-size:10px;color:var(--text-3)">@k.ScopeUserRole</div>
                                    }
                                    else
                                    { <span style="color:var(--text-3);font-size:11px">Tam erişim</span> }
                                </td>
                                <td style="font-size:12px">@k.CreatedByName</td>
                                <td style="font-size:12px">@k.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td style="font-size:12px">
                                    @(k.LastUsedAt.HasValue ? k.LastUsedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "—")
                                </td>
                                <td>
                                    @if (k.IsActive)
                                    { <span class="tag tag-success">Aktif</span> }
                                    else
                                    { <span class="tag tag-error">İptal Edildi</span> }
                                </td>
                                <td>
                                    @if (k.IsActive)
                                    { <button class="btn btn-sm btn-danger" @onclick="() => McpRevoke(k.Id)">İptal Et</button> }
                                    else
                                    { <button class="btn btn-sm" @onclick="() => McpDelete(k.Id)">Sil</button> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="cfg-card">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0f9ff"></div>
                <div><div class="cfg-card-title">MCP Endpoint Bilgisi</div></div>
            </div>
            <p style="font-size:13px;color:var(--text-2);margin:0 0 8px">MCP sunucusuna bağlanmak için aşağıdaki URL'yi kullanın:</p>
            <code style="background:var(--bg-2);padding:8px 12px;border-radius:6px;font-size:12px;display:block">@(_mcpBaseUrl)/mcp</code>
            <p style="font-size:12px;color:var(--text-3);margin:8px 0 0">
                Bağlantı için <code>X-Api-Key</code> header'ı veya <code>Authorization: Bearer &lt;key&gt;</code> kullanın.
            </p>
        </div>
    }

    @* ════ E-POSTA KUYRUĞU ══════════════════════════════════════════════ *@
    @if (_tab == "email_monitor")
    {
        <div class="cfg-section-hdr">
            <h2>E-posta Kuyruğu</h2>
            <p>SMTP durumu ve son gönderim geçmişi. <button class="btn btn-outline btn-sm" style="margin-left:8px" @onclick="RefreshEmailMonitor">Yenile</button></p>
        </div>

        <div class="cfg-card" style="margin-bottom:16px">
            <div class="cfg-card-hdr">
                <div class="cfg-card-icon" style="background:#f0f9ff"></div>
                <div><div class="cfg-card-title">SMTP Yapılandırması</div></div>
                <button class="btn btn-outline btn-sm" style="margin-left:auto" @onclick='()=>_tab="email"'>Ayarları Düzenle</button>
            </div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;font-size:13px">
                <div class="cfg-stat">
                    <span style="color:var(--text-3)">Durum</span>
                    @if (_emailSettings.Enabled)
                    { <span class="tag tag-success">Aktif</span> }
                    else
                    { <span class="tag tag-error">Devre Dışı</span> }
                </div>
                <div class="cfg-stat">
                    <span style="color:var(--text-3)">Sunucu</span>
                    <code style="font-size:12px">@(_emailSettings.Host.Length > 0 ? _emailSettings.Host : "—"):@_emailSettings.Port</code>
                </div>
                <div class="cfg-stat">
                    <span style="color:var(--text-3)">SSL/TLS</span>
                    <span>@(_emailSettings.UseSsl ? "Evet" : "Hayır")</span>
                </div>
                <div class="cfg-stat">
                    <span style="color:var(--text-3)">Gönderen</span>
                    <span>@(_emailSettings.FromAddress.Length > 0 ? _emailSettings.FromAddress : "—")</span>
                </div>
                <div class="cfg-stat">
                    <span style="color:var(--text-3)">Kuyruk</span>

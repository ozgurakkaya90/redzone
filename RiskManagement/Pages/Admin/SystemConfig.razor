    // ── Export ────────────────────────────────────────────────────────────
    private async Task DownloadConfigExport()
    {
        var all = CfgSvc.GetAll();
        var sensitiveKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "email_settings", "smtp_password", "bind_password" };

        var export = new Dictionary<string, object?>();
        foreach (var (k, v) in all)
        {
            if (sensitiveKeys.Any(s => k.Contains(s, StringComparison.OrdinalIgnoreCase)))
                continue;
            // Email settings: include but mask password
            if (k == "email_settings" && v is System.Text.Json.JsonElement je)
            { export[k] = "[MASKELENDI]"; continue; }
            export[k] = v;
        }

        var json = System.Text.Json.JsonSerializer.Serialize(new
        {
            exported_at = DateTime.UtcNow,
            version     = System.Reflection.Assembly.GetExecutingAssembly().GetName().Version?.ToString(),
            settings    = export,
        }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true, PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.SnakeCaseLower });

        LogChange("config_export", null, null, "Ayar yedeği (export) indirildi");
        await DownloadText($"config-export-{DateTime.Now:yyyyMMdd-HHmm}.json", json);

    protected override void OnInitialized()
    {
        _advancedMode   = CfgSvc.Get<bool>("admin_cfg_advanced_mode");
        _emailSettings  = CfgSvc.GetEmailSettings();
        _appName        = CfgSvc.Get<string>("app_name")      is { Length: > 0 } n  ? n  : "RED";
        _appTagline     = CfgSvc.Get<string>("app_tagline")   is { Length: > 0 } tl ? tl : "Risk · Etik · Denetim";
        _sidebarColor       = CfgSvc.Get<string>("sidebar_color")          is { Length: > 0 } sc ? sc : "#0f1f33";
        _sidebarTextColor   = CfgSvc.Get<string>("sidebar_text_color")   is { Length: > 0 } tc ? tc : "#94A3B8";
        _sidebarFontSize    = int.TryParse(CfgSvc.Get<string>("sidebar_font_size"),     out var fs) ? fs : 13;
        _sidebarFont        = CfgSvc.Get<string>("sidebar_font")         is { Length: > 0 } sf ? sf : "Inter";
        _navSectionColor    = CfgSvc.Get<string>("nav_section_color")    is { Length: > 0 } nc ? nc : "#64748B";
        _navSectionFontSize = int.TryParse(CfgSvc.Get<string>("nav_section_font_size"), out var nf) ? nf : 10;
        _logoPath           = CfgSvc.Get<string>("logo_path")            ?? "";

        // E-posta şablonları
        foreach (var k in new[]{ "risk_proposed","status_changed","owner_assigned","action_due","test" })
        {
            _emailTplSubjects[k] = CfgSvc.Get<string>($"email_tpl_{k}_subject") ?? "";
            _emailTplBodies[k]   = CfgSvc.Get<string>($"email_tpl_{k}_body")    ?? "";
        }

        _riskActive     = CfgSvc.IsModuleActive("risk");
        _auditActive    = CfgSvc.IsModuleActive("audit");
        _externalActive = CfgSvc.IsModuleActive("external");
        _ethicsActive   = CfgSvc.IsModuleActive("ethics");
        _ldapEnabled    = Db.LdapConfigurations.FirstOrDefault()?.Enabled ?? false;
        _ldapCfg        = Db.LdapConfigurations.FirstOrDefault() ?? new LdapConfiguration();
        ParseAppDb();
        ReloadCompanies();
        _departments = [.. Db.Departments.Include(d => d.Manager)
            .Include(d => d.Organization).ThenInclude(o => o!.Company).OrderBy(d => d.Name)];
        _allUsers    = [.. Db.Users.Where(u => u.IsActive).OrderBy(u => u.FullName)];

        var theme = CfgSvc.Get<JsonElement>("site_theme");
        _primaryColor   = theme.TryGetProperty("primary_color",   out var p) ? p.GetString()! : "#E1251B";
        _secondaryColor = theme.TryGetProperty("secondary_color", out var s) ? s.GetString()! : "#16a34a";

        _riskCategories       = [.. CfgSvc.GetList("risk_categories")];
        _riskStrategies       = [.. CfgSvc.GetList("risk_strategies")];
        _controlTypes         = [.. CfgSvc.GetList("control_types")];
        _controlEffectiveness = [.. CfgSvc.GetList("control_effectiveness")];
        _controlFrequencies   = [.. CfgSvc.GetList("control_frequencies")];
        _auditTypes           = [.. CfgSvc.GetList("audit_types")];
        _auditCategories      = [.. CfgSvc.GetList("audit_categories")];
        _auditSeverities      = [.. CfgSvc.GetList("audit_severities")];
        _ethicsCategories     = [.. CfgSvc.GetList("ethics_categories")];
        _riskDetailFields     = CfgSvc.GetRiskDetailFields();
        _reviewThresholdDays  = CfgSvc.Get<int>("review_threshold_days") is var t && t > 0 ? t : 90;
        _weekDays             = CfgSvc.GetWeekDays();
        _warnDays             = CfgSvc.GetWarnDays();
        _critDays             = CfgSvc.GetCritDays();
        _defaultActionDueDays  = CfgSvc.GetDefaultActionDueDays();
        _secMaxFailedLogins    = CfgSvc.GetMaxFailedLogins();
        _secLockoutMinutes     = CfgSvc.GetLockoutMinutes();
        _secPasswordMinLen     = CfgSvc.GetPasswordMinLength();
        _secPasswordComplexity = CfgSvc.GetPasswordComplexity();
        _secSessionHours       = CfgSvc.GetSessionTimeoutHours();
        _secResetTokenMin      = CfgSvc.GetResetTokenMinutes();
        _actionDueRemindDays   = CfgSvc.GetActionDueRemindDays();
        _emailEventToggles     = _emailEvents.ToDictionary(e => e.Key, e => CfgSvc.IsEmailEventEnabled(e.Key));
        _actionRequireToggles  = _actionRequireDefs.ToDictionary(d => d.Key, d => CfgSvc.IsActionFieldRequired(d.Key));
        ExtReloadBodies();
        _extUsers = [.. Db.Users.Where(u => u.IsActive).OrderBy(u => u.FullName)];
        MigrRefresh();

        // MCP
        var ctx = HttpCtx.HttpContext;
        if (ctx is not null)
        {
            var idStr = ctx.User.FindFirstValue(ClaimTypes.NameIdentifier);
            int.TryParse(idStr, out _mcpCurrentUserId);
            _mcpBaseUrl = $"{ctx.Request.Scheme}://{ctx.Request.Host}";
        }
        McpLoadKeys();

        // E-posta Kuyruğu
        _emailLog = EmailQueueSvc.GetLog();
    }

    // ── E-posta ──────────────────────────────────────────────────────────────
    private void ApplyPreset(string provider)
    {
        switch (provider)
        {
            case "m365":
                _emailSettings.Host   = "smtp.office365.com";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = true;
                break;
            case "gmail":
                _emailSettings.Host   = "smtp.gmail.com";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = true;
                break;
            case "exchange":
                _emailSettings.Host   = "mail.sirketiniz.local";
                _emailSettings.Port   = 25;
                _emailSettings.UseSsl = false;
                break;
        }
    }

    private void ApplySmtpPreset(string provider)
    {
        switch (provider)
        {
            case "gmail":
                _emailSettings.Host   = "smtp.gmail.com";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = true;
                break;
            case "outlook":
                _emailSettings.Host   = "smtp.office365.com";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = true;
                break;
            case "yandex":
                _emailSettings.Host   = "smtp.yandex.com";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = true;
                break;
            case "custom":
                _emailSettings.Host   = "";
                _emailSettings.Port   = 587;
                _emailSettings.UseSsl = false;
                break;
        }
    }

    private void SaveEmailSettings()
    {
        CfgSvc.SetEmailSettings(_emailSettings);
        LogChange("email_settings",
            "[eski]",
            $"host={_emailSettings.Host};port={_emailSettings.Port};ssl={_emailSettings.UseSsl};enabled={_emailSettings.Enabled};from={_emailSettings.FromAddress}",
            "SMTP ayarları güncellendi");
        _emailSaveMsg = "Kaydedildi";
        _ = Task.Delay(3000).ContinueWith(_ => { _emailSaveMsg = ""; InvokeAsync(StateHasChanged); });
    }

    private async Task SendTestEmail()
    {
        if (string.IsNullOrWhiteSpace(_testEmail)) return;
        _testSending = true; _testResult = "";
        try
        {
            await EmailSvc.SendTestAsync(_testEmail, _testEmail);
            _testResult = $"Test e-postası kuyruğa eklendi → {_testEmail}";
            _testOk = true;
        }
        catch (Exception ex) { _testResult = $"Hata: {ex.Message}"; _testOk = false; }
        finally { _testSending = false; }
    }


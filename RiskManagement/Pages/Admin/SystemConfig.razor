    private async Task CheckSmtp()
    {
        _smtpChecking = true; _smtpCheckMsg = null;
        StateHasChanged();
        var s = CfgSvc.GetEmailSettings();
        if (!s.Enabled) { _smtpCheckOk = false; _smtpCheckMsg = "E-posta gönderimi devre dışı (Ayarlar → E-posta SMTP)"; _smtpChecking = false; return; }
        try
        {
            using var client = new System.Net.Mail.SmtpClient(s.Host, s.Port);
            client.EnableSsl    = s.UseSsl;
            client.Timeout      = 5000;
            if (!string.IsNullOrEmpty(s.Username))
                client.Credentials = new System.Net.NetworkCredential(s.Username, s.Password);
            await Task.Run(() => client.Send(new System.Net.Mail.MailMessage("noreply@test.local", "noreply@test.local", "ping", "ping")));
            _smtpCheckOk  = true;
            _smtpCheckMsg = $"Bağlantı başarılı — {s.Host}:{s.Port}";
        }
        catch (Exception ex)
        {
            _smtpCheckOk  = false;
            _smtpCheckMsg = ex.Message.Length > 120 ? ex.Message[..120] + "…" : ex.Message;
        }
        finally { _smtpChecking = false; }
    }

    private void CheckUploadsDir()
    {
        var path = Path.Combine(Env.WebRootPath, "uploads");
        _uploadsDirChecked = true;
        try
        {
            if (!Directory.Exists(path))
            {
                Directory.CreateDirectory(path);
            }
            var testFile = Path.Combine(path, ".write_test");
            System.IO.File.WriteAllText(testFile, "ok");
            System.IO.File.Delete(testFile);
            var bytes = Directory.GetFiles(path, "*", SearchOption.AllDirectories).Sum(f => new FileInfo(f).Length);
            _uploadsDirSizeStr = bytes < 1024 * 1024 ? $"{bytes / 1024.0:F1} KB" : $"{bytes / 1024.0 / 1024.0:F1} MB";
            _uploadsDirOk = true;
        }
        catch { _uploadsDirOk = false; _uploadsDirSizeStr = ""; }
    }


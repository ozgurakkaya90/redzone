    // ── LDAP ─────────────────────────────────────────────────────────────────
    private void SaveLdap()
    {
        _ldapSaved = false; _ldapTestSteps = [];
        _ldapCfg.UpdatedAt = DateTime.UtcNow;
        var existing = Db.LdapConfigurations.FirstOrDefault();
        if (existing == null) { Db.LdapConfigurations.Add(_ldapCfg); }
        else
        {
            existing.Enabled = _ldapCfg.Enabled; existing.Server = _ldapCfg.Server;
            existing.Port = _ldapCfg.Port; existing.UseSsl = _ldapCfg.UseSsl; existing.UseTls = _ldapCfg.UseTls;
            existing.Timeout = _ldapCfg.Timeout; existing.BindDn = _ldapCfg.BindDn;
            existing.BindPassword = _ldapCfg.BindPassword; existing.UserSearchBase = _ldapCfg.UserSearchBase;
            existing.UserSearchFilter = _ldapCfg.UserSearchFilter; existing.AttrDisplayName = _ldapCfg.AttrDisplayName;
            existing.AttrEmail = _ldapCfg.AttrEmail; existing.AttrDepartment = _ldapCfg.AttrDepartment;
            existing.AutoCreateUsers = _ldapCfg.AutoCreateUsers; existing.DefaultRole = _ldapCfg.DefaultRole;
            existing.UpdatedAt = _ldapCfg.UpdatedAt;
        }
        Db.SaveChanges(); _ldapSaved = true;
    }

    private async Task TestLdapConnection()
    {
        if (string.IsNullOrWhiteSpace(_ldapCfg.Server)) return;
        _ldapTestRunning = true; _ldapTestSteps = []; StateHasChanged();
        await Task.Run(() =>
        {
            try
            {
                using var tcp = new System.Net.Sockets.TcpClient();
                if (!tcp.ConnectAsync(_ldapCfg.Server!, _ldapCfg.Port).Wait(_ldapCfg.Timeout * 1000))
                { _ldapTestSteps.Add($"❌ TCP: {_ldapCfg.Server}:{_ldapCfg.Port} erişilemiyor."); _ldapTestSuccess = false; return; }
                _ldapTestSteps.Add($"✅ TCP: {_ldapCfg.Server}:{_ldapCfg.Port} erişilebilir.");

                var conn = new LdapConnection { SecureSocketLayer = _ldapCfg.UseSsl };
                conn.Connect(_ldapCfg.Server!, _ldapCfg.Port);
                if (_ldapCfg.UseTls) conn.StartTls();
                _ldapTestSteps.Add(_ldapCfg.UseSsl ? "✅ LDAPS bağlantısı kuruldu." : "✅ LDAP bağlantısı kuruldu.");
                if (!string.IsNullOrEmpty(_ldapCfg.BindDn)) conn.Bind(_ldapCfg.BindDn, _ldapCfg.BindPassword ?? "");
                _ldapTestSteps.Add("✅ Bind başarılı.");
                conn.Disconnect();
                _ldapTestSuccess = true;
            }
            catch (Exception ex) { _ldapTestSteps.Add($"❌ {ex.Message}"); _ldapTestSuccess = false; }
        });
        _ldapTestRunning = false; StateHasChanged();
    }

    // ── Veritabanı ───────────────────────────────────────────────────────────
    private void ParseAppDb()
    {
        var raw = AppConfig.GetConnectionString("DefaultConnection") ?? "";
        _appDbConnStrMasked = System.Text.RegularExpressions.Regex.Replace(
            raw, @"(?i)(password|pwd)=([^;]+)", m => $"{m.Groups[1].Value}=••••••");
        var parts = raw.Split(';', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2)).Where(p => p.Length == 2)
            .ToDictionary(p => p[0].Trim().ToLowerInvariant(), p => p[1].Trim());
        _appDbInfo = new AppDbInfo
        {
            Host = parts.GetValueOrDefault("server") ?? "", Port = 3306,
            DatabaseName = parts.GetValueOrDefault("database") ?? "",
            Username = parts.GetValueOrDefault("user") ?? "", RawConnStr = raw,
        };
    }

    private async Task TestAppDb()
    {
        _testingAppDb = true; _appDbTestResult = null; _appDbDetail = null; StateHasChanged();
        try
        {
            using var conn = new MySqlConnection(_appDbInfo.RawConnStr);
            await conn.OpenAsync();
            using var cmd = conn.CreateCommand();
            cmd.CommandText = "SELECT VERSION(), (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE())";
            using var r = await cmd.ExecuteReaderAsync();
            if (await r.ReadAsync()) { _appDbTestOk = true; _appDbTestResult = $"✅ MySQL {r.GetString(0)} · {r.GetInt32(1)} tablo"; }
        }
        catch (Exception ex) { _appDbTestOk = false; _appDbTestResult = $"❌ {ex.Message}"; }
        _testingAppDb = false;
    }

    private async Task BrowseAppDbTables()
    {
        _appDbTables.Clear();
        try
        {
            using var conn = new MySqlConnection(_appDbInfo.RawConnStr);
            await conn.OpenAsync(); using var cmd = conn.CreateCommand();
            cmd.CommandText = "SHOW TABLES"; using var r = await cmd.ExecuteReaderAsync();
            while (await r.ReadAsync()) _appDbTables.Add(r.GetString(0));
        }
        catch (Exception ex) { _appDbTables.Add($"Hata: {ex.Message}"); }
    }


    void ReloadDepts() =>
        _departments = [.. Db.Departments.Include(d => d.Manager)
            .Include(d => d.Organization).ThenInclude(o => o!.Company).OrderBy(d => d.Name)];

    private void AddCompany()
    {
        _companyError = "";
        if (string.IsNullOrWhiteSpace(_newCompanyName)) { _companyError = "Şirket adı boş olamaz."; return; }
        if (Db.Companies.Any(c => c.Name == _newCompanyName.Trim())) { _companyError = "Bu şirket zaten mevcut."; return; }
        Db.Companies.Add(new Company { Name = _newCompanyName.Trim(), Description = string.IsNullOrWhiteSpace(_newCompanyDesc) ? null : _newCompanyDesc.Trim() });
        Db.SaveChanges();
        _newCompanyName = ""; _newCompanyDesc = "";
        ReloadCompanies(); _success = "Şirket eklendi.";
    }

    private void DeleteCompany(int id)
    {
        var c = Db.Companies.Find(id); if (c == null) return;
        Db.Companies.Remove(c); Db.SaveChanges();
        ReloadCompanies(); _success = "Şirket silindi.";
    }

    private void AddOrganization()
    {
        _orgError = "";
        if (string.IsNullOrWhiteSpace(_newOrgName)) { _orgError = "Organizasyon adı boş olamaz."; return; }
        Db.Organizations.Add(new Organization { Name = _newOrgName.Trim(), CompanyId = _newOrgCompanyId });
        Db.SaveChanges();
        _newOrgName = ""; _newOrgCompanyId = null;
        ReloadCompanies(); _success = "Organizasyon eklendi.";
    }

    private void DeleteOrganization(int id)
    {
        var o = Db.Organizations.Find(id); if (o == null) return;
        Db.Organizations.Remove(o); Db.SaveChanges();
        ReloadCompanies(); _success = "Organizasyon silindi.";
    }

    private void AddDepartment()
    {
        _deptError = "";
        if (string.IsNullOrWhiteSpace(_newDeptName)) { _deptError = "Departman adı boş olamaz."; return; }
        if (Db.Departments.Any(d => d.Name == _newDeptName.Trim())) { _deptError = "Bu departman zaten mevcut."; return; }
        Db.Departments.Add(new Department { Name = _newDeptName.Trim(), OrganizationId = _newDeptOrgId });
        Db.SaveChanges();
        _newDeptName = ""; _newDeptOrgId = null;
        ReloadDepts(); _success = "Departman eklendi.";
    }

    private void DeleteDepartment(int id)
    {
        var dept = Db.Departments.Find(id); if (dept == null) return;
        Db.Departments.Remove(dept); Db.SaveChanges();
        ReloadDepts(); _success = "Departman silindi.";
    }

    private void SetManager(int deptId, string managerIdStr)
    {
        var dept = Db.Departments.Find(deptId); if (dept == null) return;
        dept.ManagerUserId = int.TryParse(managerIdStr, out var mid) && mid > 0 ? mid : null;
        Db.SaveChanges(); ReloadDepts(); _success = "Yönetici güncellendi.";
    }

    private void SetOrganization(int deptId, string orgIdStr)
    {
        var dept = Db.Departments.Find(deptId); if (dept == null) return;
        dept.OrganizationId = int.TryParse(orgIdStr, out var oid) && oid > 0 ? oid : null;
        Db.SaveChanges(); ReloadDepts(); _success = "Organizasyon güncellendi.";
    }
}

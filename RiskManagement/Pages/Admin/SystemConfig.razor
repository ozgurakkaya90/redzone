    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        _logoError = "";
        var file = e.File;
        if (file.Size > 2_000_000) { _logoError = "Maksimum dosya boyutu 2 MB."; return; }
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not ".png" and not ".jpg" and not ".jpeg")
        { _logoError = "Sadece PNG veya JPG yükleyebilirsiniz. SVG güvenlik nedeniyle desteklenmez."; return; }

        var dir = Path.Combine(Env.WebRootPath, "uploads");
        Directory.CreateDirectory(dir);
        var dest = Path.Combine(dir, $"logo{ext}");
        await using var fs = File.Create(dest);
        await using var stream = file.OpenReadStream(2_000_000);
        await stream.CopyToAsync(fs);

        _logoPath = $"/uploads/logo{ext}?v={DateTimeOffset.UtcNow.ToUnixTimeSeconds()}";
        CfgSvc.Set("logo_path", _logoPath);
    }


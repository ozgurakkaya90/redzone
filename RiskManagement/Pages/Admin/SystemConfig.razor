        try
        {
            var pending = string.Join(", ", _migrPending);
            await Task.Run(() => Db.Database.Migrate()); MigrRefresh();
            _migrResult = _migrPending.Count == 0 ? "Migration'lar başarıyla uygulandı." : $"Tamamlandı. Hâlâ {_migrPending.Count} bekleyen var.";
            LogChange("db_migration", "[bekleyen]", pending, "Veritabanı migration çalıştırıldı");
        }
        catch (Exception ex) { Logger.LogError(ex, "Migration hatası"); _migrResult = "Hata: " + ex.Message; MigrRefresh(); }
        finally { _migrRunning = false; }
    }
    private async Task MigrRestartApp()
    {
        _migrRestarting = true; _migrRestartMsg = "Yeniden başlatma komutu verildi. 10 saniye içinde site tekrar açılacak…"; StateHasChanged();
        await Task.Delay(300);
        _ = Task.Run(async () => { await Task.Delay(500); Environment.Exit(0); });
    }
}

@page "/dashboard"
@attribute [Authorize]
@inject RiskService RiskSvc
@inject AuditService AuditSvc
@inject ExternalAuditService ExtAuditSvc
@inject EthicsService EthicsSvc
@inject ConfigService CfgSvc
@inject TaskService TaskSvc
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@using System.Security.Claims
@using RiskManagement.Models
@using Microsoft.EntityFrameworkCore

<PageTitle>Ana Panel — RED</PageTitle>

<!-- ── Üst karşılama şeridi ── -->
<div class="page-toolbar">
    <div class="page-toolbar-left">
        <h1 class="page-toolbar-title">Hoş geldiniz, @FullName.Split(' ')[0]</h1>
        <div class="page-toolbar-sub">
            @DateTime.Now.ToString("dd MMMM yyyy, dddd", new System.Globalization.CultureInfo("tr-TR"))
        </div>
    </div>
    <div class="page-toolbar-actions">
        @if (_modRisk)  { <a href="/risk/new" class="btn btn-primary btn-sm">+ Risk Öner</a> }
        @if (_modAudit) { <a href="/audit/findings/new" class="btn btn-outline btn-sm">Bulgu Gir</a> }
    </div>
</div>

<!-- ── Dikkat gerektiren ── -->
@if (_urgent.Count > 0)
{
    <div class="attention-strip">
        <div class="attention-strip-hdr">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="#b45309" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span class="attention-strip-title">Dikkat Gerektiriyor</span>
            <span class="attention-strip-count">@_urgent.Count öğe</span>
        </div>
        @foreach (var u in _urgent.Take(5))
        {
            <a href="@u.Url" class="attention-strip-item">
                <span class="attention-strip-item-title">@u.Title</span>
                <span class="attention-strip-item-cat">@u.Category</span>
                <span style="color:var(--text-3);font-size:12px">›</span>
            </a>
        }
        @if (_urgent.Count > 5)
        {
            <div style="font-size:12px;color:#b45309;padding-top:6px">+ @(_urgent.Count - 5) öğe daha</div>
        }
    </div>
}

<!-- ── Özet rakamlar ── -->
<div class="stat-strip">
    @foreach (var (label, value, color, _, href) in _summaryCards)
    {
        <a href="@href" class="stat-strip-item" style="--stat-color:@color">
            <div class="stat-strip-val">@value</div>
            <div class="stat-strip-label">@label</div>
        </a>
    }
</div>

<!-- ── Görevlerim ── -->
<div class="card" style="margin-bottom:20px;padding:0;overflow:hidden">
    <div class="task-list-hdr">
        <span class="task-list-title">Görevlerim</span>
        @if (_tasks.Count > 0)
        {
            <span class="task-list-count">@_tasks.Count</span>
        }
        <div class="task-list-controls">
            <select class="form-control" style="font-size:11px;padding:3px 6px;width:auto" @onchange="OnSortChange">
                <option value="priority">Öncelik</option>
                <option value="category">Kategori</option>
                <option value="title">Başlık</option>
            </select>
            <button class="btn btn-outline btn-sm" style="padding:3px 8px;min-height:28px"
                    @onclick="() => _sortAsc = !_sortAsc">
                @(_sortAsc ? "↑" : "↓")
            </button>
        </div>
    </div>

    @if (SortedTasks.Count == 0)
    {
        <div class="task-item" style="color:var(--text-3)">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            <div class="task-item-body">
                <div class="task-item-title" style="color:var(--text-2)">Bekleyen göreviniz yok</div>
                <div class="task-item-detail">Harika gidiyorsunuz!</div>
            </div>
        </div>
    }
    else
    {
        <div class="task-list-body">
            @foreach (var task in SortedTasks)
            {
                <a href="@task.Url" class="task-item"
                   style="--task-color:@task.Color;--task-bg:@task.Bg;--task-border:@(task.Color+"40")">
                    <span class="task-item-bar"></span>
                    <div class="task-item-body">
                        <div class="task-item-title">@task.Title</div>
                        <div class="task-item-detail">@task.Detail</div>
                    </div>
                    <span class="task-item-cat">@task.Category</span>
                    <span style="color:var(--text-3);font-size:12px">›</span>
                </a>
            }
        </div>
    }
</div>

<!-- ── Modül özetleri ── -->
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px">
    @if (_modRisk)
    {
        <div class="module-card">
            <div class="module-card-header">
                <span class="module-card-title">Risk Yönetimi</span>
                <span class="module-card-value">@_riskTotal</span>
            </div>
            <MiniBarRow Label="Öneri / İnceleme" Value="_riskProposedReview" Max="_riskTotal" Color="#6d28d9" />
            <MiniBarRow Label="Envanterde"        Value="_riskApproved"       Max="_riskTotal" Color="#16a34a" />
            <MiniBarRow Label="Kontrol / Aksiyon" Value="_riskControlled"     Max="_riskTotal" Color="#0284c7" />
            <MiniBarRow Label="Reddedilen"         Value="_riskRejected"       Max="_riskTotal" Color="#dc2626" />
            <a href="/risk/dashboard" class="module-card-link">Risk Paneline Git →</a>
        </div>
    }
    @if (CanSeeEthics && _modEthics)
    {
        <div class="module-card">
            <div class="module-card-header">
                <span class="module-card-title">Etik Yönetimi</span>
                <span class="module-card-value">@_ethicsTotal</span>
            </div>
            <MiniBarRow Label="Beklemede"    Value="_ethicsPending" Max="_ethicsTotal" Color="#6d28d9" />
            <MiniBarRow Label="Etik Kurulda" Value="_ethicsBoard"   Max="_ethicsTotal" Color="#ca8a04" />
            <MiniBarRow Label="Sonuçlanan"   Value="_ethicsClosed"  Max="_ethicsTotal" Color="#16a34a" />
            <a href="/ethics" class="module-card-link">Etik Paneline Git →</a>
        </div>
    }
    @if (_modAudit)
    {
        <div class="module-card">
            <div class="module-card-header">
                <span class="module-card-title">İç Denetim</span>
                <span class="module-card-value">@_auditOpen</span>
            </div>
            <MiniBarRow Label="Açık Bulgular"    Value="_auditOpen"             Max="@Math.Max(_auditTotal,1)" Color="#dc2626" />
            <MiniBarRow Label="Kapanış Bekleyen" Value="_auditClosureRequested" Max="@Math.Max(_auditTotal,1)" Color="#ca8a04" />
            <MiniBarRow Label="Kapalı"           Value="_auditClosed"           Max="@Math.Max(_auditTotal,1)" Color="#16a34a" />
            <MiniBarRow Label="Vadesi Geçmiş"    Value="_auditOverdue"          Max="@Math.Max(_auditTotal,1)" Color="#7f1d1d" />
            <a href="/audit" class="module-card-link">Denetim Paneline Git →</a>
        </div>
    }
    @if (_modExternal && _canSeeExternal)
    {
        <div class="module-card">
            <div class="module-card-header">
                <span class="module-card-title">Dış Denetim</span>
                <span class="module-card-value">@_extTotal</span>
            </div>
            <MiniBarRow Label="Planlandı"    Value="_extPlanned"    Max="@Math.Max(_extTotal,1)" Color="#3b82f6" />
            <MiniBarRow Label="Devam Ediyor" Value="_extInProgress" Max="@Math.Max(_extTotal,1)" Color="#f59e0b" />
            <MiniBarRow Label="Tamamlandı"   Value="_extCompleted"  Max="@Math.Max(_extTotal,1)" Color="#16a34a" />
            <MiniBarRow Label="Yaklaşan"     Value="_extUpcoming"   Max="@Math.Max(_extTotal,1)" Color="#0369a1" />
            <a href="/audit/external" class="module-card-link">Dış Denetimlere Git →</a>
        </div>
    }
</div>

@code {
    private string Role    => HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    private int    UserId  => int.TryParse(HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;
    private string FullName => HttpCtx.HttpContext?.User.FindFirst("full_name")?.Value ?? "Kullanıcı";
    private bool CanSeeEthics => Role is "audit_manager" or "ethics_board" or "admin";

    private bool _modRisk, _modAudit, _modEthics, _modExternal;
    private bool _canSeeExternal;
    private List<UserTask> _tasks = [], _urgent = [];
    private string _sortField = "priority";
    private bool   _sortAsc   = true;

    private void OnSortChange(ChangeEventArgs e) => _sortField = e.Value?.ToString() ?? "priority";

    private List<UserTask> SortedTasks => _sortField switch
    {
        "category" => _sortAsc ? [.. _tasks.OrderBy(t => t.Category)] : [.. _tasks.OrderByDescending(t => t.Category)],
        "title"    => _sortAsc ? [.. _tasks.OrderBy(t => t.Title)]    : [.. _tasks.OrderByDescending(t => t.Title)],
        _          => [.. _tasks.OrderByDescending(t => t.Priority == "urgent").ThenBy(t => t.Title)],
    };

    private int _riskTotal, _riskProposedReview, _riskApproved, _riskControlled, _riskRejected;
    private int _auditTotal, _auditOpen, _auditClosureRequested, _auditClosed, _auditOverdue;
    private int _ethicsTotal, _ethicsPending, _ethicsBoard, _ethicsClosed;
    private int _extTotal, _extPlanned, _extInProgress, _extCompleted, _extUpcoming;

    private List<(string Label, int Value, string Color, string Bg, string Href)> _summaryCards = [];

    protected override void OnInitialized()
    {
        _modRisk     = CfgSvc.IsModuleActive("risk");
        _modAudit    = CfgSvc.IsModuleActive("audit");
        _modEthics   = CfgSvc.IsModuleActive("ethics");
        _modExternal = CfgSvc.IsModuleActive("external");

        _tasks  = TaskSvc.GetTasksForUser(UserId, Role);
        _urgent = _tasks.Where(t => t.Priority == "urgent").ToList();

        var risks = RiskSvc.GetForUser(UserId, Role);
        _riskTotal          = risks.Count;
        _riskProposedReview = risks.Count(r => r.Status is "proposed" or "under_review" or "awaiting_approval");
        _riskApproved       = risks.Count(r => r.Status is "approved" or "strategy_set");
        _riskControlled     = risks.Count(r => r.Status is "controlled" or "residual_evaluated" or "action_planned");
        _riskRejected       = risks.Count(r => r.Status == "rejected");

        var highRisk = risks.Count(r =>
            r.Evaluations.FirstOrDefault(e => e.EvalType == "initial")?.RiskLevel
            is "Çok Yüksek Risk" or "Yüksek Risk");

        var stats = AuditSvc.GetDashboardForUser(UserId, Role, CfgSvc.GetList("audit_severities"));
        _auditTotal = stats.Total; _auditOpen = stats.Open;
        _auditClosureRequested = stats.ClosureRequested;
        _auditClosed = stats.Closed; _auditOverdue = stats.Overdue;

        if (CanSeeEthics)
        {
            var reports = EthicsSvc.GetAll();
            _ethicsTotal   = reports.Count;
            _ethicsPending = reports.Count(r => r.Status == "pending");
            _ethicsBoard   = reports.Count(r => r.Status == "ethics_board_notified");
            _ethicsClosed  = reports.Count(r => r.Status is "irrelevant" or "no_violation" or "disciplinary_referred");
        }

        if (_modExternal)
        {
            try
            {
                var user = Db.Users.Include(u => u.UserRoles).FirstOrDefault(u => u.Id == UserId);
                if (user != null)
                {
                    _canSeeExternal = ExtAuditSvc.IsAdmin(user) ||
                        user.UserRoles.Any(r => r.RoleName is "auditor" or "audit_manager") ||
                        Db.UserExternalAuditBodies.Any(b => b.UserId == user.Id);
                    if (_canSeeExternal)
                    {
                        var extStats = ExtAuditSvc.GetStats(user);
                        _extTotal      = extStats.Total;
                        _extPlanned    = extStats.Planned;
                        _extInProgress = extStats.InProgress;
                        _extCompleted  = extStats.Completed;
                        _extUpcoming   = extStats.Upcoming;
                    }
                }
            }
            catch { /* migration uygulanmamışsa sessizce yut */ }
        }

        _summaryCards =
        [
            ("Toplam Risk",       _riskTotal,          "#374151", "#f9fafb", "/risk"),
            ("İncelemede",        _riskProposedReview, "#1d4ed8", "#eff6ff", "/risk?status=under_review"),
            ("Yüksek / Kritik",   highRisk,            "#dc2626", "#fef2f2", "/risk?level=Yüksek Risk"),
            ("Açık Bulgular",     _auditOpen,          "#b45309", "#fffbeb", "/audit/findings"),
            ("Vadesi Geçmiş",     _auditOverdue,       "#7f1d1d", "#fff1f0", "/audit/findings"),
        ];
    }
}

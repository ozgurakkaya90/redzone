{
  // Bu dosyayı kopyalayın: cp appsettings.Development.example.json appsettings.Development.json
  // appsettings.Development.json .gitignore ile versiyon kontrolü dışındadır.
  "ConnectionStrings": {
    // SQLite için (geliştirme ortamı önerilir):
    "DefaultConnection": "Data Source=riskmanagement_dev.db"
    // MySQL için:
    // "DefaultConnection": "Server=localhost;Database=RiskManagement_Dev;User=riskapp;Password=dev_password;"
  },
  "AppSettings": {
    // SQLite kullanmak için true yapın (geliştirme ortamı için önerilir)
    "UseSqlite": true,
    // Demo modu: true yapılırsa varsayılan demo kullanıcıları oluşturulur
    "DemoMode": true,
    // Maksimum dosya yükleme boyutu (MB)
    "MaxUploadSizeMb": 10
  },
  "Email": {
    // Geliştirme ortamında e-posta devre dışı bırakın
    "Enabled": false,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "dev@example.com",
    "Password": "dev_smtp_password",
    "FromAddress": "noreply@example.com",
    "FromName": "RED Risk Sistemi (Dev)",
    "BaseUrl": "https://localhost:5001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}

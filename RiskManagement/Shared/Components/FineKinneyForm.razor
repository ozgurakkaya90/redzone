@inject ConfigService CfgSvc
@inject IRiskCalculator RiskCalc
@using RiskManagement.Models

<div>
    <!-- Olasılık -->
    <div class="fk-section">
        <div class="fk-section-title">
            <span class="fk-section-label">P — Olasılık</span>
            <span class="fk-section-hint">Bu olayın gerçekleşme ihtimali nedir?</span>
        </div>
        <div class="fk-options">
            @foreach (var opt in _probability)
            {
                var v = opt.Value;
                var sel = Math.Abs(_p - v) < 0.001 && _p > 0;
                <button type="button" class="fk-opt @(sel ? "selected" : "")" @onclick="() => _p = v">
                    <span class="fk-opt-val">@opt.Value.ToString("0.##")</span>
                    <span class="fk-opt-body">
                        <span class="fk-opt-label">@opt.Label</span>
                        @if (!string.IsNullOrEmpty(opt.Hint))
                        { <span class="fk-opt-hint">@opt.Hint</span> }
                    </span>
                    @if (sel) { <span class="fk-opt-check">✓</span> }
                </button>
            }
        </div>
    </div>

    <!-- Maruziyet -->
    <div class="fk-section">
        <div class="fk-section-title">
            <span class="fk-section-label">E — Maruziyet</span>
            <span class="fk-section-hint">Tehlikeye ne sıklıkla maruz kalınıyor?</span>
        </div>
        <div class="fk-options">
            @foreach (var opt in _exposure)
            {
                var v = opt.Value;
                var sel = Math.Abs(_e - v) < 0.001 && _e > 0;
                <button type="button" class="fk-opt @(sel ? "selected" : "")" @onclick="() => _e = v">
                    <span class="fk-opt-val">@opt.Value.ToString("0.##")</span>
                    <span class="fk-opt-body">
                        <span class="fk-opt-label">@opt.Label</span>
                        @if (!string.IsNullOrEmpty(opt.Hint))
                        { <span class="fk-opt-hint">@opt.Hint</span> }
                    </span>
                    @if (sel) { <span class="fk-opt-check">✓</span> }
                </button>
            }
        </div>
    </div>

    <!-- Sonuç -->
    <div class="fk-section">
        <div class="fk-section-title">
            <span class="fk-section-label">C — Sonuç</span>
            <span class="fk-section-hint">En kötü durumda ne olabilir?</span>
        </div>
        <div class="fk-options">
            @foreach (var opt in _consequence)
            {
                var v = opt.Value;
                var sel = Math.Abs(_c - v) < 0.001 && _c > 0;
                <button type="button" class="fk-opt @(sel ? "selected" : "")" @onclick="() => _c = v">
                    <span class="fk-opt-val">@opt.Value.ToString("0.##")</span>
                    <span class="fk-opt-body">
                        <span class="fk-opt-label">@opt.Label</span>
                        @if (!string.IsNullOrEmpty(opt.Hint))
                        { <span class="fk-opt-hint">@opt.Hint</span> }
                    </span>
                    @if (sel) { <span class="fk-opt-check">✓</span> }
                </button>
            }
        </div>
    </div>

    <!-- Canlı skor -->
    @if (_p > 0 && _e > 0 && _c > 0)
    {
        var score = Math.Round(_p * _e * _c, 2);
        var level = RiskCalc.CalculateRiskLevel(score);
        var color = RiskCalc.GetRiskLevelColor(level);
        <div class="fk-score-bar">
            <div>
                <div style="font-size:11px;color:var(--text-3);margin-bottom:2px">Risk Skoru = P × E × C</div>
                <div style="font-size:13px;color:var(--text-2)">
                    @_p.ToString("0.##") × @_e.ToString("0.##") × @_c.ToString("0.##") =
                    <strong style="font-size:24px;color:@color;margin-left:4px">@score.ToString("0.##")</strong>
                </div>
            </div>
            <div style="text-align:right">
                <div style="font-size:11px;color:var(--text-3);margin-bottom:4px">Seviye</div>
                <span style="display:inline-block;padding:4px 14px;border-radius:20px;background:@(color+"20");color:@color;font-weight:700;font-size:13px;border:1.5px solid @(color+"50")">
                    @level
                </span>
            </div>
        </div>
    }
    else
    {
        <div style="background:var(--gray-50);border:1px dashed var(--gray-300);border-radius:8px;padding:14px 16px;margin-bottom:16px">
            <div style="font-size:12px;font-weight:600;color:var(--text-2);margin-bottom:8px">
                Üç parametreyi de seçtikten sonra Risk Skoru = P × E × C otomatik hesaplanır.
            </div>
            <div style="display:flex;gap:6px;flex-wrap:wrap">
                @foreach (var r in _referenceRanges)
                {
                    <div style="background:@r.Bg;color:@r.Color;border:1px solid @r.Color;border-radius:6px;padding:4px 10px;text-align:center;flex:1;min-width:90px">
                        <div style="font-size:10px;font-weight:700">@r.Range</div>
                        <div style="font-size:11px;font-weight:600;margin-top:1px">@r.Label</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="form-group">
        <label class="form-label">@(EvalType == "residual" ? "Kontroller uygulandıktan sonraki durum" : "Değerlendirici Notu")</label>
        <textarea class="form-control" rows="2" @bind="_notes"
                  placeholder="@(EvalType == "residual" ? "Mevcut kontroller sonrası kalan risk durumunu açıklayın…" : "Opsiyonel: Değerlendirmeye ilişkin notlarınız…")"></textarea>
    </div>

    <button class="btn btn-success btn-sm" @onclick="Submit"
            disabled="@(Loading || _p == 0 || _e == 0 || _c == 0)">
        @(Loading ? "Kaydediliyor…" : "Değerlendirmeyi Kaydet")
    </button>
</div>

@code {
    [Parameter] public string EvalType { get; set; } = "initial";
    [Parameter] public EventCallback<EvalResult> OnSubmit { get; set; }
    [Parameter] public bool Loading { get; set; }

    private double _p, _e, _c;
    private string _notes = "";
    private ScoredOption[] _probability = [], _exposure = [], _consequence = [];

    private record ReferenceRange(string Range, string Label, string Color, string Bg);
    private static readonly ReferenceRange[] _referenceRanges =
    [
        new("< 20",      "Kabul Edilebilir", "#166534", "#dcfce7"),
        new("20–70",     "Orta Risk",        "#854d0e", "#fef9c3"),
        new("70–200",    "Önemli Risk",      "#9a3412", "#ffedd5"),
        new("200–400",   "Yüksek Risk",      "#991b1b", "#fee2e2"),
        new("≥ 400",     "Çok Yüksek Risk",  "#7f1d1d", "#fecaca"),
    ];

    protected override void OnInitialized()
    {
        _probability = CfgSvc.Get<ScoredOption[]>("fk_probability") ?? [];
        _exposure    = CfgSvc.Get<ScoredOption[]>("fk_exposure")    ?? [];
        _consequence = CfgSvc.Get<ScoredOption[]>("fk_consequence") ?? [];
    }

    private async Task Submit()
        => await OnSubmit.InvokeAsync(new EvalResult(EvalType, _p, _e, _c, _notes));
}

@using System.Security.Claims
@inject ImportService ImportSvc
@inject IHttpContextAccessor HttpCtx
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Visible)
{
    <div class="confirm-overlay" @onclick="Close">
        <div class="card import-modal-card" @onclick:stopPropagation>

            <div class="import-modal-header">
                <div>
                    <div class="import-modal-title">İçe Aktar — @Title</div>
                    <div class="import-modal-sub">Yalnızca .xlsx formatı desteklenir</div>
                </div>
                <button @onclick="Close" class="import-modal-close" aria-label="Kapat">
                    <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>

            <div class="import-template-hint">
                <div style="flex:1">
                    <div class="import-template-title">Şablonu İndir</div>
                    <div class="import-template-sub">Doğru formatı görmek için önce şablonu indirin</div>
                </div>
                <a href="/import/template/@Module" class="btn btn-outline btn-sm" style="white-space:nowrap;flex-shrink:0">
                    <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Şablon
                </a>
            </div>

            @if (!_loading && _result is null)
            {
                <label for="import-modal-file" class="import-dropzone @(_file != null ? "import-dropzone--selected" : "")">
                    <div class="import-dropzone-icon">
                        <svg width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
                        </svg>
                    </div>
                    <div class="import-dropzone-label">
                        @(_file is null ? "Excel dosyası seçin (.xlsx)" : _file.Name)
                    </div>
                    <InputFile OnChange="FileSelected" accept=".xlsx" style="display:none" id="import-modal-file" />
                    <span class="btn btn-outline btn-sm" style="cursor:pointer;pointer-events:none">Dosya Seç</span>
                </label>

                @if (_file is not null)
                {
                    <div class="import-file-selected">
                        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @_file.Name (@_fileSizeLabel)
                        <button @onclick="ClearFile" class="import-file-remove" aria-label="Kaldır">
                            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_uploadError))
                {
                    <div class="alert alert-error" style="margin-top:8px">@_uploadError</div>
                }

                <div style="display:flex;gap:8px;margin-top:16px">
                    <button class="btn btn-primary" @onclick="Upload" disabled="@(_file is null)">İçe Aktar</button>
                    <button class="btn btn-outline" @onclick="Close">İptal</button>
                </div>
            }

            @if (_loading)
            {
                <div class="spinner" style="padding:32px 16px">
                    <span style="font-size:14px;font-weight:600;color:var(--text-2)">Dosya işleniyor…</span>
                </div>
            }

            @if (_result is not null)
            {
                @if (_result.Imported > 0 || _result.Updated > 0)
                {
                    <div class="alert alert-success" style="margin-bottom:12px">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        <div>
                            <div style="font-weight:700">
                                @if (_result.Imported > 0) { <span>@_result.Imported yeni kayıt aktarıldı</span> }
                                @if (_result.Imported > 0 && _result.Updated > 0) { <span>, </span> }
                                @if (_result.Updated > 0) { <span>@_result.Updated kayıt güncellendi</span> }
                            </div>
                            @if (_result.Skipped > 0)
                            {
                                <div style="font-size:12px;opacity:.8;margin-top:2px">@_result.Skipped satır atlandı</div>
                            }
                        </div>
                    </div>
                }

                @if (_result.Errors.Count > 0)
                {
                    <div class="alert alert-error" style="flex-direction:column;align-items:flex-start;margin-bottom:12px">
                        <div style="font-weight:700;margin-bottom:6px">@_result.Errors.Count hata</div>
                        <div class="import-error-list">
                            @foreach (var err in _result.Errors)
                            {
                                <div style="padding:2px 0">• @err</div>
                            }
                        </div>
                    </div>
                }

                <div style="display:flex;gap:8px">
                    @if (_result.Imported > 0 || _result.Updated > 0)
                    {
                        <button class="btn btn-primary" @onclick="Done">Tamam, Sayfayı Yenile</button>
                    }
                    <button class="btn btn-outline" @onclick="Reset">Yeni Dosya Yükle</button>
                    <button class="btn btn-outline" @onclick="Close">Kapat</button>
                </div>
            }

        </div>
    </div>
}

<style>
    .import-modal-card   { width: 520px; max-width: 95vw; padding: 24px; position: relative; }
    .import-modal-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
    .import-modal-title  { font-size: 17px; font-weight: 800; color: var(--text); }
    .import-modal-sub    { font-size: 12px; color: var(--text-3); margin-top: 2px; }
    .import-modal-close  {
        background: none; border: none; cursor: pointer;
        color: var(--text-3); padding: 4px; border-radius: var(--r-sm);
        display: flex; align-items: center; transition: color .15s, background .15s;
    }
    .import-modal-close:hover { color: var(--text); background: var(--gray-100); }

    .import-template-hint {
        display: flex; align-items: center; gap: 12px;
        background: var(--blue-50); border: 1px solid var(--blue-100);
        border-radius: var(--r-lg); padding: 10px 14px; margin-bottom: 16px;
    }
    .import-template-title { font-size: 13px; font-weight: 600; color: #0369a1; }
    .import-template-sub   { font-size: 12px; color: #0284c7; margin-top: 2px; }

    .import-dropzone {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        border: 2px dashed var(--border-strong); border-radius: var(--r-lg);
        padding: 24px; text-align: center; background: var(--gray-50);
        cursor: pointer; transition: border-color .15s, background .15s;
    }
    .import-dropzone:hover, .import-dropzone--selected {
        border-color: var(--navy-700); background: var(--navy-50);
    }
    .import-dropzone-icon  { color: var(--gray-400); }
    .import-dropzone-label { font-size: 13px; font-weight: 600; color: var(--text-2); }

    .import-file-selected {
        margin-top: 10px; padding: 8px 12px;
        background: var(--green-50); border: 1px solid var(--green-100);
        border-radius: var(--r-md); font-size: 12px; color: #15803d;
        display: flex; align-items: center; gap: 8px;
    }
    .import-file-remove {
        margin-left: auto; background: none; border: none;
        cursor: pointer; color: var(--gray-400); display: flex; align-items: center;
        padding: 2px; border-radius: 3px; transition: color .15s;
    }
    .import-file-remove:hover { color: var(--red-500); }

    .import-error-list {
        max-height: 160px; overflow-y: auto;
        font-size: 12px; color: #991b1b; width: 100%;
    }
</style>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Module { get; set; } = "";

    private bool _prevVisible;

    protected override async Task OnParametersSetAsync()
    {
        if (Visible && !_prevVisible)
            await JS.InvokeVoidAsync("window.scrollTo", 0, 0);
        _prevVisible = Visible;
    }

    private IBrowserFile? _file;
    private string _fileSizeLabel = "";
    private bool _loading;
    private ImportResult? _result;
    private string _uploadError = "";

    private int UserId => int.TryParse(
        HttpCtx.HttpContext?.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id : 0;

    private void FileSelected(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _result = null;
        _uploadError = "";
        _fileSizeLabel = FormatSize(_file.Size);
    }

    private void ClearFile()
    {
        _file = null;
        _result = null;
        _uploadError = "";
        _fileSizeLabel = "";
    }

    private async Task Upload()
    {
        if (_file is null) return;
        _loading = true;
        _result = null;
        _uploadError = "";
        try
        {
            using var ms = new MemoryStream();
            await using var s = _file.OpenReadStream(maxAllowedSize: UploadLimits.MaxBytes);
            await s.CopyToAsync(ms);
            ms.Position = 0;
            _result = RunImport(ms);
        }
        catch (Exception ex)
        {
            _uploadError = "Hata: " + ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    [Inject] private RiskLibraryService LibSvc      { get; set; } = default!;
    [Inject] private RiskService        RiskSvc     { get; set; } = default!;
    [Inject] private AuditService       AuditSvcInj { get; set; } = default!;
    [Inject] private AuthService        AuthSvc     { get; set; } = default!;

    private ImportResult RunImport(MemoryStream ms)
    {
        var userObj = AuthSvc.ActiveUserFromPrincipal(HttpCtx.HttpContext?.User);
        if (userObj is null) return new ImportResult { Errors = ["Kimlik doğrulama gerekli."] };

        // controls ve action-plans: risk.manage izni olmayanlar yalnızca erişebildiği risklere yazabilir
        HashSet<int>? allowedRiskIds = null;
        if (Module is "controls" or "action-plans")
        {
            if (!AuthSvc.HasPermission(userObj, "risk.manage"))
                allowedRiskIds = RiskSvc.GetForUser(userObj).Select(r => r.Id).ToHashSet();
        }

        // audit-actions: audit.close_approve izni olmayanlar yalnızca erişebildiği bulgulara yazabilir
        HashSet<int>? allowedFindingIds = null;
        if (Module is "audit-actions")
        {
            if (!AuthSvc.HasPermission(userObj, "audit.close_approve"))
                allowedFindingIds = AuditSvcInj.GetFindingsForUser(userObj).Select(f => f.Id).ToHashSet();
        }

        return Module switch
        {
            "risks"                    => ImportSvc.ImportRisksFromExcel(ms, UserId),
            "controls"                 => ImportSvc.ImportControlsFromExcel(ms, UserId, allowedRiskIds),
            "action-plans"             => ImportSvc.ImportActionPlansFromExcel(ms, UserId, allowedRiskIds),
            "findings"                 => ImportSvc.ImportFindingsFromExcel(ms, UserId),
            "audit-actions"            => ImportSvc.ImportAuditActionsFromExcel(ms, UserId, allowedFindingIds),
            "ethics"                   => ImportSvc.ImportEthicsFromExcel(ms),
            "library"                  => LibSvc.ImportFromExcel(ms, UserId),
            "external-nonconformities" => ImportSvc.ImportExternalAuditNonconformitiesFromExcel(ms, UserId),
            _                          => new ImportResult { Errors = ["Geçersiz modül."] }
        };
    }

    private void Reset()
    {
        _file = null;
        _result = null;
        _uploadError = "";
        _fileSizeLabel = "";
    }

    private void Done() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    private void Close() { Reset(); _ = OnClose.InvokeAsync(); }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return bytes + " B";
        if (bytes < 1048576) return (bytes / 1024.0).ToString("F1") + " KB";
        return (bytes / 1048576.0).ToString("F1") + " MB";
    }
}

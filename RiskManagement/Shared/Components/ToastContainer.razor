@inject ToastService ToastSvc
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="toast-container">
        @foreach (var t in _toasts)
        {
            var tid = t.Id;
            <div class="toast toast-@t.Toast.Type.ToString().ToLower()" role="alert" aria-live="polite">
                <span class="toast-icon">@Icon(t.Toast.Type)</span>
                <span class="toast-msg">@t.Toast.Message</span>
                <button style="background:none;border:none;cursor:pointer;color:inherit;opacity:.6;padding:0 0 0 8px;font-size:16px;line-height:1;flex-shrink:0"
                        @onclick="() => Dismiss(tid)" aria-label="Kapat">×</button>
                <div class="toast-progress" style="animation-duration:@(t.Toast.DurationMs)ms"></div>
            </div>
        }
    </div>
}

@code {
    private readonly List<ToastItem> _toasts = [];

    private record ToastItem(RiskManagement.Services.Toast Toast, Guid Id);

    protected override void OnInitialized() => ToastSvc.OnShow += ShowToast;

    private void ShowToast(RiskManagement.Services.Toast toast)
    {
        var item = new ToastItem(toast, Guid.NewGuid());
        _toasts.Add(item);
        InvokeAsync(StateHasChanged);
        Task.Delay(toast.DurationMs + 200).ContinueWith(_ =>
        {
            _toasts.RemoveAll(t => t.Id == item.Id);
            InvokeAsync(StateHasChanged);
        });
    }

    private void Dismiss(Guid id)
    {
        _toasts.RemoveAll(t => t.Id == id);
    }

    private static MarkupString Icon(ToastType t) => t switch
    {
        ToastType.Success => new MarkupString("<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><polyline points='20 6 9 17 4 12'/></svg>"),
        ToastType.Error   => new MarkupString("<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/></svg>"),
        ToastType.Warning => new MarkupString("<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z'/><line x1='12' y1='9' x2='12' y2='13'/><line x1='12' y1='17' x2='12.01' y2='17'/></svg>"),
        _                 => new MarkupString("<svg xmlns='http://www.w3.org/2000/svg' width='15' height='15' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><circle cx='12' cy='12' r='10'/><line x1='12' y1='8' x2='12' y2='12'/><line x1='12' y1='16' x2='12.01' y2='16'/></svg>"),
    };

    public void Dispose() => ToastSvc.OnShow -= ShowToast;
}

# ── Veritabanı ────────────────────────────────────────────────────────────────
# MySQL root şifresi (docker-compose için)
DB_ROOT_PASSWORD=root_change_me

# Uygulama kullanıcısının şifresi
DB_PASSWORD=riskpassword_change_me

# ── Güvenlik ──────────────────────────────────────────────────────────────────
# En az 32 karakter, rastgele oluşturulmuş bir değer kullanın.
# Üretmek için: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# ── Uygulama ──────────────────────────────────────────────────────────────────
# Gerçek ortamda false olmalı — seed verisi yükler
DEMO_MODE=false

# Maksimum dosya yükleme boyutu (MB)
MAX_UPLOAD_MB=10
